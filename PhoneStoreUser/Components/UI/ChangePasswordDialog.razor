@using PhoneStoreUser.Components.Models
@using System.ComponentModel.DataAnnotations

<div class="fixed inset-0 z-50 flex items-center justify-center bg-gray-900/60 backdrop-blur-md transition-opacity p-4" @onclick="Close">
    <div class="relative w-full max-w-md transform overflow-hidden rounded-2xl bg-white shadow-2xl ring-1 ring-black/5 transition-all" @onclick:stopPropagation>
        
        <div class="absolute right-4 top-4 z-10">
            <button type="button" @onclick="Close" class="rounded-full bg-white/80 p-2 text-gray-400 hover:bg-gray-100 hover:text-gray-600 transition-colors backdrop-blur-sm">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <EditForm Model="@Model" OnValidSubmit="Save">
            <DataAnnotationsValidator />

            <div class="h-24 w-full bg-gradient-to-r from-orange-500 to-red-600 flex items-center justify-center">
                <div class="rounded-full bg-white/20 p-3 backdrop-blur-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                </div>
            </div>

            <div class="px-8 py-6">
                <h3 class="text-center text-xl font-bold text-gray-900 mb-1">Đổi mật khẩu</h3>
                <p class="text-center text-sm text-gray-500 mb-6">Hãy chọn một mật khẩu mạnh để bảo vệ tài khoản.</p>

                <div class="space-y-5">
                    <div class="group">
                        <label class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-gray-500">Mật khẩu hiện tại</label>
                        <div class="relative">
                            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                                </svg>
                            </div>
                            <input type="@(ShowOldPass ? "text" : "password")" 
                                   @bind="Model.OldPassword" 
                                   class="block w-full rounded-xl border border-gray-300 bg-gray-50 py-2.5 pl-10 pr-10 text-sm text-gray-900 placeholder-gray-400 focus:border-orange-500 focus:bg-white focus:ring-2 focus:ring-orange-500/20 transition-all" 
                                   placeholder="••••••••" />
                            <button type="button" @onclick="() => ShowOldPass = !ShowOldPass" class="absolute inset-y-0 right-0 flex items-center pr-3 text-gray-400 hover:text-gray-600">
                                @if (ShowOldPass) { <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858-5.908a9.04 9.04 0 012.12-.313c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" /></svg> }
                                else { <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg> }
                            </button>
                        </div>
                        <ValidationMessage For="@(() => Model.OldPassword)" class="mt-1 text-xs font-medium text-red-500" />
                    </div>

                    <div class="group">
                        <label class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-gray-500">Mật khẩu mới</label>
                        <div class="relative">
                            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                </svg>
                            </div>
                            <input type="@(ShowNewPass ? "text" : "password")" 
                                   @bind="Model.NewPassword" 
                                   class="block w-full rounded-xl border border-gray-300 bg-gray-50 py-2.5 pl-10 pr-10 text-sm text-gray-900 placeholder-gray-400 focus:border-orange-500 focus:bg-white focus:ring-2 focus:ring-orange-500/20 transition-all" 
                                   placeholder="Nhập mật khẩu mới" />
                            <button type="button" @onclick="() => ShowNewPass = !ShowNewPass" class="absolute inset-y-0 right-0 flex items-center pr-3 text-gray-400 hover:text-gray-600">
                                @if (ShowNewPass) { <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858-5.908a9.04 9.04 0 012.12-.313c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" /></svg> }
                                else { <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg> }
                            </button>
                        </div>
                        <ValidationMessage For="@(() => Model.NewPassword)" class="mt-1 text-xs font-medium text-red-500" />
                    </div>

                    <div class="group">
                        <label class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-gray-500">Xác nhận mật khẩu</label>
                        <div class="relative">
                            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                            <input type="@(ShowConfirmPass ? "text" : "password")" 
                                   @bind="Model.ConfirmPassword" 
                                   class="block w-full rounded-xl border border-gray-300 bg-gray-50 py-2.5 pl-10 pr-10 text-sm text-gray-900 placeholder-gray-400 focus:border-orange-500 focus:bg-white focus:ring-2 focus:ring-orange-500/20 transition-all" 
                                   placeholder="Nhập lại mật khẩu mới" />
                            <button type="button" @onclick="() => ShowConfirmPass = !ShowConfirmPass" class="absolute inset-y-0 right-0 flex items-center pr-3 text-gray-400 hover:text-gray-600">
                                @if (ShowConfirmPass) { <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858-5.908a9.04 9.04 0 012.12-.313c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" /></svg> }
                                else { <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg> }
                            </button>
                        </div>
                        <ValidationMessage For="@(() => Model.ConfirmPassword)" class="mt-1 text-xs font-medium text-red-500" />
                    </div>
                </div>

                <div class="mt-8 flex items-center justify-end gap-3 border-t border-gray-100 pt-5">
                    <button type="button" @onclick="Close" class="rounded-xl px-5 py-2.5 text-sm font-semibold text-gray-600 hover:bg-gray-100 hover:text-gray-900 transition-colors">
                        Hủy bỏ
                    </button>
                    <button type="submit" 
                            disabled="@(IsSaving || IsSuccess)" 
                            class="@($"flex items-center gap-2 rounded-xl px-6 py-2.5 text-sm font-semibold text-white shadow-sm transition-all focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 disabled:opacity-70 disabled:cursor-not-allowed " + 
                                    (IsSuccess 
                                        ? "bg-green-600 hover:bg-green-700 focus-visible:outline-green-600" 
                                        : "bg-orange-600 hover:bg-orange-700 focus-visible:outline-orange-600"))">
                        @if (IsSaving)
                        {
                            <svg class="h-4 w-4 animate-spin text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                            <span>Đang xử lý...</span>
                        }
                        else if (IsSuccess)
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                            </svg>
                            <span>Thành công</span>
                        }
                        else
                        {
                            <span>Đổi mật khẩu</span>
                        }
                    </button>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public bool IsSuccess { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<ChangePasswordModel> OnSave { get; set; }

    private ChangePasswordModel Model { get; set; } = new();
    
    // States for visibility toggles
    private bool ShowOldPass = false;
    private bool ShowNewPass = false;
    private bool ShowConfirmPass = false;

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private async Task Save()
    {
        await OnSave.InvokeAsync(Model);
    }
}