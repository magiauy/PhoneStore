@using PhoneStoreUser.Services
@inject IInventoryService InventoryService

@if (IsVisible)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50" @onclick="Close">
        <div class="bg-white rounded-lg shadow-lg w-full max-w-2xl p-6 relative" @onclick:stopPropagation>
            <button class="absolute top-4 right-4 text-gray-500 hover:text-gray-700" @onclick="Close">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>

            <h2 class="text-xl font-bold mb-4">Chi tiết tồn kho: @ProductName</h2>

            @if (IsLoading)
            {
                <div class="flex justify-center py-8">
                    <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
                </div>
            }
            else if (BatchDetails == null || !BatchDetails.Any())
            {
                <div class="text-center py-8 text-gray-500">
                    Không tìm thấy dữ liệu tồn kho cho sản phẩm này.
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Mã lô hàng</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Ngày nhập</th>
                                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Số lượng nhập</th>
                                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Tồn hiện tại</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            @foreach (var batch in BatchDetails)
                            {
                                <tr>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                        @batch.BatchCode
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                        @(batch.CreatedAt == DateTime.MinValue ? "Chưa cập nhật" : batch.CreatedAt.ToString("dd/MM/yyyy HH:mm"))
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 text-right font-bold">
                                        @batch.ImportedQuantity
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 text-right font-bold">
                                        @batch.CurrentQuantity
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="bg-gray-50">
                            <tr>
                                <td colspan="2" class="px-6 py-3 text-right text-sm font-bold text-gray-900">Tổng cộng:</td>
                                <td class="px-6 py-3 text-right text-sm font-bold text-blue-600">
                                    @BatchDetails.Sum(b => b.ImportedQuantity)
                                </td>
                                <td class="px-6 py-3 text-right text-sm font-bold text-blue-600">
                                    @BatchDetails.Sum(b => b.CurrentQuantity)
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public int ProductId { get; set; }
    [Parameter] public string ProductName { get; set; } = string.Empty;

    private List<BatchDetailDto> BatchDetails { get; set; } = new();
    private bool IsLoading { get; set; } = false;

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible && ProductId > 0)
        {
            await LoadDataAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        IsLoading = true;
        try
        {
            BatchDetails = await InventoryService.GetProductBatchDetailsAsync(ProductId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Lỗi tải chi tiết lô hàng: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task Close()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
    }
}
