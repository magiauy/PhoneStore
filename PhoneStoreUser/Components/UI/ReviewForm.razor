@using PhoneStoreUser.Services
@using PhoneStoreUser.Data
@using Microsoft.AspNetCore.Components.Authorization
@inject IReviewService ReviewService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
    <div class="flex items-center gap-3 mb-4">
        <div class="p-2 bg-blue-100 text-[#2563EB] rounded-lg">
            <i class="fa-solid fa-pen-nib"></i>
        </div>
        <h4 class="text-lg font-bold text-gray-900">Viết đánh giá của bạn</h4>
    </div>

    @if (!IsLoggedIn)
    {
        <div class="text-center py-6 bg-white rounded-xl border border-dashed border-gray-300">
            <p class="text-gray-500 mb-3 text-sm">Bạn cần đăng nhập để đánh giá sản phẩm này.</p>
            <a href="login?returnUrl=@Navigation.Uri" 
               class="inline-block px-6 py-2 bg-white border border-gray-300 text-gray-700 font-medium rounded-xl hover:bg-gray-50 hover:text-[#2563EB] hover:border-[#2563EB] transition">
                Đăng nhập ngay
            </a>
        </div>
    }
    else
    {
        @if (IsSuccess)
        {
            <div class="p-4 bg-green-50 text-green-700 rounded-xl border border-green-100 flex items-center gap-3 animate-fade-in">
                <i class="fa-solid fa-circle-check text-xl"></i>
                <div>
                    <span class="font-bold block">Thành công!</span>
                    <span class="text-sm">Cảm ơn bạn đã chia sẻ đánh giá.</span>
                </div>
            </div>
        }
        else
        {
            <EditForm Model="@ReviewModel" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                
                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="mb-4 p-3 bg-red-50 text-red-600 text-sm rounded-xl border border-red-100">
                        @ErrorMessage
                    </div>
                }

                <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
                    <div class="md:col-span-4 flex flex-col justify-center">
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Bạn chấm mấy sao?</label>
                        <div class="flex gap-2">
                            @for (int i = 1; i <= 5; i++)
                            {
                                var rating = i;
                                <button type="button" @onclick="() => SetRating(rating)" 
                                        class="text-2xl transition hover:scale-110 focus:outline-none">
                                    @if (ReviewModel.Rating >= rating)
                                    {
                                        <i class="fa-solid fa-star text-yellow-400"></i>
                                    }
                                    else
                                    {
                                        <i class="fa-regular fa-star text-gray-300"></i>
                                    }
                                </button>
                            }
                        </div>
                        @if (ShowRatingError)
                        {
                            <span class="text-red-500 text-xs mt-1">Vui lòng chọn số sao.</span>
                        }
                    </div>

                    <div class="md:col-span-8">
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Chia sẻ cảm nhận</label>
                        <InputTextArea 
                            @bind-Value="ReviewModel.Comment" 
                            class="w-full rounded-xl border-gray-200 bg-white shadow-sm focus:border-[#2563EB] focus:ring-[#2563EB] text-sm py-3 px-4" 
                            rows="3" 
                            placeholder="Sản phẩm có đúng như mô tả không?..." />
                        <ValidationMessage For="@(() => ReviewModel.Comment)" class="text-red-500 text-xs mt-1" />
                    </div>
                </div>

                <div class="mt-4 text-right">
                    <button type="submit" disabled="@IsSubmitting" 
                            class="px-8 py-3 bg-[#2563EB] text-white font-semibold rounded-xl hover:bg-blue-700 transition disabled:opacity-50 disabled:cursor-not-allowed shadow-sm">
                        @if (IsSubmitting)
                        {
                            <span><i class="fa-solid fa-spinner fa-spin mr-2"></i>Đang gửi...</span>
                        }
                        else
                        {
                            <span>Gửi đánh giá</span>
                        }
                    </button>
                </div>
            </EditForm>
        }
    }
</div>

@code {
    [Parameter] public int ProductId { get; set; }
    [Parameter] public EventCallback OnReviewSubmitted { get; set; }

    private ReviewEntity ReviewModel = new() { Rating = 5 };
    private bool IsLoggedIn = false;
    private int UserId;
    private bool IsSubmitting = false;
    private string? ErrorMessage;
    private bool IsSuccess = false;
    private bool ShowRatingError = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            IsLoggedIn = true;
            var idClaim = user.FindFirst("person_id");
            if (idClaim != null && int.TryParse(idClaim.Value, out int id)) UserId = id;
        }
    }

    private void SetRating(int rating)
    {
        ReviewModel.Rating = rating;
        ShowRatingError = false;
    }

    private async Task HandleSubmit()
    {
        if (ReviewModel.Rating < 1) { ShowRatingError = true; return; }
        IsSubmitting = true;
        try
        {
            ReviewModel.ProductId = ProductId;
            ReviewModel.PersonId = UserId;
            ReviewModel.CreatedAt = DateTime.UtcNow;
            await ReviewService.AddReviewAsync(ReviewModel);
            IsSuccess = true;
            ReviewModel = new() { Rating = 5 };
            await OnReviewSubmitted.InvokeAsync();
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { IsSubmitting = false; }
    }
}