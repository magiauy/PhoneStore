@using System
@using System.Collections.Generic
@using PhoneStoreUser.Components.Models
@using PhoneStoreUser.Components.ViewModels
@using PhoneStoreUser.Services

@inject IProductCatalogService ProductCatalogService
@inject ICloudinaryService CloudinaryService

<a href="@GetProductUrl()"
   class="group rounded-2xl border border-gray-200 bg-white overflow-hidden shadow-sm transition hover:-translate-y-1 hover:shadow-lg block flex flex-col min-h-[350px]">

    <div class="relative overflow-hidden bg-gray-50 aspect-square mt-4">
        <img src="@ImageUrl"
             alt="@Product?.Name"
             class="w-full h-full object-cover transition duration-200 group-hover:scale-105"
             loading="lazy"
             @onerror="HandleImageError" />
    </div>

    <div class="p-4 space-y-2 flex flex-col flex-1">
        @if (Product != null)
        {
            <h3 class="text-sm font-semibold text-gray-900 line-clamp-2 grow">@Product.Name</h3>

            <div class="mt-auto pt-2">
                <p class="text-lg font-bold text-[#2563EB]">
                    @(Product.Price > 0
                        ? $"{Product.Price.ToString("N0", new System.Globalization.CultureInfo("vi-VN"))} ₫"
                        : "Liên hệ")
                </p>

                @* Pricing Labels based on PricingMode *@
                @if (Product.PricingMode == PricingMode.CLEARANCE)
                {
                    <span class="inline-block mt-1 px-2 py-0.5 text-xs font-medium text-orange-700 bg-orange-100 rounded-full">
                        Giá ưu đãi xả kho (Số lượng có hạn)
                    </span>
                }
                else if (Product.PricingMode == PricingMode.AUTO_PROTECT && IsPriceRecentlyUpdated(Product.PriceUpdatedAt))
                {
                    <span class="inline-block mt-1 px-2 py-0.5 text-xs font-medium text-blue-700 bg-blue-100 rounded-full">
                        Giá thị trường (Cập nhật 24h)
                    </span>
                }

                <button type="button" class="mt-3 w-full rounded-xl bg-[#2563EB] py-2 text-sm font-semibold text-white transition hover:bg-blue-700">
                    Xem chi tiết
                </button>
            </div>
        }
    </div>
</a>

@code {
    [Parameter]
    public ProductCardViewModel? Product { get; set; }

    private const string DefaultFallbackImageUrl = "/images/hero/iphone-17-pm-2.png";
    private string ImageUrl { get; set; } = DefaultFallbackImageUrl;
    private IReadOnlyList<ProductAttribute> Attributes { get; set; } = Array.Empty<ProductAttribute>();
    private IReadOnlyList<ProductAttributeValue> AttributeValues { get; set; } = Array.Empty<ProductAttributeValue>();
    private IReadOnlyDictionary<int, IReadOnlyList<ProductAttributeOption>> AttributeOptions { get; set; } = new Dictionary<int, IReadOnlyList<ProductAttributeOption>>();

    protected override async Task OnParametersSetAsync()
    {
        ImageUrl = DefaultFallbackImageUrl;

        if (Product == null)
        {
            Attributes = Array.Empty<ProductAttribute>();
            AttributeValues = Array.Empty<ProductAttributeValue>();
            AttributeOptions = new Dictionary<int, IReadOnlyList<ProductAttributeOption>>();
            return;
        }

        // Get attributes for the model
        var modelAttributes = await ProductCatalogService.GetAttributesForModelAsync(Product.ModelId);
        AttributeValues = await ProductCatalogService.GetAttributeValuesForProductsAsync(new[] { Product.Id });
        AttributeOptions = await ProductCatalogService.GetAttributeOptionsForAttributesAsync(modelAttributes.Select(a => a.Id));

        // Build display attributes
        var attributes = new List<ProductAttribute>();
        foreach (var attr in modelAttributes)
        {
            var value = AttributeValues.FirstOrDefault(v => v.AttributeId == attr.Id && v.ProductId == Product.Id);
            if (value != null)
            {
                attributes.Add(attr);
            }
        }
        Attributes = attributes;

        // Build image URL
        var variantImageUrl = await BuildVariantImageUrlAsync(Product);
        if (!string.IsNullOrEmpty(variantImageUrl))
        {
            ImageUrl = variantImageUrl;
        }
    }

    private static string GetAttributeDisplayValue(ProductAttribute attr, ProductAttributeValue? value, IReadOnlyDictionary<int, IReadOnlyList<ProductAttributeOption>> options)
    {
        if (value == null)
        {
            return string.Empty;
        }

        if (value.OptionId.HasValue && options.TryGetValue(attr.Id, out var attrOptions))
        {
            var option = attrOptions.FirstOrDefault(o => o.Id == value.OptionId.Value);
            return option?.DisplayValue ?? string.Empty;
        }

        if (!string.IsNullOrEmpty(value.ValueText))
        {
            return value.ValueText;
        }

        if (value.ValueNumber.HasValue)
        {
            return value.ValueNumber.Value.ToString();
        }

        if (value.ValueBool.HasValue)
        {
            return value.ValueBool.Value ? "Yes" : "No";
        }

        if (value.ValueDate.HasValue)
        {
            return value.ValueDate.Value.ToString("d");
        }

        return string.Empty;
    }

    private Task<string?> BuildVariantImageUrlAsync(ProductCardViewModel product)
    {
        if (product == null)
        {
            return Task.FromResult<string?>(null);
        }

        var brand = product.BrandName?.Trim();
        var sku = product.Sku?.Trim();
        var slugValue = string.IsNullOrWhiteSpace(product.Slug) ? "default" : product.Slug.Trim();

        if (string.IsNullOrEmpty(brand) || string.IsNullOrEmpty(sku))
        {
            return Task.FromResult<string?>(null);
        }

        var cacheKey = (product.UpdatedAt ?? product.CreatedAt)?.Ticks.ToString();
        return CloudinaryService.GetImageUrlAsync(brand, slugValue, sku, cacheKey);
    }

    private void HandleImageError()
    {
        ImageUrl = DefaultFallbackImageUrl;
    }

    /// <summary>
    /// Check if price was updated within the last 24 hours
    /// </summary>
    private static bool IsPriceRecentlyUpdated(DateTime? priceUpdatedAt)
    {
        if (priceUpdatedAt == null) return false;
        return (DateTime.UtcNow - priceUpdatedAt.Value).TotalHours <= 24;
    }

    private string GetProductUrl()
    {
        if (Product == null)
        {
            return "/";
        }

        var queryParams = new List<string>();
        foreach (var attr in Attributes)
        {
            var value = AttributeValues.FirstOrDefault(v => v.AttributeId == attr.Id && v.ProductId == Product.Id);
            if (value != null)
            {
                var displayValue = GetAttributeDisplayValue(attr, value, AttributeOptions);
                if (!string.IsNullOrEmpty(displayValue))
                {
                    queryParams.Add($"{Uri.EscapeDataString(attr.Name.ToLowerInvariant())}={Uri.EscapeDataString(displayValue)}");
                }
            }
        }

        var queryString = string.Join("&", queryParams);
        return $"/product/{Product.Slug}/{Product.Sku}";
    }
}

