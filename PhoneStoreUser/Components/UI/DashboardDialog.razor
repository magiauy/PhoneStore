@using PhoneStoreUser.Components.Models
@using PhoneStoreUser.Services
@inject PhoneStoreUser.Services.IDashboardService DashboardService

<div class="fixed inset-0 z-50 flex items-center justify-center bg-gray-900/60 backdrop-blur-md transition-opacity p-4" @onclick="Close">
    <div class="relative w-full max-w-5xl max-h-[90vh] flex flex-col transform overflow-hidden rounded-2xl bg-white shadow-2xl ring-1 ring-black/5 transition-all" @onclick:stopPropagation>

        <div class="absolute right-4 top-4 z-10">
            <button type="button" @onclick="Close" class="rounded-full bg-white/80 p-2 text-black-400 hover:bg-gray-100 hover:text-gray-600 transition-colors backdrop-blur-sm shadow-sm">
                Thoát
            </button>
        </div>

        @if(DashboardData is null)
        {
            <div class="flex h-96 flex-col items-center justify-center space-y-4">
                <div class="h-10 w-10 animate-spin rounded-full border-[3px] border-blue-100 border-t-blue-600"></div>
                <p class="text-sm font-medium text-gray-500">Đang tổng hợp dữ liệu...</p>
            </div>
        }
        else
        {
            <div class="overflow-y-auto custom-scrollbar">
                <div class="h-32 w-full bg-gradient-to-r from-indigo-600 to-purple-600">
                    <div class="-mt-10 px-8 mb-6 flex items-end">
                        <div class="flex h-20 w-20 items-center justify-center rounded-2xl border-4 border-white bg-white shadow-lg text-3xl font-bold text-indigo-600 shrink-0">
                            @(DashboardData.FullName?.Length > 0 ? DashboardData.FullName[0].ToString().ToUpper() : "U")
                        </div>
                        <div class="ml-4 pt-10">
                            <h3 class="text-2xl font-bold text-gray-900">@DashboardData.FullName</h3>
                            <p class="text-indigo-600 text-sm font-medium">Khách hàng thân thiết</p>
                        </div>
                    </div>
                </div>
                <div class="px-8 pt-14 pb-8 space-y-8">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="bg-blue-50 rounded-2xl p-5 border border-blue-100 flex items-center justify-between">
                            <div>
                                <p class="text-sm font-semibold text-blue-500 uppercase tracking-wide">Tổng chi tiêu</p>
                                <p class="text-2xl font-bold text-gray-900 mt-1">@string.Format("{0:N0} đ", DashboardData.TotalSpent)</p>
                            </div>
                            <div class="p-3 bg-blue-100 text-blue-600 rounded-xl">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                            </div>
                        </div>

                        <div class="bg-green-50 rounded-2xl p-5 border border-green-100 flex items-center justify-between">
                            <div>
                                <p class="text-sm font-semibold text-green-600 uppercase tracking-wide">Đơn thành công</p>
                                <p class="text-2xl font-bold text-gray-900 mt-1">@DashboardData.TotalOrders <span class="text-sm font-normal text-gray-500">đơn</span></p>
                            </div>
                            <div class="p-3 bg-green-100 text-green-600 rounded-xl">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" /></svg>
                            </div>
                        </div>

                        <div class="bg-purple-50 rounded-2xl p-5 border border-purple-100 flex items-center justify-between">
                            <div>
                                <p class="text-sm font-semibold text-purple-600 uppercase tracking-wide">Đang bảo hành</p>
                                <p class="text-2xl font-bold text-gray-900 mt-1">@DashboardData.ActiveWarrantyCount <span class="text-sm font-normal text-gray-500">thiết bị</span></p>
                            </div>
                            <div class="p-3 bg-purple-100 text-purple-600 rounded-xl">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                            </div>
                        </div>
                    </div>

                    <div>
                        <h4 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
                            Thiết bị của tôi
                        </h4>
                        <div class="overflow-hidden rounded-xl border border-gray-200 shadow-sm">
                            <table class="w-full text-left text-sm text-gray-500">
                                <thead class="bg-gray-50 text-xs uppercase text-gray-700">
                                    <tr>
                                        <th class="px-6 py-3 font-semibold">Sản phẩm</th>
                                        <th class="px-6 py-3 font-semibold">Serial / IMEI</th>
                                        <th class="px-6 py-3 font-semibold">Ngày mua</th>
                                        <th class="px-6 py-3 font-semibold">Hạn bảo hành</th>
                                        <th class="px-6 py-3 font-semibold text-center">Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-100 bg-white">
                                    @if(DashboardData.MyDevices.Any())
                                    {
                                        @foreach(var device in DashboardData.MyDevices)
                                        {
                                            <tr class="hover:bg-gray-50/50 transition-colors">
                                                <td class="px-6 py-4 font-medium text-gray-900">@device.ProductName</td>
                                                <td class="px-6 py-4 font-mono text-xs text-gray-600">@device.IMEI</td>
                                                <td class="px-6 py-4">@device.PurchaseDate.ToString("dd/MM/yyyy")</td>
                                                <td class="px-6 py-4">@device.WarrantyExpireDate.ToString("dd/MM/yyyy")</td>
                                                <td class="px-6 py-4 text-center">
                                                    @if(device.IsActive)
                                                    {
                                                        <span class="inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800">
                                                            Còn hạn
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-800">
                                                            Hết hạn
                                                        </span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5" class="px-6 py-8 text-center text-gray-400 italic">
                                                Bạn chưa mua thiết bị nào tại cửa hàng.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div>
                        <h4 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
                            Đơn hàng gần đây
                        </h4>
                        <div class="overflow-hidden rounded-xl border border-gray-200 shadow-sm">
                            <table class="w-full text-left text-sm text-gray-500">
                                <thead class="bg-gray-50 text-xs uppercase text-gray-700">
                                    <tr>
                                        <th class="px-6 py-3 font-semibold">Mã đơn #</th>
                                        <th class="px-6 py-3 font-semibold">Ngày đặt</th>
                                        <th class="px-6 py-3 font-semibold text-right">Tổng tiền</th>
                                        <th class="px-6 py-3 font-semibold text-center">Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-100 bg-white">
                                    @if(DashboardData.RecentOrders.Any())
                                    {
                                        @foreach(var order in DashboardData.RecentOrders)
                                        {
                                            <tr class="hover:bg-gray-50/50 transition-colors">
                                                <td class="px-6 py-4 font-medium text-gray-900">#@order.InvoiceId</td>
                                                <td class="px-6 py-4">@order.Date.ToString("dd/MM/yyyy HH:mm")</td>
                                                <td class="px-6 py-4 text-right font-medium text-gray-900">
                                                    @string.Format("{0:N0} đ", order.TotalAmount)
                                                </td>
                                                <td class="px-6 py-4 text-center">
                                                    @GetStatusBadge(order.Status)
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4" class="px-6 py-8 text-center text-gray-400 italic">
                                                Chưa có đơn hàng nào.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public DashboardModel? DashboardData { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    // Helper hiển thị trạng thái đẹp mắt
    private RenderFragment GetStatusBadge(string status) => builder =>
    {
        string colorClass = status.ToLower() switch
        {
            "paid" or "completed" => "bg-green-100 text-green-800",
            "pending" or "dividing" => "bg-yellow-100 text-yellow-800",
            "cancelled" => "bg-red-100 text-red-800",
            "unpaid" => "bg-gray-100 text-gray-800",
            _ => "bg-blue-100 text-blue-800"
        };

        string text = status.ToLower() switch
        {
            "paid" => "Đã thanh toán",
            "completed" => "Hoàn thành",
            "pending" => "Chờ xử lý",
            "cancelled" => "Đã hủy",
            "unpaid" => "Chưa thanh toán",
            _ => status
        };

        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium {colorClass}");
        builder.AddContent(2, text);
        builder.CloseElement();
    };
}
