@using System
@using PhoneStoreUser.Components.Models

@inject IProductCatalogService ProductCatalogService

<a href="/product/@ProductModel?.Slug" class="group rounded-2xl border border-gray-200 bg-white overflow-hidden shadow-sm transition hover:-translate-y-1 hover:shadow-lg block">
    <div class="relative overflow-hidden bg-gray-50 aspect-square">
        <img src="@ImageUrl" 
             alt="@ProductModel?.Name" 
             class="w-full h-full object-cover transition duration-200 group-hover:scale-105" 
             loading="lazy"
             @onerror="HandleImageError" />
    </div>
    <div class="p-4 space-y-2">
        <h3 class="text-sm font-semibold text-gray-900 line-clamp-2">@ProductModel?.Name</h3>
        <p class="text-xs text-gray-500">@ProductModel?.Description</p>
        
        @if (SelectedProduct != null)
        {
             <p class="text-lg font-bold text-[#2563EB]">
                @(SelectedProduct.Price > 0 
                    ? $"{SelectedProduct.Price.ToString("N0", new System.Globalization.CultureInfo("vi-VN"))} ₫" 
                    : "Liên hệ")
            </p>
        }
        
        <button type="button" class="mt-3 w-full rounded-xl bg-[#2563EB] py-2 text-sm font-semibold text-white transition hover:bg-blue-700">
            Xem chi tiết
        </button>
    </div>
</a>

@code {
    [Parameter]
    public ProductModel? ProductModel { get; set; }

    private const string DefaultFallbackImageUrl = "/images/hero/iphone-17-pm-2.png";
    private Product? SelectedProduct { get; set; }
    private string ImageUrl { get; set; } = DefaultFallbackImageUrl;

    protected override async Task OnParametersSetAsync()
    {
        ImageUrl = GetFallbackImageUrl(ProductModel);

        if (ProductModel == null)
        {
            SelectedProduct = null;
            return;
        }

        var products = await ProductCatalogService.GetProductsByModelAsync(ProductModel.Id);
        SelectedProduct = products.FirstOrDefault();

        var variantImageUrl = BuildVariantImageUrl(SelectedProduct, ProductModel);
        if (!string.IsNullOrEmpty(variantImageUrl))
        {
            ImageUrl = variantImageUrl;
        }
    }

    private static string GetFallbackImageUrl(ProductModel? model)
        => !string.IsNullOrEmpty(model?.Image) ? model.Image! : DefaultFallbackImageUrl;

    private static string? BuildVariantImageUrl(Product? product, ProductModel? model)
    {
        if (product == null || model == null)
        {
            return null;
        }

        var brand = product.BrandName?.Trim();
        var slug = model.Slug?.Trim();
        var sku = product.Sku?.Trim();

        if (string.IsNullOrEmpty(brand) || string.IsNullOrEmpty(slug) || string.IsNullOrEmpty(sku))
        {
            return null;
        }

        var brandSegment = Uri.EscapeDataString(brand.ToLowerInvariant());
        var slugSegment = Uri.EscapeDataString(slug);
        var skuSegment = Uri.EscapeDataString(sku);

        return $"https://res.cloudinary.com/dstytmxfh/image/upload/v1763457477/mobileguzone/{brandSegment}/{slugSegment}/{skuSegment}.webp";
    }

    private void HandleImageError()
    {
        Console.WriteLine("Image failed to load, using fallback image.");
        ImageUrl = GetFallbackImageUrl(ProductModel);
    }
}

