@using System
@using PhoneStoreUser.Components.Models
@using PhoneStoreUser.Services
@using System.Globalization

@inject IProductCatalogService ProductCatalogService
@inject ICloudinaryService CloudinaryService
@inject IReviewService ReviewService

<a href="/product/@ProductModel?.Slug" 
   class="group relative flex h-full flex-col overflow-hidden rounded-xl bg-white border border-gray-100 transition-all duration-300 hover:border-blue-500 hover:shadow-xl hover:-translate-y-1 hover:z-10">
    <!-- Image Container -->
    <div class="relative aspect-square overflow-hidden bg-white p-6">
        <img src="@ImageUrl" 
             alt="@ProductModel?.Name" 
             class="h-full w-full object-cover object-center transition duration-500 group-hover:scale-110" 
             loading="lazy"
             @onerror="HandleImageError" />
        
        <!-- Badges -->
        <div class="absolute left-3 top-3 flex flex-col gap-2">
            @if (IsNew)
            {
                <span class="inline-flex items-center rounded-lg bg-blue-600 px-2.5 py-1 text-xs font-bold text-white shadow-md backdrop-blur-sm">
                    Mới
                </span>
            }
            @if (SelectedProduct?.PricingMode == PricingMode.CLEARANCE)
            {
                <span class="inline-flex items-center rounded-lg bg-red-600 px-2.5 py-1 text-xs font-bold text-white shadow-md backdrop-blur-sm">
                    Xả kho
                </span>
            }
            else if (SelectedProduct?.PricingMode == PricingMode.AUTO_PROTECT && IsPriceRecentlyUpdated(SelectedProduct.PriceUpdatedAt))
            {
                 <span class="inline-flex items-center rounded-lg bg-green-600 px-2.5 py-1 text-xs font-bold text-white shadow-md backdrop-blur-sm">
                    Giá tốt
                </span>
            }
        </div>
    </div>

    <!-- Content -->
    <div class="flex flex-col p-4">
        <!-- Brand -->
        @if (!string.IsNullOrEmpty(SelectedProduct?.BrandName))
        {
            <p class="mb-1 text-xs font-medium uppercase tracking-wide text-gray-500">
                @SelectedProduct.BrandName
            </p>
        }

        <!-- Title -->
        <h3 class="mb-2 line-clamp-2 min-h-[2.5rem] text-sm font-bold text-gray-900 transition-colors group-hover:text-blue-600">
            @ProductModel?.Name
        </h3>

        <!-- Reviews -->
        <div class="mb-3 flex items-center gap-1.5">
            <div class="flex text-yellow-400 text-xs">
                 @for (int i = 1; i <= 5; i++)
                 {
                     if (i <= Math.Round(AverageRating))
                     {
                         <i class="fa-solid fa-star"></i>
                     }
                     else
                     {
                         <i class="fa-regular fa-star text-gray-300"></i>
                     }
                 }
            </div>
            <span class="text-xs text-gray-500">(@TotalReviews)</span>
        </div>

        <!-- Price -->
        <div class="mt-auto">
            @if (SelectedProduct != null)
            {
                <div class="flex flex-wrap items-baseline gap-2">
                    <p class="text-lg font-bold text-[#2563EB]">
                        @(SelectedProduct.Price > 0
                            ? $"{SelectedProduct.Price.ToString("N0", new CultureInfo("vi-VN"))} ₫"
                            : "Liên hệ")
                    </p>
                </div>
            }
            else
            {
                <p class="text-lg font-bold text-gray-400">Đang cập nhật</p>
            }
        </div>
        
        <!-- Action Button -->
        <div class="mt-4 rounded-xl bg-gray-50 py-2.5 text-center text-sm font-semibold text-gray-900 transition-all duration-300 group-hover:bg-[#2563EB] group-hover:text-white group-hover:shadow-md">
            Xem chi tiết
        </div>
    </div>
</a>

@code {
    [Parameter]
    public ProductModel? ProductModel { get; set; }

    private const string DefaultFallbackImageUrl = "/images/hero/iphone-17-pm-2.png";
    private Product? SelectedProduct { get; set; }
    private string ImageUrl { get; set; } = DefaultFallbackImageUrl;
    private double AverageRating { get; set; }
    private int TotalReviews { get; set; }
    private bool IsNew { get; set; }

    private static bool IsPriceRecentlyUpdated(DateTime? priceUpdatedAt)
    {
        if (priceUpdatedAt == null) return false;
        return (DateTime.UtcNow - priceUpdatedAt.Value).TotalHours <= 24;
    }

    protected override async Task OnParametersSetAsync()
    {
        ImageUrl = GetFallbackImageUrl(ProductModel);

        if (ProductModel == null)
        {
            SelectedProduct = null;
            return;
        }

        var productsTask = ProductCatalogService.GetProductsByModelAsync(ProductModel.Id);
        var reviewsTask = ReviewService.GetReviewSummaryAsync(ProductModel.Id);

        await Task.WhenAll(productsTask, reviewsTask);

        var products = await productsTask;
        var reviewSummary = await reviewsTask;

        SelectedProduct = products.FirstOrDefault();
        AverageRating = reviewSummary.AverageRating;
        TotalReviews = reviewSummary.TotalReviews;
        
        // Define "New" as created within the last 14 days
        IsNew = ProductModel.CreatedAt.HasValue && (DateTime.UtcNow - ProductModel.CreatedAt.Value).TotalDays <= 14;

        var variantImageUrl = await BuildVariantImageUrlAsync(SelectedProduct, ProductModel);
        if (!string.IsNullOrEmpty(variantImageUrl))
        {
            ImageUrl = variantImageUrl;
        }
    }

    private static string GetFallbackImageUrl(ProductModel? model)
        => !string.IsNullOrEmpty(model?.Image) ? model.Image! : DefaultFallbackImageUrl;

    private Task<string?> BuildVariantImageUrlAsync(Product? product, ProductModel? model)
    {
        if (product == null || model == null)
        {
            return Task.FromResult<string?>(null);
        }

        var brand = product.BrandName?.Trim();
        var slug = model.Slug?.Trim();
        var sku = product.Sku?.Trim();

        if (string.IsNullOrEmpty(brand) || string.IsNullOrEmpty(slug) || string.IsNullOrEmpty(sku))
        {
            return Task.FromResult<string?>(null);
        }

        var cacheKey = (product.UpdatedAt ?? product.CreatedAt)?.Ticks.ToString();
        return CloudinaryService.GetImageUrlAsync(brand, slug, sku, cacheKey);
    }

    private void HandleImageError()
    {
        Console.WriteLine("Image failed to load, using fallback image.");
        ImageUrl = GetFallbackImageUrl(ProductModel);
    }
}