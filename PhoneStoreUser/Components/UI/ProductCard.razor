@using PhoneStoreUser.Components.Models

<a href="/product/@ProductModel?.Slug" class="group rounded-2xl border border-gray-200 bg-white overflow-hidden shadow-sm transition hover:-translate-y-1 hover:shadow-lg block">
    <div class="relative overflow-hidden bg-gray-50 aspect-square">
        <img src="@ImageUrl" 
             alt="@ProductModel?.Name" 
             class="w-full h-full object-cover transition duration-200 group-hover:scale-105" 
             loading="lazy" />
    </div>
    <div class="p-4 space-y-2">
        <p class="text-xs uppercase tracking-wide text-gray-500">@BrandName</p>
        <h3 class="text-sm font-semibold text-gray-900 line-clamp-2">@ProductModel?.Name</h3>
        <p class="text-xs text-gray-500">@ProductModel?.Description</p>
        <button type="button" class="mt-3 w-full rounded-xl bg-[#2563EB] py-2 text-sm font-semibold text-white transition hover:bg-blue-700">
            Xem chi tiết
        </button>
    </div>
</a>

@code {
    [Parameter]
    public ProductModel? ProductModel { get; set; }

    [Parameter]
    public string BrandName { get; set; } = string.Empty;

    private string ImageUrl { get; set; } = string.Empty;

    protected override void OnParametersSet()
    {
        if (ProductModel != null && !string.IsNullOrEmpty(BrandName))
        {
            ImageUrl = $"https://res.cloudinary.com/REMOVED_SECRET/image/upload/v1763457477/phone_products/{BrandName.ToLower()}/{ProductModel.Slug}/{ProductModel.Image}";
        }
    }
}

