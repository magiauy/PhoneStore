<div class="relative overflow-hidden rounded-4xl bg-linear-to-r from-[#0F0F0F] via-[#111827] to-[#2563EB] text-white">
    <div class="relative grid gap-6 p-6 md:grid-cols-[1.2fr_0.8fr] md:items-center min-h-[360px]">
        
        <!-- TEXT BLOCK -->
        <div class="space-y-3">
            <p class="text-xs uppercase tracking-[0.3em] text-white/60">@Subheading</p>
            <h1 class="text-3xl font-bold leading-tight md:text-4xl">@Heading</h1>
            <p class="text-sm text-white/80">@Description</p>

            <div class="flex flex-wrap gap-3 pt-2 text-sm font-semibold">
                <a href="@PrimaryHref" class="inline-flex items-center gap-2 rounded-full bg-white px-5 py-2 text-[#0F0F0F] transition hover:bg-gray-100">
                    @PrimaryCta
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m9 5l7 7l-7 7" />
                    </svg>
                </a>
                <a href="@SecondaryHref" class="inline-flex items-center gap-2 rounded-full border border-white/40 px-5 py-2 text-white transition hover:bg-white/10">
                    @SecondaryCta
                </a>
            </div>
        </div>

        <!-- HERO IMAGE BLOCK - Absolute Positioning -->
        <div class="absolute right-0 top-0 bottom-0 w-1/3 overflow-hidden md:w-2/5">
            <!-- Glow lớn hơn -->
            <div class="absolute -right-16 top-1/2 h-80 w-80 -translate-y-1/2 rounded-full bg-white/15 blur-3xl md:h-96 md:w-96"></div>

            <!-- Ảnh flagship - 90% chiều cao banner, sát phải, dịch trái 10-20px -->
            <img src="@HeroImage"
                 alt="Hero device"
                 class="absolute right-0 top-1/2 -translate-y-1/2 -translate-x-3 md:-translate-x-5
                        h-[120%]
                        object-contain
                        select-none pointer-events-none" />
        </div>
    </div>
</div>


@code {
    [Parameter, EditorRequired] public string Heading { get; set; } = string.Empty;
    [Parameter] public string Subheading { get; set; } = "Flagship Premium";
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public string PrimaryCta { get; set; } = "Khám phá";
    [Parameter] public string PrimaryHref { get; set; } = "#";
    [Parameter] public string SecondaryCta { get; set; } = "Ưu đãi thu cũ";
    [Parameter] public string SecondaryHref { get; set; } = "#";
    [Parameter] public string HeroImage { get; set; } = "https://via.placeholder.com/480x480?text=Flagship";
}
