@using PhoneStoreUser.Services
@using PhoneStoreUser.Components.Models
@inject IProductCatalogService ProductCatalogService
@inject IDisplaySettingsService DisplaySettingsService
@inject NavigationManager NavigationManager

@if (Brands?.Any() == true)
{
    <section class="rounded-3xl border border-gray-200 bg-white p-4 shadow-sm">
        <div class="flex items-center justify-between pb-3">
            <div>
                <p class="text-xs uppercase tracking-wide text-gray-500">Thương hiệu tin chọn</p>
                <h2 class="text-lg font-semibold text-gray-900">Săn flagship chính hãng</h2>
            </div>
            <span class="text-xs font-medium text-[#2563EB]">Tổng @Brands.Count() hãng</span>
        </div>
        <div class="flex gap-3 overflow-x-auto pb-1 pt-1">
            @foreach (var brand in Brands)
            {
                <button @onclick="() => NavigateToBrand(brand.Id)" class="flex min-w-[140px] flex-1 items-center gap-3 rounded-2xl border border-gray-200 bg-gray-50/60 px-3 py-2 text-left cursor-pointer transition hover:-translate-y-0.5 hover:border-[#2563EB] hover:bg-white group">
                    @if (!string.IsNullOrEmpty(brand.LogoUrl))
                    {
                        <img src="@brand.LogoUrl" alt="@brand.Name logo" class="h-10 w-10 rounded-full border border-gray-200 bg-white object-contain p-1" />
                    }
                    else
                    {
                        <span class="flex h-10 w-10 items-center justify-center rounded-full border border-gray-200 bg-white text-sm font-semibold text-[#2563EB]">@brand.Initial</span>
                    }
                    <span>
                        <p class="text-sm font-semibold text-gray-900">@brand.Name</p>
                        <p class="text-xs text-gray-500">@brand.Tagline</p>
                    </span>
                </button>
            }
        </div>
    </section>
}

@code {
    private List<BrandBadgeModel> Brands { get; set; } = new();

    // Metadata mapping for UI presentation
    private readonly Dictionary<string, (string Tagline, string Initial, string? LogoUrl)> BrandMetadata = new(StringComparer.OrdinalIgnoreCase)
    {
        { "Apple", ("iPhone, iPad", "A", "/images/brand-logo/apple.png") },
        { "Samsung", ("Galaxy AI", "S", "/images/brand-logo/samsung.png") },
        { "Xiaomi", ("HyperOS", "Mi", "/images/brand-logo/xiaomi.png") },
        { "Oppo", ("Tốc độ 240W", "O", "/images/brand-logo/oppo.png") },
        { "Tecno", ("Camera ZEISS", "T", "/images/brand-logo/tecno.png") },
        { "Sony", ("Camera Pro", "S", null) },
        { "Nokia", ("Connecting People", "N", null) }
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadBrands();
    }

    private async Task LoadBrands()
    {
        try
        {
            // Lấy brands từ DisplaySettingsService
            var homeBrands = await DisplaySettingsService.GetHomeBrandsAsync();

            if (homeBrands.Any())
            {
                // Map to ViewModel với metadata
                Brands = homeBrands.Select(b =>
                {
                    var meta = BrandMetadata.TryGetValue(b.Name, out var m) ? m : ("Chính hãng", b.Name.Length > 0 ? b.Name[0].ToString().ToUpper() : "?", null);
                    return new BrandBadgeModel(b.Id, b.Name, meta.Tagline, meta.Initial, meta.LogoUrl);
                }).ToList();
            }
            else
            {
                // Fallback: lấy tất cả brands nếu chưa có cài đặt
                var allBrands = await ProductCatalogService.GetBrandsAsync();
                Brands = allBrands.Take(6).Select(b =>
                {
                    var meta = BrandMetadata.TryGetValue(b.Name, out var m) ? m : ("Chính hãng", b.Name.Length > 0 ? b.Name[0].ToString().ToUpper() : "?", null);
                    return new BrandBadgeModel(b.Id, b.Name, meta.Tagline, meta.Initial, meta.LogoUrl);
                }).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading brands in BrandList: {ex.Message}");
        }
    }

    private void NavigateToBrand(int brandId)
    {
        NavigationManager.NavigateTo($"/products?branch={brandId}");
    }
}
