@using PhoneStoreUser.Components.ViewModels
@using PhoneStoreUser.Services
@implements IDisposable
@inject ICartService CartService
@inject IUserSessionService SessionService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager


<header class="sticky top-0 z-40 border-b border-gray-200 bg-white/95 backdrop-blur shadow-sm">
    <div class="max-w-6xl mx-auto px-4">
        <div class="flex flex-wrap items-center gap-3 py-3">
            <div class="flex items-center gap-3">
                <button class="md:hidden rounded-full border border-gray-200 p-2 text-gray-600 hover:border-[#2563EB] hover:text-[#2563EB] transition">
                    <span class="sr-only">Mở menu</span>
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
                    </svg>
                </button>
                <a class="text-lg font-bold tracking-tight text-gray-900" href="/">
                    Gu<span class="text-[#2563EB]">Zone</span>
                </a>
            </div>

            <div class="w-full flex-1 md:w-auto">
                <label class="sr-only" for="site-search">Tìm kiếm sản phẩm</label>
                <div class="flex items-center gap-2 rounded-full border border-gray-200 bg-gray-50/80 px-4 py-2 shadow-inner">
                    <svg class="h-4 w-4 text-gray-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 4.5a6 6 0 1 1 0 12a6 6 0 0 1 0-12zm7 12l3.5 3.5" />
                    </svg>
                    <input id="site-search" type="search" placeholder="Tìm kiếm iPhone 15 Pro Max..." class="w-full bg-transparent text-sm text-gray-800 placeholder:text-gray-400 focus:outline-none" />
                </div>
            </div>

            <div class="flex items-center gap-2 text-sm font-medium text-gray-700">
                @if (ActiveSession is not null)
                {
                    <div class="relative">
                        <button @onclick="ToggleUserMenu" class="hidden md:inline-flex items-center gap-2 rounded-full border border-gray-200 px-3 py-2 text-gray-700 hover:bg-gray-50 transition">
                            <div class="flex h-8 w-8 items-center justify-center rounded-full bg-[#2563EB]/10 text-[#2563EB] font-semibold">
                                @(ActiveSession.DisplayName?.Length > 0 ? ActiveSession.DisplayName[0].ToString()?.ToUpperInvariant() : "G")
                            </div>
                            <div class="flex flex-col text-left leading-tight">
                                <span class="text-sm font-semibold text-gray-900">@ActiveSession.DisplayName</span>
                            </div>
                            <svg class="h-4 w-4 text-gray-400 transition-transform @(IsUserMenuOpen ? "rotate-180" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                            </svg>
                        </button>

                        @if (IsUserMenuOpen)
                        {
                            <div class="absolute right-0 mt-2 w-56 origin-top-right rounded-xl border border-gray-100 bg-white shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none z-50">
                                <div class="p-2">
                                    <button @onclick="OpenProfileDialog" class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 transition">
                                        <svg class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                                        </svg>
                                        Thông tin cá nhân
                                    </button>
                                    <div class="my-1 h-px bg-gray-100"></div>
                                    <button @onclick="Logout" class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-sm text-red-600 hover:bg-red-50 transition">
                                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" />
                                        </svg>
                                        Đăng xuất
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <a href="/login" class="hidden md:inline-flex items-center gap-1 rounded-full border border-gray-200 px-3 py-2 hover:border-[#2563EB] hover:text-[#2563EB] transition">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0a3.75 3.75 0 0 1 7.5 0ZM4.5 20.25a7.5 7.5 0 0 1 15 0V21H4.5z" />
                        </svg>
                        Đăng nhập
                    </a>
                }
                <a href="/cart" class="relative inline-flex items-center gap-2 rounded-full border border-gray-200 px-3 py-2 hover:border-[#2563EB] hover:text-[#2563EB] transition">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M7.5 18C8.32843 18 9 18.6716 9 19.5C9 20.3284 8.32843 21 7.5 21C6.67157 21 6 20.3284 6 19.5C6 18.6716 6.67157 18 7.5 18Z" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M16.5 18.0001C17.3284 18.0001 18 18.6716 18 19.5001C18 20.3285 17.3284 21.0001 16.5 21.0001C15.6716 21.0001 15 20.3285 15 19.5001C15 18.6716 15.6716 18.0001 16.5 18.0001Z" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M2 3L2.26121 3.09184C3.5628 3.54945 4.2136 3.77826 4.58584 4.32298C4.95808 4.86771 4.95808 5.59126 4.95808 7.03836V9.76C4.95808 12.7016 5.02132 13.6723 5.88772 14.5862C6.75412 15.5 8.14857 15.5 10.9375 15.5H12M16.2404 15.5C17.8014 15.5 18.5819 15.5 19.1336 15.0504C19.6853 14.6008 19.8429 13.8364 20.158 12.3075L20.6578 9.88275C21.0049 8.14369 21.1784 7.27417 20.7345 6.69708C20.2906 6.12 18.7738 6.12 17.0888 6.12H11.0235M4.95808 6.12H7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                    <span>Giỏ hàng</span>
                    @if (CartItemCount > 0)
                    {
                        <span class="absolute -top-1 -right-1 rounded-full bg-[#2563EB] px-2 text-[10px] font-semibold text-white">@CartItemCount</span>
                    }
                </a>
            </div>
        </div>

        <nav class="hidden md:flex items-center gap-3 border-t border-gray-100 py-2 text-xs font-semibold uppercase tracking-wide text-gray-600">
            @foreach (var item in NavigationItems)
            {
                <a class="rounded-full border border-transparent px-3 py-1 text-gray-600 hover:border-[#2563EB]/30 hover:bg-[#2563EB]/5 hover:text-[#2563EB] transition" href="@item.Href">@item.Label</a>
            }
        </nav>
    </div>
</header>

@if (IsProfileDialogOpen && ActiveSession is not null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4" @onclick="CloseProfileDialog">
        <div class="w-full max-w-md transform overflow-hidden rounded-2xl bg-white p-6 text-left align-middle shadow-xl transition-all" @onclick:stopPropagation>
            <div class="flex items-center justify-between mb-5">
                <h3 class="text-lg font-bold leading-6 text-gray-900">Thông tin cá nhân</h3>
                <button @onclick="CloseProfileDialog" class="rounded-full p-1 text-gray-400 hover:bg-gray-100 hover:text-gray-500 transition">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="flex flex-col items-center mb-6">
                <div class="flex h-20 w-20 items-center justify-center rounded-full bg-[#2563EB]/10 text-[#2563EB] text-3xl font-bold mb-3">
                    @(ActiveSession.DisplayName?.Length > 0 ? ActiveSession.DisplayName[0].ToString()?.ToUpperInvariant() : "G")
                </div>
                <h4 class="text-xl font-semibold text-gray-900">@ActiveSession.DisplayName</h4>
                <p class="text-sm text-gray-500">@ActiveSession.Username</p>
            </div>

            <div class="space-y-4">
                <div class="flex items-center gap-3 rounded-xl bg-gray-50 p-3">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white text-gray-500 shadow-sm">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                        </svg>
                    </div>
                    <div class="flex-1 overflow-hidden">
                        <p class="text-xs font-medium text-gray-500">Email</p>
                        <p class="truncate text-sm font-semibold text-gray-900">@(ActiveSession.Email ?? "Chưa cập nhật")</p>
                    </div>
                </div>

                <div class="flex items-center gap-3 rounded-xl bg-gray-50 p-3">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white text-gray-500 shadow-sm">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
                        </svg>
                    </div>
                    <div class="flex-1 overflow-hidden">
                        <p class="text-xs font-medium text-gray-500">Số điện thoại</p>
                        <p class="truncate text-sm font-semibold text-gray-900">@(ActiveSession.Phone ?? "Chưa cập nhật")</p>
                    </div>
                </div>
            </div>

            <div class="mt-6 flex justify-end">
                <button @onclick="CloseProfileDialog" class="rounded-xl bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-gray-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900 transition">
                    Đóng
                </button>
            </div>
        </div>
    </div>
}

@code {
    private int CartItemCount = 0;
    private UserSession? ActiveSession;
    private bool IsUserMenuOpen = false;
    private bool IsProfileDialogOpen = false;

    private readonly List<NavigationItem> NavigationItems = new()
    {
        new("Flagship", "#flagship"),
        new("Apple", "#apple"),
        new("Samsung", "#samsung"),
        new("Android cao cấp", "#android"),
        new("Tablet", "#tablet"),
        new("Phụ kiện", "#accessories")
    };

    private record NavigationItem(string Label, string Href);

    protected override async Task OnInitializedAsync()
    {
        CartService.OnChange += StateHasChanged;
        SessionService.OnChange += HandleSessionChanged;
        await UpdateCartCount();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CartService.OnChange += async () => await UpdateCartCount();
            await UpdateCartCount();
        }

        await SessionService.InitializeAsync();
        if (ActiveSession != SessionService.CurrentSession)
        {
            ActiveSession = SessionService.CurrentSession;
            StateHasChanged();
        }
    }

    private async Task UpdateCartCount()
    {
        var items = await CartService.GetCartItems();
        CartItemCount = items.Sum(i => i.Quantity);
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CartService.OnChange -= StateHasChanged;
        SessionService.OnChange -= HandleSessionChanged;
    }

    private void HandleSessionChanged()
    {
        ActiveSession = SessionService.CurrentSession;
        _ = InvokeAsync(StateHasChanged);
    }

    private void ToggleUserMenu()
    {
        IsUserMenuOpen = !IsUserMenuOpen;
    }

    private void OpenProfileDialog()
    {
        IsUserMenuOpen = false;
        IsProfileDialogOpen = true;
        JS.InvokeVoidAsync("document.body.classList.add", "overflow-hidden");
    }

    private void CloseProfileDialog()
    {
        IsProfileDialogOpen = false;
        JS.InvokeVoidAsync("document.body.classList.remove", "overflow-hidden");
    }

    private async Task Logout()
    {
        await SessionService.LogoutAsync();
        IsUserMenuOpen = false;
        NavigationManager.NavigateTo("/", true);
    }
}

