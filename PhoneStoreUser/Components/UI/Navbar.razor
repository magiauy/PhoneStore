@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using PhoneStoreUser.Components.Models
@using PhoneStoreUser.Services
@implements IDisposable
@inject ICartService CartService
@inject CookieAuthStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject IUserProfileService UserProfileService
@inject IAuthService AuthService
@inject IProductCatalogService ProductCatalogService
@using Microsoft.AspNetCore.Components.Web

<header class="sticky top-0 z-40 border-b border-gray-200 bg-white/95 backdrop-blur shadow-sm">
    <div class="max-w-6xl mx-auto px-4">
        <div class="flex flex-wrap items-center gap-3 py-3">
            <div class="flex items-center gap-3">
                <button class="md:hidden rounded-full border border-gray-200 p-2 text-gray-600 hover:border-[#2563EB] hover:text-[#2563EB] transition">
                    <span class="sr-only">Mở menu</span>
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
                    </svg>
                </button>
                <a class="text-lg font-bold tracking-tight text-gray-900" href="/">
                    Gu<span class="text-[#2563EB]">Zone</span>
                </a>
            </div>

            <div class="w-full flex-1 md:w-auto">
                <label class="sr-only" for="site-search">Tìm kiếm sản phẩm</label>
                <div class="flex items-center gap-2 rounded-full border border-gray-200 bg-gray-50/80 px-4 py-2 shadow-inner">
                    <svg class="h-4 w-4 text-gray-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 4.5a6 6 0 1 1 0 12a6 6 0 0 1 0-12zm7 12l3.5 3.5" />
                    </svg>
                    <input id="site-search" type="search" placeholder="Tìm kiếm iPhone 15 Pro Max..." class="w-full bg-transparent text-sm text-gray-800 placeholder:text-gray-400 focus:outline-none" @bind="SearchValue" @bind:event="oninput" @onkeydown="HandleSearchKeyDown" />
                </div>
            </div>

            <div class="flex items-center gap-2 text-sm font-medium text-gray-700">
                <AuthorizeView>
                    <Authorized>
                        @if (ActiveSession is not null)
                        {
                            <div class="relative">
                                <button @onclick="ToggleUserMenu" class="hidden md:inline-flex items-center gap-2 rounded-full border border-gray-200 px-3 py-[2px] text-gray-700 hover:bg-gray-50 transition">
                                    <div class="flex h-8 w-8 items-center justify-center rounded-full bg-[#2563EB]/10 text-[#2563EB] font-semibold">
                                        @(ActiveSession.DisplayName?.Length > 0 ? ActiveSession.DisplayName[0].ToString()?.ToUpperInvariant() : "G")
                                    </div>
                                    <div class="flex flex-col text-left leading-tight">
                                        <span class="text-sm font-semibold text-gray-900">@ActiveSession.DisplayName</span>
                                    </div>
                                    <svg class="h-4 w-4 text-gray-400 transition-transform @(IsUserMenuOpen ? "rotate-180" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                                    </svg>
                                </button>

                                @if (IsUserMenuOpen)
                                {
                                    <div class="absolute right-0 mt-2 w-56 origin-top-right rounded-xl border border-gray-100 bg-white shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none z-50">
                                        <div class="p-2">
                                            <button @onclick="OpenProfileDialog" class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 transition">
                                                <svg class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                                                </svg>
                                                Thông tin cá nhân
                                            </button>
                                            <button @onclick="OpenChangePasswordDialog" class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 transition">
                                                <svg class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
                                                </svg>
                                                Đổi mật khẩu
                                            </button>
                                            <a href="/history" class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 transition">
                                            <svg fill="#000000" class="h-4 w-4 text-gray-500" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M12,2A10,10,0,0,0,5.12,4.77V3a1,1,0,0,0-2,0V7.5a1,1,0,0,0,1,1H8.62a1,1,0,0,0,0-2H6.22A8,8,0,1,1,4,12a1,1,0,0,0-2,0A10,10,0,1,0,12,2Zm0,6a1,1,0,0,0-1,1v3a1,1,0,0,0,1,1h2a1,1,0,0,0,0-2H13V9A1,1,0,0,0,12,8Z"/>
                                            </svg>
                                                Lịch sử mua hàng
                                            </a>
                                            <div class="my-1 h-px bg-gray-100"></div>
                                            <button @onclick="Logout" class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-sm text-red-600 hover:bg-red-50 transition">
                                                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" />
                                                </svg>
                                                Đăng xuất
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="hidden md:inline-flex items-center gap-2 rounded-full border border-gray-200 px-3 py-2 text-gray-500">
                                <span class="h-4 w-4 animate-spin rounded-full border-2 border-gray-300 border-t-[#2563EB]"></span>
                                Đang tải...
                            </div>
                        }
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="hidden md:inline-flex items-center gap-1 rounded-full border border-gray-200 px-3 py-2 hover:border-[#2563EB] hover:text-[#2563EB] transition">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0a3.75 3.75 0 0 1 7.5 0ZM4.5 20.25a7.5 7.5 0 0 1 15 0V21H4.5z" />
                            </svg>
                            Đăng nhập
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
                <a href="/cart" class="relative inline-flex items-center gap-2 rounded-full border border-gray-200 px-3 py-2 hover:border-[#2563EB] hover:text-[#2563EB] transition">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M7.5 18C8.32843 18 9 18.6716 9 19.5C9 20.3284 8.32843 21 7.5 21C6.67157 21 6 20.3284 6 19.5C6 18.6716 6.67157 18 7.5 18Z" stroke="currentColor" stroke-width="1.5" />
                        <path d="M16.5 18.0001C17.3284 18.0001 18 18.6716 18 19.5001C18 20.3285 17.3284 21.0001 16.5 21.0001C15.6716 21.0001 15 20.3285 15 19.5001C15 18.6716 15.6716 18.0001 16.5 18.0001Z" stroke="currentColor" stroke-width="1.5" />
                        <path d="M2 3L2.26121 3.09184C3.5628 3.54945 4.2136 3.77826 4.58584 4.32298C4.95808 4.86771 4.95808 5.59126 4.95808 7.03836V9.76C4.95808 12.7016 5.02132 13.6723 5.88772 14.5862C6.75412 15.5 8.14857 15.5 10.9375 15.5H12M16.2404 15.5C17.8014 15.5 18.5819 15.5 19.1336 15.0504C19.6853 14.6008 19.8429 13.8364 20.158 12.3075L20.6578 9.88275C21.0049 8.14369 21.1784 7.27417 20.7345 6.69708C20.2906 6.12 18.7738 6.12 17.0888 6.12H11.0235M4.95808 6.12H7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                    <span>Giỏ hàng</span>
                    @if (CartItemCount > 0)
                    {
                        <span class="absolute -top-1 -right-1 rounded-full bg-[#2563EB] px-2 text-[10px] font-semibold text-white">@CartItemCount</span>
                    }
                </a>
            </div>
        </div>

        <nav class="hidden md:flex items-center gap-3 border-t border-gray-100 py-2 text-xs font-semibold uppercase tracking-wide text-gray-600">
            <!-- Categories -->
            @foreach (var item in TopCategories)
            {
                <a class="rounded-full border border-transparent px-3 py-1 text-gray-600 hover:border-[#2563EB]/30 hover:bg-[#2563EB]/5 hover:text-[#2563EB] transition" href="@item.Href">@item.Label</a>
            }
        </nav>
    </div>
</header>

@if (IsProfileDialogOpen && ActiveSession is not null)
{
    <ProfileDialog
        UserProfile="@UserProfile"
        ActiveSession="@ActiveSession"
        IsSaving="@IsSaving"
        IsSuccess="@IsUpdateProfileSuccess"
        OnClose="@CloseProfileDialog"
        OnSave="@HandleUpdateProfile" />
}

@if (IsChangePasswordDialogOpen)
{
    <ChangePasswordDialog
        IsSaving="@IsSavingPassword"
        IsSuccess="@IsChangePasswordSuccess"
        OnClose="@CloseChangePasswordDialog"
        OnSave="@HandleChangePassword" />
}
@code {
    private int CartItemCount = 0;
    private UserSession? ActiveSession;
    private bool IsUserMenuOpen = false;
    private bool IsProfileDialogOpen = false;
    private ProfileModel? UserProfile;
    private bool IsSaving = false;
    private bool IsUpdateProfileSuccess = false;
    private bool IsChangePasswordDialogOpen = false;
    private bool IsSavingPassword = false;
    private bool IsChangePasswordSuccess = false;
    private string SearchValue { get; set; } = string.Empty;

    private List<NavigationItem> TopCategories = new();

    // Priority lists
    private readonly string[] PriorityCategoryNames = { "Điện thoại", "PhoneFlagShip", "Phụ kiện", "Laptop", "Đồng hồ", "Âm thanh" };

    private record NavigationItem(string Label, string Href);

    protected override async Task OnInitializedAsync()
    {
        CartService.OnChange += HandleCartChanged;
        AuthStateProvider.AuthenticationStateChanged += HandleAuthenticationChangedAsync;

        await UpdateCartCount();
        await LoadActiveUserAsync();
        await LoadNavigationItems();
    }

    private async Task LoadNavigationItems()
    {
        try
        {
            var categories = await ProductCatalogService.GetCategoriesAsync();
            var brands = await ProductCatalogService.GetBrandsAsync();

            TopCategories = GetPrioritizedItems(
                categories.Select(c => new { c.Name, c.Id }),
                PriorityCategoryNames,
                item => new NavigationItem(item.Name, $"/products?catalog={item.Id}")
        );
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading navigation items: {ex.Message}");
        }
    }

    private List<NavigationItem> GetPrioritizedItems<T>(
        IEnumerable<T> sourceItems, 
        string[] priorityNames, 
        Func<T, NavigationItem> mapToNavItem)
    {
        var result = new List<NavigationItem>();
        var itemsList = sourceItems.ToList();
        var itemsByName = itemsList.ToDictionary(
            i => (i.GetType().GetProperty("Name")?.GetValue(i) as string)?.ToLowerInvariant() ?? "", 
            i => i
        );

        // 1. Add priority items if they exist
        foreach (var name in priorityNames)
        {
            if (itemsByName.TryGetValue(name.ToLowerInvariant(), out var item))
            {
                result.Add(mapToNavItem(item));
                itemsList.Remove(item); // Remove to avoid duplicates
            }
        }

        // 2. Fill remaining slots up to 6
        foreach (var item in itemsList)
        {
            if (result.Count >= 6) break;
            result.Add(mapToNavItem(item));
        }

        return result;
    }

    private void HandleCartChanged()
    {
        _ = UpdateCartCount();
    }
    // Rename to match expected delegate signature: void (Task<AuthenticationState>)
    private async void HandleAuthenticationChangedAsync(Task<AuthenticationState> task)
    {
        var state = await task;
        await UpdateSessionAsync(state.User);
    }

    private async Task LoadActiveUserAsync()
    {
        if (AuthStateProvider is null)
        {
            return;
        }

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        Console.WriteLine("Loaded authentication state." + (state.User.Identity?.IsAuthenticated == true ? "User is authenticated." : "User is not authenticated."));
        await UpdateSessionAsync(state.User);
    }

    private async Task UpdateSessionAsync(ClaimsPrincipal user)
    {
        if (user.Identity?.IsAuthenticated == true
            && int.TryParse(user.FindFirst("person_id")?.Value, out var personId)
            && int.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var accountId))
        {
            var profile = await UserProfileService.GetProfileAsync(personId);
            ActiveSession = new UserSession
            {
                AccountId = accountId,
                PersonId = personId,
                Username = user.Identity?.Name ?? user.FindFirst(ClaimTypes.Name)?.Value ?? string.Empty,
                DisplayName = profile?.FullName ?? user.Identity?.Name ?? "Khách hàng",
                Email = profile?.Email ?? user.FindFirst(ClaimTypes.Email)?.Value,
                Phone = profile?.Phone
            };
        }
        else
        {
            ActiveSession = null;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdateCartCount()
    {
        var items = await CartService.GetCartItems();
        CartItemCount = items.Sum(i => i.Quantity);
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CartService.OnChange -= HandleCartChanged;
        if (AuthStateProvider is not null)
        {
            AuthStateProvider.AuthenticationStateChanged -= HandleAuthenticationChangedAsync;
        }
    }

    private void ToggleUserMenu()
    {
        IsUserMenuOpen = !IsUserMenuOpen;
    }

    private async Task OpenProfileDialog()
    {
        IsUserMenuOpen = false;
        IsProfileDialogOpen = true;
        await JS.InvokeVoidAsync("document.body.classList.add", "overflow-hidden");

        if (ActiveSession != null)
        {
            UserProfile = await UserProfileService.GetProfileAsync(ActiveSession.PersonId);
            if (UserProfile == null)
            {
                UserProfile = new ProfileModel
                {
                    PersonId = ActiveSession.PersonId,
                    FullName = ActiveSession.DisplayName,
                    Email = ActiveSession.Email,
                    Phone = ActiveSession.Phone
                };
            }
        }
    }

    private async Task HandleUpdateProfile()
    {
        if (UserProfile is null) return;

        IsSaving = true;
        StateHasChanged();
        try
        {
            await UserProfileService.UpdateProfileAsync(UserProfile);
            await Task.Delay(1000);

            IsSaving = false;
            IsUpdateProfileSuccess = true;
            StateHasChanged();
            await Task.Delay(1000);
            if (ActiveSession != null)
            {
                ActiveSession.DisplayName = UserProfile.FullName;
                ActiveSession.Email = UserProfile.Email;
                ActiveSession.Phone = UserProfile.Phone;
            }
            CloseProfileDialog();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Đã xảy ra lỗi khi cập nhật: " + ex.Message);
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void CloseProfileDialog()
    {
        IsUpdateProfileSuccess = false;
        IsProfileDialogOpen = false;
        JS.InvokeVoidAsync("document.body.classList.remove", "overflow-hidden");
    }

    private Task Logout()
    {
        AuthStateProvider.NotifyUserLogout();
        IsUserMenuOpen = false;
        NavigationManager.NavigateTo("/logout", true);
        return Task.CompletedTask;
    }

    private void OpenChangePasswordDialog()
    {
        IsUserMenuOpen = false;
        IsChangePasswordDialogOpen = true;
        IsChangePasswordSuccess = false;
        JS.InvokeVoidAsync("document.body.classList.add", "overflow-hidden");
    }

    private void CloseChangePasswordDialog()
    {
        IsChangePasswordDialogOpen = false;
        JS.InvokeVoidAsync("document.body.classList.remove", "overflow-hidden");
    }

    private async Task HandleChangePassword(ChangePasswordModel model)
    {
        IsSavingPassword = true;
        try
        {
            if (ActiveSession != null)
            {
                await AuthService.ChangePasswordAsync(ActiveSession.AccountId, model);
                await Task.Delay(1000);

                IsSavingPassword = false;
                IsChangePasswordSuccess = true;
                StateHasChanged();
                await Task.Delay(1000);
                CloseChangePasswordDialog();
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Lỗi: " + ex.Message);
        }
        finally
        {
            IsSavingPassword = false;
            IsChangePasswordSuccess = false;
        }
    }

    private void HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            var searchTerm = SearchValue?.Trim();
            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                NavigationManager.NavigateTo($"/products?search={Uri.EscapeDataString(searchTerm)}");
            }
        }
    }
}
