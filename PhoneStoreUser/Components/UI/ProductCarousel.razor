@if (ProductModels?.Any() == true)
{
    <div class="relative">
        <div class="flex gap-4 overflow-x-auto pb-2">
            @foreach (var model in ProductModels)
            {
                <div class="min-w-[240px] max-w-[280px] flex-1">
                    <ProductCard ProductModel="model" />
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public IEnumerable<ProductModel>? ProductModels { get; set; }
}
