@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);
        
        // Nếu đang ở trang admin, redirect về admin login
        if (currentPath.StartsWith("admin", StringComparison.OrdinalIgnoreCase))
        {
            // Trang /admin là trang login admin, không cần redirect
            if (currentPath.Equals("admin", StringComparison.OrdinalIgnoreCase) || 
                currentPath.Equals("admin/", StringComparison.OrdinalIgnoreCase))
            {
                return;
            }
            
            // Các trang admin khác, redirect về /admin (admin login)
            Navigation.NavigateTo("/admin", forceLoad: true);
            return;
        }
        
        // Các trang user, redirect về /login với ReturnUrl
        var loginUrl = $"/login?ReturnUrl={Uri.EscapeDataString("/" + currentPath)}";
        Navigation.NavigateTo(loginUrl, forceLoad: true);
    }
}
