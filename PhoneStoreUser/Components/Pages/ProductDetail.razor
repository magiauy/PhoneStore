@page "/product/{slug}/{sku?}"
@using PhoneStoreUser.Components.Models
@using Microsoft.Extensions.Logging
@using Microsoft.AspNetCore.WebUtilities
@rendermode InteractiveServer
@inject IProductCatalogService ProductCatalogService
@inject ICartService CartService
@inject NavigationManager NavigationManager
@inject ILogger<ProductDetail> Logger
@inject IReviewService ReviewService

<PageTitle>@ProductModel?.Name - GuZone</PageTitle>

<div class="container mx-auto px-4 py-8">
    @if (ShowToast)
    {
        <div class="fixed bottom-4 right-4 z-50 rounded-xl bg-green-600 px-6 py-3 text-white shadow-lg transition-opacity duration-300 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span class="font-medium">Đã thêm sản phẩm vào giỏ hàng!</span>
        </div>
    }
    @if (IsLoading)
    {
        <div class="rounded-2xl border border-gray-200 bg-white p-6 text-center text-sm text-gray-500">Đang tải chi tiết sản phẩm...</div>
    }
    else if (ProductModel != null)
    {
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
            <!-- Product Image -->
            <div class="bg-gray-50 rounded-2xl overflow-hidden aspect-square relative">
                @foreach (var product in Products)
                {
                    var isSelected = product.Id == SelectedProduct?.Id;
                    var imgUrl = GetProductImageUrl(product);
                    
                    <img src="@imgUrl"
                         alt="@product.Name" 
                         class="w-full h-full object-cover absolute inset-0 transition-opacity duration-300 ease-in-out @(isSelected ? "opacity-100 z-10" : "opacity-0 z-0")" 
                         loading="@(isSelected ? "eager" : "lazy")" />
                }
            </div>

            <!-- Product Info -->
            <div class="space-y-6">
                <div>
                    <p class="text-sm text-gray-500 uppercase">GuZone</p>
                    <h1 class="text-3xl font-bold text-gray-900 mt-2">@ProductModel.Name</h1>
                    
                    <div class="flex items-center gap-2 mt-2">
                        <div class="flex text-yellow-400 text-sm">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Math.Round(AverageRating))
                                {
                                    <i class="fa-solid fa-star"></i>
                                }
                                else
                                {
                                    <i class="fa-regular fa-star text-gray-300"></i>
                                }
                            }
                        </div>
                        <span class="text-sm text-gray-500">(@TotalReviews đánh giá)</span>
                    </div>

                    <p class="text-gray-600 mt-2">@ProductModel.Description</p>
                    
                    @if (SelectedProduct != null)
                    {
                        <p class="text-2xl font-bold text-[#2563EB] mt-4">
                            @(SelectedProduct.Price > 0 
                                ? $"{SelectedProduct.Price.ToString("N0", new System.Globalization.CultureInfo("vi-VN"))} ₫" 
                                : "Liên hệ")
                        </p>
                    }
                </div>

                <!-- Attributes Selection -->
                @foreach (var attr in Attributes)
                {
                    var choices = GetAttributeChoices(attr.Id);

                    <div class="space-y-2">
                        <label class="text-sm font-semibold text-gray-700">@attr.Name</label>
                        
                        @if (choices.Count > 0)
                        {
                            <div class="flex flex-wrap gap-2">
                                @foreach (var choice in choices)
                                {
                                    var capturedChoice = choice;
                                    <button
                                        type="button"
                                        class="@GetAttributeButtonClass(capturedChoice)"
                                        @onclick="@(() => SelectAttributeValue(capturedChoice))">
                                        @capturedChoice.DisplayValue
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-xs text-gray-500">Chưa có tuỳ chọn cho thuộc tính này.</p>
                        }
                    </div>
                }

                <!-- Selected Product Info -->
                @if (SelectedProduct != null)
                {
                    <div class="border-t pt-6 space-y-3">
                        <p class="text-sm text-gray-600">SKU: @SelectedProduct.Sku</p>
                        <p class="text-sm text-gray-600">Bảo hành: @SelectedProduct.WarrantyMonths tháng</p>
                    </div>
                }

                <!-- Action Buttons -->
                <div class="space-y-3">
                    <button class="w-full bg-[#2563EB] text-white py-3 rounded-xl font-semibold hover:bg-blue-700 transition" @onclick="AddToCart">
                        Thêm vào giỏ hàng
                    </button>
                </div>
            </div>
        </div>

<section class="mt-12 space-y-8">
    <div class="flex items-center justify-between">
        <h3 class="text-2xl font-bold text-gray-900">Đánh giá & Nhận xét</h3>
        
        @if (!ShowReviewForm)
        {
            <button @onclick="() => ShowReviewForm = true" 
                    class="px-6 py-2.5 bg-[#2563EB] text-white font-semibold rounded-xl hover:bg-blue-700 transition shadow-sm flex items-center gap-2">
                <i class="fa-solid fa-pen-to-square"></i>
                Viết đánh giá
            </button>
        }
    </div>

    @if (ShowReviewForm)
    {
        <div class="animate-fade-in-down"> <div class="flex justify-between items-center mb-2">
                <p class="text-gray-500 text-sm">Chia sẻ trải nghiệm của bạn về sản phẩm này</p>
                <button @onclick="() => ShowReviewForm = false" class="text-gray-400 hover:text-red-500 text-sm">
                    <i class="fa-solid fa-xmark mr-1"></i> Đóng lại
                </button>
            </div>
            
            @if (SelectedProduct != null)
            {
                <ReviewForm ProductId="SelectedProduct.Id" OnReviewSubmitted="HandleReviewSubmitted" />
            }
        </div>
    }

    <ReviewList @ref="reviewList" ProductModelId="ProductModel?.Id ?? 0" ProductId="SelectedProduct?.Id ?? 0" />
</section>

    }
</div>

@code {
    [Parameter] public string? Slug { get; set; }
    [Parameter] public string? Sku { get; set; }

    private ProductModel? ProductModel { get; set; }
    private List<Product> Products { get; set; } = new();
    private List<ProductAttribute> Attributes { get; set; } = new();
    private List<ProductAttributeValue> AttributeValues { get; set; } = new();
    private Dictionary<int, IReadOnlyList<ProductAttributeOption>> AttributeOptionLookup { get; set; } = new();
    private Dictionary<int, List<AttributeChoice>> AttributeChoices { get; set; } = new();
    private Dictionary<int, AttributeChoice> SelectedAttributes { get; set; } = new();
    private Product? SelectedProduct { get; set; }
    private string CurrentImageUrl { get; set; } = string.Empty;
    private bool IsLoading { get; set; } = true;
    private bool ShowToast { get; set; } = false;
    private PhoneStoreUser.Components.UI.ReviewList? reviewList;
    private double AverageRating { get; set; }
    private int TotalReviews { get; set; }
    private bool ShowReviewForm = false; // Mặc định là ẩn

    protected override async Task OnParametersSetAsync()
    {
        await LoadProductDetailAsync();
    }

    private async Task LoadProductDetailAsync()
    {
        IsLoading = true;
        ProductModel = null;
        Products.Clear();
        Attributes.Clear();
        AttributeValues.Clear();
        AttributeOptionLookup = new Dictionary<int, IReadOnlyList<ProductAttributeOption>>();
        AttributeChoices.Clear();
        SelectedAttributes.Clear();
        SelectedProduct = null;
        CurrentImageUrl = string.Empty;

        if (!string.IsNullOrWhiteSpace(Sku))
        {
            var product = await ProductCatalogService.GetProductBySkuAsync(Sku);
            if (product != null)
            {
                ProductModel = await ProductCatalogService.GetProductModelByIdAsync(product.ModelId);
                if (ProductModel != null)
                {
                    var summary = await ReviewService.GetReviewSummaryAsync(ProductModel.Id);
                    AverageRating = summary.AverageRating;
                    TotalReviews = summary.TotalReviews;

                    Products = (await ProductCatalogService.GetProductsByModelAsync(ProductModel.Id)).ToList();
                    var productIds = Products.Select(p => p.Id).ToList();
                    Attributes = (await ProductCatalogService.GetAttributesForModelAsync(ProductModel.Id)).ToList();
                    AttributeValues = productIds.Count > 0
                        ? (await ProductCatalogService.GetAttributeValuesForProductsAsync(productIds)).ToList()
                        : new List<ProductAttributeValue>();

                    var attributeIds = Attributes.Select(a => a.Id).Distinct().ToList();
                    AttributeOptionLookup = attributeIds.Count > 0
                        ? (await ProductCatalogService.GetAttributeOptionsForAttributesAsync(attributeIds)).ToDictionary(pair => pair.Key, pair => pair.Value)
                        : new Dictionary<int, IReadOnlyList<ProductAttributeOption>>();

                    BuildAttributeChoices();

                    // Set default selection to the product matching the SKU
                    SelectedProduct = Products.FirstOrDefault(p => p.Id == product.Id) ?? Products.FirstOrDefault();
                    if (SelectedProduct != null)
                    {
                        ApplySelectedProductAttributes(SelectedProduct, replaceExisting: true);
                    }

                    // Parse query parameters and update selection if matches found
                    ParseQueryParameters();
                    FindMatchingProduct();
                }
            }
        }
        else if (!string.IsNullOrWhiteSpace(Slug))
        {
            ProductModel = await ProductCatalogService.GetProductModelBySlugAsync(Slug);
            if (ProductModel != null)
            {
                var summary = await ReviewService.GetReviewSummaryAsync(ProductModel.Id);
                AverageRating = summary.AverageRating;
                TotalReviews = summary.TotalReviews;

                Products = (await ProductCatalogService.GetProductsByModelAsync(ProductModel.Id)).ToList();
                var productIds = Products.Select(p => p.Id).ToList();
                Attributes = (await ProductCatalogService.GetAttributesForModelAsync(ProductModel.Id)).ToList();
                AttributeValues = productIds.Count > 0
                    ? (await ProductCatalogService.GetAttributeValuesForProductsAsync(productIds)).ToList()
                    : new List<ProductAttributeValue>();

                var attributeIds = Attributes.Select(a => a.Id).Distinct().ToList();
                AttributeOptionLookup = attributeIds.Count > 0
                    ? (await ProductCatalogService.GetAttributeOptionsForAttributesAsync(attributeIds)).ToDictionary(pair => pair.Key, pair => pair.Value)
                    : new Dictionary<int, IReadOnlyList<ProductAttributeOption>>();

                BuildAttributeChoices();

                // Set default selection to the first product
                SelectedProduct = Products.FirstOrDefault();
                if (SelectedProduct != null)
                {
                    ApplySelectedProductAttributes(SelectedProduct, replaceExisting: true);
                }

                // Parse query parameters and update selection if matches found
                ParseQueryParameters();
                FindMatchingProduct();
            }
        }
        
        IsLoading = false;
    }

    private IReadOnlyList<AttributeChoice> GetAttributeChoices(int attributeId)
    {
        return AttributeChoices.TryGetValue(attributeId, out var choices) && choices.Count > 0
            ? choices
            : Array.Empty<AttributeChoice>();
    }

    private void SelectAttributeValue(AttributeChoice choice)
    {
        SelectedAttributes[choice.AttributeId] = choice;
        FindMatchingProduct();
    }

    private void FindMatchingProduct()
    {
        foreach (var product in Products)
        {
            var productAttrValues = AttributeValues.Where(av => av.ProductId == product.Id).ToList();
            bool matches = true;

            foreach (var selected in SelectedAttributes)
            {
                var attrValue = productAttrValues.FirstOrDefault(av => av.AttributeId == selected.Key);
                if (attrValue == null)
                {
                    matches = false;
                    break;
                }

                if (selected.Value.OptionId.HasValue)
                {
                    if (attrValue.OptionId != selected.Value.OptionId)
                    {
                        matches = false;
                        break;
                    }
                }
                else
                {
                    var normalized = attrValue.ValueText?.Trim();
                    var expected = selected.Value.RawValueText ?? selected.Value.DisplayValue;
                    if (!string.Equals(normalized, expected, StringComparison.OrdinalIgnoreCase))
                    {
                        matches = false;
                        break;
                    }
                }
            }

            if (matches)
            {
                SelectedProduct = product;
                ApplySelectedProductAttributes(product, replaceExisting: false);
                @* UpdateImageUrl(); *@
                return;
            }
        }
    }

    private void UpdateImageUrl()
    {


        CurrentImageUrl = !string.IsNullOrEmpty(ProductModel?.Image)
            ? ProductModel!.Image!
            @* : "/images/hero/iphone-17-pm-2.png"; *@
            : $"https://res.cloudinary.com/REMOVED_SECRET/image/upload/e_upscale,w_1200/v1763457477/mobileguzone/{SelectedProduct?.BrandName.ToLower()}/{ProductModel?.Slug}/{SelectedProduct?.Sku}.webp";
    }

    private string GetAttributeButtonClass(AttributeChoice choice)
    {
        bool isSelected = SelectedAttributes.TryGetValue(choice.AttributeId, out var selectedValue)
            && selectedValue == choice;
        return isSelected
            ? "px-4 py-2 rounded-lg border-2 border-[#2563EB] bg-blue-50 text-[#2563EB] font-semibold transition"
            : "px-4 py-2 rounded-lg border border-gray-300 hover:border-gray-400 transition";
    }

    private void BuildAttributeChoices()
    {
        AttributeChoices.Clear();
        foreach (var attribute in Attributes)
        {
            var choices = BuildChoicesForAttribute(attribute.Id);
            if (choices.Count > 0)
            {
                AttributeChoices[attribute.Id] = choices;
            }
        }
    }

    private List<AttributeChoice> BuildChoicesForAttribute(int attributeId)
    {
        var values = AttributeValues.Where(av => av.AttributeId == attributeId);
        var result = new List<AttributeChoice>();
        var seenOptionIds = new HashSet<int>();
        var seenText = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        foreach (var value in values)
        {
            var choice = CreateChoiceFromValue(value);
            if (choice == null)
            {
                continue;
            }

            if (choice.OptionId.HasValue)
            {
                if (!seenOptionIds.Add(choice.OptionId.Value))
                {
                    continue;
                }
            }
            else
            {
                var key = choice.DisplayValue;
                if (!seenText.Add(key))
                {
                    continue;
                }
            }

            result.Add(choice);
        }

        return result
            .OrderBy(c => c.OptionId.HasValue ? 0 : 1)
            .ThenBy(c => c.DisplayValue, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private AttributeChoice? CreateChoiceFromValue(ProductAttributeValue value)
    {
        var display = ResolveAttributeDisplay(value.AttributeId, value.OptionId, value.ValueText);
        if (string.IsNullOrWhiteSpace(display))
        {
            return null;
        }

        return new AttributeChoice(value.AttributeId, value.OptionId, display, value.ValueText?.Trim());
    }

    private string ResolveAttributeDisplay(int attributeId, int? optionId, string? valueText)
    {
        if (optionId.HasValue && AttributeOptionLookup.TryGetValue(attributeId, out var options))
        {
            var option = options.FirstOrDefault(o => o.Id == optionId.Value);
            if (option != null)
            {
                return option.DisplayValue;
            }
        }

        return valueText?.Trim() ?? string.Empty;
    }

    private void ApplySelectedProductAttributes(Product product, bool replaceExisting)
    {
        var productValues = AttributeValues.Where(av => av.ProductId == product.Id);
        foreach (var value in productValues)
        {
            var choice = CreateChoiceFromValue(value);
            if (choice == null)
            {
                continue;
            }

            if (replaceExisting || !SelectedAttributes.ContainsKey(value.AttributeId))
            {
                SelectedAttributes[value.AttributeId] = choice;
            }
        }
    }
    private string GetProductImageUrl(Product product)
    {
        // Ưu tiên logic Cloudinary cho từng variant (SKU)
        // Nếu logic cũ của bạn ưu tiên ProductModel.Image thì đảo ngược lại điều kiện if
        
        // Giả sử bạn muốn ưu tiên ảnh theo SKU (variant) để đổi màu sắc:
        if (product != null && ProductModel != null)
        {
             return $"https://res.cloudinary.com/REMOVED_SECRET/image/upload/w_800,h_800,c_fill,f_auto,q_auto/v1763457477/mobileguzone/{product.BrandName.ToLower()}/{ProductModel.Slug}/{product.Sku}.webp";
        }

        // Fallback nếu không tạo được link variant
        return ProductModel?.Image ?? "";
    }

    private async Task AddToCart()
    {
        if (SelectedProduct != null)
        {
            // Ensure CurrentImageUrl is up to date or calculate it here
            var imgUrl = !string.IsNullOrEmpty(CurrentImageUrl) ? CurrentImageUrl : GetProductImageUrl(SelectedProduct);
            
            await CartService.AddToCart(SelectedProduct, imgUrl);
            
            ShowToast = true;
            StateHasChanged();
            await Task.Delay(3000);
            ShowToast = false;
            StateHasChanged();
        }
    }

    private async Task HandleReviewSubmitted()
    {
        if (reviewList != null)
        {
            ShowReviewForm = false; // Gửi xong thì đóng form lại cho gọn
            ShowToast = true; // Hiện thông báo (nếu có logic toast ở parent)
            await reviewList.RefreshAsync(); // Reload lại list
        }

        if (ProductModel != null)
        {
            var summary = await ReviewService.GetReviewSummaryAsync(ProductModel.Id);
            AverageRating = summary.AverageRating;
            TotalReviews = summary.TotalReviews;
            StateHasChanged();
        }
    }

    private void ParseQueryParameters()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        foreach (var attr in Attributes)
        {
            var attrName = attr.Name.ToLowerInvariant();
            if (query.TryGetValue(attrName, out var values) && values.Count > 0)
            {
                var value = values[0];
                var choices = GetAttributeChoices(attr.Id);
                var choice = choices.FirstOrDefault(c => c.DisplayValue.Equals(value, StringComparison.OrdinalIgnoreCase));
                if (choice != null)
                {
                    SelectedAttributes[attr.Id] = choice;
                }
            }
        }
    }


    private sealed record AttributeChoice(int AttributeId, int? OptionId, string DisplayValue, string? RawValueText);
}
