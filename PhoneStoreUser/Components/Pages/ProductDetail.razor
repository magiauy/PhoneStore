@page "/product/{slug}/{sku?}"
@using PhoneStoreUser.Components.Models
@using Microsoft.Extensions.Logging
@using Microsoft.AspNetCore.WebUtilities
@using PhoneStoreUser.Services
@using System.Globalization
@rendermode InteractiveServer
@inject IProductCatalogService ProductCatalogService
@inject ICartService CartService
@inject NavigationManager NavigationManager
@inject ILogger<ProductDetail> Logger
@inject IReviewService ReviewService
@inject ICloudinaryService CloudinaryService
@inject IInventoryService InventoryService

@* Xử lý hiển thị tiêu đề trang khi đang tải *@
<PageTitle>@(ProductModel?.Name ?? "Chi tiết sản phẩm") - GuZone</PageTitle>

<div class="container mx-auto px-4 py-8">
    @if (ShowToast)
    {
        <div class="fixed bottom-4 right-4 z-50 rounded-xl @(ToastIsWarning ? "bg-yellow-500" : "bg-green-600") px-6 py-3 text-white shadow-lg transition-opacity duration-300 flex items-center gap-2">
            @if (ToastIsWarning)
            {
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            }
            else
            {
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
            }
            <span class="font-medium">@ToastMessage</span>
        </div>
    }

    @if (IsLoading)
    {
        <div class="rounded-2xl border border-gray-200 bg-white p-6 text-center text-sm text-gray-500">
            Đang tải thông tin sản phẩm...
        </div>
    }
    else if (ProductModel != null)
    {
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
            <div class="bg-gray-50 rounded-2xl overflow-hidden aspect-square relative">
                @foreach (var product in Products)
                {
                    var isSelected = product.Id == SelectedProduct?.Id;
                    var imgUrl = GetProductImageUrl(product);
                    
                    <img src="@imgUrl"
                         alt="@product.Name" 
                         class="w-full h-full object-cover absolute inset-0 transition-opacity duration-300 ease-in-out @(isSelected ? "opacity-100 z-10" : "opacity-0 z-0")" 
                         loading="@(isSelected ? "eager" : "lazy")" />
                }
            </div>

            <div class="space-y-6">
                <div>
                    <p class="text-sm text-gray-500 uppercase">GuZone</p>
                    <h1 class="text-3xl font-bold text-gray-900 mt-2">@ProductModel.Name</h1>
                    
                    <div class="flex items-center gap-2 mt-2">
                        <div class="flex text-yellow-400 text-sm">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Math.Round(AverageRating))
                                {
                                    <i class="fa-solid fa-star"></i>
                                }
                                else
                                {
                                    <i class="fa-regular fa-star text-gray-300"></i>
                                }
                            }
                        </div>
                        <span class="text-sm text-gray-500">(@TotalReviews lượt đánh giá)</span>
                    </div>

                    <p class="text-gray-600 mt-2">@ProductModel.Description</p>
                    
                    @if (SelectedProduct != null)
                    {
                        <p class="text-2xl font-bold text-[#2563EB] mt-4">
                            @(SelectedProduct.Price > 0 
                                ? $"{SelectedProduct.Price.ToString("N0", new CultureInfo("vi-VN"))} ₫" 
                                : "Liên hệ")
                        </p>
                        
                        @* Pricing Labels based on PricingMode *@
                        @if (SelectedProduct.PricingMode == PricingMode.CLEARANCE)
                        {
                            <span class="inline-block mt-2 px-3 py-1 text-sm font-medium text-orange-700 bg-orange-100 rounded-full">
                                Giá ưu đãi xả kho (Số lượng có hạn)
                            </span>
                        }
                        else if (SelectedProduct.PricingMode == PricingMode.AUTO_PROTECT && IsPriceRecentlyUpdated(SelectedProduct.PriceUpdatedAt))
                        {
                            <span class="inline-block mt-2 px-3 py-1 text-sm font-medium text-blue-700 bg-blue-100 rounded-full">
                                Giá thị trường (Cập nhật 24h)
                            </span>
                        }
                        
                        @* Stock warning when stock <= 5 *@
                        @if (GetProductStock(SelectedProduct.Id) is var stockQuantity && stockQuantity > 0 && stockQuantity <= 5)
                        {
                            <p class="mt-2 text-sm font-medium text-red-600">
                                <i class="fa-solid fa-fire mr-1"></i>
                                Chỉ còn @stockQuantity sản phẩm với mức giá này
                            </p>
                        }
                    }
                </div>

                @if (SelectedAttributes.Count > 0)
                {
                    <div class="flex justify-end">
                        <button type="button"
                                class="text-sm text-[#2563EB] hover:text-blue-700 font-semibold underline-offset-4 hover:underline"
                                @onclick="ResetSelections">
                            Chọn lại
                        </button>
                    </div>
                }

                @foreach (var attr in Attributes)
                {
                    var choices = GetAttributeChoices(attr.Id);

                    <div class="space-y-2">
                        <label class="text-sm font-semibold text-gray-700">@attr.Name</label>
                        
                        @if (choices.Count > 0)
                        {
                            <div class="flex flex-wrap gap-2">
                                @foreach (var choice in choices)
                                {
                                    var capturedChoice = choice;
                                    var isDisabled = !IsChoiceAvailable(capturedChoice);
                                    <button
                                        type="button"
                                        class="@GetAttributeButtonClass(capturedChoice, isDisabled)"
                                        disabled="@isDisabled"
                                        @onclick="@(() => SelectAttributeValue(capturedChoice))">
                                        @capturedChoice.DisplayValue
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-xs text-gray-500">Không có tùy chọn khả dụng.</p>
                        }
                    </div>
                }

                @if (SelectedProduct != null)
                {
                    <div class="border-t pt-6 space-y-3">
                        <p class="text-sm text-gray-600">Mã SKU: <span class="font-medium text-gray-900">@SelectedProduct.Sku</span></p>
                        <p class="text-sm text-gray-600">Bảo hành: <span class="font-medium text-gray-900">@SelectedProduct.WarrantyMonths tháng</span></p>
                    </div>
                }

                <div class="space-y-3">
                    <button class="w-full bg-[#2563EB] text-white py-3 rounded-xl font-semibold hover:bg-blue-700 transition" @onclick="AddToCart">
                        Thêm vào giỏ hàng
                    </button>
                </div>
            </div>
        </div>

        <section class="mt-12 space-y-8">
            <div class="flex items-center justify-between">
                <h3 class="text-2xl font-bold text-gray-900">Đánh giá & Nhận xét</h3>
                
                @if (!ShowReviewForm)
                {
                    <button @onclick="() => ShowReviewForm = true" 
                            class="px-6 py-2.5 bg-[#2563EB] text-white font-semibold rounded-xl hover:bg-blue-700 transition shadow-sm flex items-center gap-2">
                        <i class="fa-solid fa-pen-to-square"></i>
                        Viết đánh giá
                    </button>
                }
            </div>

            @if (ShowReviewForm)
            {
                <div class="animate-fade-in-down"> 
                    <div class="flex justify-between items-center mb-2">
                        <p class="text-gray-500 text-sm">Mời bạn chia sẻ cảm nhận về sản phẩm</p>
                        <button @onclick="() => ShowReviewForm = false" class="text-gray-400 hover:text-red-500 text-sm transition-colors">
                            <i class="fa-solid fa-xmark mr-1"></i> Đóng
                        </button>
                    </div>
                    
                    @if (SelectedProduct != null)
                    {
                        <ReviewForm ProductId="SelectedProduct.Id" OnReviewSubmitted="HandleReviewSubmitted" />
                    }
                </div>
            }

            <ReviewList @ref="reviewList" ProductModelId="ProductModel?.Id ?? 0" ProductId="SelectedProduct?.Id ?? 0" />
        </section>
    }
</div>
@code {
    [Parameter] public string? Slug { get; set; }
    [Parameter] public string? Sku { get; set; }

    private ProductModel? ProductModel { get; set; }
    private List<Product> Products { get; set; } = new();
    private List<ProductAttribute> Attributes { get; set; } = new();
    private List<ProductAttributeValue> AttributeValues { get; set; } = new();
    private Dictionary<int, IReadOnlyList<ProductAttributeOption>> AttributeOptionLookup { get; set; } = new();
    private Dictionary<int, List<AttributeChoice>> AttributeChoices { get; set; } = new();
    private Dictionary<int, AttributeChoice> SelectedAttributes { get; set; } = new();
    // Only attributes the user interacted with are used to tighten availability filtering.
    private HashSet<int> UserSelectedAttributeIds { get; set; } = new();
    private Product? SelectedProduct { get; set; }
    private Dictionary<int, string?> ProductImageUrls { get; set; } = new();
    private const string ProductImageTransformation = "w_800,h_800,c_fill,f_auto,q_auto";
    private bool IsLoading { get; set; } = true;
    private bool ShowToast { get; set; } = false;
    private PhoneStoreUser.Components.UI.ReviewList? reviewList;
    private double AverageRating { get; set; }
    private int TotalReviews { get; set; }
    private int? LastSelectedAttributeId { get; set; }
    private bool ShowReviewForm = false; // Mặc định là ẩn
    private Dictionary<int, ProductAvailabilitySnapshot> ProductAvailability { get; set; } = new();
    private string ToastMessage { get; set; } = "Thêm vào giỏ hàng thành công!";
    private bool ToastIsWarning { get; set; } = false;

    protected override async Task OnParametersSetAsync()
    {
        await LoadProductDetailAsync();
    }

    private async Task LoadProductDetailAsync()
    {
        IsLoading = true;
        ProductModel = null;
        Products.Clear();
        Attributes.Clear();
        AttributeValues.Clear();
        AttributeOptionLookup = new Dictionary<int, IReadOnlyList<ProductAttributeOption>>();
        AttributeChoices.Clear();
        SelectedAttributes.Clear();
        UserSelectedAttributeIds.Clear();
        SelectedProduct = null;
        ProductImageUrls.Clear();
        LastSelectedAttributeId = null;

        if (!string.IsNullOrWhiteSpace(Sku))
        {
            var product = await ProductCatalogService.GetProductBySkuAsync(Sku);
            if (product != null)
            {
                ProductModel = await ProductCatalogService.GetProductModelByIdAsync(product.ModelId);
                if (ProductModel != null)
                {
                    var summary = await ReviewService.GetReviewSummaryAsync(ProductModel.Id);
                    AverageRating = summary.AverageRating;
                    TotalReviews = summary.TotalReviews;

                    Products = (await ProductCatalogService.GetProductsByModelAsync(ProductModel.Id)).ToList();
                    var productIds = Products.Select(p => p.Id).ToList();
                    Attributes = (await ProductCatalogService.GetAttributesForModelAsync(ProductModel.Id)).ToList();
                    AttributeValues = productIds.Count > 0
                        ? (await ProductCatalogService.GetAttributeValuesForProductsAsync(productIds)).ToList()
                        : new List<ProductAttributeValue>();

                    var attributeIds = Attributes.Select(a => a.Id).Distinct().ToList();
                    AttributeOptionLookup = attributeIds.Count > 0
                        ? (await ProductCatalogService.GetAttributeOptionsForAttributesAsync(attributeIds)).ToDictionary(pair => pair.Key, pair => pair.Value)
                        : new Dictionary<int, IReadOnlyList<ProductAttributeOption>>();

                    BuildAttributeChoices();

                    // Set default selection to the product matching the SKU
                    SelectedProduct = Products.FirstOrDefault(p => p.Id == product.Id) ?? Products.FirstOrDefault();
                    if (SelectedProduct != null)
                    {
                        ApplySelectedProductAttributes(SelectedProduct, replaceExisting: true);
                    }

                    // Parse query parameters and update selection if matches found
                    ParseQueryParameters();
                    FindMatchingProduct();
                }
            }
        }
        else if (!string.IsNullOrWhiteSpace(Slug))
        {
            ProductModel = await ProductCatalogService.GetProductModelBySlugAsync(Slug);
            if (ProductModel != null)
            {
                var summary = await ReviewService.GetReviewSummaryAsync(ProductModel.Id);
                AverageRating = summary.AverageRating;
                TotalReviews = summary.TotalReviews;

                Products = (await ProductCatalogService.GetProductsByModelAsync(ProductModel.Id)).ToList();
                var productIds = Products.Select(p => p.Id).ToList();
                Attributes = (await ProductCatalogService.GetAttributesForModelAsync(ProductModel.Id)).ToList();
                AttributeValues = productIds.Count > 0
                    ? (await ProductCatalogService.GetAttributeValuesForProductsAsync(productIds)).ToList()
                    : new List<ProductAttributeValue>();

                var attributeIds = Attributes.Select(a => a.Id).Distinct().ToList();
                AttributeOptionLookup = attributeIds.Count > 0
                    ? (await ProductCatalogService.GetAttributeOptionsForAttributesAsync(attributeIds)).ToDictionary(pair => pair.Key, pair => pair.Value)
                    : new Dictionary<int, IReadOnlyList<ProductAttributeOption>>();

                BuildAttributeChoices();

                // Set default selection to the first product
                SelectedProduct = Products.FirstOrDefault();
                if (SelectedProduct != null)
                {
                    ApplySelectedProductAttributes(SelectedProduct, replaceExisting: true);
                }

                // Parse query parameters and update selection if matches found
                ParseQueryParameters();
                FindMatchingProduct();
            }
        }
        
        if (ProductModel != null && Products.Count > 0)
        {
            await PopulateProductImagesAsync();
            
            // Load stock availability for all products
            var productIds = Products.Select(p => p.Id).ToList();
            ProductAvailability = await InventoryService.GetAvailabilityForProductsAsync(productIds);
        }

        IsLoading = false;
    }

    private IReadOnlyList<AttributeChoice> GetAttributeChoices(int attributeId)
    {
        return AttributeChoices.TryGetValue(attributeId, out var choices) && choices.Count > 0
            ? choices
            : Array.Empty<AttributeChoice>();
    }

    private void SelectAttributeValue(AttributeChoice choice)
    {
        if (!IsChoiceAvailable(choice))
        {
            return;
        }

        UserSelectedAttributeIds.Add(choice.AttributeId);
        LastSelectedAttributeId = choice.AttributeId;
        SelectedAttributes[choice.AttributeId] = choice;
        FindMatchingProduct();
    }

    private void FindMatchingProduct()
    {
        var activeSelections = SelectedAttributes
            .Where(kvp => UserSelectedAttributeIds.Contains(kvp.Key))
            .ToDictionary(kvp => kvp.Key, kvp => kvp.Value);

        if (Products.Count == 0)
        {
            return;
        }

        if (activeSelections.Count == 0)
        {
            if (SelectedProduct == null)
            {
                SelectedProduct = Products.FirstOrDefault();
                if (SelectedProduct != null)
                {
                    ApplySelectedProductAttributes(SelectedProduct, replaceExisting: true);
                }
            }
            return;
        }

        var matchingProduct = Products.FirstOrDefault(product => DoesProductMatchSelection(product, activeSelections));

        if (matchingProduct == null && LastSelectedAttributeId.HasValue
            && SelectedAttributes.TryGetValue(LastSelectedAttributeId.Value, out var lastChoice))
        {
            matchingProduct = Products.FirstOrDefault(product =>
                DoesChoiceMatchAttributeValue(
                    lastChoice,
                    AttributeValues.FirstOrDefault(av =>
                        av.ProductId == product.Id && av.AttributeId == lastChoice.AttributeId)));
        }

        if (matchingProduct == null && SelectedProduct != null)
        {
            matchingProduct = SelectedProduct;
        }

        matchingProduct ??= Products.FirstOrDefault();

        if (matchingProduct != null)
        {
            SelectedProduct = matchingProduct;
            ApplySelectedProductAttributes(matchingProduct, replaceExisting: true);
        }
    }

    private async Task PopulateProductImagesAsync()
    {
        ProductImageUrls.Clear();

        if (ProductModel == null || Products.Count == 0)
        {
            return;
        }

        var slug = ProductModel.Slug ?? string.Empty;

        var tasks = Products.Select(async product =>
        {
            var cacheKey = (product.UpdatedAt ?? product.CreatedAt)?.Ticks.ToString();
            var url = await CloudinaryService.GetImageUrlAsync(
                product.BrandName ?? string.Empty,
                slug,
                product.Sku,
                cacheKey,
                format: "webp",
                transformation: ProductImageTransformation);
            return (product.Id, url);
        }).ToList();

        var results = await Task.WhenAll(tasks);
        foreach (var result in results)
        {
            ProductImageUrls[result.Item1] = result.Item2;
        }
    }

    private string GetAttributeButtonClass(AttributeChoice choice, bool isDisabled)
    {
        if (isDisabled)
        {
            return "px-4 py-2 rounded-lg border border-gray-200 bg-gray-100 text-gray-400 cursor-not-allowed";
        }

        bool isSelected = SelectedAttributes.TryGetValue(choice.AttributeId, out var selectedValue)
            && selectedValue == choice;
        return isSelected
            ? "px-4 py-2 rounded-lg border-2 border-[#2563EB] bg-blue-50 text-[#2563EB] font-semibold transition"
            : "px-4 py-2 rounded-lg border border-gray-300 hover:border-gray-400 transition";
    }

    private void BuildAttributeChoices()
    {
        AttributeChoices.Clear();
        foreach (var attribute in Attributes)
        {
            var choices = BuildChoicesForAttribute(attribute.Id);
            if (choices.Count > 0)
            {
                AttributeChoices[attribute.Id] = choices;
            }
        }
    }

    private List<AttributeChoice> BuildChoicesForAttribute(int attributeId)
    {
        var values = AttributeValues.Where(av => av.AttributeId == attributeId);
        var result = new List<AttributeChoice>();
        var seenOptionIds = new HashSet<int>();
        var seenText = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        foreach (var value in values)
        {
            var choice = CreateChoiceFromValue(value);
            if (choice == null)
            {
                continue;
            }

            if (choice.OptionId.HasValue)
            {
                if (!seenOptionIds.Add(choice.OptionId.Value))
                {
                    continue;
                }
            }
            else
            {
                var key = choice.DisplayValue;
                if (!seenText.Add(key))
                {
                    continue;
                }
            }

            result.Add(choice);
        }

        return result
            .OrderBy(c => c.OptionId.HasValue ? 0 : 1)
            .ThenBy(c => c.DisplayValue, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private AttributeChoice? CreateChoiceFromValue(ProductAttributeValue value)
    {
        var display = ResolveAttributeDisplay(value.AttributeId, value.OptionId, value.ValueText);
        if (string.IsNullOrWhiteSpace(display))
        {
            return null;
        }

        return new AttributeChoice(value.AttributeId, value.OptionId, display, value.ValueText?.Trim());
    }

    private string ResolveAttributeDisplay(int attributeId, int? optionId, string? valueText)
    {
        if (optionId.HasValue && AttributeOptionLookup.TryGetValue(attributeId, out var options))
        {
            var option = options.FirstOrDefault(o => o.Id == optionId.Value);
            if (option != null)
            {
                return option.DisplayValue;
            }
        }

        return valueText?.Trim() ?? string.Empty;
    }

    private void ApplySelectedProductAttributes(Product product, bool replaceExisting)
    {
        var productValues = AttributeValues.Where(av => av.ProductId == product.Id);
        foreach (var value in productValues)
        {
            var choice = CreateChoiceFromValue(value);
            if (choice == null)
            {
                continue;
            }

            if (replaceExisting || !SelectedAttributes.ContainsKey(value.AttributeId))
            {
                SelectedAttributes[value.AttributeId] = choice;
            }
        }
    }
    private string GetProductImageUrl(Product product)
    {
        if (product == null)
        {
            return ProductModel?.Image ?? string.Empty;
        }

        if (ProductImageUrls.TryGetValue(product.Id, out var cachedUrl) && !string.IsNullOrEmpty(cachedUrl))
        {
            return cachedUrl;
        }

        return ProductModel?.Image ?? string.Empty;
    }

    private async Task AddToCart()
    {
        if (SelectedProduct != null)
        {
            var imgUrl = GetProductImageUrl(SelectedProduct);

            var (success, message) = await CartService.AddToCartWithInventoryCheck(SelectedProduct, 1, imgUrl);
            
            if (success)
            {
                ToastIsWarning = !string.IsNullOrEmpty(message);
                ToastMessage = message ?? "Thêm vào giỏ hàng thành công!";
            }
            else
            {
                ToastIsWarning = true;
                ToastMessage = message ?? "Không thể thêm sản phẩm vào giỏ hàng";
            }
            
            ShowToast = true;
            StateHasChanged();
            await Task.Delay(3000);
            ShowToast = false;
            StateHasChanged();
        }
    }

    private async Task HandleReviewSubmitted()
    {
        if (reviewList != null)
        {
            ShowReviewForm = false; // Gửi xong thì đóng form lại cho gọn
            ShowToast = true; // Hiện thông báo (nếu có logic toast ở parent)
            await reviewList.RefreshAsync(); // Reload lại list
        }

        if (ProductModel != null)
        {
            var summary = await ReviewService.GetReviewSummaryAsync(ProductModel.Id);
            AverageRating = summary.AverageRating;
            TotalReviews = summary.TotalReviews;
            StateHasChanged();
        }
    }

    private void ParseQueryParameters()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        foreach (var attr in Attributes)
        {
            var attrName = attr.Name.ToLowerInvariant();
            if (query.TryGetValue(attrName, out var values) && values.Count > 0)
            {
                var value = values[0];
                var choices = GetAttributeChoices(attr.Id);
                var choice = choices.FirstOrDefault(c => c.DisplayValue.Equals(value, StringComparison.OrdinalIgnoreCase));
                if (choice != null)
                {
                    SelectedAttributes[attr.Id] = choice;
                    UserSelectedAttributeIds.Add(attr.Id);
                    LastSelectedAttributeId = attr.Id;
                }
            }
        }
    }

    private void ResetSelections()
    {
        SelectedAttributes.Clear();
        UserSelectedAttributeIds.Clear();
        LastSelectedAttributeId = null;

        SelectedProduct = Products.FirstOrDefault();
        if (SelectedProduct != null)
        {
            ApplySelectedProductAttributes(SelectedProduct, replaceExisting: true);
        }
    }

    /// <summary>
    /// Check if price was updated within the last 24 hours
    /// </summary>
    private static bool IsPriceRecentlyUpdated(DateTime? priceUpdatedAt)
    {
        if (priceUpdatedAt == null) return false;
        return (DateTime.UtcNow - priceUpdatedAt.Value).TotalHours <= 24;
    }

    /// <summary>
    /// Get the available stock quantity for a product
    /// </summary>
    private int GetProductStock(int productId)
    {
        if (ProductAvailability.TryGetValue(productId, out var snapshot))
        {
            return snapshot.AvailableQuantity;
        }
        return 0;
    }

    private bool IsChoiceAvailable(AttributeChoice choice)
    {
        if (Products.Count == 0)
        {
            return false;
        }

        var simulatedSelection = SelectedAttributes
            .Where(kvp => kvp.Key != choice.AttributeId && UserSelectedAttributeIds.Contains(kvp.Key))
            .ToDictionary(kvp => kvp.Key, kvp => kvp.Value);

        simulatedSelection[choice.AttributeId] = choice;

        return Products.Any(product => DoesProductMatchSelection(product, simulatedSelection));
    }

    private bool DoesProductMatchSelection(Product product, IReadOnlyDictionary<int, AttributeChoice> selection)
    {
        var productAttrValues = AttributeValues.Where(av => av.ProductId == product.Id).ToList();

        foreach (var selected in selection)
        {
            var attrValue = productAttrValues.FirstOrDefault(av => av.AttributeId == selected.Key);
            if (!DoesChoiceMatchAttributeValue(selected.Value, attrValue))
            {
                return false;
            }
        }

        return true;
    }

    private static bool DoesChoiceMatchAttributeValue(AttributeChoice choice, ProductAttributeValue? attrValue)
    {
        if (attrValue == null)
        {
            return false;
        }

        if (choice.OptionId.HasValue)
        {
            return attrValue.OptionId == choice.OptionId;
        }

        var normalized = attrValue.ValueText?.Trim();
        var expected = choice.RawValueText ?? choice.DisplayValue;
        return !string.IsNullOrEmpty(normalized)
            && string.Equals(normalized, expected, StringComparison.OrdinalIgnoreCase);
    }

    private sealed record AttributeChoice(int AttributeId, int? OptionId, string DisplayValue, string? RawValueText);
}
