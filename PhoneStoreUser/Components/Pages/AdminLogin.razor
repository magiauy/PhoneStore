@page "/admin"
@using PhoneStoreUser.Components.Models
@using PhoneStoreUser.Components.Layout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Http
@layout LoginLayout
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>GuZone Admin Login</PageTitle>

@if (_isChecking)
{
    <div class="min-h-screen flex items-center justify-center bg-slate-50">
        <div class="text-center">
            <div class="h-8 w-8 animate-spin rounded-full border-4 border-slate-900 border-t-transparent mx-auto mb-4"></div>
            <p class="text-slate-600">Đang kiểm tra...</p>
        </div>
    </div>
}
else
{
<div class="min-h-screen flex items-center justify-center bg-slate-50 px-4">
    <div class="w-full max-w-md bg-white border border-slate-200 rounded-2xl shadow-lg p-6 sm:p-8">
        @if (_showAccessDenied)
        {
            <div class="text-center">
                <div class="inline-flex items-center justify-center h-16 w-16 rounded-full bg-rose-100 text-rose-600 mb-4">
                    <i class="fa-solid fa-ban text-3xl"></i>
                </div>
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight mb-2">Truy cập bị từ chối</h1>
                <p class="text-sm text-slate-500 mb-6">Tài khoản của bạn không có quyền truy cập trang quản trị.</p>
                <a href="/" class="inline-flex items-center gap-2 px-4 py-2 bg-slate-900 text-white rounded-xl text-sm font-medium hover:bg-slate-800 transition">
                    <i class="fa-solid fa-home"></i>
                    Về trang chủ
                </a>
            </div>
        }
        else
        {
        <div class="space-y-2 text-center mb-8">
            <div class="inline-flex items-center justify-center h-12 w-12 rounded-xl bg-slate-900 text-white mb-4 shadow-lg shadow-slate-900/20">
                <i class="fa-solid fa-shield-halved text-xl"></i>
            </div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Admin Portal</h1>
            <p class="text-sm text-slate-500">Đăng nhập dành cho quản trị viên & nhân viên</p>
        </div>

        <form method="post" action="/admin/login" class="space-y-5">
            <AntiforgeryToken />
            
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-600 flex items-start gap-3">
                    <i class="fa-solid fa-circle-exclamation mt-0.5 shrink-0"></i>
                    <span>@ErrorMessage</span>
                </div>
            }

            <div class="space-y-4">
                <div class="space-y-1.5">
                    <label for="username" class="text-sm font-semibold text-slate-700">Tên đăng nhập</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                            <i class="fa-solid fa-user text-sm"></i>
                        </div>
                        <input
                            id="username"
                            name="EmailOrUsername"
                            value="@Model.EmailOrUsername"
                            class="w-full pl-10 pr-3 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-slate-900 transition shadow-sm placeholder:text-slate-400"
                            placeholder="username"
                            autocomplete="username"
                            required />
                    </div>
                </div>

                <div class="space-y-1.5">
                    <label for="password" class="text-sm font-semibold text-slate-700">Mật khẩu</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                            <i class="fa-solid fa-lock text-sm"></i>
                        </div>
                        <input
                            id="password"
                            type="password"
                            name="Password"
                            class="w-full pl-10 pr-3 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-slate-900 transition shadow-sm placeholder:text-slate-400"
                            placeholder="••••••••"
                            autocomplete="current-password"
                            required />
                    </div>
                </div>

                <div class="flex items-center justify-between pt-1">
                    <label class="inline-flex items-center gap-2 text-sm text-slate-600 cursor-pointer select-none group">
                        <input
                            type="checkbox"
                            name="RememberMe"
                            value="true"
                            class="h-4 w-4 text-slate-900 border-slate-300 rounded focus:ring-slate-900 cursor-pointer"
                            checked="@Model.RememberMe" />
                        <span class="group-hover:text-slate-900 transition">Ghi nhớ đăng nhập</span>
                    </label>
                </div>

                <button
                    type="submit"
                    class="w-full bg-slate-900 text-white font-semibold py-3 rounded-xl text-sm flex items-center justify-center gap-2 hover:bg-slate-800 active:scale-[0.98] transition shadow-md shadow-slate-900/10 mt-2">
                    <span>Đăng nhập hệ thống</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </div>
        </form>
        
        <div class="mt-8 text-center">
            <p class="text-xs text-slate-400">
                &copy; @DateTime.Now.Year GuZone Admin System. All rights reserved.
            </p>
        </div>
        }
    </div>
</div>
}

@code {
    [SupplyParameterFromForm]
    public LoginModel Model { get; set; } = new();

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private string? ErrorMessage => Error switch
    {
        "missing_credentials" => "Vui lòng nhập đầy đủ tên đăng nhập và mật khẩu.",
        "invalid_credentials" => "Tên đăng nhập hoặc mật khẩu không chính xác.",
        "unauthorized" => "Tài khoản không có quyền truy cập trang quản trị.",
        _ => null
    };

    private bool _showAccessDenied = false;
    private bool _isChecking = true;
    private bool _shouldRedirect = false;
    private string _redirectUrl = string.Empty;

    protected override void OnInitialized()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext == null)
        {
            _isChecking = false;
            return;
        }

        // Kiểm tra xem có admin cookie không
        var hasAdminCookie = httpContext.Request.Cookies.ContainsKey("guzone.admin");
        var hasUserCookie = httpContext.Request.Cookies.ContainsKey("guzone.auth");

        // Nếu có admin cookie, HttpContext.User sẽ được xác thực với admin scheme
        // vì policy scheme forward /admin/* đến adminScheme
        var user = httpContext.User;
        
        if (hasAdminCookie && user.Identity?.IsAuthenticated == true && user.IsInRole("EMPLOYEE"))
        {
            // Admin đã đăng nhập, đánh dấu để redirect sau khi render
            _shouldRedirect = true;
            _redirectUrl = "/admin/dashboard";
            return;
        }

        // Nếu chỉ có user cookie (không có admin cookie), hiển thị access denied
        if (hasUserCookie && !hasAdminCookie)
        {
            _showAccessDenied = true;
        }

        _isChecking = false;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && _shouldRedirect && !string.IsNullOrEmpty(_redirectUrl))
        {
            NavigationManager.NavigateTo(_redirectUrl, forceLoad: true);
        }
    }
}
