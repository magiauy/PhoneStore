@page "/"

<PageTitle>GuZone - Flagship Store</PageTitle>

<div class="space-y-6">
    <HeroBanner
        Heading="Nâng cấp flagship chuẩn GuZone"
        Subheading="Limited Launch"
        Description="Đặt trước iPhone 15 Pro Max, Galaxy S24 Ultra và hàng loạt flagship Android với ưu đãi thu cũ + trợ giá đến 5 triệu."
        PrimaryCta="Đặt trước ngay"
        PrimaryHref="#flagship"
        SecondaryCta="Ưu đãi thu cũ"
        SecondaryHref="#care"
        HeroImage="https://via.placeholder.com/480x480?text=Flagship" />

    <BrandList Brands="BrandBadges" />

    <section id="flagship" class="space-y-3">
        <SectionTitle Title="Flagship nổi bật" Subtitle="Hàng mới về tuần này" ActionHref="#" />
        <ProductCarousel Products="FeaturedProducts" />
    </section>

    <section id="android" class="space-y-3">
        <SectionTitle Title="Android cao cấp" Subtitle="Mạnh mẽ - camera AI" ActionHref="#" />
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var product in AndroidProducts)
            {
                <ProductCard Product="product" />
            }
        </div>
    </section>

    <section id="care" class="grid gap-3 md:grid-cols-3">
        @foreach (var service in ServiceFeatures)
        {
            <article class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
                <div class="flex items-center gap-3">
                    <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[#2563EB]/10 text-lg">@service.Icon</span>
                    <div>
                        <h3 class="text-base font-semibold text-gray-900">@service.Title</h3>
                        <p class="text-xs text-gray-500">@service.Description</p>
                    </div>
                </div>
            </article>
        }
    </section>
</div>

