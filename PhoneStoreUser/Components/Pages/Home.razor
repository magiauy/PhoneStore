@page "/"
@using PhoneStoreUser.Components.Models
@inject IProductCatalogService ProductCatalogService

<PageTitle>GuZone - Flagship Store</PageTitle>

<div class="space-y-6">
    <HeroBanner
        Heading="Đón đầu iPhone 17 Pro Max cùng GuZone"
        Subheading="Limited Launch"
        Description="Đặt trước iPhone 17 Pro Max với ưu đãi thu cũ + trợ giá đến 5 triệu. Số lượng mở bán đợt đầu có hạn."
        PrimaryCta="Đặt trước ngay"
        PrimaryHref="/products?search=iphone%2017"
        SecondaryCta="Ưu đãi thu cũ"
        SecondaryHref="#care"
        HeroImage="/images/hero/iphone-17-pm-2.png" />

    <BrandList />

    <section id="flagship" class="space-y-3">
        <SectionTitle Title="Flagship nổi bật" Subtitle="Hàng mới về tuần này" ActionHref="/products?catalog=2" />
        @if (IsLoading)
        {
            <div class="rounded-2xl border border-gray-200 bg-white p-6 text-sm text-gray-500">Đang tải dữ liệu sản phẩm...</div>
        }
        else if (!FlagshipModels.Any())
        {
            <div class="rounded-2xl border border-dashed border-gray-300 bg-white p-6 text-sm text-gray-500">Chưa có sản phẩm để hiển thị.</div>
        }
        else
        {
            <ProductCarousel ProductModels="FlagshipModels" />
        }
    </section>

    <section id="android" class="space-y-3">
        <SectionTitle Title="Android cao cấp" Subtitle="Mạnh mẽ - camera AI" ActionHref="/products?catalog=3" />
        @if (IsLoading)
        {
            <div class="rounded-2xl border border-gray-200 bg-white p-6 text-sm text-gray-500">Đang tải...</div>
        }
        else if (ProductModels.Any())
        {
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var model in ProductModels.Take(VisibleAndroidCount))
                {
                    <ProductCard ProductModel="model" />
                }
            </div>
            
            @if (VisibleAndroidCount < ProductModels.Count)
            {
                <div class="flex justify-center mt-4">
                    <button class="rounded-xl border border-gray-200 bg-white px-6 py-2 text-sm font-semibold text-gray-600 hover:bg-gray-50 hover:text-[#2563EB] transition" 
                            @onclick="ShowMoreAndroid">
                        Xem thêm 9 sản phẩm
                    </button>
                </div>
            }
        }
    </section>

    <section id="care" class="grid gap-3 md:grid-cols-3">
        @foreach (var service in ServiceFeatures)
        {
            <article class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
                <div class="flex items-center gap-3">
                    <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[#2563EB]/10 text-lg">@service.Icon</span>
                    <div>
                        <h3 class="text-base font-semibold text-gray-900">@service.Title</h3>
                        <p class="text-xs text-gray-500">@service.Description</p>
                    </div>
                </div>
            </article>
        }
    </section>
</div>

@code {
    private List<ProductModel> ProductModels { get; set; } = new();
    private List<ProductModel> FlagshipModels { get; set; } = new();
    private bool IsLoading { get; set; } = true;
    private int VisibleAndroidCount { get; set; } = 9;

    private void ShowMoreAndroid()
    {
        VisibleAndroidCount += 9;
    }

    protected override async Task OnInitializedAsync()
    {
        var t1 = ProductCatalogService.GetProductModelsAsync();
        var t2 = ProductCatalogService.GetProductModelsByCategorySlugAsync("PhoneFlagShip");

        await Task.WhenAll(t1, t2);

        ProductModels = (await t1).ToList();
        FlagshipModels = (await t2).ToList();
        
        IsLoading = false;
    }

    private readonly List<ServiceFeature> ServiceFeatures = new()
    {
        new("Thu cũ đổi mới", "Định giá trong 3 phút, trợ giá thêm đến 5 triệu.", "♻"),
        new("Trả góp 0%", "Hỗ trợ hơn 25 ngân hàng, duyệt hồ sơ online.", "💳"),
        new("Giao nhanh 2h", "Áp dụng tại 20 tỉnh thành, miễn phí vận chuyển.", "⚡"),
        new("Bảo hành VIP", "1 đổi 1 trong 30 ngày, hỗ trợ tận nơi.", "🛡"),
        new("Lắp đặt tại nhà", "Thiết lập thiết bị, chuyển dữ liệu an toàn.", "🧑‍💻"),
        new("GuZone Care+", "Bảo vệ rơi vỡ, ngập nước với phí ưu đãi.", "✨")
    };

    private record ServiceFeature(string Title, string Description, string Icon);
}
