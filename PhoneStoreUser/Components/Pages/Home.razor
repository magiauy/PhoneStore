@page "/"

<PageTitle>GuZone - Điện thoại hàng đầu</PageTitle>

<div class="bg-gray-100 min-h-screen text-gray-900">
    <div class="max-w-6xl mx-auto px-4 py-4 space-y-4">
        <section class="bg-[#0F0F0F] text-white rounded-2xl p-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="space-y-3">
                <p class="text-sm uppercase tracking-wide text-gray-300">GuZone Phone Store</p>
                <h1 class="text-3xl font-bold leading-tight">Săn smartphone mạnh mẽ với giá tốt nhất</h1>
                <p class="text-sm text-gray-200">Bộ sưu tập flagship và tầm trung chính hãng, giao hàng siêu tốc toàn quốc.</p>
            </div>
            <button class="bg-[#2563EB] text-white px-4 py-2 rounded-xl text-sm font-semibold shadow-sm hover:bg-blue-600 transition-all duration-200">Xem sản phẩm</button>
        </section>

        <section class="bg-white rounded-2xl border p-4 shadow-sm">
            <div class="flex items-center justify-between mb-3">
                <h2 class="text-xl font-semibold text-gray-900">Danh mục nhanh</h2>
                <span class="text-xs text-gray-500">Chọn thương hiệu yêu thích</span>
            </div>
            <div class="flex gap-2 overflow-x-auto">
                @foreach (var category in QuickCategories)
                {
                    <button class="flex items-center gap-2 px-4 py-2 rounded-xl border border-gray-200 bg-gray-50 text-sm font-medium text-gray-700 hover:border-[#2563EB] hover:text-[#2563EB] transition">
                        <span class="w-8 h-8 rounded-full bg-white border border-gray-200 flex items-center justify-center text-[#2563EB] text-sm font-semibold">@category.Icon</span>
                        <span>@category.Name</span>
                    </button>
                }
            </div>
        </section>

        <section class="space-y-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-xl font-semibold text-gray-900">Sản phẩm nổi bật</h2>
                    <p class="text-sm text-gray-500">Hàng mới về, bảo hành chính hãng</p>
                </div>
                <a class="text-sm font-medium text-[#2563EB] hover:underline" href="#">Xem tất cả</a>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
                @foreach (var product in FeaturedProducts)
                {
                    <div class="rounded-xl border bg-white p-3 shadow-sm hover:shadow-md transition">
                        <div class="aspect-square rounded-lg overflow-hidden bg-gray-100 flex items-center justify-center">
                            <img src="@product.Image" alt="@product.Name" class="w-full h-full object-cover" />
                        </div>
                        <div class="mt-3 space-y-1">
                            <p class="text-xs uppercase text-gray-500">@product.Brand</p>
                            <h3 class="text-sm font-medium text-gray-900">@product.Name</h3>
                            <p class="text-lg font-semibold text-[#2563EB]">@product.Price</p>
                        </div>
                        <button class="mt-3 w-full bg-[#0F0F0F] text-white py-2 rounded-lg text-sm font-semibold hover:bg-black transition">Chi tiết</button>
                    </div>
                }
            </div>
        </section>

        <section class="bg-[#2563EB] text-white rounded-2xl p-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <p class="text-sm uppercase text-white/70">Ưu đãi tháng này</p>
                <h3 class="text-2xl font-semibold">Đổi máy cũ lấy máy mới - Trợ giá đến 3 triệu</h3>
            </div>
            <button class="px-4 py-2 rounded-xl border border-white text-sm font-semibold hover:bg-white hover:text-[#2563EB] transition">Tư vấn ngay</button>
        </section>

        <section class="space-y-3">
            <div class="flex items-center justify-between">
                <h2 class="text-xl font-semibold text-gray-900">Dịch vụ nổi bật</h2>
                <span class="text-xs text-gray-500">Trải nghiệm mua sắm chuẩn GuZone</span>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                @foreach (var service in HighlightServices)
                {
                    <div class="rounded-2xl border bg-white p-4 shadow-sm">
                        <div class="w-10 h-10 rounded-lg bg-gray-100 text-[#2563EB] flex items-center justify-center font-semibold mb-3">@service.Icon</div>
                        <h3 class="text-lg font-semibold text-gray-900">@service.Title</h3>
                        <p class="text-sm text-gray-600">@service.Description</p>
                    </div>
                }
            </div>
        </section>
    </div>

    <footer class="border-t border-gray-200 px-4 py-4 text-center text-xs text-gray-500">
        © @DateTime.Now.Year GuZone. Giữ chuẩn chất lượng và dịch vụ.
    </footer>
</div>

@code {
    private record QuickCategory(string Name, string Icon);

    private record FeaturedProduct(string Name, string Brand, string Price, string Image);

    private record HighlightService(string Title, string Description, string Icon);

    private List<QuickCategory> QuickCategories { get; } = new()
    {
        new("Apple", ""),
        new("Samsung", "S"),
        new("Xiaomi", "Mi"),
        new("Vivo", "V"),
        new("Oppo", "O")
    };

    private List<FeaturedProduct> FeaturedProducts { get; } = new()
    {
        new("iPhone 15 Pro Max 256GB", "Apple", "41.990.000đ", "https://via.placeholder.com/400x400?text=iPhone+15"),
        new("Galaxy S24 Ultra 12GB", "Samsung", "34.990.000đ", "https://via.placeholder.com/400x400?text=Galaxy+S24"),
        new("Xiaomi 14T Pro 12GB", "Xiaomi", "18.990.000đ", "https://via.placeholder.com/400x400?text=Xiaomi+14T"),
        new("Vivo X100 Pro 12GB", "Vivo", "24.990.000đ", "https://via.placeholder.com/400x400?text=Vivo+X100")
    };

    private List<HighlightService> HighlightServices { get; } = new()
    {
        new("Giao nhanh", "Nhận hàng trong 2h tại nội thành, miễn phí vận chuyển toàn quốc.", "⚡"),
        new("Bảo hành", "Đổi mới 30 ngày, hỗ trợ chính hãng tại hơn 200 trung tâm.", "🛡"),
        new("Thanh toán linh hoạt", "Trả góp 0% qua 25 ngân hàng và ví điện tử phổ biến.", "💳")
    };
}
