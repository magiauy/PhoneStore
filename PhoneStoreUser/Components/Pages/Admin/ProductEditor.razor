@page "/admin/products/create"
@page "/admin/products/edit/{Id:int}"
@layout AdminLayout
@using System
@using PhoneStoreUser.Components.Models
@using PhoneStoreUser.Data
@using PhoneStoreUser.Services
@using Microsoft.EntityFrameworkCore
@inject IProductService ProductService
@inject ICloudinaryService CloudinaryService
@inject NavigationManager NavigationManager
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject IJSRuntime JS

<div class="max-w-4xl mx-auto p-6 font-sans">
    <div class="mb-6 flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">@(Id == 0 ? "Thêm sản phẩm mới" : "Cập nhật sản phẩm")</h1>
            <p class="text-sm text-slate-500">Điền thông tin chi tiết cho sản phẩm.</p>
        </div>
        <a href="/admin/products" class="rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition">
            <i class="fa-solid fa-arrow-left mr-2"></i> Quay lại
        </a>
    </div>

    <EditForm Model="@Product" OnValidSubmit="HandleSave">
        <DataAnnotationsValidator />
        
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
            <div class="lg:col-span-2 space-y-6">
                <!-- General Info -->
                <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                    <h2 class="mb-4 text-base font-bold text-slate-900">Thông tin chung</h2>
                    <div class="space-y-4">
                        <div>
                            <label class="mb-1.5 block text-xs font-bold text-slate-700 uppercase tracking-wide">Tên sản phẩm <span class="text-red-500">*</span></label>
                            <InputText @bind-Value="Product.Name" class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" placeholder="Nhập tên sản phẩm" />
                            <ValidationMessage For="@(() => Product.Name)" class="text-xs text-red-500 mt-1" />
                        </div>
                        
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="mb-1.5 block text-xs font-bold text-slate-700 uppercase tracking-wide">SKU <span class="text-red-500">*</span></label>
                                <InputText @bind-Value="Product.Sku" class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm font-mono focus:border-blue-500 focus:ring-1 focus:ring-blue-500" placeholder="Mã SKU" />
                                <ValidationMessage For="@(() => Product.Sku)" class="text-xs text-red-500 mt-1" />
                            </div>
                            <div>
                                <label class="mb-1.5 block text-xs font-bold text-slate-700 uppercase tracking-wide">Model ID</label>
                                <InputNumber @bind-Value="Product.ModelId" class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" placeholder="ID Model" />
                            </div>
                        </div>

                        <div>
                            <label class="mb-1.5 block text-xs font-bold text-slate-700 uppercase tracking-wide">Trạng thái</label>
                            <InputSelect @bind-Value="Product.Status" class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
                                <option value="active">Đang bán</option>
                                <option value="inactive">Ngừng bán</option>
                                <option value="discontinued">Ngừng kinh doanh</option>
                            </InputSelect>
                        </div>
                    </div>
                </div>

                <!-- Pricing -->
                <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                    <h2 class="mb-4 text-base font-bold text-slate-900">Giá bán & Chi phí</h2>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="mb-1.5 block text-xs font-bold text-slate-700 uppercase tracking-wide">Giá bán</label>
                            <div class="relative">
                                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs">₫</span>
                                <InputNumber @bind-Value="Product.Price" class="w-full rounded-xl border border-slate-200 py-2.5 pl-6 pr-3 text-sm font-medium text-slate-900 focus:border-blue-500 focus:ring-1 focus:ring-blue-500" />
                            </div>
                        </div>
                        <div>
                            <label class="mb-1.5 block text-xs font-bold text-slate-700 uppercase tracking-wide">Giá vốn</label>
                            <div class="relative">
                                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs">₫</span>
                                <InputNumber @bind-Value="Product.Cost" class="w-full rounded-xl border border-slate-200 py-2.5 pl-6 pr-3 text-sm font-medium text-slate-900 focus:border-blue-500 focus:ring-1 focus:ring-blue-500" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="space-y-6">
                <!-- Organization -->
                <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                    <h2 class="mb-4 text-base font-bold text-slate-900">Phân loại</h2>
                    <div class="space-y-4">
                        <div>
                            <label class="mb-1.5 block text-xs font-bold text-slate-700 uppercase tracking-wide">Danh mục</label>
                            <InputSelect @bind-Value="Product.CategoryId" class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
                                <option value="0">-- Chọn danh mục --</option>
                                @foreach (var category in Categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div>
                            <label class="mb-1.5 block text-xs font-bold text-slate-700 uppercase tracking-wide">Thương hiệu</label>
                            <InputSelect @bind-Value="Product.BrandId" class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
                                <option value="">-- Chọn thương hiệu --</option>
                                @foreach (var brand in Brands)
                                {
                                    <option value="@brand.Id">@brand.Name</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                </div>

                <!-- Image Upload -->
                <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                    <h2 class="mb-4 text-base font-bold text-slate-900">Hinh anh</h2>
                    <div class="space-y-4">
                        @if (!string.IsNullOrEmpty(UploadedImageUrl))
                        {
                            <div class="relative rounded-xl overflow-hidden border border-slate-200 aspect-square">
                                <img src="@UploadedImageUrl" class="w-full h-full object-cover" @onerror="HandlePreviewImageError" />
                                <button type="button" @onclick="RemoveImage" class="absolute top-2 right-2 bg-white/80 hover:bg-white text-red-500 rounded-full p-1.5 shadow-sm transition">
                                    <i class="fa-solid fa-trash text-sm"></i>
                                </button>
                            </div>
                        }
                        else
                        {
                            @if (ImageLoadFailed)
                            {
                                <div class="text-xs text-red-500 text-center">Khong tim thay anh theo URL chuan. Vui long tai anh moi.</div>
                            }
                            <div class="flex items-center justify-center w-full">
                                <label for="dropzone-file" class="flex flex-col items-center justify-center w-full h-48 border-2 border-slate-300 border-dashed rounded-xl cursor-pointer bg-slate-50 hover:bg-slate-100 transition">
                                    <div class="flex flex-col items-center justify-center pt-5 pb-6">
                                        @if (IsUploading)
                                        {
                                            <i class="fa-solid fa-spinner fa-spin text-2xl text-slate-400 mb-3"></i>
                                            <p class="text-sm text-slate-500">Đang tải lê n...</p>
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-cloud-arrow-up text-2xl text-slate-400 mb-3"></i>
                                            <p class="mb-2 text-sm text-slate-500"><span class="font-semibold">Click to upload</span></p>
                                            <p class="text-xs text-slate-500">PNG, JPG (MAX. 10MB)</p>
                                        }
                                    </div>
                                    <InputFile OnChange="HandleImageUpload" class="hidden" id="dropzone-file" accept="image/*" />
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-6 flex items-center justify-end gap-3 border-t border-slate-200 pt-6">
            <a href="/admin/products" class="rounded-xl border border-slate-200 bg-white px-6 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition">Hủy bỏ</a>
            <button type="submit" disabled="@IsSaving" class="rounded-xl bg-blue-600 px-6 py-3 text-sm font-bold text-white shadow-sm hover:bg-blue-500 transition flex items-center gap-2 disabled:opacity-50">
                @if (IsSaving)
                {
                    <i class="fa-solid fa-spinner fa-spin"></i> <span>Đang lưu...</span>
                }
                else
                {
                    <span>@(Id == 0 ? "Tạo sản phẩm" : "Lưu thay đổi")</span>
                }
            </button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private ProductEntity Product = new() { Status = "active" };
    private List<CategoryEntity> Categories = new();
    private List<BrandEntity> Brands = new();
    private string? UploadedImageUrl;
    private bool IsUploading = false;
    private bool IsSaving = false;
    private bool ImageLoadFailed = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadMetadata();
        if (Id != 0)
        {
            var existing = await ProductService.GetProductByIdAsync(Id);
            if (existing != null)
            {
                Product = existing;
            }
        }

        var initialUrl = BuildCloudinaryImageUrl();
        UploadedImageUrl = string.IsNullOrEmpty(initialUrl) ? null : initialUrl;
        ImageLoadFailed = false;
    }

    private async Task LoadMetadata()
    {
        using var context = await DbContextFactory.CreateDbContextAsync();
        Categories = await context.Categories.ToListAsync();
        Brands = await context.Brands.ToListAsync();
    }

    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        if (Product.BrandId == null || string.IsNullOrWhiteSpace(Product.Sku) || string.IsNullOrWhiteSpace(Product.Name))
        {
            await JS.InvokeVoidAsync("alert", "Vui long chon Thuong hieu, nhap Ten san pham va SKU truoc khi tai anh.");
            return;
        }

        IsUploading = true;
        try
        {
            var file = e.File;

            var brandSegment = GetBrandSegment();
            if (brandSegment == null)
            {
                await JS.InvokeVoidAsync("alert", "Khong the xac dinh thuong hieu. Vui long thu lai.");
                return;
            }

            string slugSegment;
            if (Product.Model != null && !string.IsNullOrWhiteSpace(Product.Model.Slug))
            {
                slugSegment = Product.Model.Slug;
            }
            else
            {
                slugSegment = GenerateSlug(Product.Name);
                if (Product.Model == null)
                {
                    Product.Model = new ProductModelEntity
                    {
                        Name = Product.Name,
                        Slug = slugSegment,
                        CreatedAt = DateTime.UtcNow
                    };
                }
                else if (string.IsNullOrWhiteSpace(Product.Model.Slug))
                {
                    Product.Model.Slug = slugSegment;
                }
            }

            var skuSegment = Uri.EscapeDataString(Product.Sku.Trim());

            var folder = $"mobileguzone/{brandSegment}/{Uri.EscapeDataString(slugSegment)}";
            var publicId = skuSegment;

            var url = await CloudinaryService.UploadImageAsync(file, folder, publicId);
            if (!string.IsNullOrEmpty(url))
            {
                UploadedImageUrl = url;
                if (Product.Model != null)
                {
                    Product.Model.DefaultImageUrl = url;
                }
                ImageLoadFailed = false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Upload failed: {ex.Message}");
            await JS.InvokeVoidAsync("alert", $"Loi tai anh: {ex.Message}");
        }
        finally
        {
            IsUploading = false;
        }
    }

    private async Task RemoveImage()
    {
        if (string.IsNullOrEmpty(UploadedImageUrl)) return;

        if (!await JS.InvokeAsync<bool>("confirm", "Bạn có chắc chắn muốn xóa ảnh này không?"))
        {
            return;
        }

        // Extract publicId from URL
        // Example: https://res.cloudinary.com/cloudname/image/upload/v1234567890/mobileguzone/apple/iphone-15/sku123.webp
        // PublicId: mobileguzone/apple/iphone-15/sku123
        
        try 
        {
            var uri = new Uri(UploadedImageUrl);
            var pathSegments = uri.AbsolutePath.Split('/');
            // Find index of 'upload'
            var uploadIndex = Array.IndexOf(pathSegments, "upload");
            if (uploadIndex != -1 && uploadIndex + 2 < pathSegments.Length)
            {
                // Skip 'upload' and version (e.g., v1234567890)
                var publicIdSegments = pathSegments.Skip(uploadIndex + 2);
                var publicIdWithExtension = string.Join("/", publicIdSegments);
                var publicId = System.IO.Path.ChangeExtension(publicIdWithExtension, null);

                var success = await CloudinaryService.DeleteImageAsync(publicId);
                if (success)
                {
                    UploadedImageUrl = null;
                    ImageLoadFailed = false;
                    if (Product.Model != null)
                    {
                        Product.Model.DefaultImageUrl = null;
                    }
                }
                else
                {
                     await JS.InvokeVoidAsync("alert", "Không thể xóa ảnh trên Cloudinary.");
                }
            }
        }
        catch (Exception ex)
        {
             Console.WriteLine($"Delete failed: {ex.Message}");
             // Fallback: just clear from UI if parsing fails, but warn user
             UploadedImageUrl = null;
             ImageLoadFailed = false;
             if (Product.Model != null)
             {
                 Product.Model.DefaultImageUrl = null;
             }
        }
    }

    private string GenerateSlug(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return string.Empty;
        
        var str = name.ToLowerInvariant();
        // Simple slug generation: replace spaces with dashes, remove special chars
        str = System.Text.RegularExpressions.Regex.Replace(str, @"[^a-z0-9\s-]", "");
        str = System.Text.RegularExpressions.Regex.Replace(str, @"\s+", "-").Trim('-');
        return str;
    }

    private async Task HandleSave()
    {
        IsSaving = true;
        try
        {
            bool success;
            if (Id == 0)
            {
                success = await ProductService.CreateProductAsync(Product);
            }
            else
            {
                success = await ProductService.UpdateProductAsync(Product);
            }

            if (success)
            {
                NavigationManager.NavigateTo("/admin/products");
            }
            else
            {
                // Show error
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving product: {ex.Message}");
        }
        finally
        {
            IsSaving = false;
        }
    }

    private string? BuildCloudinaryImageUrl()
    {
        var brandName = Brands.FirstOrDefault(b => b.Id == Product.BrandId)?.Name ?? Product.Brand?.Name;
        var slug = Product.Model?.Slug;
        var sku = Product.Sku;

        if (string.IsNullOrWhiteSpace(brandName) || string.IsNullOrWhiteSpace(slug) || string.IsNullOrWhiteSpace(sku))
        {
            return null;
        }

        var brandSegment = Uri.EscapeDataString(brandName.Trim().ToLowerInvariant());
        var slugSegment = Uri.EscapeDataString(slug.Trim());
        var skuSegment = Uri.EscapeDataString(sku.Trim());

        return $"https://res.cloudinary.com/dstytmxfh/image/upload/v1763457477/mobileguzone/{brandSegment}/{slugSegment}/{skuSegment}.webp";
    }

    private string? GetBrandSegment()
    {
        var brandName = Brands.FirstOrDefault(b => b.Id == Product.BrandId)?.Name ?? Product.Brand?.Name;
        if (string.IsNullOrWhiteSpace(brandName))
        {
            return null;
        }

        return Uri.EscapeDataString(brandName.Trim().ToLowerInvariant());
    }

    private void HandlePreviewImageError()
    {
        if (ImageLoadFailed)
        {
            return;
        }

        ImageLoadFailed = true;
        UploadedImageUrl = null;
        StateHasChanged();
    }
}
