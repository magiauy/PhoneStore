@page "/admin/orders"
@layout AdminLayout

<div class="space-y-4">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-lg font-semibold text-gray-900">Quản lý đơn hàng</h1>
            <p class="text-sm text-gray-500">Theo dõi trạng thái và cập nhật giao hàng</p>
        </div>
        <div class="flex items-center gap-2">
            <select class="w-40 rounded-lg border border-gray-300 p-2 text-sm focus:ring-2 focus:ring-blue-500">
                <option>Toàn bộ kênh</option>
                <option>Online</option>
                <option>Showroom</option>
            </select>
            <button class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700 transition">Xuất CSV</button>
        </div>
    </div>

    <div class="flex flex-wrap gap-2">
        <button class="px-3 py-2 text-sm rounded-lg border border-blue-600 bg-blue-50 text-blue-700 font-semibold">Tất cả (124)</button>
        <button class="px-3 py-2 text-sm rounded-lg border border-gray-200 text-gray-700 hover:border-blue-600 hover:text-blue-600 transition">Chờ duyệt (18)</button>
        <button class="px-3 py-2 text-sm rounded-lg border border-gray-200 text-gray-700 hover:border-blue-600 hover:text-blue-600 transition">Đang giao (42)</button>
        <button class="px-3 py-2 text-sm rounded-lg border border-gray-200 text-gray-700 hover:border-blue-600 hover:text-blue-600 transition">Hoàn tất (57)</button>
        <button class="px-3 py-2 text-sm rounded-lg border border-gray-200 text-gray-700 hover:border-blue-600 hover:text-blue-600 transition">Đã hủy (7)</button>
    </div>

    <div class="overflow-x-auto rounded-xl border border-gray-200 bg-white shadow-sm">
        <table class="min-w-full text-sm">
            <thead class="bg-gray-50 text-gray-700 text-sm font-medium">
                <tr>
                    <th class="p-3 text-left">Mã</th>
                    <th class="p-3 text-left">Khách hàng</th>
                    <th class="p-3 text-left">Sản phẩm</th>
                    <th class="p-3 text-left">Tổng</th>
                    <th class="p-3 text-left">Trạng thái</th>
                    <th class="p-3 text-left">Thanh toán</th>
                    <th class="p-3 text-right">Ngày</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Orders)
                {
                    <tr class="border-b border-gray-200 hover:bg-gray-50">
                        <td class="p-3 font-semibold text-gray-900">#@order.Code</td>
                        <td class="p-3">@order.Customer</td>
                        <td class="p-3 text-gray-700">@order.Items</td>
                        <td class="p-3 text-blue-600 font-semibold">@order.Total</td>
                        <td class="p-3">
                            <span class="rounded-full bg-blue-600/10 text-blue-600 px-2.5 py-1 text-xs font-medium">@order.Status</span>
                        </td>
                        <td class="p-3 text-gray-700">@order.Payment</td>
                        <td class="p-3 text-right text-gray-500">@order.Date</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
        <section class="rounded-xl border bg-white p-4 shadow-sm space-y-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-base font-semibold text-gray-900">Xác nhận giao nhanh</h2>
                    <p class="text-sm text-gray-500">Cập nhật thông tin vận chuyển</p>
                </div>
                <span class="rounded-full bg-blue-600/10 px-3 py-1 text-xs font-semibold text-blue-600">4 đơn</span>
            </div>
            <div class="space-y-3">
                <div class="rounded-lg border border-gray-200 p-3">
                    <p class="text-sm font-semibold">#A1209 • Nguyễn Hải An</p>
                    <p class="text-xs text-gray-500">iPhone 15 Pro Max 256GB - Titan • COD</p>
                    <div class="mt-3 flex items-center gap-2">
                        <input class="w-full rounded-lg border border-gray-300 p-2 text-sm focus:ring-2 focus:ring-blue-500" placeholder="Ghi chú vận chuyển" />
                        <button class="rounded-lg bg-blue-600 px-3 py-2 text-sm font-semibold text-white hover:bg-blue-700 transition">Xác nhận</button>
                    </div>
                </div>
                <div class="rounded-lg border border-gray-200 p-3">
                    <p class="text-sm font-semibold">#A1211 • Trần Gia Bảo</p>
                    <p class="text-xs text-gray-500">Galaxy S24 Ultra • Chuyển khoản</p>
                    <div class="mt-3 flex items-center gap-2">
                        <input class="w-full rounded-lg border border-gray-300 p-2 text-sm focus:ring-2 focus:ring-blue-500" placeholder="Ghi chú giao hàng" />
                        <button class="rounded-lg bg-blue-600 px-3 py-2 text-sm font-semibold text-white hover:bg-blue-700 transition">Xác nhận</button>
                    </div>
                </div>
            </div>
        </section>

        <section class="rounded-xl border bg-white p-4 shadow-sm space-y-3">
            <div>
                <h2 class="text-base font-semibold text-gray-900">Tạo đơn thủ công</h2>
                <p class="text-sm text-gray-500">Nhập nhanh đơn showroom</p>
            </div>
            <div class="space-y-3">
                <div>
                    <label class="text-sm text-gray-600 font-medium mb-1 block">Khách hàng</label>
                    <input class="w-full rounded-lg border border-gray-300 p-2 text-sm focus:ring-2 focus:ring-blue-500" placeholder="Tên khách hoặc số điện thoại" />
                </div>
                <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                    <div>
                        <label class="text-sm text-gray-600 font-medium mb-1 block">Sản phẩm</label>
                        <input class="w-full rounded-lg border border-gray-300 p-2 text-sm focus:ring-2 focus:ring-blue-500" placeholder="VD: iPhone 15 Pro" />
                    </div>
                    <div>
                        <label class="text-sm text-gray-600 font-medium mb-1 block">Số lượng</label>
                        <input type="number" class="w-full rounded-lg border border-gray-300 p-2 text-sm focus:ring-2 focus:ring-blue-500" value="1" />
                    </div>
                </div>
                <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                    <div>
                        <label class="text-sm text-gray-600 font-medium mb-1 block">Tổng tiền</label>
                        <input class="w-full rounded-lg border border-gray-300 p-2 text-sm focus:ring-2 focus:ring-blue-500" placeholder="₫0" />
                    </div>
                    <div>
                        <label class="text-sm text-gray-600 font-medium mb-1 block">Trạng thái</label>
                        <select class="w-full rounded-lg border border-gray-300 p-2 text-sm focus:ring-2 focus:ring-blue-500">
                            <option>Chờ duyệt</option>
                            <option>Đang giao</option>
                            <option>Hoàn tất</option>
                        </select>
                    </div>
                </div>
                <button class="w-full rounded-lg bg-blue-600 py-2 text-sm font-semibold text-white hover:bg-blue-700 transition">Lưu đơn</button>
            </div>
        </section>
    </div>
</div>

@code {
    private List<OrderItem> Orders = new()
    {
        new("A1201", "Trương Minh Khải", "iPhone 15 PM 256GB", "₫18.990.000", "Chờ duyệt", "COD", "12/03"),
        new("A1203", "Lê Quốc Dũng", "MacBook Air M3", "₫32.990.000", "Đang giao", "Chuyển khoản", "12/03"),
        new("A1204", "Phạm Anh Khoa", "Galaxy S24 Ultra", "₫29.900.000", "Đang giao", "Đã thanh toán", "11/03"),
        new("A1205", "Nguyễn Hà Vy", "iPhone 14 128GB", "₫16.490.000", "Hoàn tất", "COD", "10/03"),
        new("A1207", "Bùi Thái Hòa", "iPad Air M2", "₫21.500.000", "Hoàn tất", "Chuyển khoản", "09/03"),
    };

    private record OrderItem(string Code, string Customer, string Items, string Total, string Status, string Payment, string Date);
}
