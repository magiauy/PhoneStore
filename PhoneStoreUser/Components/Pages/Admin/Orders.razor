@page "/admin/orders"
@using PhoneStoreUser.Components.Layout
@layout AdminLayout
@using System.Globalization
@using PhoneStoreUser.Services
@using PhoneStoreUser.Components.ViewModels
@inject IAdminOrderService AdminOrderService

<div class="flex h-[calc(100vh-10rem)] gap-6 bg-gray-50/50 p-6 font-sans">
    
    <div class="flex w-1/3 flex-col gap-4">
        <div class="flex flex-col gap-3">
            <h1 class="text-xl font-bold text-slate-900">Xử lý đơn hàng</h1>
            <div class="relative">
                <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                <input @bind="SearchTerm" @bind:event="oninput" @onkeyup="HandleSearch" class="w-full rounded-xl border border-slate-200 py-2.5 pl-9 pr-4 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 shadow-sm" placeholder="Tìm mã đơn, SĐT..." />
            </div>
            <div class="flex gap-2 overflow-x-auto pb-1 no-scrollbar">
                <button @onclick='() => FilterByStatus(null)' class="@GetFilterButtonClass(null)">Tất cả</button>
                <button @onclick='() => FilterByStatus("pending")' class="@GetFilterButtonClass("pending")">Cần xử lý</button>
                <button @onclick='() => FilterByStatus("delivering")' class="@GetFilterButtonClass("delivering")">Đang giao</button>
                <button @onclick='() => FilterByStatus("completed")' class="@GetFilterButtonClass("completed")">Hoàn tất</button>
            </div>
        </div>

        <div class="flex-1 overflow-y-auto pr-1 space-y-3">
            @if (IsLoading)
            {
                <div class="text-center text-slate-500 py-8">Đang tải...</div>
            }
            else if (!FilteredInvoices.Any())
            {
                <div class="text-center text-slate-500 py-8">Không có đơn hàng nào</div>
            }
            else
            {
                @foreach (var invoice in FilteredInvoices)
                {
                    bool isSelected = SelectedInvoice?.InvoiceId == invoice.InvoiceId;
                    <div @onclick="() => SelectInvoice(invoice)" 
                         class="cursor-pointer rounded-xl border p-4 transition-all duration-200 hover:shadow-md
                                @(isSelected ? "border-blue-500 bg-blue-50/50 ring-1 ring-blue-500" : "border-slate-200 bg-white hover:border-blue-300")">
                        
                        <div class="flex justify-between items-start mb-2">
                            <span class="font-mono text-sm font-bold text-slate-900">#@invoice.InvoiceCode</span>
                            <span class="text-[10px] text-slate-500">@invoice.InvoiceDate.ToString("dd/MM HH:mm")</span>
                        </div>
                        
                        <div class="mb-3">
                            <p class="text-sm font-medium text-slate-800">@invoice.CustomerName</p>
                            <div class="flex items-center gap-1 text-xs text-slate-500">
                                 @if(invoice.PaymentMethod == "bank") { <i class="fa-solid fa-credit-card text-blue-500"></i> }
                                 else { <i class="fa-solid fa-money-bill text-emerald-500"></i> }
                                 <span>@(invoice.PaymentMethod == "bank" ? "Chuyển khoản" : "COD")</span>
                            </div>
                        </div>

                        <div class="flex items-center justify-between border-t border-slate-100 pt-3">
                            @{ var statusStyle = GetStatusStyle(invoice.Status); }
                            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-medium @statusStyle.Class">
                                <i class="@statusStyle.Icon mr-1"></i> @GetStatusLabel(invoice.Status)
                            </span>
                            <span class="text-sm font-bold text-slate-900">@FormatCurrency(invoice.Total)</span>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <div class="flex flex-1 flex-col rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
        @if (SelectedInvoiceDetail != null)
        {
            bool isReadOnly = SelectedInvoiceDetail.Status == "completed" || SelectedInvoiceDetail.Status == "cancelled" || SelectedInvoiceDetail.Status == "refunded";

            <div class="border-b border-slate-100 bg-slate-50/50 px-6 py-4 flex justify-between items-center">
                <div>
                    <div class="flex items-center gap-3">
                        <h2 class="text-lg font-bold text-slate-900">Đơn hàng #@SelectedInvoiceDetail.InvoiceCode</h2>
                        @if(!string.IsNullOrEmpty(SelectedInvoiceDetail.PromoCode))
                        {
                            <span class="inline-flex items-center gap-1 rounded-md bg-rose-50 px-2 py-1 text-xs font-medium text-rose-600 border border-rose-100">
                                <i class="fa-solid fa-tag"></i> @SelectedInvoiceDetail.PromoCode
                            </span>
                        }
                    </div>
                    <div class="flex gap-4 mt-1 text-xs text-slate-500">
                         <span class="flex items-center gap-1"><i class="fa-solid fa-user-tie"></i> @SelectedInvoiceDetail.CreatedBy</span>
                         <span class="flex items-center gap-1"><i class="fa-regular fa-clock"></i> @SelectedInvoiceDetail.InvoiceDate.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                </div>
                <div class="flex gap-2">
                     <button class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50 transition">
                        <i class="fa-solid fa-print"></i> In phiếu
                    </button>
                    @if (!isReadOnly)
                    {
                        <button @onclick="HandleCancelOrder" class="rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-sm font-medium text-rose-600 hover:bg-rose-100 transition">
                            Hủy đơn
                        </button>
                    }
                </div>
            </div>

            <div class="flex-1 overflow-y-auto p-6">
                @if (SelectedInvoiceDetail.Status == "paid")
                {
                    <div class="mb-4 flex items-center gap-3 rounded-lg border border-blue-100 bg-blue-50 p-3 text-blue-700">
                        <i class="fa-solid fa-circle-info text-xl"></i>
                        <div>
                            <p class="text-sm font-bold">Đã thanh toán - Cần xuất kho</p>
                            <p class="text-xs text-blue-600">Khách đã thanh toán online. Vui lòng nhập Serial/IMEI (nếu có) và xác nhận giao hàng.</p>
                        </div>
                    </div>
                }

                <table class="w-full text-left text-sm text-slate-600 mb-6">
                    <thead class="bg-slate-50 text-xs uppercase font-semibold text-slate-500">
                        <tr>
                            <th class="px-3 py-3 rounded-l-lg">Sản phẩm</th>
                            <th class="px-3 py-3 text-center">SL</th>
                            <th class="px-3 py-3 text-right">Đơn giá</th>
                            <th class="px-3 py-3 text-right">Giảm</th>
                            <th class="px-3 py-3 text-right rounded-r-lg">Tổng</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var line in SelectedInvoiceDetail.Lines)
                        {
                            <tr>
                                <td class="px-3 py-4 align-top">
                                    <p class="font-medium text-slate-900">@line.ProductName</p>
                                    @if (line.HasSerial)
                                    {
                                        <div class="mt-2 p-3 bg-amber-50 rounded-lg border border-amber-100">
                                            <div class="flex justify-between items-center mb-2">
                                                <label class="text-[10px] font-bold text-amber-700 uppercase flex items-center gap-1">
                                                    <i class="fa-solid fa-barcode"></i> Serial / IMEI
                                                </label>
                                                @if(isReadOnly) {
                                                    <span class="text-[10px] text-amber-600 font-medium"><i class="fa-solid fa-lock"></i> Đã khóa</span>
                                                }
                                            </div>
                                            <div class="space-y-2">
                                                @for (int i = 0; i < line.Quantity; i++)
                                                {
                                                    int index = i;
                                                    string existingSerial = line.Serials.Count > i ? line.Serials[i] : "";
                                                    string serialKey = $"{line.LineId}_{i}";
                                                    <input disabled="@isReadOnly"
                                                           value="@GetSerialInput(serialKey, existingSerial)"
                                                           @onchange='e => HandleSerialInput(line.LineId, serialKey, e.Value?.ToString() ?? "")'
                                                           class="w-full rounded border bg-white px-2 py-1.5 text-xs font-mono text-slate-700 placeholder:text-slate-400
                                                            @(isReadOnly ? "border-slate-200 bg-slate-50 text-slate-500" : "border-amber-300 focus:border-amber-500 focus:ring-1 focus:ring-amber-500")"
                                                           placeholder="Nhập Serial #@(i + 1)..." />
                                                }
                                            </div>
                                        </div>
                                    }
                                </td>
                                <td class="px-3 py-4 text-center align-top">x@(line.Quantity)</td>
                                <td class="px-3 py-4 text-right align-top">@FormatCurrency(line.UnitPrice)</td>
                                <td class="px-3 py-4 text-right align-top text-rose-500">
                                    @(line.DiscountPct > 0 ? $"-{line.DiscountPct}%" : "-")
                                </td>
                                <td class="px-3 py-4 text-right font-medium text-slate-900 align-top">@FormatCurrency(line.TotalPrice)</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="flex justify-end border-t border-slate-100 pt-4">
                    <div class="w-72 space-y-2">
                        <div class="flex justify-between text-sm text-slate-500">
                            <span>Thành tiền:</span>
                            <span>@FormatCurrency(SelectedInvoiceDetail.Subtotal)</span>
                        </div>
                         <div class="flex justify-between text-sm text-rose-500">
                            <span>Giảm giá:</span>
                            <span>-@FormatCurrency(SelectedInvoiceDetail.DiscountAmount)</span>
                        </div>
                        <div class="flex justify-between border-t border-dashed border-slate-200 pt-2 text-lg font-bold text-slate-900">
                            <span>Tổng thanh toán:</span>
                            <span class="text-blue-600">@FormatCurrency(SelectedInvoiceDetail.GrandTotal)</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="border-t border-slate-200 bg-white p-4">
                 <div class="flex items-center justify-between">
                     <div class="flex flex-col">
                         <span class="text-xs text-slate-500">Trạng thái hiện tại</span>
                         <div class="flex items-center gap-2">
                             @{ var currentStyle = GetStatusStyle(SelectedInvoiceDetail.Status); }
                             <i class="@currentStyle.Icon @currentStyle.TextClass"></i>
                             <span class="font-bold text-sm text-slate-900">@GetStatusLabel(SelectedInvoiceDetail.Status)</span>
                         </div>
                     </div>

                     <div class="flex gap-3">
                         @if (SelectedInvoiceDetail.Status == "pending" || SelectedInvoiceDetail.Status == "paid")
                         {
                             <button @onclick="HandleConfirmDelivery" class="rounded-xl bg-blue-600 px-6 py-2.5 text-sm font-bold text-white shadow-lg shadow-blue-200 hover:bg-blue-700 transition">
                                 <i class="fa-solid fa-truck-fast"></i> Xác nhận & Giao hàng
                             </button>
                         }
                         else if (SelectedInvoiceDetail.Status == "delivering")
                         {
                              <button @onclick="HandleCompleteOrder" class="rounded-xl bg-emerald-600 px-6 py-2.5 text-sm font-bold text-white shadow-lg shadow-emerald-200 hover:bg-emerald-700 transition">
                                 <i class="fa-solid fa-check-double"></i> Xác nhận Hoàn tất
                             </button>
                         }
                         else if (SelectedInvoiceDetail.Status == "completed")
                         {
                             <span class="flex items-center gap-2 text-emerald-600 font-medium px-4 py-2 bg-emerald-50 rounded-lg border border-emerald-100">
                                 <i class="fa-solid fa-circle-check"></i> Đơn hàng đã hoàn thành
                             </span>
                         }
                     </div>
                 </div>
            </div>
        }
        else if (IsLoading)
        {
            <div class="flex items-center justify-center h-full">
                <div class="text-slate-500">Đang tải chi tiết...</div>
            </div>
        }
        else
        {
            <div class="flex items-center justify-center h-full">
                <div class="text-slate-500">Chọn đơn hàng để xem chi tiết</div>
            </div>
        }
    </div>
</div>

@code {
    private List<AdminOrderDto> Invoices = new();
    private List<AdminOrderDto> FilteredInvoices = new();
    private AdminOrderDto? SelectedInvoice;
    private AdminOrderDetailDto? SelectedInvoiceDetail;
    private string? CurrentStatusFilter = null;
    private string SearchTerm = "";
    private bool IsLoading = true;
    private Dictionary<string, string> SerialInputs = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        IsLoading = true;
        StateHasChanged();

        Invoices = await AdminOrderService.GetPendingOrdersAsync(CurrentStatusFilter);
        FilteredInvoices = Invoices;
        
        if (SelectedInvoice != null)
        {
            // Reload selected invoice if it still exists
            SelectedInvoice = Invoices.FirstOrDefault(i => i.InvoiceId == SelectedInvoice.InvoiceId);
            if (SelectedInvoice != null)
            {
                await LoadOrderDetail(SelectedInvoice.InvoiceId);
            }
        }

        IsLoading = false;
        StateHasChanged();
    }

    private async Task SelectInvoice(AdminOrderDto invoice)
    {
        SelectedInvoice = invoice;
        await LoadOrderDetail(invoice.InvoiceId);
    }

    private async Task LoadOrderDetail(int invoiceId)
    {
        IsLoading = true;
        StateHasChanged();

        SelectedInvoiceDetail = await AdminOrderService.GetOrderDetailAsync(invoiceId);
        SerialInputs.Clear(); // Clear previous serial inputs

        IsLoading = false;
        StateHasChanged();
    }

    private async Task FilterByStatus(string? status)
    {
        CurrentStatusFilter = status;
        await LoadOrders();
    }

    private void HandleSearch()
    {
        if (string.IsNullOrWhiteSpace(SearchTerm))
        {
            FilteredInvoices = Invoices;
        }
        else
        {
            FilteredInvoices = Invoices.Where(i =>
                i.InvoiceCode.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ||
                i.CustomerName.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ||
                (i.CustomerPhone != null && i.CustomerPhone.Contains(SearchTerm))
            ).ToList();
        }
    }

    private string GetFilterButtonClass(string? status)
    {
        return CurrentStatusFilter == status
            ? "whitespace-nowrap rounded-lg bg-slate-900 px-3 py-1.5 text-xs font-medium text-white shadow-sm"
            : "whitespace-nowrap rounded-lg bg-white border border-slate-200 px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-50";
    }

    private string GetSerialInput(string key, string existingSerial)
    {
        return string.IsNullOrWhiteSpace(existingSerial) && SerialInputs.ContainsKey(key) 
            ? SerialInputs[key] 
            : existingSerial;
    }

    private void HandleSerialInput(int lineId, string key, string value)
    {
        SerialInputs[key] = value;
    }

    private async Task HandleConfirmDelivery()
    {
        if (SelectedInvoiceDetail == null) return;

        try
        {
            // Save all pending serials
            await SavePendingSerials();

            // Update status to delivering
            await AdminOrderService.UpdateOrderStatusAsync(SelectedInvoiceDetail.InvoiceId, "delivering");

            // Reload orders
            await LoadOrders();
        }
        catch (Exception ex)
        {
            // TODO: Show error message to user
            Console.WriteLine($"Error confirming delivery: {ex.Message}");
        }
    }

    private async Task HandleCompleteOrder()
    {
        if (SelectedInvoiceDetail == null) return;

        try
        {
            await AdminOrderService.UpdateOrderStatusAsync(SelectedInvoiceDetail.InvoiceId, "completed");
            await LoadOrders();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error completing order: {ex.Message}");
        }
    }

    private async Task HandleCancelOrder()
    {
        if (SelectedInvoiceDetail == null) return;

        // TODO: Show dialog to get cancellation reason
        string reason = "Admin cancelled";

        try
        {
            await AdminOrderService.CancelOrderAsync(SelectedInvoiceDetail.InvoiceId, reason);
            await LoadOrders();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cancelling order: {ex.Message}");
        }
    }

    private async Task SavePendingSerials()
    {
        if (SelectedInvoiceDetail == null) return;

        foreach (var line in SelectedInvoiceDetail.Lines.Where(l => l.HasSerial))
        {
            for (int i = 0; i < line.Quantity; i++)
            {
                string serialKey = $"{line.LineId}_{i}";
                if (SerialInputs.TryGetValue(serialKey, out var serial) && !string.IsNullOrWhiteSpace(serial))
                {
                    try
                    {
                        await AdminOrderService.AddSerialToOrderLineAsync(line.LineId, serial, null, null);
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Error adding serial: {ex.Message}");
                        // Continue with other serials
                    }
                }
            }
        }
    }

    private string FormatCurrency(decimal value) => string.Format(new CultureInfo("vi-VN"), "{0:C0}", value);

    private string GetStatusLabel(string status) => status switch {
        "unpaid" => "Chưa thanh toán",
        "pending" => "Chờ duyệt (COD)",
        "paid" => "Đã thanh toán",
        "delivering" => "Đang giao hàng",
        "completed" => "Hoàn tất",
        "cancelled" => "Đã hủy",
        "refunded" => "Đã hoàn tiền",
        _ => status
    };

    private (string Class, string TextClass, string Icon) GetStatusStyle(string status) => status switch {
        "unpaid" => ("bg-slate-100 text-slate-600", "text-slate-600", "fa-solid fa-circle-notch"),
        "pending" => ("bg-amber-50 text-amber-600 border border-amber-100", "text-amber-600", "fa-solid fa-clock"),
        "paid" => ("bg-cyan-50 text-cyan-700 border border-cyan-100", "text-cyan-700", "fa-solid fa-circle-dollar-to-slot"),
        "delivering" => ("bg-blue-50 text-blue-600 border border-blue-100", "text-blue-600", "fa-solid fa-truck-fast"),
        "completed" => ("bg-emerald-50 text-emerald-600 border border-emerald-100", "text-emerald-600", "fa-solid fa-check-double"),
        "cancelled" => ("bg-rose-50 text-rose-600 border border-rose-100", "text-rose-600", "fa-solid fa-ban"),
        _ => ("bg-gray-50 text-gray-600", "text-gray-600", "fa-solid fa-circle")
    };
}