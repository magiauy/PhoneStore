@page "/admin/dashboard"
@layout AdminLayout
@using PhoneStoreUser.Services
@using PhoneStoreUser.Components.ViewModels
@inject IDashboardService DashboardService

<div class="space-y-6 bg-gray-50/50 p-6 min-h-screen font-sans">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Dashboard</h1>
            <p class="text-slate-500 text-sm">Tổng quan hiệu suất kinh doanh.</p>
        </div>
        <div class="flex gap-2 items-center">
            <!-- Month Picker -->
            <div class="flex items-center gap-2 bg-white border border-slate-200 rounded-lg px-3 py-2 shadow-sm">
                <i class="fa-solid fa-calendar text-slate-400"></i>
                <select @bind="SelectedMonth" @bind:after="OnMonthChanged" class="bg-transparent text-sm font-medium text-slate-700 focus:outline-none cursor-pointer">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m">Tháng @m</option>
                    }
                </select>
                <select @bind="SelectedYear" @bind:after="OnMonthChanged" class="bg-transparent text-sm font-medium text-slate-700 focus:outline-none cursor-pointer">
                    @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 5; y--)
                    {
                        <option value="@y">@y</option>
                    }
                </select>
            </div>
            <button class="px-4 py-2 bg-white border border-slate-200 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-50 shadow-sm transition">
                <i class="fa-solid fa-download mr-2"></i>Xuất báo cáo
            </button>
            <button class="px-4 py-2 bg-slate-900 rounded-lg text-sm font-medium text-white hover:bg-slate-800 shadow-sm transition">
                <i class="fa-solid fa-plus mr-2"></i>Tạo đơn mới
            </button>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="flex items-center justify-center py-12">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
            <span class="ml-3 text-slate-500">Đang tải dữ liệu...</span>
        </div>
    }
    else
    {
        <!-- Statistics Cards -->
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <div class="relative overflow-hidden rounded-2xl bg-white p-5 shadow-sm border border-slate-100 group hover:shadow-md transition-all duration-300">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-sm font-medium text-slate-500">Doanh thu tháng</p>
                        <h3 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 tabular-nums">@FormatCurrency(MonthlyStats?.TotalRevenue ?? 0)</h3>
                    </div>
                    <div class="bg-emerald-100 text-emerald-600 flex h-10 w-10 items-center justify-center rounded-xl transition-transform group-hover:scale-110">
                        <i class="fa-solid fa-chart-line text-lg"></i>
                    </div>
                </div>
                <div class="mt-4 flex items-center text-xs">
                    @{
                        var revenueGrowth = MonthlyStats?.RevenueGrowthPercent ?? 0;
                        var revenuePositive = revenueGrowth >= 0;
                    }
                    <span class="@(revenuePositive ? "text-emerald-600 bg-emerald-50" : "text-rose-600 bg-rose-50") inline-flex items-center rounded-md px-2 py-1 font-medium ring-1 ring-inset ring-opacity-20">
                        @if (revenuePositive)
                        {
                            <i class="fa-solid fa-arrow-up mr-1 text-[10px]"></i>
                        }
                        else
                        {
                            <i class="fa-solid fa-arrow-down mr-1 text-[10px]"></i>
                        }
                        @Math.Abs(revenueGrowth).ToString("F1")%
                    </span>
                    <span class="ml-2 text-slate-400">so với tháng trước</span>
                </div>
            </div>

            <div class="relative overflow-hidden rounded-2xl bg-white p-5 shadow-sm border border-slate-100 group hover:shadow-md transition-all duration-300">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-sm font-medium text-slate-500">Tổng đơn hàng</p>
                        <h3 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 tabular-nums">@(MonthlyStats?.TotalOrders ?? 0)</h3>
                    </div>
                    <div class="bg-blue-100 text-blue-600 flex h-10 w-10 items-center justify-center rounded-xl transition-transform group-hover:scale-110">
                        <i class="fa-solid fa-bag-shopping text-lg"></i>
                    </div>
                </div>
                <div class="mt-4 flex items-center text-xs">
                    @{
                        var orderGrowth = MonthlyStats?.OrderGrowthPercent ?? 0;
                        var orderPositive = orderGrowth >= 0;
                    }
                    <span class="@(orderPositive ? "text-emerald-600 bg-emerald-50" : "text-rose-600 bg-rose-50") inline-flex items-center rounded-md px-2 py-1 font-medium ring-1 ring-inset ring-opacity-20">
                        @if (orderPositive)
                        {
                            <i class="fa-solid fa-arrow-up mr-1 text-[10px]"></i>
                        }
                        else
                        {
                            <i class="fa-solid fa-arrow-down mr-1 text-[10px]"></i>
                        }
                        @Math.Abs(orderGrowth)%
                    </span>
                    <span class="ml-2 text-slate-400">so với tháng trước</span>
                </div>
            </div>

            <div class="relative overflow-hidden rounded-2xl bg-white p-5 shadow-sm border border-slate-100 group hover:shadow-md transition-all duration-300">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-sm font-medium text-slate-500">Khách hàng mới</p>
                        <h3 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 tabular-nums">@(MonthlyStats?.NewCustomers ?? 0)</h3>
                    </div>
                    <div class="bg-violet-100 text-violet-600 flex h-10 w-10 items-center justify-center rounded-xl transition-transform group-hover:scale-110">
                        <i class="fa-solid fa-users text-lg"></i>
                    </div>
                </div>
                <div class="mt-4 flex items-center text-xs">
                    <span class="text-slate-400">Trong tháng @SelectedMonth/@SelectedYear</span>
                </div>
            </div>

            <div class="relative overflow-hidden rounded-2xl bg-white p-5 shadow-sm border border-slate-100 group hover:shadow-md transition-all duration-300">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-sm font-medium text-slate-500">Giá trị TB/đơn</p>
                        <h3 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 tabular-nums">@FormatCurrency(AverageOrderValue)</h3>
                    </div>
                    <div class="bg-amber-100 text-amber-600 flex h-10 w-10 items-center justify-center rounded-xl transition-transform group-hover:scale-110">
                        <i class="fa-solid fa-calculator text-lg"></i>
                    </div>
                </div>
                <div class="mt-4 flex items-center text-xs">
                    <span class="text-slate-400">Trung bình mỗi đơn hàng</span>
                </div>
            </div>
        </div>

        <!-- Top Products and Top Customers -->
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
            <!-- Top 10 Products -->
            <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                <div class="flex items-center justify-between p-5 border-b border-slate-100">
                    <div class="flex gap-2 items-center">
                        <div class="h-8 w-1 bg-emerald-600 rounded-full"></div>
                        <div>
                            <h2 class="text-base font-semibold text-slate-900">Top 10 Sản phẩm bán chạy</h2>
                            <p class="text-xs text-slate-500">Tháng @SelectedMonth/@SelectedYear</p>
                        </div>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    @if (TopProducts.Count == 0)
                    {
                        <div class="p-8 text-center text-slate-500">
                            <i class="fa-solid fa-box-open text-3xl mb-2"></i>
                            <p>Không có dữ liệu sản phẩm</p>
                        </div>
                    }
                    else
                    {
                        <table class="w-full text-left text-sm text-slate-600">
                            <thead class="bg-slate-50/50 text-xs uppercase font-semibold text-slate-500">
                                <tr>
                                    <th class="px-5 py-3">#</th>
                                    <th class="px-5 py-3">Sản phẩm</th>
                                    <th class="px-5 py-3 text-right">SL bán</th>
                                    <th class="px-5 py-3 text-right">Doanh thu</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @{ var productIndex = 0; }
                                @foreach (var product in TopProducts)
                                {
                                    productIndex++;
                                    <tr class="hover:bg-slate-50/80 transition-colors">
                                        <td class="px-5 py-3">
                                            @if (productIndex <= 3)
                                            {
                                                <span class="@GetRankBadgeClass(productIndex) inline-flex items-center justify-center w-6 h-6 rounded-full text-xs font-bold">
                                                    @productIndex
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-slate-400">@productIndex</span>
                                            }
                                        </td>
                                        <td class="px-5 py-3 font-medium text-slate-800 max-w-[200px] truncate" title="@product.ProductName">
                                            @product.ProductName
                                        </td>
                                        <td class="px-5 py-3 text-right font-semibold text-slate-700 tabular-nums">
                                            @product.QuantitySold
                                        </td>
                                        <td class="px-5 py-3 text-right font-semibold text-emerald-600 tabular-nums">
                                            @FormatCurrency(product.TotalRevenue)
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>

            <!-- Top 10 Customers -->
            <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                <div class="flex items-center justify-between p-5 border-b border-slate-100">
                    <div class="flex gap-2 items-center">
                        <div class="h-8 w-1 bg-blue-600 rounded-full"></div>
                        <div>
                            <h2 class="text-base font-semibold text-slate-900">Top 10 Khách hàng</h2>
                            <p class="text-xs text-slate-500">Tháng @SelectedMonth/@SelectedYear</p>
                        </div>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    @if (TopCustomers.Count == 0)
                    {
                        <div class="p-8 text-center text-slate-500">
                            <i class="fa-solid fa-users text-3xl mb-2"></i>
                            <p>Không có dữ liệu khách hàng</p>
                        </div>
                    }
                    else
                    {
                        <table class="w-full text-left text-sm text-slate-600">
                            <thead class="bg-slate-50/50 text-xs uppercase font-semibold text-slate-500">
                                <tr>
                                    <th class="px-5 py-3">#</th>
                                    <th class="px-5 py-3">Khách hàng</th>
                                    <th class="px-5 py-3 text-right">Số đơn</th>
                                    <th class="px-5 py-3 text-right">Tổng mua</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @{ var customerIndex = 0; }
                                @foreach (var customer in TopCustomers)
                                {
                                    customerIndex++;
                                    <tr class="hover:bg-slate-50/80 transition-colors">
                                        <td class="px-5 py-3">
                                            @if (customerIndex <= 3)
                                            {
                                                <span class="@GetRankBadgeClass(customerIndex) inline-flex items-center justify-center w-6 h-6 rounded-full text-xs font-bold">
                                                    @customerIndex
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-slate-400">@customerIndex</span>
                                            }
                                        </td>
                                        <td class="px-5 py-3">
                                            <div class="flex items-center gap-3">
                                                <div class="h-8 w-8 rounded-full bg-slate-100 flex items-center justify-center text-xs font-bold text-slate-500 ring-2 ring-white">
                                                    @(string.IsNullOrEmpty(customer.CustomerName) ? "?" : customer.CustomerName.Substring(0, 1).ToUpper())
                                                </div>
                                                <span class="font-medium text-slate-700 max-w-[150px] truncate" title="@customer.CustomerName">
                                                    @customer.CustomerName
                                                </span>
                                            </div>
                                        </td>
                                        <td class="px-5 py-3 text-right font-semibold text-slate-700 tabular-nums">
                                            @customer.OrderCount
                                        </td>
                                        <td class="px-5 py-3 text-right font-semibold text-blue-600 tabular-nums">
                                            @FormatCurrency(customer.TotalPurchaseValue)
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private int SelectedMonth { get; set; } = DateTime.Now.Month;
    private int SelectedYear { get; set; } = DateTime.Now.Year;
    private bool IsLoading { get; set; } = true;

    private MonthlyStatistics? MonthlyStats { get; set; }
    private List<TopProductDto> TopProducts { get; set; } = new();
    private List<TopCustomerDto> TopCustomers { get; set; } = new();

    private decimal AverageOrderValue => MonthlyStats?.TotalOrders > 0
        ? MonthlyStats.TotalRevenue / MonthlyStats.TotalOrders
        : 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardDataAsync();
    }

    private async Task OnMonthChanged()
    {
        await LoadDashboardDataAsync();
    }

    private async Task LoadDashboardDataAsync()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            var statsTask = DashboardService.GetMonthlyStatisticsAsync(SelectedYear, SelectedMonth);
            var productsTask = DashboardService.GetTopSellingProductsAsync(SelectedYear, SelectedMonth, 10);
            var customersTask = DashboardService.GetTopCustomersAsync(SelectedYear, SelectedMonth, 10);

            await Task.WhenAll(statsTask, productsTask, customersTask);

            MonthlyStats = await statsTask;
            TopProducts = await productsTask;
            TopCustomers = await customersTask;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard data: {ex.Message}");
            MonthlyStats = new MonthlyStatistics(0, 0, 0, 0, 0);
            TopProducts = new();
            TopCustomers = new();
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private string FormatCurrency(decimal amount)
    {
        if (amount >= 1_000_000_000)
            return $"₫{amount / 1_000_000_000:F1}B";
        if (amount >= 1_000_000)
            return $"₫{amount / 1_000_000:F1}M";
        if (amount >= 1_000)
            return $"₫{amount / 1_000:F0}K";
        return $"₫{amount:N0}";
    }

    private string GetRankBadgeClass(int rank) => rank switch
    {
        1 => "bg-amber-400 text-white",
        2 => "bg-slate-400 text-white",
        3 => "bg-amber-600 text-white",
        _ => "bg-slate-100 text-slate-600"
    };
}
