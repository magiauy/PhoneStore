@page "/admin"
@layout AdminLayout

<div class="space-y-4">
    <div class="grid grid-cols-1 gap-3 md:grid-cols-4">
        @foreach (var stat in Stats)
        {
            <article class="rounded-xl border bg-white p-3 shadow-sm hover:shadow-md transition">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs text-gray-500">@stat.Label</p>
                        <h3 class="text-xl font-semibold text-gray-900">@stat.Value</h3>
                    </div>
                    <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-600/10 text-blue-600">
                        <i class="@stat.Icon"></i>
                    </span>
                </div>
                <p class="mt-2 text-xs text-gray-500">@stat.Description</p>
            </article>
        }
    </div>

    <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
        <section class="lg:col-span-2 rounded-xl border bg-white p-4 shadow-sm">
            <div class="flex items-center justify-between mb-3">
                <div>
                    <h2 class="text-lg font-semibold text-gray-900">Đơn hàng mới</h2>
                    <p class="text-sm text-gray-500">Theo dõi các đơn chờ xác nhận</p>
                </div>
                <button class="px-3 py-2 text-sm rounded-lg border border-gray-200 hover:border-blue-600 hover:text-blue-600 transition">Xem tất cả</button>
            </div>
            <div class="overflow-x-auto">
                <table class="min-w-full text-sm">
                    <thead class="bg-gray-50 text-gray-700 text-sm font-medium">
                        <tr>
                            <th class="p-3 text-left">Mã đơn</th>
                            <th class="p-3 text-left">Khách hàng</th>
                            <th class="p-3 text-left">Giá trị</th>
                            <th class="p-3 text-left">Trạng thái</th>
                            <th class="p-3 text-right">Ngày</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in LatestOrders)
                        {
                            <tr class="border-b border-gray-200 hover:bg-gray-50">
                                <td class="p-3 font-semibold text-gray-900">#@order.Code</td>
                                <td class="p-3">@order.Customer</td>
                                <td class="p-3 text-blue-600 font-semibold">@order.Total</td>
                                <td class="p-3">
                                    <span class="rounded-full bg-blue-600/10 text-blue-600 px-2.5 py-1 text-xs font-medium">@order.Status</span>
                                </td>
                                <td class="p-3 text-right text-gray-500">@order.Date</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="rounded-xl border bg-white p-4 shadow-sm space-y-3">
            <div>
                <h2 class="text-lg font-semibold text-gray-900">Nhiệm vụ nhanh</h2>
                <p class="text-sm text-gray-500">Tác vụ ưu tiên trong ngày</p>
            </div>
            <div class="space-y-2">
                @foreach (var task in QuickActions)
                {
                    <div class="flex items-center justify-between rounded-lg border border-gray-200 px-3 py-2 hover:border-blue-600 transition">
                        <div>
                            <p class="text-sm font-medium text-gray-900">@task.Title</p>
                            <p class="text-xs text-gray-500">@task.Note</p>
                        </div>
                        <span class="text-xs rounded-full bg-gray-100 px-2 py-1 text-gray-600">@task.Priority</span>
                    </div>
                }
            </div>
            <button class="w-full rounded-lg bg-blue-600 text-white py-2 text-sm font-semibold hover:bg-blue-700 transition">Tạo nhiệm vụ</button>
        </section>
    </div>
</div>

@code {
    private List<StatItem> Stats = new()
    {
        new("Doanh thu hôm nay", "₫125.5M", "fa-solid fa-wave-square", "+18% so với hôm qua"),
        new("Đơn hàng", "76", "fa-solid fa-receipt", "12 đơn đang chờ xử lý"),
        new("Hủy trả", "3", "fa-solid fa-rotate-left", "Cần xác minh nguyên nhân"),
        new("Khách mới", "22", "fa-solid fa-user-plus", "Đăng ký qua landing page"),
    };

    private List<LatestOrder> LatestOrders = new()
    {
        new("A1201", "Trương Minh Khải", "₫18.990.000", "Chờ duyệt", "12/03"),
        new("A1202", "Nguyễn Hà Vy", "₫24.500.000", "Chờ duyệt", "12/03"),
        new("A1203", "Lê Quốc Dũng", "₫32.990.000", "Xác nhận", "12/03"),
        new("A1204", "Phạm Anh Khoa", "₫9.200.000", "Chờ duyệt", "11/03"),
    };

    private List<QuickAction> QuickActions = new()
    {
        new("Gửi email ưu đãi 3.3", "Danh sách khách VIP", "Cao"),
        new("Kiểm tra tồn kho iPhone 15PM", "Kho chi nhánh Q1", "Trung bình"),
        new("Cập nhật banner trang chủ", "Ra mắt Galaxy mới", "Cao"),
        new("Rà soát đơn COD", "Xác nhận khu vực ngoại thành", "Thấp"),
    };

    private record StatItem(string Label, string Value, string Icon, string Description);
    private record LatestOrder(string Code, string Customer, string Total, string Status, string Date);
    private record QuickAction(string Title, string Note, string Priority);
}
