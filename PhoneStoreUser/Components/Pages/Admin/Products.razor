@page "/admin/products"
@layout AdminLayout
@using System
@using PhoneStoreUser.Components.Models
@using PhoneStoreUser.Data
@using PhoneStoreUser.Services
@using PhoneStoreUser.Components.ViewModels
@inject IProductService ProductService
@inject NavigationManager NavigationManager

<div class="space-y-6 bg-gray-50/50 p-6 min-h-screen font-sans">
    
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Sản phẩm</h1>
            <p class="text-sm text-slate-500">Quản lý danh mục sản phẩm và kho hàng.</p>
        </div>
        <div class="flex items-center gap-3">
            <div class="relative flex-1 sm:flex-none">
                <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                <input @bind="SearchTerm" @bind:event="oninput" @onkeyup="HandleSearch" class="w-full sm:w-72 rounded-xl border border-slate-200 py-2.5 pl-9 pr-4 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 shadow-sm" placeholder="Tìm tên, SKU..." />
            </div>
            <a href="/admin/products/create" class="hidden sm:inline-flex items-center gap-2 rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 transition">
                <i class="fa-solid fa-plus"></i> Thêm mới
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-6">
        
        <section class="flex flex-col gap-4">
            <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden flex flex-col h-full">
                <div class="flex items-center justify-between p-5 border-b border-slate-100">
                    <h2 class="text-base font-bold text-slate-900">Danh sách sản phẩm</h2>
                </div>

                <div class="overflow-x-auto flex-1">
                    <table class="w-full text-left text-sm text-slate-600">
                        <thead class="bg-slate-50/50 text-xs uppercase font-semibold text-slate-500">
                            <tr>
                                <th class="px-5 py-4">ID</th>
                                <th class="px-5 py-4">Sản phẩm</th>
                                <th class="px-5 py-4">Giá bán</th>
                                <th class="px-5 py-4">Danh mục</th>
                                <th class="px-5 py-4">Trạng thái</th>
                                <th class="px-5 py-4 text-right">Hành động</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 bg-white">
    @if (IsLoading)
    {
        @for (int i = 0; i < PageSize; i++)
        {
            <tr class="animate-pulse">
                <td class="px-5 py-4"><div class="h-4 w-8 rounded bg-slate-200"></div></td>
                <td class="px-5 py-4">
                    <div class="flex items-center gap-3">
                        <div class="h-10 w-10 rounded bg-slate-200"></div>
                        <div class="space-y-2">
                            <div class="h-3 w-32 rounded bg-slate-200"></div>
                            <div class="h-3 w-20 rounded bg-slate-100"></div>
                        </div>
                    </div>
                </td>
                <td class="px-5 py-4"><div class="h-4 w-24 rounded bg-slate-200"></div></td>
                <td class="px-5 py-4"><div class="h-4 w-24 rounded bg-slate-200"></div></td>
                <td class="px-5 py-4"><div class="h-6 w-16 rounded bg-slate-200"></div></td>
                <td class="px-5 py-4 text-right">
                    <div class="flex justify-end gap-2">
                        <div class="h-8 w-8 rounded bg-slate-100"></div>
                        <div class="h-8 w-8 rounded bg-slate-100"></div>
                    </div>
                </td>
            </tr>
        }
    }
    else if (!ProductsData.Any())
    {
        <tr>
            <td colspan="6" class="px-5 py-12 text-center">
                <div class="flex flex-col items-center justify-center gap-2 text-slate-500">
                    <i class="fa-solid fa-box-open text-3xl text-slate-300"></i>
                    <p>Không tìm thấy sản phẩm nào.</p>
                </div>
            </td>
        </tr>
    }
    else
    {
        @foreach (var product in ProductsData)
        {
            <tr class="hover:bg-slate-50/80 transition-colors group">
                <td class="px-5 py-4 font-mono text-xs text-slate-500">#@product.Id</td>
                <td class="px-5 py-4">
                    <div class="flex items-center gap-3">
                        @{
                            var imageUrl = GetProductImageUrl(product);
                        }
                        @if (!string.IsNullOrEmpty(imageUrl))
                        {
                            <img src="@imageUrl" alt="@product.Name" class="h-10 w-10 rounded object-cover border border-slate-200" />
                        }
                        else
                        {
                            <div class="h-10 w-10 rounded bg-slate-100 flex items-center justify-center text-slate-400">
                                <i class="fa-solid fa-image"></i>
                            </div>
                        }
                        <div>
                            <p class="font-semibold text-slate-900">@product.Name</p>
                            <p class="text-xs text-slate-500">SKU: @product.Sku</p>
                        </div>
                    </div>
                </td>
                <td class="px-5 py-4 font-medium text-slate-900">
                    @product.Price.ToString("N0") ₫
                </td>
                <td class="px-5 py-4 text-slate-600">
                    @(product.Category?.Name ?? "-")
                </td>
                <td class="px-5 py-4">
                    @if (product.Status == "active")
                    {
                        <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">Đang bán</span>
                    }
                    else if (product.Status == "inactive")
                    {
                        <span class="inline-flex items-center rounded-full bg-slate-50 px-2 py-1 text-xs font-medium text-slate-600 ring-1 ring-inset ring-slate-500/10">Ngừng bán</span>
                    }
                    else
                    {
                        <span class="inline-flex items-center rounded-full bg-red-50 px-2 py-1 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-600/20">@product.Status</span>
                    }
                </td>
                <td class="px-5 py-4 text-right">
                    <a href="/admin/products/edit/@product.Id" class="text-slate-400 hover:text-blue-600 transition p-2" title="Chỉnh sửa">
                        <i class="fa-solid fa-pen-to-square"></i>
                    </a>
                    <button @onclick="() => DeleteProduct(product.Id)" class="text-slate-400 hover:text-red-600 transition p-2" title="Xóa">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </td>
            </tr>
        }
    }
</tbody>
                    </table>
                </div>
                
                <!-- Pagination -->
                <div class="border-t border-slate-100 px-5 py-4 text-sm text-slate-600 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                    <div class="flex items-center gap-2">
                        <label class="text-sm font-semibold text-slate-700">Rows per page:</label>
                        <select @onchange="OnPageSizeChanged" 
                                disabled="@IsLoading"
                                class="h-8 rounded border border-slate-300 bg-white px-2 py-1 text-sm text-slate-700 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 disabled:opacity-50">
                            <option value="10" selected="@(PageSize == 10)">10</option>
                            <option value="20" selected="@(PageSize == 20)">20</option>
                            <option value="50" selected="@(PageSize == 50)">50</option>
                        </select>
                    </div>

                    <div class="text-sm font-medium text-slate-700">
                        @DisplayFrom-@DisplayTo of @TotalRecords
                    </div>

                    <div class="flex items-center gap-1">
                        <button class="flex h-8 w-8 items-center justify-center rounded hover:bg-slate-100 disabled:opacity-30 disabled:hover:bg-transparent transition text-slate-600"
                                @onclick="GoToFirstPage"
                                disabled="@(CurrentPage == 1 || IsLoading)"
                                title="First Page">
                            <i class="fa-solid fa-angles-left"></i>
                        </button>
                        <button class="flex h-8 w-8 items-center justify-center rounded hover:bg-slate-100 disabled:opacity-30 disabled:hover:bg-transparent transition text-slate-600"
                                @onclick="GoToPreviousPage"
                                disabled="@(!CanGoPrevious || IsLoading)"
                                title="Previous Page">
                            <i class="fa-solid fa-angle-left"></i>
                        </button>
                        <button class="flex h-8 w-8 items-center justify-center rounded hover:bg-slate-100 disabled:opacity-30 disabled:hover:bg-transparent transition text-slate-600"
                                @onclick="GoToNextPage"
                                disabled="@(!CanGoNext || IsLoading)"
                                title="Next Page">
                            <i class="fa-solid fa-angle-right"></i>
                        </button>
                        <button class="flex h-8 w-8 items-center justify-center rounded hover:bg-slate-100 disabled:opacity-30 disabled:hover:bg-transparent transition text-slate-600"
                                @onclick="GoToLastPage"
                                disabled="@(CurrentPage == TotalPages || IsLoading)"
                                title="Last Page">
                            <i class="fa-solid fa-angles-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

@code {
    private List<ProductEntity> ProductsData = new();
    private bool IsLoading = true;
    
    // Pagination & Filter
    private int CurrentPage = 1;
    private int PageSize = 10;
    private int TotalRecords;
    private int TotalPages;
    private string SearchTerm = "";

    private int DisplayFrom => TotalRecords == 0 ? 0 : ((CurrentPage - 1) * PageSize) + 1;
    private int DisplayTo => TotalRecords == 0 ? 0 : Math.Min(TotalRecords, ((CurrentPage - 1) * PageSize) + ProductsData.Count);
    private bool CanGoPrevious => CurrentPage > 1;
    private bool CanGoNext => TotalPages > 0 && CurrentPage < TotalPages;

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        IsLoading = true;
        try
        {
            var result = await ProductService.GetProductsAsync(SearchTerm, CurrentPage, PageSize);
            ProductsData = result.Items;
            TotalRecords = result.TotalCount;
            TotalPages = result.TotalPages;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading products: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task HandleSearch()
    {
        CurrentPage = 1;
        await LoadProducts();
    }

    private async Task DeleteProduct(int id)
    {
        if (await ProductService.DeleteProductAsync(id))
        {
            await LoadProducts();
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newPageSize))
        {
            PageSize = newPageSize;
            CurrentPage = 1;
            await LoadProducts();
        }
    }

    private async Task GoToPreviousPage()
    {
        if (!CanGoPrevious || IsLoading) return;
        CurrentPage--;
        await LoadProducts();
    }

    private async Task GoToNextPage()
    {
        if (!CanGoNext || IsLoading) return;
        CurrentPage++;
        await LoadProducts();
    }

    private async Task GoToFirstPage()
    {
        if (CurrentPage == 1 || IsLoading) return;
        CurrentPage = 1;
        await LoadProducts();
    }

    private async Task GoToLastPage()
    {
        if (CurrentPage == TotalPages || IsLoading) return;
        CurrentPage = TotalPages;
        await LoadProducts();
    }

    private static string? GetProductImageUrl(ProductEntity product)
    {
        var brand = product.Brand?.Name?.Trim();
        var slug = product.Model?.Slug?.Trim();
        var sku = product.Sku?.Trim();

        if (!string.IsNullOrEmpty(brand) && !string.IsNullOrEmpty(slug) && !string.IsNullOrEmpty(sku))
        {
            var brandSegment = Uri.EscapeDataString(brand.ToLowerInvariant());
            var slugSegment = Uri.EscapeDataString(slug);
            var skuSegment = Uri.EscapeDataString(sku);

        var fallbackDate = product.UpdatedAt ?? product.CreatedAt ?? DateTime.UtcNow;
        string versionParam = fallbackDate.Ticks.ToString();

        // Thêm vào đuôi ảnh
        return $"https://res.cloudinary.com/dstytmxfh/image/upload/mobileguzone/{brandSegment}/{slugSegment}/{skuSegment}.webp?v={versionParam}";        }

        return product.Model?.DefaultImageUrl;
    }
}
