@page "/admin/reviews"
@using PhoneStoreUser.Data
@using PhoneStoreUser.Services
@using PhoneStoreUser.Components.ViewModels
@inject IAdminReviewService ReviewService
@inject NavigationManager Navigation
@layout Layout.AdminLayout

<div class="container mx-auto p-6">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Quản lý Đánh giá</h1>
    </div>

    <div class="bg-white rounded-lg shadow-md overflow-hidden">
        <div class="p-4 border-b border-gray-200 flex justify-between items-center">
            <div class="relative w-64">
                <input type="text" @bind="searchTerm" @bind:event="oninput" @onkeyup="HandleSearch" placeholder="Tìm kiếm đánh giá..." class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition" />
                <span class="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400">
                    <i class="fa-solid fa-search"></i>
                </span>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-50 text-gray-700 font-semibold uppercase text-sm">
                        <th class="p-4 border-b">ID</th>
                        <th class="p-4 border-b">Sản phẩm</th>
                        <th class="p-4 border-b">Khách hàng</th>
                        <th class="p-4 border-b">Đánh giá</th>
                        <th class="p-4 border-b">Nội dung</th>
                        <th class="p-4 border-b">Ngày tạo</th>
                        <th class="p-4 border-b text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody class="text-gray-600">
                    @if (reviews == null)
                    {
                        <tr>
                            <td colspan="7" class="p-4 text-center">Đang tải...</td>
                        </tr>
                    }
                    else if (!reviews.Items.Any())
                    {
                        <tr>
                            <td colspan="7" class="p-4 text-center">Không tìm thấy đánh giá nào.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in reviews.Items)
                        {
                            <tr class="hover:bg-gray-50 transition border-b last:border-b-0">
                                <td class="p-4">@item.Id</td>
                                <td class="p-4 font-medium text-gray-800">
                                    @(item.Product?.Name ?? "N/A")
                                </td>
                                <td class="p-4">
                                    @(item.Person?.FullName ?? "N/A")
                                </td>
                                <td class="p-4">
                                    <div class="flex text-yellow-400">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= item.Rating)
                                            {
                                                <i class="fa-solid fa-star text-xs"></i>
                                            }
                                            else
                                            {
                                                <i class="fa-regular fa-star text-xs text-gray-300"></i>
                                            }
                                        }
                                    </div>
                                </td>
                                <td class="p-4 max-w-xs truncate" title="@item.Comment">
                                    @item.Comment
                                </td>
                                <td class="p-4 text-sm">
                                    @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="p-4 text-center">
                                    <button @onclick="() => ConfirmDelete(item.Id)" class="text-red-600 hover:text-red-800 mx-2" title="Xóa">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (reviews != null && reviews.TotalPages > 1)
        {
            <div class="p-4 border-t border-gray-200 flex justify-center">
                <nav class="flex gap-2">
                    <button @onclick="() => LoadPage(reviews.Page - 1)" disabled="@(!reviews.HasPreviousPage)" class="px-3 py-1 border rounded hover:bg-gray-100 disabled:opacity-50">Trước</button>
                    @for (int i = 1; i <= reviews.TotalPages; i++)
                    {
                        var pageNum = i;
                        <button @onclick="() => LoadPage(pageNum)" class="px-3 py-1 border rounded hover:bg-gray-100 @(reviews.Page == pageNum ? "bg-blue-600 text-white" : "")">@i</button>
                    }
                    <button @onclick="() => LoadPage(reviews.Page + 1)" disabled="@(!reviews.HasNextPage)" class="px-3 py-1 border rounded hover:bg-gray-100 disabled:opacity-50">Sau</button>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Delete Confirmation Modal -->
@if (showDeleteModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50">
        <div class="bg-white rounded-lg shadow-xl w-full max-w-sm p-6">
            <div class="text-center mb-4">
                <i class="fa-solid fa-triangle-exclamation text-4xl text-red-500 mb-2"></i>
                <h3 class="text-lg font-bold text-gray-800">Xác nhận xóa</h3>
                <p class="text-gray-600">Bạn có chắc chắn muốn xóa đánh giá này không? Hành động này không thể hoàn tác.</p>
            </div>
            <div class="flex justify-center gap-3">
                <button @onclick="CloseDeleteModal" class="px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50">Hủy</button>
                <button @onclick="DeleteReview" class="px-4 py-2 bg-red-600 text-white rounded-md hover:bg-red-700">Xóa</button>
            </div>
        </div>
    </div>
}

@code {
    private PagedResult<ReviewEntity>? reviews;
    private string searchTerm = "";
    private int currentPage = 1;
    private bool showDeleteModal = false;
    private int deleteReviewId;

    protected override async Task OnInitializedAsync()
    {
        await LoadReviews();
    }

    private async Task LoadReviews()
    {
        reviews = await ReviewService.GetReviewsAsync(searchTerm, currentPage);
        if (reviews != null)
        {
            currentPage = reviews.Page;
        }
    }

    private async Task HandleSearch()
    {
        currentPage = 1;
        await LoadReviews();
    }

    private async Task LoadPage(int page)
    {
        if (reviews == null) return;
        if (page < 1 || page > reviews.TotalPages) return;

        currentPage = page;
        await LoadReviews();
    }

    private void ConfirmDelete(int id)
    {
        deleteReviewId = id;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        deleteReviewId = 0;
    }

    private async Task DeleteReview()
    {
        if (deleteReviewId > 0)
        {
            await ReviewService.DeleteReviewAsync(deleteReviewId);
            await LoadReviews();
            CloseDeleteModal();
        }
    }
}
