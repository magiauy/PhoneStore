@page "/admin/reports"
@layout AdminLayout
@using PhoneStoreUser.Services
@using PhoneStoreUser.Components.ViewModels
@using Microsoft.JSInterop
@inject IReportService ReportService
@inject IExcelExportService ExcelExportService
@inject IJSRuntime JSRuntime

<div class="space-y-6 bg-gray-50/50 p-6 min-h-screen font-sans">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Báo cáo</h1>
            <p class="text-slate-500 text-sm">Xem và xuất báo cáo kinh doanh.</p>
        </div>
    </div>

    <!-- Tab Navigation -->
    <div class="border-b border-slate-200">
        <nav class="flex gap-4" aria-label="Tabs">
            <button @onclick="() => SelectTab(ReportTab.PurchaseOrder)"
                    class="@GetTabClass(ReportTab.PurchaseOrder) px-4 py-3 text-sm font-medium border-b-2 transition-colors">
                <i class="fa-solid fa-file-invoice-dollar mr-2"></i>
                Báo cáo nhập
            </button>
            <button @onclick="() => SelectTab(ReportTab.Invoice)"
                    class="@GetTabClass(ReportTab.Invoice) px-4 py-3 text-sm font-medium border-b-2 transition-colors">
                <i class="fa-solid fa-receipt mr-2"></i>
                Báo cáo hóa đơn
            </button>
        </nav>
    </div>

    <!-- Date Range Picker -->
    <div class="flex flex-wrap items-center gap-4 bg-white border border-slate-200 rounded-lg p-4 shadow-sm">
        <div class="flex items-center gap-2">
            <label class="text-sm font-medium text-slate-600">Từ ngày:</label>
            <input type="date" @bind="StartDate" @bind:after="OnDateRangeChanged"
                   class="px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>
        <div class="flex items-center gap-2">
            <label class="text-sm font-medium text-slate-600">Đến ngày:</label>
            <input type="date" @bind="EndDate" @bind:after="OnDateRangeChanged"
                   class="px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>
        <button @onclick="LoadReportData"
                class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-medium hover:bg-blue-700 transition">
            <i class="fa-solid fa-search mr-2"></i>Xem báo cáo
        </button>
    </div>


    @if (IsLoading)
    {
        <div class="flex items-center justify-center py-12">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
            <span class="ml-3 text-slate-500">Đang tải dữ liệu...</span>
        </div>
    }
    else
    {
        @if (ActiveTab == ReportTab.PurchaseOrder)
        {
            <!-- Purchase Order Report Tab -->
            <div class="space-y-6">
                <!-- Summary Cards -->
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-2">
                    <div class="relative overflow-hidden rounded-2xl bg-white p-5 shadow-sm border border-slate-100 group hover:shadow-md transition-all duration-300">
                        <div class="flex items-start justify-between">
                            <div>
                                <p class="text-sm font-medium text-slate-500">Tổng số đơn nhập</p>
                                <h3 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 tabular-nums">@(PurchaseOrderReport?.TotalCount ?? 0)</h3>
                            </div>
                            <div class="bg-blue-100 text-blue-600 flex h-10 w-10 items-center justify-center rounded-xl transition-transform group-hover:scale-110">
                                <i class="fa-solid fa-file-invoice-dollar text-lg"></i>
                            </div>
                        </div>
                    </div>

                    <div class="relative overflow-hidden rounded-2xl bg-white p-5 shadow-sm border border-slate-100 group hover:shadow-md transition-all duration-300">
                        <div class="flex items-start justify-between">
                            <div>
                                <p class="text-sm font-medium text-slate-500">Tổng giá trị nhập</p>
                                <h3 class="mt-2 text-2xl font-bold tracking-tight text-emerald-600 tabular-nums">@FormatCurrency(PurchaseOrderReport?.TotalValue ?? 0)</h3>
                            </div>
                            <div class="bg-emerald-100 text-emerald-600 flex h-10 w-10 items-center justify-center rounded-xl transition-transform group-hover:scale-110">
                                <i class="fa-solid fa-coins text-lg"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Purchase Order Chart -->
                @if (PurchaseOrderReport?.ChartData?.Count > 0)
                {
                    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm p-5">
                        <h3 class="text-lg font-semibold text-slate-800 mb-4">
                            <i class="fa-solid fa-chart-bar mr-2 text-blue-600"></i>
                            Biểu đồ giá trị nhập theo thời gian
                        </h3>
                        <div class="h-72">
                            <canvas id="purchaseOrderChart"></canvas>
                        </div>
                    </div>
                }

                <!-- Export Button -->
                <div class="flex justify-end">
                    <button @onclick="ExportPurchaseOrderToExcel" disabled="@(PurchaseOrderReport?.Items.Count == 0)"
                            class="px-4 py-2 bg-emerald-600 text-white rounded-lg text-sm font-medium hover:bg-emerald-700 transition disabled:opacity-50 disabled:cursor-not-allowed">
                        <i class="fa-solid fa-file-excel mr-2"></i>Xuất Excel
                    </button>
                </div>

                <!-- Data Table -->
                <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                    <div class="overflow-x-auto">
                        @if (PurchaseOrderReport?.Items.Count == 0)
                        {
                            <div class="p-8 text-center text-slate-500">
                                <i class="fa-solid fa-box-open text-3xl mb-2"></i>
                                <p>Không có dữ liệu đơn nhập trong khoảng thời gian này</p>
                            </div>
                        }
                        else
                        {
                            <table class="w-full text-left text-sm text-slate-600">
                                <thead class="bg-slate-50/50 text-xs uppercase font-semibold text-slate-500">
                                    <tr>
                                        <th class="px-5 py-3">Mã đơn</th>
                                        <th class="px-5 py-3">Ngày đặt</th>
                                        <th class="px-5 py-3">Nhà cung cấp</th>
                                        <th class="px-5 py-3 text-right">Số lượng</th>
                                        <th class="px-5 py-3 text-right">Tổng giá trị</th>
                                        <th class="px-5 py-3">Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    @foreach (var item in PurchaseOrderReport?.Items ?? new())
                                    {
                                        <tr class="hover:bg-slate-50/80 transition-colors">
                                            <td class="px-5 py-3 font-medium text-slate-800">#@item.Id</td>
                                            <td class="px-5 py-3">@item.OrderDate.ToString("dd/MM/yyyy")</td>
                                            <td class="px-5 py-3">@item.SupplierName</td>
                                            <td class="px-5 py-3 text-right tabular-nums">@item.TotalItems</td>
                                            <td class="px-5 py-3 text-right font-semibold text-emerald-600 tabular-nums">@FormatCurrency(item.TotalValue)</td>
                                            <td class="px-5 py-3">
                                                <span class="@GetStatusBadgeClass(item.Status) inline-flex items-center rounded-md px-2 py-1 text-xs font-medium">
                                                    @item.Status
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Invoice Report Tab -->
            <div class="space-y-6">
                <!-- Summary Cards -->
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-2">
                    <div class="relative overflow-hidden rounded-2xl bg-white p-5 shadow-sm border border-slate-100 group hover:shadow-md transition-all duration-300">
                        <div class="flex items-start justify-between">
                            <div>
                                <p class="text-sm font-medium text-slate-500">Tổng số hóa đơn</p>
                                <h3 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 tabular-nums">@(InvoiceReport?.TotalCount ?? 0)</h3>
                            </div>
                            <div class="bg-violet-100 text-violet-600 flex h-10 w-10 items-center justify-center rounded-xl transition-transform group-hover:scale-110">
                                <i class="fa-solid fa-receipt text-lg"></i>
                            </div>
                        </div>
                    </div>

                    <div class="relative overflow-hidden rounded-2xl bg-white p-5 shadow-sm border border-slate-100 group hover:shadow-md transition-all duration-300">
                        <div class="flex items-start justify-between">
                            <div>
                                <p class="text-sm font-medium text-slate-500">Tổng doanh thu</p>
                                <h3 class="mt-2 text-2xl font-bold tracking-tight text-emerald-600 tabular-nums">@FormatCurrency(InvoiceReport?.TotalRevenue ?? 0)</h3>
                            </div>
                            <div class="bg-emerald-100 text-emerald-600 flex h-10 w-10 items-center justify-center rounded-xl transition-transform group-hover:scale-110">
                                <i class="fa-solid fa-chart-line text-lg"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Invoice Chart -->
                @if (InvoiceReport?.ChartData?.Count > 0)
                {
                    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm p-5">
                        <h3 class="text-lg font-semibold text-slate-800 mb-4">
                            <i class="fa-solid fa-chart-line mr-2 text-emerald-600"></i>
                            Biểu đồ doanh thu theo thời gian
                        </h3>
                        <div class="h-72">
                            <canvas id="invoiceChart"></canvas>
                        </div>
                    </div>
                }

                <!-- Export Button -->
                <div class="flex justify-end">
                    <button @onclick="ExportInvoiceToExcel" disabled="@(InvoiceReport?.Items.Count == 0)"
                            class="px-4 py-2 bg-emerald-600 text-white rounded-lg text-sm font-medium hover:bg-emerald-700 transition disabled:opacity-50 disabled:cursor-not-allowed">
                        <i class="fa-solid fa-file-excel mr-2"></i>Xuất Excel
                    </button>
                </div>

                <!-- Data Table -->
                <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                    <div class="overflow-x-auto">
                        @if (InvoiceReport?.Items.Count == 0)
                        {
                            <div class="p-8 text-center text-slate-500">
                                <i class="fa-solid fa-receipt text-3xl mb-2"></i>
                                <p>Không có dữ liệu hóa đơn trong khoảng thời gian này</p>
                            </div>
                        }
                        else
                        {
                            <table class="w-full text-left text-sm text-slate-600">
                                <thead class="bg-slate-50/50 text-xs uppercase font-semibold text-slate-500">
                                    <tr>
                                        <th class="px-5 py-3">Mã hóa đơn</th>
                                        <th class="px-5 py-3">Ngày lập</th>
                                        <th class="px-5 py-3">Khách hàng</th>
                                        <th class="px-5 py-3 text-right">Số lượng</th>
                                        <th class="px-5 py-3 text-right">Tổng giá trị</th>
                                        <th class="px-5 py-3">Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    @foreach (var item in InvoiceReport?.Items ?? new())
                                    {
                                        <tr class="hover:bg-slate-50/80 transition-colors">
                                            <td class="px-5 py-3 font-medium text-slate-800">#@item.Id</td>
                                            <td class="px-5 py-3">@item.InvoiceDate.ToString("dd/MM/yyyy")</td>
                                            <td class="px-5 py-3">@item.CustomerName</td>
                                            <td class="px-5 py-3 text-right tabular-nums">@item.TotalItems</td>
                                            <td class="px-5 py-3 text-right font-semibold text-emerald-600 tabular-nums">@FormatCurrency(item.TotalValue)</td>
                                            <td class="px-5 py-3">
                                                <span class="@GetStatusBadgeClass(item.Status) inline-flex items-center rounded-md px-2 py-1 text-xs font-medium">
                                                    @item.Status
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>


@code {
    private enum ReportTab { PurchaseOrder, Invoice }

    private ReportTab ActiveTab { get; set; } = ReportTab.PurchaseOrder;
    private DateTime StartDate { get; set; } = DateTime.Now.AddMonths(-1).Date;
    private DateTime EndDate { get; set; } = DateTime.Now.Date;
    private bool IsLoading { get; set; } = false;
    private bool _shouldRenderChart = false;
    private bool _isJsReady = false;
    private int _chartReadyAttempts = 0;

    private PurchaseOrderReportData? PurchaseOrderReport { get; set; }
    private InvoiceReportData? InvoiceReport { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadReportData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isJsReady = true;
            // Nếu data đã load xong trước firstRender, render chart ngay
            if (_shouldRenderChart && !IsLoading)
            {
                _shouldRenderChart = false;
                await Task.Delay(50);
                await RenderCharts();
            }
        }
        else if (_shouldRenderChart && !IsLoading && _isJsReady)
        {
            _shouldRenderChart = false;
            // Delay nhỏ để đảm bảo DOM đã render xong canvas element
            await Task.Delay(50);
            await RenderCharts();
        }
    }

    private async Task SelectTab(ReportTab tab)
    {
        if (ActiveTab != tab)
        {
            ActiveTab = tab;
            await LoadReportData();
        }
    }

    private void OnDateRangeChanged()
    {
        // Validate date range
        if (StartDate > EndDate)
        {
            EndDate = StartDate;
        }
    }

    private async Task LoadReportData()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            if (ActiveTab == ReportTab.PurchaseOrder)
            {
                PurchaseOrderReport = await ReportService.GetPurchaseOrderReportAsync(StartDate, EndDate);
            }
            else
            {
                InvoiceReport = await ReportService.GetInvoiceReportAsync(StartDate, EndDate);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading report data: {ex.Message}");
            PurchaseOrderReport = new PurchaseOrderReportData(0, 0, new(), new());
            InvoiceReport = new InvoiceReportData(0, 0, new(), new());
        }
        finally
        {
            IsLoading = false;
            _shouldRenderChart = true;
            StateHasChanged();
        }
    }

    private async Task RenderCharts()
    {
        try
        {
            // Ensure Chart.js is loaded (local then CDN) before readiness checks
            await JSRuntime.InvokeVoidAsync("loadChartJs");

            if (!await EnsureChartInteropReadyAsync())
            {
                _chartReadyAttempts++;

                if (_chartReadyAttempts > 40)
                {
                    Console.WriteLine("Chart scripts are still not available after multiple attempts.");
                    _shouldRenderChart = false;
                    return;
                }

                _shouldRenderChart = true;
                await Task.Delay(200);
                await InvokeAsync(StateHasChanged);
                return;
            }

            _chartReadyAttempts = 0;

            if (ActiveTab == ReportTab.PurchaseOrder && PurchaseOrderReport?.ChartData?.Count > 0)
            {
                var labels = PurchaseOrderReport.ChartData.Select(c => c.Label).ToArray();
                var data = PurchaseOrderReport.ChartData.Select(c => (double)c.Value).ToArray();
                await JSRuntime.InvokeVoidAsync("createBarChart", 
                    "purchaseOrderChart", 
                    labels, 
                    data, 
                    "Giá trị nhập",
                    "rgba(59, 130, 246, 0.5)",
                    "rgb(59, 130, 246)");
            }
            else if (ActiveTab == ReportTab.Invoice && InvoiceReport?.ChartData?.Count > 0)
            {
                var labels = InvoiceReport.ChartData.Select(c => c.Label).ToArray();
                var data = InvoiceReport.ChartData.Select(c => (double)c.Value).ToArray();
                await JSRuntime.InvokeVoidAsync("createLineChart", 
                    "invoiceChart", 
                    labels, 
                    data, 
                    "Doanh thu",
                    "rgb(16, 185, 129)",
                    "rgba(16, 185, 129, 0.1)");
            }
        }
        catch (JSDisconnectedException)
        {
            // Bỏ qua khi circuit bị ngắt kết nối
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error rendering chart: {ex.Message}");
        }
    }

    private async Task<bool> EnsureChartInteropReadyAsync()
    {
        // Avoid eval; rely on a safe helper defined in site.js
        return await JSRuntime.InvokeAsync<bool>("ensureChartReady");
    }

    private async Task ExportPurchaseOrderToExcel()
    {
        if (PurchaseOrderReport?.Items == null || PurchaseOrderReport.Items.Count == 0)
            return;

        try
        {
            var excelBytes = ExcelExportService.ExportPurchaseOrderReport(PurchaseOrderReport.Items, StartDate, EndDate);
            var fileName = ExcelExportService.GetPurchaseOrderReportFileName(StartDate, EndDate);
            await DownloadFile(excelBytes, fileName, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error exporting to Excel: {ex.Message}");
        }
    }

    private async Task ExportInvoiceToExcel()
    {
        if (InvoiceReport?.Items == null || InvoiceReport.Items.Count == 0)
            return;

        try
        {
            var excelBytes = ExcelExportService.ExportInvoiceReport(InvoiceReport.Items, StartDate, EndDate);
            var fileName = ExcelExportService.GetInvoiceReportFileName(StartDate, EndDate);
            await DownloadFile(excelBytes, fileName, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error exporting to Excel: {ex.Message}");
        }
    }

    private async Task DownloadFile(byte[] fileBytes, string fileName, string contentType)
    {
        var base64 = Convert.ToBase64String(fileBytes);
        await JSRuntime.InvokeVoidAsync("downloadFileFromBase64", base64, fileName, contentType);
    }

    private string GetTabClass(ReportTab tab)
    {
        return tab == ActiveTab
            ? "text-blue-600 border-blue-600"
            : "text-slate-500 border-transparent hover:text-slate-700 hover:border-slate-300";
    }

    private string FormatCurrency(decimal amount)
    {
        if (amount >= 1_000_000_000)
            return $"₫{amount / 1_000_000_000:F1}B";
        if (amount >= 1_000_000)
            return $"₫{amount / 1_000_000:F1}M";
        if (amount >= 1_000)
            return $"₫{amount / 1_000:F0}K";
        return $"₫{amount:N0}";
    }

    private string GetStatusBadgeClass(string status)
    {
        return status?.ToLower() switch
        {
            "completed" or "hoàn thành" or "paid" => "bg-emerald-50 text-emerald-700 ring-1 ring-emerald-600/20",
            "pending" or "chờ xử lý" => "bg-amber-50 text-amber-700 ring-1 ring-amber-600/20",
            "cancelled" or "đã hủy" => "bg-rose-50 text-rose-700 ring-1 ring-rose-600/20",
            "processing" or "đang xử lý" => "bg-blue-50 text-blue-700 ring-1 ring-blue-600/20",
            _ => "bg-slate-50 text-slate-700 ring-1 ring-slate-600/20"
        };
    }
}
