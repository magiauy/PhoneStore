@page "/admin/customers"
@layout AdminLayout

<div class="space-y-6 bg-gray-50/50 p-6 min-h-screen font-sans">
    
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Khách hàng</h1>
            <p class="text-sm text-slate-500">Quản lý hồ sơ hội viên và lịch sử mua hàng.</p>
        </div>
        <div class="flex items-center gap-3">
            <div class="relative flex-1 sm:flex-none">
                <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                <input class="w-full sm:w-72 rounded-xl border border-slate-200 py-2.5 pl-9 pr-4 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 shadow-sm" placeholder="Tìm tên, SĐT, email..." />
            </div>
            <button class="hidden sm:inline-flex items-center gap-2 rounded-xl bg-white border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 transition">
                <i class="fa-solid fa-filter"></i> Bộ lọc
            </button>
        </div>
    </div>

    <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
        <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-50 text-blue-600"><i class="fa-solid fa-users"></i></div>
            <div><p class="text-xs text-slate-500">Tổng khách hàng</p><p class="text-lg font-bold text-slate-900">1,240</p></div>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-amber-50 text-amber-600"><i class="fa-solid fa-crown"></i></div>
            <div><p class="text-xs text-slate-500">Khách VIP</p><p class="text-lg font-bold text-slate-900">85</p></div>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        
        <section class="lg:col-span-2 flex flex-col gap-4">
            <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden flex flex-col h-full">
                <div class="flex items-center justify-between p-5 border-b border-slate-100">
                    <h2 class="text-base font-bold text-slate-900">Danh sách hội viên</h2>
                    <div class="flex gap-2">
                        <select class="rounded-lg border-0 bg-slate-50 py-1.5 pl-3 pr-8 text-xs font-medium text-slate-700 focus:ring-2 focus:ring-blue-500">
                            <option>Tất cả hạng</option>
                            <option>VIP Gold</option>
                            <option>Thành viên</option>
                        </select>
                    </div>
                </div>

                <div class="overflow-x-auto flex-1">
                    <table class="w-full text-left text-sm text-slate-600">
                        <thead class="bg-slate-50/50 text-xs uppercase font-semibold text-slate-500">
                            <tr>
                                <th class="px-5 py-4">Hồ sơ</th>
                                <th class="px-5 py-4">Hạng</th>
                                <th class="px-5 py-4">Đơn gần nhất</th>
                                <th class="px-5 py-4 text-right">Tổng chi tiêu</th>
                                <th class="px-5 py-4 text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var customer in CustomersData)
                            {
                                <tr class="hover:bg-slate-50/80 transition-colors group">
                                    <td class="px-5 py-4">
                                        <div class="flex items-center gap-3">
                                            <div class="h-10 w-10 shrink-0 rounded-full bg-slate-100 border border-slate-200 flex items-center justify-center text-sm font-bold text-slate-500 ring-2 ring-white">
                                                @GetInitials(customer.Name)
                                            </div>
                                            <div>
                                                <p class="font-semibold text-slate-900">@customer.Name</p>
                                                <p class="text-xs text-slate-500 flex items-center gap-1">
                                                    <i class="fa-solid fa-phone text-[10px]"></i> @customer.Phone
                                                </p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-5 py-4">
                                        @if(customer.Tier == "VIP")
                                        {
                                            <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-2.5 py-1 text-xs font-medium text-amber-700 ring-1 ring-inset ring-amber-600/20">
                                                <i class="fa-solid fa-crown text-[10px]"></i> VIP
                                            </span>
                                        }
                                        else if (customer.Tier == "Khách mới")
                                        {
                                            <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600">
                                                New
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center rounded-full bg-blue-50 px-2.5 py-1 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-700/10">
                                                Member
                                            </span>
                                        }
                                    </td>
                                    <td class="px-5 py-4">
                                        <p class="text-slate-900 font-medium truncate w-32" title="@customer.LastOrder">@customer.LastOrder</p>
                                        <p class="text-[10px] text-slate-400">12/03/2024</p>
                                    </td>
                                    <td class="px-5 py-4 text-right font-semibold text-slate-900 tabular-nums">
                                        @customer.Value
                                    </td>
                                    <td class="px-5 py-4 text-right">
                                        <button class="text-slate-400 hover:text-blue-600 transition p-2"><i class="fa-solid fa-pen-to-square"></i></button>
                                        <button class="text-slate-400 hover:text-blue-600 transition p-2"><i class="fa-solid fa-envelope"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <section class="flex flex-col gap-4">
            <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sticky top-6">
                <div class="mb-5 flex items-center justify-between border-b border-slate-100 pb-4">
                    <div>
                        <h2 class="text-base font-bold text-slate-900">Thêm hội viên</h2>
                        <p class="text-xs text-slate-500">Tạo hồ sơ khách hàng mới</p>
                    </div>
                    <div class="h-8 w-8 rounded-full bg-blue-50 flex items-center justify-center text-blue-600">
                        <i class="fa-solid fa-user-plus text-sm"></i>
                    </div>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="mb-1.5 block text-xs font-bold text-slate-700 uppercase tracking-wide">Tên đầy đủ</label>
                        <div class="relative">
                            <i class="fa-solid fa-user absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                            <input class="w-full rounded-xl border border-slate-200 py-2.5 pl-9 pr-3 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 transition" placeholder="Ví dụ: Nguyễn Văn A" />
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                         <div>
                            <label class="mb-1.5 block text-xs font-bold text-slate-700 uppercase tracking-wide">Số điện thoại</label>
                            <input class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" placeholder="09xx..." />
                        </div>
                        <div>
                            <label class="mb-1.5 block text-xs font-bold text-slate-700 uppercase tracking-wide">Hạng thẻ</label>
                            <select class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
                                <option>Thành viên</option>
                                <option>VIP Silver</option>
                                <option>VIP Gold</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="mb-1.5 block text-xs font-bold text-slate-700 uppercase tracking-wide">Email</label>
                        <div class="relative">
                            <i class="fa-solid fa-envelope absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                            <input class="w-full rounded-xl border border-slate-200 py-2.5 pl-9 pr-3 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500" placeholder="customer@email.com" />
                        </div>
                    </div>

                    <div>
                        <label class="mb-1.5 block text-xs font-bold text-slate-700 uppercase tracking-wide">Ghi chú</label>
                        <textarea rows="3" class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 resize-none" placeholder="Sở thích, ngày sinh, lưu ý đặc biệt..."></textarea>
                    </div>

                    <div class="rounded-lg bg-blue-50 p-3 border border-blue-100">
                        <div class="flex items-start gap-3">
                            <input type="checkbox" id="welcome" class="mt-1 h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" checked />
                            <div>
                                <label for="welcome" class="text-sm font-semibold text-blue-900 block">Gửi Email chào mừng</label>
                                <p class="text-xs text-blue-600/80">Kèm mã giảm giá 10% cho đơn đầu tiên.</p>
                            </div>
                        </div>
                    </div>

                    <button class="w-full rounded-xl bg-slate-900 py-3 text-sm font-bold text-white shadow-sm hover:bg-slate-800 transition flex items-center justify-center gap-2">
                        <i class="fa-solid fa-check"></i> Lưu hồ sơ
                    </button>
                </div>
            </div>
        </section>
    </div>
</div>

@code {
    private List<CustomerRow> CustomersData = new()
    {
        new("Nguyễn Hà Vy", "0963 123 888", "VIP", "iPhone 15 Pro Max", "₫32.990.000", "Active"),
        new("Trương Minh Khải", "0909 777 188", "Thành viên", "Galaxy S24 Ultra", "₫29.900.000", "Active"),
        new("Lê Quốc Dũng", "0987 555 221", "VIP", "MacBook Air M3", "₫32.990.000", "Active"),
        new("Phạm Anh Khoa", "0911 345 222", "Khách mới", "iPhone 14 128GB", "₫16.490.000", "Theo dõi"),
        new("Bùi Thái Hòa", "0933 448 992", "Thành viên", "iPad Air M2", "₫21.500.000", "Active"),
    };

    private record CustomerRow(string Name, string Phone, string Tier, string LastOrder, string Value, string Status);

    // Hàm tiện ích lấy chữ cái đầu của tên để làm Avatar
    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "KH";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpper();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }
}