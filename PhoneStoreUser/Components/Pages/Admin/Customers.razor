@page "/admin/customers"
@layout AdminLayout
@using PhoneStoreUser.Services
@using PhoneStoreUser.Components.ViewModels
@using PhoneStoreUser.Helper
@inject IAdminCustomerService CustomerService

<div class="space-y-6 bg-gray-50/50 p-6 min-h-screen font-sans">
    
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Khách hàng</h1>
            <p class="text-sm text-slate-500">Quản lý hồ sơ hội viên và lịch sử mua hàng.</p>
        </div>
        <div class="flex items-center gap-3">
            <div class="relative flex-1 sm:flex-none">
                <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                <input @bind="SearchTerm" @bind:event="oninput" @onkeyup="OnSearchInputChanged" 
                       class="w-full sm:w-72 rounded-xl border border-slate-200 py-2.5 pl-9 pr-4 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 shadow-sm" 
                       placeholder="Tìm tên, SĐT, email..." />
            </div>
        </div>
    </div>

    <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
        <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-50 text-blue-600"><i class="fa-solid fa-users"></i></div>
            <div><p class="text-xs text-slate-500">Tổng khách hàng</p><p class="text-lg font-bold text-slate-900">@TotalCustomers</p></div>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        
        <section class="lg:col-span-2 flex flex-col gap-4">
            <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden flex flex-col h-full">
                <div class="flex items-center justify-between p-5 border-b border-slate-100">
                    <h2 class="text-base font-bold text-slate-900">Danh sách hội viên</h2>
                </div>

                <div class="overflow-x-auto flex-1">
                    <table class="w-full text-left text-sm text-slate-600">
                        <thead class="bg-slate-50/50 text-xs uppercase font-semibold text-slate-500">
                            <tr>
                                <th class="px-5 py-4">Hồ sơ</th>
                                <th class="px-5 py-4">Đơn gần nhất</th>
                                <th class="px-5 py-4 text-right">Tổng chi tiêu</th>
                                <th class="px-5 py-4 text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 bg-white">
    @if (IsLoading)
    {
        @* Render ra số dòng giả bằng đúng PageSize để giữ chiều cao bảng không đổi *@
        @for (int i = 0; i < PageSize; i++)
        {
            <tr class="animate-pulse">
                <td class="px-5 py-4">
                    <div class="flex items-center gap-3">
                        @* Avatar giả *@
                        <div class="h-10 w-10 shrink-0 rounded-full bg-slate-200"></div>
                        <div class="flex-1 space-y-2">
                            @* Tên giả *@
                            <div class="h-4 w-32 rounded bg-slate-200"></div>
                            @* SĐT giả *@
                            <div class="h-3 w-20 rounded bg-slate-100"></div>
                        </div>
                    </div>
                </td>
                <td class="px-5 py-4">
                    <div class="space-y-2">
                        @* Ngày tháng giả *@
                        <div class="h-4 w-24 rounded bg-slate-200"></div>
                        <div class="h-3 w-16 rounded bg-slate-100"></div>
                    </div>
                </td>
                <td class="px-5 py-4 text-right">
                    @* Giá tiền giả (căn phải) *@
                    <div class="ml-auto h-4 w-20 rounded bg-slate-200"></div>
                </td>
                <td class="px-5 py-4 text-right">
                    @* Nút bấm giả *@
                    <div class="flex justify-end gap-2">
                        <div class="h-8 w-8 rounded bg-slate-100"></div>
                        <div class="h-8 w-8 rounded bg-slate-100"></div>
                    </div>
                </td>
            </tr>
        }
    }
    else if (!CustomersData.Any())
    {
        <tr>
            <td colspan="4" class="px-5 py-12 text-center">
                <div class="flex flex-col items-center justify-center gap-2 text-slate-500">
                    <i class="fa-solid fa-inbox text-3xl text-slate-300"></i>
                    <p>Chưa có khách hàng nào.</p>
                </div>
            </td>
        </tr>
    }
    else
    {
        @foreach (var customer in CustomersData)
        {
            <tr class="hover:bg-slate-50/80 transition-colors group">
                <td class="px-5 py-4">
                    <div class="flex items-center gap-3">
                        <div class="h-10 w-10 shrink-0 rounded-full bg-slate-100 border border-slate-200 flex items-center justify-center text-sm font-bold text-slate-500 ring-2 ring-white">
                            @GetInitials(customer.Name)
                        </div>
                        <div>
                            <p class="font-semibold text-slate-900">@customer.Name</p>
                            <p class="text-xs text-slate-500 flex items-center gap-1">
                                <i class="fa-solid fa-phone text-[10px]"></i> @customer.Phone
                            </p>
                        </div>
                    </div>
                </td>
                <td class="px-5 py-4">
                    @if (customer.LastOrderDate.HasValue)
                    {
                        <p class="text-slate-900 font-medium">@customer.LastOrderDate.Value.ToString("dd/MM/yyyy")</p>
                        <p class="text-[10px] text-slate-400">@customer.LastOrderDate.Value.ToString("HH:mm")</p>
                    }
                    else
                    {
                        <span class="text-slate-400 text-xs">-</span>
                    }
                </td>
                <td class="px-5 py-4 text-right font-semibold text-slate-900 tabular-nums">
                    @OrderUIHelper.FormatCurrency(customer.TotalSpend)
                </td>
                <td class="px-5 py-4 text-right">
                    <button @onclick="() => OpenEditModal(customer.Id)" class="text-slate-400 hover:text-blue-600 transition p-2" title="Sửa thông tin"><i class="fa-solid fa-pen-to-square"></i></button>
                </td>
            </tr>
        }
        
        @* Tối ưu phụ: Nếu trang cuối ít hơn PageSize, render thêm dòng trống để bảng không bị co lên *@
        @if(CustomersData.Count < PageSize && CustomersData.Any())
        {
             @for(int i = 0; i < (PageSize - CustomersData.Count); i++)
             {
                 <tr class="h-[73px]"> @* Chiều cao trung bình của 1 row *@
                     <td colspan="4"></td>
                 </tr>
             }
        }
    }
</tbody>
                    </table>
                </div>
                <div class="border-t border-slate-100 px-5 py-4 text-sm text-slate-600 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                    <p>
                    </p>
<div class="flex flex-wrap items-center justify-between gap-4 rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm">
    
    <div class="flex items-center gap-2">
        <label class="text-sm font-semibold text-slate-700">Rows per page:</label>
        <select @onchange="OnPageSizeChanged" 
                disabled="@IsLoading"
                class="h-8 rounded border border-slate-300 bg-white px-2 py-1 text-sm text-slate-700 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 disabled:opacity-50">
            <option value="10" selected="@(PageSize == 10)">10</option>
            <option value="20" selected="@(PageSize == 20)">20</option>
            <option value="50" selected="@(PageSize == 50)">50</option>
            <option value="100" selected="@(PageSize == 100)">100</option>
        </select>
    </div>

    <div class="text-sm font-medium text-slate-700">
        @DisplayFrom-@DisplayTo of @TotalCustomers
    </div>

    <div class="flex items-center gap-1">
        
        <button class="flex h-8 w-8 items-center justify-center rounded hover:bg-slate-100 disabled:opacity-30 disabled:hover:bg-transparent transition text-slate-600"
                @onclick="GoToFirstPage"
                disabled="@(CurrentPage == 1 || IsLoading)"
                title="First Page">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path fill="none" d="M24 0v24H0V0h24z" opacity=".87"></path>
                <path d="M17.7 15.89L13.82 12l3.89-3.89c.39-.39.39-1.02 0-1.41-.39-.39-1.02-.39-1.41 0l-4.59 4.59c-.39.39-.39 1.02 0 1.41l4.59 4.59c.39.39 1.02.39 1.41 0 .38-.38.38-1.02-.01-1.4zM7 6c.55 0 1 .45 1 1v10c0 .55-.45 1-1 1s-1-.45-1-1V7c0-.55.45-1 1-1z"></path>
            </svg>
        </button>

        <button class="flex h-8 w-8 items-center justify-center rounded hover:bg-slate-100 disabled:opacity-30 disabled:hover:bg-transparent transition text-slate-600"
                @onclick="GoToPreviousPage"
                disabled="@(!CanGoPrevious || IsLoading)"
                title="Previous Page">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M14.71 15.88L10.83 12l3.88-3.88c.39-.39.39-1.02 0-1.41-.39-.39-1.02-.39-1.41 0L8.71 11.3c-.39.39-.39 1.02 0 1.41l4.59 4.59c.39.39 1.02.39 1.41 0 .38-.39.39-1.03 0-1.42z"></path>
            </svg>
        </button>

        <button class="flex h-8 w-8 items-center justify-center rounded hover:bg-slate-100 disabled:opacity-30 disabled:hover:bg-transparent transition text-slate-600"
                @onclick="GoToNextPage"
                disabled="@(!CanGoNext || IsLoading)"
                title="Next Page">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M9.29 15.88L13.17 12 9.29 8.12c-.39-.39-.39-1.02 0-1.41.39-.39 1.02-.39 1.41 0l4.59 4.59c.39.39.39 1.02 0 1.41L10.7 17.3c-.39.39-1.02.39-1.41 0-.38-.39-.39-1.03 0-1.42z"></path>
            </svg>
        </button>

        <button class="flex h-8 w-8 items-center justify-center rounded hover:bg-slate-100 disabled:opacity-30 disabled:hover:bg-transparent transition text-slate-600"
                @onclick="GoToLastPage"
                disabled="@(CurrentPage == TotalPages || IsLoading)"
                title="Last Page">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path fill="none" d="M0 0h24v24H0V0z" opacity=".87"></path>
                <path d="M6.29 8.11L10.18 12l-3.89 3.89c-.39.39-.39 1.02 0 1.41.39.39 1.02.39 1.41 0l4.59-4.59c.39-.39.39-1.02 0-1.41L7.7 6.7c-.39-.39-1.02-.39-1.41 0-.38.39-.38 1.03 0 1.41zM17 6c.55 0 1 .45 1 1v10c0 .55-.45 1-1 1s-1-.45-1-1V7c0-.55.45-1 1-1z"></path>
            </svg>
        </button>
    </div>
</div>
                </div>
            </div>
        </section>

        <section class="flex flex-col gap-4">
            <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sticky top-6">
                <div class="mb-5 flex items-center justify-between border-b border-slate-100 pb-4">
                    <div>
                        <h2 class="text-base font-bold text-slate-900">Thêm hội viên</h2>
                        <p class="text-xs text-slate-500">Tạo hồ sơ khách hàng mới</p>
                    </div>
                    <div class="h-8 w-8 rounded-full bg-blue-50 flex items-center justify-center text-blue-600">
                        <i class="fa-solid fa-user-plus text-sm"></i>
                    </div>
                </div>

                <EditForm Model="@NewCustomer" OnValidSubmit="HandleCreateCustomer" class="space-y-4">
                    <DataAnnotationsValidator />
                    
                    <div>
                        <label class="mb-1.5 block text-xs font-bold text-slate-700 uppercase tracking-wide">Tên đầy đủ</label>
                        <div class="relative">
                            <i class="fa-solid fa-user absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                            <InputText @bind-Value="NewCustomer.FullName" class="w-full rounded-xl border border-slate-200 py-2.5 pl-9 pr-3 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 transition" placeholder="Ví dụ: Nguyễn Văn A" />
                        </div>
                    </div>

                    <div>
                        <label class="mb-1.5 block text-xs font-bold text-slate-700 uppercase tracking-wide">Số điện thoại</label>
                        <InputText @bind-Value="NewCustomer.Phone" class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" placeholder="09xx..." />
                    </div>

                    <div>
                        <label class="mb-1.5 block text-xs font-bold text-slate-700 uppercase tracking-wide">Email</label>
                        <div class="relative">
                            <i class="fa-solid fa-envelope absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                            <InputText @bind-Value="NewCustomer.Email" class="w-full rounded-xl border border-slate-200 py-2.5 pl-9 pr-3 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500" placeholder="customer@email.com" />
                        </div>
                    </div>

                    <div>
                        <label class="mb-1.5 block text-xs font-bold text-slate-700 uppercase tracking-wide">Địa chỉ</label>
                        <InputTextArea @bind-Value="NewCustomer.Address" rows="3" class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 resize-none" placeholder="Địa chỉ giao hàng..."></InputTextArea>
                    </div>

                    <button type="submit" disabled="@IsSaving" class="w-full rounded-xl bg-slate-900 py-3 text-sm font-bold text-white shadow-sm hover:bg-slate-800 transition flex items-center justify-center gap-2 disabled:opacity-50">
                        @if (IsSaving)
                        {
                            <i class="fa-solid fa-spinner fa-spin"></i> <span>Đang lưu...</span>
                        }
                        else
                        {
                            <i class="fa-solid fa-check"></i> <span>Lưu hồ sơ</span>
                        }
                    </button>
                </EditForm>
            </div>
        </section>
    </div>
</div>

@* Edit Customer Modal *@
@if (IsEditModalOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50" @onclick="CloseEditModal">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-md mx-4" @onclick:stopPropagation="true">
            <div class="flex items-center justify-between p-5 border-b border-slate-100">
                <div>
                    <h2 class="text-lg font-bold text-slate-900">Sửa thông tin khách hàng</h2>
                    <p class="text-xs text-slate-500">Cập nhật hồ sơ khách hàng</p>
                </div>
                <button @onclick="CloseEditModal" class="text-slate-400 hover:text-slate-600 transition p-2">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <div class="p-5">
                @if (IsLoadingEditCustomer)
                {
                    <div class="flex items-center justify-center py-8">
                        <i class="fa-solid fa-spinner fa-spin text-2xl text-slate-400"></i>
                    </div>
                }
                else
                {
                    <EditForm Model="@EditCustomer" OnValidSubmit="HandleUpdateCustomer" class="space-y-4">
                        <DataAnnotationsValidator />
                        
                        <div>
                            <label class="mb-1.5 block text-xs font-bold text-slate-700 uppercase tracking-wide">Tên đầy đủ</label>
                            <div class="relative">
                                <i class="fa-solid fa-user absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                                <InputText @bind-Value="EditCustomer.FullName" class="w-full rounded-xl border border-slate-200 py-2.5 pl-9 pr-3 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 transition" placeholder="Ví dụ: Nguyễn Văn A" />
                            </div>
                        </div>

                        <div>
                            <label class="mb-1.5 block text-xs font-bold text-slate-700 uppercase tracking-wide">Số điện thoại</label>
                            <InputText @bind-Value="EditCustomer.Phone" class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" placeholder="09xx..." />
                        </div>

                        <div>
                            <label class="mb-1.5 block text-xs font-bold text-slate-700 uppercase tracking-wide">Email</label>
                            <div class="relative">
                                <i class="fa-solid fa-envelope absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                                <InputText @bind-Value="EditCustomer.Email" class="w-full rounded-xl border border-slate-200 py-2.5 pl-9 pr-3 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500" placeholder="customer@email.com" />
                            </div>
                        </div>

                        <div>
                            <label class="mb-1.5 block text-xs font-bold text-slate-700 uppercase tracking-wide">Địa chỉ</label>
                            <InputTextArea @bind-Value="EditCustomer.Address" rows="3" class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 resize-none" placeholder="Địa chỉ giao hàng..."></InputTextArea>
                        </div>

                        @* Account Info Section *@
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
                            <div class="flex items-center gap-2 mb-3">
                                <i class="fa-solid fa-user-shield text-slate-500"></i>
                                <span class="text-xs font-bold text-slate-700 uppercase tracking-wide">Thông tin tài khoản</span>
                            </div>
                            @if (CustomerAccountInfo == null)
                            {
                                <div class="flex items-center justify-center py-2">
                                    <i class="fa-solid fa-spinner fa-spin text-slate-400"></i>
                                </div>
                            }
                            else if (CustomerAccountInfo.HasAccount)
                            {
                                <div class="space-y-3 text-sm">
                                    <div class="flex items-center justify-between">
                                        <span class="text-slate-500">Tên đăng nhập:</span>
                                        <span class="font-medium text-slate-900">@CustomerAccountInfo.Username</span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-slate-500">Trạng thái:</span>
                                        <div class="flex items-center gap-2">
                                            @if (CustomerAccountInfo.IsActive)
                                            {
                                                <span class="inline-flex items-center gap-1 rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700">
                                                    <i class="fa-solid fa-circle text-[6px]"></i> Đang hoạt động
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center gap-1 rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-700">
                                                    <i class="fa-solid fa-circle text-[6px]"></i> Đã khóa
                                                </span>
                                            }
                                            <button type="button" @onclick="HandleToggleAccountStatus" disabled="@IsTogglingStatus"
                                                    class="text-xs px-2 py-1 rounded-lg border transition @(CustomerAccountInfo.IsActive ? "border-red-200 text-red-600 hover:bg-red-50" : "border-green-200 text-green-600 hover:bg-green-50") disabled:opacity-50">
                                                @if (IsTogglingStatus)
                                                {
                                                    <i class="fa-solid fa-spinner fa-spin"></i>
                                                }
                                                else if (CustomerAccountInfo.IsActive)
                                                {
                                                    <i class="fa-solid fa-lock"></i> <span>Khóa</span>
                                                }
                                                else
                                                {
                                                    <i class="fa-solid fa-unlock"></i> <span>Mở khóa</span>
                                                }
                                            </button>
                                        </div>
                                    </div>
                                    @if (CustomerAccountInfo.LastLogin.HasValue)
                                    {
                                        <div class="flex items-center justify-between">
                                            <span class="text-slate-500">Đăng nhập lần cuối:</span>
                                            <span class="font-medium text-slate-700">@CustomerAccountInfo.LastLogin.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                        </div>
                                    }

                                    @* Change Password Section *@
                                    <div class="pt-3 border-t border-slate-200">
                                        <div class="flex items-center justify-between mb-2">
                                            <span class="text-slate-500">Đổi mật khẩu:</span>
                                            @if (!ShowPasswordChange)
                                            {
                                                <button type="button" @onclick="() => ShowPasswordChange = true" class="text-xs px-2 py-1 rounded-lg border border-blue-200 text-blue-600 hover:bg-blue-50 transition">
                                                    <i class="fa-solid fa-key"></i> Đổi mật khẩu
                                                </button>
                                            }
                                        </div>
                                        @if (ShowPasswordChange)
                                        {
                                            <div class="space-y-2">
                                                <div class="relative">
                                                    <i class="fa-solid fa-lock absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                                                    <input type="password" @bind="NewPassword" class="w-full rounded-lg border border-slate-200 py-2 pl-9 pr-3 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500" placeholder="Mật khẩu mới (tối thiểu 6 ký tự)" />
                                                </div>
                                                @if (!string.IsNullOrEmpty(PasswordChangeMessage))
                                                {
                                                    <p class="text-xs @(PasswordChangeSuccess ? "text-green-600" : "text-red-600")">@PasswordChangeMessage</p>
                                                }
                                                <div class="flex gap-2">
                                                    <button type="button" @onclick="() => { ShowPasswordChange = false; NewPassword = string.Empty; PasswordChangeMessage = null; }" class="flex-1 text-xs py-1.5 rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50 transition">
                                                        Hủy
                                                    </button>
                                                    <button type="button" @onclick="HandleChangePassword" disabled="@IsChangingPassword" class="flex-1 text-xs py-1.5 rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition disabled:opacity-50 flex items-center justify-center gap-1">
                                                        @if (IsChangingPassword)
                                                        {
                                                            <i class="fa-solid fa-spinner fa-spin"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="fa-solid fa-save"></i> <span>Lưu</span>
                                                        }
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="flex items-center gap-2 text-sm text-slate-500">
                                    <i class="fa-solid fa-circle-info text-amber-500"></i>
                                    <span>Khách hàng này chưa có tài khoản đăng nhập</span>
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(EditErrorMessage))
                        {
                            <div class="rounded-lg bg-red-50 p-3 border border-red-100">
                                <p class="text-sm text-red-600">@EditErrorMessage</p>
                            </div>
                        }

                        <div class="flex gap-3 pt-2">
                            <button type="button" @onclick="CloseEditModal" class="flex-1 rounded-xl border border-slate-200 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition">
                                Hủy
                            </button>
                            <button type="submit" disabled="@IsUpdating" class="flex-1 rounded-xl bg-blue-600 py-2.5 text-sm font-bold text-white shadow-sm hover:bg-blue-700 transition flex items-center justify-center gap-2 disabled:opacity-50">
                                @if (IsUpdating)
                                {
                                    <i class="fa-solid fa-spinner fa-spin"></i> <span>Đang lưu...</span>
                                }
                                else
                                {
                                    <i class="fa-solid fa-check"></i> <span>Cập nhật</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                }
            </div>
        </div>
    </div>
}

@code {
    private List<AdminCustomerDto> CustomersData = new();
    private CreateCustomerDto NewCustomer = new();
    private bool IsLoading = true;
    private bool IsSaving = false;
    private int CurrentPage = 1;
    private int PageSize = 10;
    private int TotalCustomers;
    private int TotalPages => TotalCustomers == 0 ? 1 : (int)Math.Ceiling(TotalCustomers / (double)PageSize);
    private int DisplayFrom => TotalCustomers == 0 ? 0 : ((CurrentPage - 1) * PageSize) + 1;
    private int DisplayTo => TotalCustomers == 0 ? 0 : Math.Min(TotalCustomers, ((CurrentPage - 1) * PageSize) + CustomersData.Count);
    private bool CanGoPrevious => CurrentPage > 1;
    private bool CanGoNext => TotalCustomers > 0 && CurrentPage < TotalPages;
    
    // Search functionality
    private string SearchTerm = string.Empty;
    private System.Timers.Timer? _searchDebounceTimer;
    
    // Edit modal state
    private bool IsEditModalOpen = false;
    private bool IsLoadingEditCustomer = false;
    private bool IsUpdating = false;
    private int EditingCustomerId = 0;
    private UpdateCustomerDto EditCustomer = new();
    private string? EditErrorMessage = null;
    private CustomerAccountInfoDto? CustomerAccountInfo = null;

    // Account management state
    private bool ShowPasswordChange = false;
    private string NewPassword = string.Empty;
    private bool IsChangingPassword = false;
    private string? PasswordChangeMessage = null;
    private bool PasswordChangeSuccess = false;
    private bool IsTogglingStatus = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
    }

    private async Task LoadCustomers()
    {
        IsLoading = true;
        try
        {
            var result = await CustomerService.GetCustomersAsync(CurrentPage, PageSize, SearchTerm);

            if (result.TotalPages > 0 && CurrentPage > result.TotalPages)
            {
                CurrentPage = result.TotalPages;
                result = await CustomerService.GetCustomersAsync(CurrentPage, PageSize, SearchTerm);
            }
            else if (result.TotalPages == 0 && CurrentPage != 1)
            {
                CurrentPage = 1;
                result = await CustomerService.GetCustomersAsync(CurrentPage, PageSize, SearchTerm);
            }

            CustomersData = new List<AdminCustomerDto>(result.Items);
            TotalCustomers = result.TotalCount;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading customers: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }
    
    private void OnSearchInputChanged()
    {
        // Debounce search to avoid too many requests
        _searchDebounceTimer?.Stop();
        _searchDebounceTimer?.Dispose();
        
        _searchDebounceTimer = new System.Timers.Timer(300);
        _searchDebounceTimer.Elapsed += async (sender, e) =>
        {
            _searchDebounceTimer?.Stop();
            await InvokeAsync(async () =>
            {
                CurrentPage = 1; // Reset to first page when searching
                await LoadCustomers();
                StateHasChanged();
            });
        };
        _searchDebounceTimer.AutoReset = false;
        _searchDebounceTimer.Start();
    }
    
    private async Task OpenEditModal(int customerId)
    {
        EditingCustomerId = customerId;
        IsEditModalOpen = true;
        IsLoadingEditCustomer = true;
        EditErrorMessage = null;
        CustomerAccountInfo = null;

        try
        {
            var customer = await CustomerService.GetCustomerByIdAsync(customerId);
            if (customer != null)
            {
                EditCustomer = new UpdateCustomerDto
                {
                    FullName = customer.Name,
                    Phone = customer.Phone,
                    Email = customer.Email,
                    Address = customer.Address
                };

                // Load account info
                CustomerAccountInfo = await CustomerService.GetCustomerAccountAsync(customerId);
            }
            else
            {
                EditErrorMessage = "Không tìm thấy khách hàng.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading customer: {ex.Message}");
            EditErrorMessage = "Lỗi khi tải thông tin khách hàng.";
        }
        finally
        {
            IsLoadingEditCustomer = false;
        }
    }

    private void CloseEditModal()
    {
        IsEditModalOpen = false;
        EditingCustomerId = 0;
        EditCustomer = new();
        EditErrorMessage = null;
        CustomerAccountInfo = null;
        // Reset account management state
        ShowPasswordChange = false;
        NewPassword = string.Empty;
        PasswordChangeMessage = null;
        PasswordChangeSuccess = false;
    }
    
    private async Task HandleUpdateCustomer()
    {
        IsUpdating = true;
        EditErrorMessage = null;
        
        try
        {
            await CustomerService.UpdateCustomerAsync(EditingCustomerId, EditCustomer);
            CloseEditModal();
            await LoadCustomers(); // Reload list to show updated data
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating customer: {ex.Message}");
            EditErrorMessage = "Lỗi khi cập nhật thông tin khách hàng.";
        }
        finally
        {
            IsUpdating = false;
        }
    }

    private async Task HandleCreateCustomer()
    {
        IsSaving = true;
        try
        {
            await CustomerService.CreateCustomerAsync(NewCustomer);
            NewCustomer = new(); // Reset form
            CurrentPage = 1;
            await LoadCustomers(); // Reload list
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating customer: {ex.Message}");
            // Show error notification if needed
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task GoToPreviousPage()
    {
        if (!CanGoPrevious || IsLoading)
        {
            return;
        }

        CurrentPage--;
        await LoadCustomers();
    }

    private async Task GoToNextPage()
    {
        if (!CanGoNext || IsLoading)
        {
            return;
        }

        CurrentPage++;
        await LoadCustomers();
    }

    // Hàm tiện ích lấy chữ cái đầu của tên để làm Avatar
    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "KH";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpper();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }
    private async Task GoToFirstPage()
    {
        if (CurrentPage == 1 || IsLoading) return;
        
        CurrentPage = 1;
        await LoadCustomers();
    }

    // Thêm hàm về trang cuối
    private async Task GoToLastPage()
    {
        if (CurrentPage == TotalPages || IsLoading) return;

        CurrentPage = TotalPages;
        await LoadCustomers();
    }
private async Task OnPageInputChanged(ChangeEventArgs e)
    {
        if (IsLoading) return;

        // Thử parse giá trị nhập vào
        if (int.TryParse(e.Value?.ToString(), out int inputPage))
        {
            // Logic validation (Validation dữ liệu)
            if (inputPage < 1) 
            {
                inputPage = 1; // Nếu nhập 0 hoặc âm -> về 1
            }
            else if (inputPage > TotalPages) 
            {
                inputPage = TotalPages; // Nếu nhập 1000 mà chỉ có 10 trang -> về 10
            }

            // Nếu số trang hợp lệ và KHÁC trang hiện tại thì mới reload
            if (inputPage != CurrentPage)
            {
                CurrentPage = inputPage;
                await LoadCustomers();
            }
            else
            {
                // Trường hợp người dùng nhập số tầm bậy (ví dụ nhập 9999), 
                // logic trên đã ép về TotalPages (ví dụ 10).
                // Tuy nhiên UI Input vẫn đang hiện 9999.
                // Dòng này để ép UI cập nhật lại con số đúng (10) nếu Blazor không tự render lại.
                // (Chỉ mang tính chất đảm bảo UI đồng bộ)
                CurrentPage = inputPage; 
            }
        }
    }
    // ... Các biến cũ giữ nguyên ...
    
    // Hàm xử lý khi thay đổi Dropdown "Rows per page"
    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newPageSize))
        {
            PageSize = newPageSize;
            CurrentPage = 1; // Reset về trang 1 khi đổi số lượng dòng
            await LoadCustomers();
        }
    }

    private async Task HandleChangePassword()
    {
        if (string.IsNullOrWhiteSpace(NewPassword))
        {
            PasswordChangeMessage = "Vui lòng nhập mật khẩu mới.";
            PasswordChangeSuccess = false;
            return;
        }

        if (NewPassword.Length < 6)
        {
            PasswordChangeMessage = "Mật khẩu phải có ít nhất 6 ký tự.";
            PasswordChangeSuccess = false;
            return;
        }

        IsChangingPassword = true;
        PasswordChangeMessage = null;

        try
        {
            var success = await CustomerService.UpdateAccountPasswordAsync(EditingCustomerId, NewPassword);
            if (success)
            {
                PasswordChangeMessage = "Đổi mật khẩu thành công!";
                PasswordChangeSuccess = true;
                NewPassword = string.Empty;
                // Auto hide after 2 seconds
                _ = Task.Delay(2000).ContinueWith(_ =>
                {
                    InvokeAsync(() =>
                    {
                        ShowPasswordChange = false;
                        PasswordChangeMessage = null;
                        StateHasChanged();
                    });
                });
            }
            else
            {
                PasswordChangeMessage = "Không thể đổi mật khẩu. Vui lòng thử lại.";
                PasswordChangeSuccess = false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error changing password: {ex.Message}");
            PasswordChangeMessage = "Lỗi khi đổi mật khẩu.";
            PasswordChangeSuccess = false;
        }
        finally
        {
            IsChangingPassword = false;
        }
    }

    private async Task HandleToggleAccountStatus()
    {
        if (CustomerAccountInfo == null || !CustomerAccountInfo.HasAccount)
            return;

        IsTogglingStatus = true;

        try
        {
            var success = await CustomerService.ToggleAccountStatusAsync(EditingCustomerId);
            if (success)
            {
                // Reload account info to reflect the change
                CustomerAccountInfo = await CustomerService.GetCustomerAccountAsync(EditingCustomerId);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error toggling account status: {ex.Message}");
        }
        finally
        {
            IsTogglingStatus = false;
        }
    }

}
