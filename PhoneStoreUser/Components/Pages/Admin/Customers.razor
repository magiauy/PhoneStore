@page "/admin/customers"
@layout AdminLayout

<div class="space-y-4">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-lg font-semibold text-gray-900">Khách hàng</h1>
            <p class="text-sm text-gray-500">Chăm sóc hội viên và lịch sử mua</p>
        </div>
        <div class="flex items-center gap-2">
            <input class="rounded-lg border border-gray-300 p-2 text-sm focus:ring-2 focus:ring-blue-500" placeholder="Tìm theo tên hoặc số điện thoại" />
            <button class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700 transition">Thêm hội viên</button>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-3 lg:grid-cols-3">
        <section class="lg:col-span-2 rounded-xl border bg-white p-4 shadow-sm">
            <div class="flex items-center justify-between mb-3">
                <div>
                    <h2 class="text-base font-semibold text-gray-900">Danh sách khách hàng</h2>
                    <p class="text-sm text-gray-500">Ưu tiên khách VIP và đã mua flagship</p>
                </div>
                <select class="rounded-lg border border-gray-300 p-2 text-sm focus:ring-2 focus:ring-blue-500">
                    <option>Tất cả hạng</option>
                    <option>VIP</option>
                    <option>Thành viên</option>
                    <option>Khách mới</option>
                </select>
            </div>
            <div class="overflow-x-auto">
                <table class="min-w-full text-sm">
                    <thead class="bg-gray-50 text-gray-700 text-sm font-medium">
                        <tr>
                            <th class="p-3 text-left">Khách hàng</th>
                            <th class="p-3 text-left">Hạng</th>
                            <th class="p-3 text-left">Đơn gần nhất</th>
                            <th class="p-3 text-left">Giá trị</th>
                            <th class="p-3 text-left">Trạng thái</th>
                            <th class="p-3 text-right">Tương tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in CustomersData)
                        {
                            <tr class="border-b border-gray-200 hover:bg-gray-50">
                                <td class="p-3">
                                    <p class="text-sm font-semibold text-gray-900">@customer.Name</p>
                                    <p class="text-xs text-gray-500">@customer.Phone</p>
                                </td>
                                <td class="p-3 text-gray-700">@customer.Tier</td>
                                <td class="p-3 text-gray-700">@customer.LastOrder</td>
                                <td class="p-3 text-blue-600 font-semibold">@customer.Value</td>
                                <td class="p-3">
                                    <span class="rounded-full bg-blue-600/10 text-blue-600 px-2.5 py-1 text-xs font-medium">@customer.Status</span>
                                </td>
                                <td class="p-3 text-right">
                                    <button class="rounded-lg border border-gray-200 px-3 py-1.5 text-xs font-semibold text-gray-700 hover:border-blue-600 hover:text-blue-600 transition">Ghi chú</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="rounded-xl border bg-white p-4 shadow-sm space-y-3">
            <div>
                <h2 class="text-base font-semibold text-gray-900">Thêm khách hàng</h2>
                <p class="text-sm text-gray-500">Gán hạng và ưu đãi ngay</p>
            </div>
            <div class="space-y-3">
                <div>
                    <label class="text-sm text-gray-600 font-medium mb-1 block">Tên đầy đủ</label>
                    <input class="w-full rounded-lg border border-gray-300 p-2 text-sm focus:ring-2 focus:ring-blue-500" placeholder="VD: Nguyễn Lê Anh" />
                </div>
                <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                    <div>
                        <label class="text-sm text-gray-600 font-medium mb-1 block">Số điện thoại</label>
                        <input class="w-full rounded-lg border border-gray-300 p-2 text-sm focus:ring-2 focus:ring-blue-500" placeholder="09xx xxx xxx" />
                    </div>
                    <div>
                        <label class="text-sm text-gray-600 font-medium mb-1 block">Email</label>
                        <input class="w-full rounded-lg border border-gray-300 p-2 text-sm focus:ring-2 focus:ring-blue-500" placeholder="customer@guzone.vn" />
                    </div>
                </div>
                <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                    <div>
                        <label class="text-sm text-gray-600 font-medium mb-1 block">Hạng</label>
                        <select class="w-full rounded-lg border border-gray-300 p-2 text-sm focus:ring-2 focus:ring-blue-500">
                            <option>VIP</option>
                            <option>Thành viên</option>
                            <option>Khách mới</option>
                        </select>
                    </div>
                    <div>
                        <label class="text-sm text-gray-600 font-medium mb-1 block">Ghi chú</label>
                        <input class="w-full rounded-lg border border-gray-300 p-2 text-sm focus:ring-2 focus:ring-blue-500" placeholder="Ưu đãi, ghi chú chăm sóc" />
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <input type="checkbox" class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500" checked />
                    <span class="text-sm text-gray-700">Gửi email welcome</span>
                </div>
                <button class="w-full rounded-lg bg-blue-600 py-2 text-sm font-semibold text-white hover:bg-blue-700 transition">Lưu khách hàng</button>
            </div>
        </section>
    </div>
</div>

@code {
    private List<CustomerRow> CustomersData = new()
    {
        new("Nguyễn Hà Vy", "0963 123 888", "VIP", "iPhone 15 Pro Max", "₫32.990.000", "Active"),
        new("Trương Minh Khải", "0909 777 188", "Thành viên", "Galaxy S24 Ultra", "₫29.900.000", "Active"),
        new("Lê Quốc Dũng", "0987 555 221", "VIP", "MacBook Air M3", "₫32.990.000", "Active"),
        new("Phạm Anh Khoa", "0911 345 222", "Khách mới", "iPhone 14 128GB", "₫16.490.000", "Theo dõi"),
        new("Bùi Thái Hòa", "0933 448 992", "Thành viên", "iPad Air M2", "₫21.500.000", "Active"),
    };

    private record CustomerRow(string Name, string Phone, string Tier, string LastOrder, string Value, string Status);
}
