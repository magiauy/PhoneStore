@page "/admin/purchase-orders/create"
@page "/admin/purchase-orders/edit/{Id:int}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using PhoneStoreUser.Data
@using PhoneStoreUser.Models
@using PhoneStoreUser.Services
@using System.Text.Json
@inject IPurchaseOrderService PurchaseOrderService
@inject ISupplierService SupplierService
@inject IProductService ProductService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@layout Layout.AdminLayout
@attribute [Authorize(Policy = "AdminOnly")]

<div class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-gray-800">
            @(Id.HasValue ? $"Chi tiết phiếu nhập #{Id}" : "Tạo phiếu nhập mới")
        </h1>
        <button @onclick="GoBack" class="text-gray-600 hover:text-gray-800">
            <i class="fas fa-arrow-left mr-2"></i>Quay lại
        </button>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-10">
            <div class="spinner-border text-blue-600" role="status">
                <span class="sr-only">Đang tải...</span>
            </div>
        </div>
    }
    else
    {
        <EditForm Model="purchaseOrder" OnValidSubmit="SaveDraft">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                <div class="bg-white shadow rounded-lg p-6">
                    <h2 class="text-lg font-semibold mb-4">Thông tin chung</h2>
                    <div class="mb-4">
                        <label class="block text-gray-700 text-sm font-bold mb-2">Nhà cung cấp</label>
                        <div class="flex items-center justify-between gap-3 rounded border border-gray-200 bg-gray-50 px-3 py-2">
                            <span class="text-gray-800 font-medium">
                                @(string.IsNullOrWhiteSpace(purchaseOrder.SupplierName) ? "Chưa chọn nhà cung cấp" : purchaseOrder.SupplierName)
                            </span>
                            @if (IsEditable)
                            {
                                <button type="button" class="text-sm bg-blue-600 hover:bg-blue-700 text-white font-semibold px-3 py-1 rounded shadow" @onclick="OpenSupplierModal">
                                    Chọn
                                </button>
                            }
                        </div>
                        <InputNumber @bind-Value="purchaseOrder.SupplierId" class="hidden" />
                        <ValidationMessage For="@(() => purchaseOrder.SupplierId)" />
                    </div>
                    <div class="mb-4">
                        <label class="block text-gray-700 text-sm font-bold mb-2">Ghi chú</label>
                        <InputTextArea @bind-Value="purchaseOrder.Note" class="shadow border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" rows="3" disabled="@(!IsEditable)" />
                    </div>
                    @if (Id.HasValue)
                    {
                        <div class="mb-4">
                            <label class="block text-gray-700 text-sm font-bold mb-2">Trạng thái</label>
                            <span class="px-3 py-1 rounded-full text-sm font-semibold @GetStatusClass(purchaseOrder.Status)">
                                @purchaseOrder.Status
                            </span>
                        </div>
                    }
                </div>

                <div class="bg-white shadow rounded-lg p-6 md:col-span-2">
                    <h2 class="text-lg font-semibold mb-4">Chi tiết nhập hàng</h2>

                    @if (IsEditable)
                    {
                        <div class="flex gap-4 mb-4">
                            <div class="flex-grow">
                                <select @bind="selectedProductId" class="shadow border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline">
                                    <option value="0">-- Chọn sản phẩm --</option>
                                    @foreach (var product in products)
                                    {
                                        <option value="@product.Id">@product.Name (@product.Sku)</option>
                                    }
                                </select>
                            </div>
                            <button type="button" @onclick="AddProduct" class="bg-green-500 hover:bg-green-600 text-white font-bold py-2 px-4 rounded">
                                <i class="fas fa-plus"></i> Thêm
                            </button>
                        </div>
                    }

                    <div class="overflow-x-auto">
                        <table class="min-w-full leading-normal">
                            <thead>
                                <tr>
                                    <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Sản phẩm</th>
                                    <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider w-24">Số lượng</th>
                                    <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider w-32">Đơn giá</th>
                                    <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Thành tiền</th>
                                    <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Serial</th>
                                    @if (IsEditable)
                                    {
                                        <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider"></th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @* FIX: Thêm @key để tránh lỗi hiển thị khi xóa dòng *@
                                @foreach (var line in purchaseOrder.Lines)
                                {
                                    <tr @key="line.ProductId"> 
                                        <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
                                            <p class="text-gray-900 whitespace-no-wrap">@line.ProductName</p>
                                            <p class="text-gray-500 text-xs">@line.ProductSku</p>
                                        </td>
                                    <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
                                            @* FIX: Use standard input for immediate update on typing *@
                                            <input type="number" @bind="line.Quantity" @bind:event="oninput" 
                                                   class="w-full border rounded px-2 py-1" 
                                                   disabled="@(!IsEditable)" min="1" />
                                        </td>
                                        <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
                                            <InputNumber @bind-Value="line.UnitCost" class="w-full border rounded px-2 py-1" disabled="@(!IsEditable)" />
                                        </td>
                                        <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
                                            @((line.Quantity * line.UnitCost).ToString("N0")) ₫
                                        </td>
                                        <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
                                            @if (line.IsSerialTracked)
                                            {
                                                <button type="button" @onclick="() => OpenSerialModal(line)" class="text-blue-600 hover:text-blue-900 underline">
                                                    @* FIX: Only count serials that actually have values *@
                                                    @(line.Serials.Count(s => !string.IsNullOrWhiteSpace(s.SerialNumber)))/@line.Quantity Serial
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="text-gray-400">N/A</span>
                                            }
                                        </td>
                                        @if (IsEditable)
                                        {
                                            <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm text-right">
                                                <button type="button" @onclick="() => RemoveLine(line)" class="text-red-600 hover:text-red-900">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </td>
                                        }
                                    </tr>
                                }
                                <tr>
                                    <td colspan="3" class="px-5 py-5 border-b border-gray-200 bg-gray-50 text-right font-bold">Tổng cộng:</td>
                                    <td colspan="3" class="px-5 py-5 border-b border-gray-200 bg-gray-50 font-bold text-blue-600">
                                        @purchaseOrder.Lines.Sum(l => l.Quantity * l.UnitCost).ToString("N0") ₫
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="flex justify-end gap-4">
                @if (IsEditable)
                {
                    <button type="submit" class="bg-gray-500 hover:bg-gray-600 text-white font-bold py-2 px-4 rounded">
                        <i class="fas fa-save mr-2"></i>Lưu nháp
                    </button>
                    
                    <button type="button" @onclick="OnClickComplete" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                        <i class="fas fa-check mr-2"></i>Hoàn tất nhập hàng
                    </button>
                }

                @if (Id.HasValue && string.Equals(purchaseOrder.Status, "DRAFT", StringComparison.OrdinalIgnoreCase))
                {
                    <button type="button" @onclick="CancelOrder" class="bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded">
                        <i class="fas fa-times mr-2"></i>Hủy phiếu
                    </button>
                }
            </div>
        </EditForm>
    }
</div>

@if (showSupplierModal)
{
    <div class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50">
        <div class="relative top-20 mx-auto w-11/12 md:w-2/3 lg:w-1/2">
            <div class="bg-white rounded-lg shadow-xl p-6">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-xl font-bold text-gray-800">Chọn nhà cung cấp</h3>
                    <button class="text-gray-500 hover:text-gray-700" @onclick="CloseSupplierModal">
                        <i class="fas fa-times"></i>
                    </button>
                </div>

                <div class="mb-4">
                    <input type="text"
                           class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                           placeholder="Tìm nhà cung cấp theo tên..."
                           value="@supplierSearchTerm"
                           @oninput="SupplierSearchInput" />
                </div>

                <div class="border rounded max-h-96 overflow-y-auto">
                    <Virtualize Context="supplier"
                                @ref="supplierVirtualize"
                                ItemsProvider="LoadSuppliers"
                                ItemSize="60">
                        <div class="px-4 py-3 border-b last:border-b-0 hover:bg-blue-50 cursor-pointer"
                             @onclick="() => SelectSupplier(supplier)">
                            <div class="font-semibold text-gray-900">@supplier.Name</div>
                            <div class="text-sm text-gray-600">
                                <span>@(string.IsNullOrWhiteSpace(supplier.Phone) ? "Không có SĐT" : supplier.Phone)</span>
                                <span class="ml-4">@((string.IsNullOrWhiteSpace(supplier.Email) ? "Không có email" : supplier.Email))</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(supplier.Address))
                            {
                                <div class="text-xs text-gray-500 mt-1">@supplier.Address</div>
                            }
                        </div>
                    </Virtualize>
                </div>

                <div class="mt-4 flex justify-end">
                    <button type="button" class="px-4 py-2 border border-gray-300 rounded text-gray-700 hover:bg-gray-50" @onclick="CloseSupplierModal">
                        Đóng
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showSerialModal && currentLine != null)
{
    <div class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50 flex items-center justify-center">
        <div class="relative p-5 border w-11/12 md:w-1/2 shadow-lg rounded-md bg-white">
            <div class="mt-3">
                <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Nhập Serial cho @currentLine.ProductName</h3>
                <div class="mb-4 text-sm text-gray-600">
                    Cần nhập: @currentLine.Quantity serials.
                </div>

                <div class="flex flex-wrap gap-4 mb-4">
                    <label class="inline-flex items-center">
                        <input type="checkbox" class="form-checkbox h-5 w-5 text-blue-600" @bind="useImei1" />
                        <span class="ml-2 text-gray-700">Nhập IMEI 1</span>
                    </label>
                    <label class="inline-flex items-center">
                        <input type="checkbox" class="form-checkbox h-5 w-5 text-blue-600" @bind="useImei2" />
                        <span class="ml-2 text-gray-700">Nhập IMEI 2</span>
                    </label>
                </div>

                <div class="max-h-96 overflow-y-auto pr-2">
                    @for (int i = 0; i < currentLine.Serials.Count; i++)
                    {
                        var index = i; 
                        var serialItem = currentLine.Serials[index];
                        var serialError = serialErrors.ContainsKey(index) ? serialErrors[index] : null;
                        var imei1Error = imei1Errors.ContainsKey(index) ? imei1Errors[index] : null;
                        var imei2Error = imei2Errors.ContainsKey(index) ? imei2Errors[index] : null;

                        <div class="mb-4 p-4 border rounded bg-gray-50 @(serialError != null || imei1Error != null || imei2Error != null ? "border-red-500 bg-red-50" : "")">
                            <div class="flex justify-between mb-2">
                                <span class="font-bold text-xs text-gray-500">Item #@(index + 1)</span>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700">Serial Number</label>
                                    <input type="text" @bind="serialItem.SerialNumber" @bind:event="oninput" 
                                           class="mt-1 block w-full border rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm @(serialError != null ? "border-red-500" : "")" 
                                           disabled="@(!IsEditable)" />
                                    @if (serialError != null)
                                    {
                                        <div class="text-red-500 text-xs mt-1">@serialError</div>
                                    }
                                </div>
                                @if (useImei1)
                                {
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700">IMEI 1</label>
                                        <input type="text" @bind="serialItem.Imei1" @bind:event="oninput"
                                               class="mt-1 block w-full border rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm @(imei1Error != null ? "border-red-500" : "")" 
                                               disabled="@(!IsEditable)" />
                                        @if (imei1Error != null)
                                        {
                                            <div class="text-red-500 text-xs mt-1">@imei1Error</div>
                                        }
                                    </div>
                                }
                                @if (useImei2)
                                {
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700">IMEI 2</label>
                                        <input type="text" @bind="serialItem.Imei2" @bind:event="oninput"
                                               class="mt-1 block w-full border rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm @(imei2Error != null ? "border-red-500" : "")" 
                                               disabled="@(!IsEditable)" />
                                        @if (imei2Error != null)
                                        {
                                            <div class="text-red-500 text-xs mt-1">@imei2Error</div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="flex justify-end mt-4 gap-2">
                     <button @onclick="CancelSerialModal" class="px-4 py-2 bg-gray-500 text-white text-base font-medium rounded-md shadow-sm hover:bg-gray-700 focus:outline-none">
                        Đóng (Không lưu)
                    </button>
                     <button @onclick="CloseSerialModal" class="px-4 py-2 bg-blue-500 text-white text-base font-medium rounded-md shadow-sm hover:bg-blue-700 focus:outline-none">
                        Kiểm tra & Lưu
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showConfirmModal)
{
    <div class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50 flex items-center justify-center">
        <div class="relative p-5 border w-96 shadow-lg rounded-md bg-white">
            <div class="mt-3 text-center">
                <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-blue-100 mb-4">
                    <i class="fas fa-question text-blue-600 text-lg"></i>
                </div>
                <h3 class="text-lg leading-6 font-medium text-gray-900">Xác nhận</h3>
                <div class="mt-2 px-7 py-3">
                    <p class="text-sm text-gray-500">
                        Bạn có chắc chắn muốn hoàn tất phiếu nhập này?
                        Hành động này sẽ cập nhật tồn kho và không thể hoàn tác.
                    </p>
                </div>
                <div class="items-center px-4 py-3">
                    <button @onclick="ConfirmCompleteOrder" class="px-4 py-2 bg-blue-500 text-white text-base font-medium rounded-md w-full shadow-sm hover:bg-blue-700 focus:outline-none mb-2">
                        Xác nhận hoàn tất
                    </button>
                    <button @onclick="() => showConfirmModal = false" class="px-4 py-2 bg-gray-100 text-gray-700 text-base font-medium rounded-md w-full shadow-sm hover:bg-gray-300 focus:outline-none">
                        Hủy bỏ
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private PurchaseOrderDTO purchaseOrder = new();
    private List<ProductEntity> products = new();
    private bool isLoading = true;
    private int selectedProductId;
    
    private bool showSupplierModal = false;
    private string supplierSearchTerm = string.Empty;
    private Virtualize<SupplierEntity>? supplierVirtualize;

    private bool showSerialModal = false;
    private bool showConfirmModal = false;
    private PurchaseOrderLineDTO? currentLine;
    
    // Checkbox flags
    private bool useImei1 = false;
    private bool useImei2 = false;

    // Error tracking: Index -> Error Message
    private Dictionary<int, string> serialErrors = new();
    private Dictionary<int, string> imei1Errors = new();
    private Dictionary<int, string> imei2Errors = new();

    private string? backupSerialsJson;

    private bool IsEditable => !Id.HasValue || string.Equals(purchaseOrder.Status, "DRAFT", StringComparison.OrdinalIgnoreCase);

    private void OpenSupplierModal()
    {
        if (!IsEditable)
        {
            return;
        }

        showSupplierModal = true;
    }

    private void CloseSupplierModal()
    {
        showSupplierModal = false;
    }

    private async Task SupplierSearchInput(ChangeEventArgs args)
    {
        supplierSearchTerm = args.Value?.ToString() ?? string.Empty;
        if (supplierVirtualize != null)
        {
            await supplierVirtualize.RefreshDataAsync();
        }
    }

    private void SelectSupplier(SupplierEntity supplier)
    {
        purchaseOrder.SupplierId = supplier.Id;
        purchaseOrder.SupplierName = supplier.Name;
        showSupplierModal = false;
    }

    private async ValueTask<ItemsProviderResult<SupplierEntity>> LoadSuppliers(ItemsProviderRequest request)
    {
        const int defaultBatchSize = 50;
        var take = Math.Max(defaultBatchSize, request.Count);
        var (items, totalCount) = await SupplierService.SearchSuppliersAsync(supplierSearchTerm, request.StartIndex, take);
        return new ItemsProviderResult<SupplierEntity>(items, totalCount);
    }

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try 
        {
            products = await ProductService.GetAllProductsAsync();

            if (Id.HasValue)
            {
                var po = await PurchaseOrderService.GetPurchaseOrderByIdAsync(Id.Value);
                if (po != null)
                {
                    purchaseOrder = po;
                    if (purchaseOrder.SupplierId > 0 && string.IsNullOrWhiteSpace(purchaseOrder.SupplierName))
                    {
                        var supplierInfo = SupplierService.GetSupplierById(purchaseOrder.SupplierId);
                        if (supplierInfo != null)
                        {
                            purchaseOrder.SupplierName = supplierInfo.Name;
                        }
                    }
                    // Đảm bảo list lines không null
                    if(purchaseOrder.Lines == null) purchaseOrder.Lines = new List<PurchaseOrderLineDTO>();
                }
                else
                {
                    Navigation.NavigateTo("/admin/purchase-orders");
                }
            }
            else
            {
                purchaseOrder = new PurchaseOrderDTO
                {
                    OrderDate = DateTime.Now,
                    CreatedBy = 1,
                    Lines = new List<PurchaseOrderLineDTO>() // Khởi tạo list
                };
            }
        }
        catch(Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Lỗi tải dữ liệu: {ex.Message}");
        }
        isLoading = false;
    }

    private void AddProduct()
    {
        if (selectedProductId == 0) return;

        var product = products.FirstOrDefault(p => p.Id == selectedProductId);
        if (product == null) return;

        var existingLine = purchaseOrder.Lines.FirstOrDefault(l => l.ProductId == selectedProductId);
        if (existingLine != null)
        {
            existingLine.Quantity++;
        }
        else
        {
            purchaseOrder.Lines.Add(new PurchaseOrderLineDTO
            {
                ProductId = product.Id,
                ProductName = product.Name,
                ProductSku = product.Sku,
                IsSerialTracked = product.IsSerialTracked,
                Quantity = 1,
                UnitCost = product.Cost,
                Serials = new List<ProductSerialDTO>()
            });
        }
        selectedProductId = 0;
    }

    private void RemoveLine(PurchaseOrderLineDTO line)
    {
        purchaseOrder.Lines.Remove(line);
    }

    // FIX LOGIC: Chuẩn bị dữ liệu trước khi hiển thị Modal
    private void OpenSerialModal(PurchaseOrderLineDTO line)
    {
        currentLine = line;
        
        if (currentLine.Serials == null) currentLine.Serials = new List<ProductSerialDTO>();

        // 1. Nếu số lượng Serial ít hơn Quantity -> Thêm mới
        while (currentLine.Serials.Count < currentLine.Quantity)
        {
            currentLine.Serials.Add(new ProductSerialDTO 
            { 
                ProductId = currentLine.ProductId,
                Status = "RESERVED", // Hoặc "in_stock" tùy logic
                SerialNumber = "",
                Imei1 = ""
            });
        }

        // 2. Nếu số lượng Serial nhiều hơn Quantity -> Xóa bớt phần thừa (tùy chọn)
        while (currentLine.Serials.Count > currentLine.Quantity)
        {
            currentLine.Serials.RemoveAt(currentLine.Serials.Count - 1);
        }

        // Reset errors
        serialErrors.Clear();
        imei1Errors.Clear();
        imei2Errors.Clear();

        // Default: If any existing item has IMEI, enable checkboxes
        if (currentLine.Serials.Any(s => !string.IsNullOrEmpty(s.Imei1))) useImei1 = true;
        if (currentLine.Serials.Any(s => !string.IsNullOrEmpty(s.Imei2))) useImei2 = true;

        // Backup for cancel
        backupSerialsJson = JsonSerializer.Serialize(currentLine.Serials);

        showSerialModal = true;
    }

    private async Task CloseSerialModal()
    {
        serialErrors.Clear();
        imei1Errors.Clear();
        imei2Errors.Clear();

        if (currentLine?.Serials != null)
        {
            var lineSerials = currentLine.Serials;
            bool hasErrors = false;

            // --- 1. Validate Serial Numbers ---
            // Local Duplicates
            var duplicateSerialGroups = lineSerials
                .Select((s, index) => new { s.SerialNumber, Index = index })
                .Where(x => !string.IsNullOrWhiteSpace(x.SerialNumber))
                .GroupBy(x => x.SerialNumber)
                .Where(g => g.Count() > 1);

            foreach (var group in duplicateSerialGroups)
            {
                foreach (var item in group)
                {
                    serialErrors[item.Index] = "Serial trùng lặp trong danh sách";
                    hasErrors = true;
                }
            }

            // DB Duplicates (Only check unique ones that aren't already locally duplicate to avoid redundant alerts)
            // But for simplicity, we iterate all non-empty serials
            for (int i = 0; i < lineSerials.Count; i++)
            {
                var s = lineSerials[i].SerialNumber;
                if (!string.IsNullOrWhiteSpace(s) && !serialErrors.ContainsKey(i))
                {
                    if (await PurchaseOrderService.IsSerialNumberExistsAsync(s))
                    {
                        serialErrors[i] = "Serial đã tồn tại trong hệ thống";
                        hasErrors = true;
                    }
                }
            }

            // --- 2. Validate IMEI 1 (if enabled) ---
            if (useImei1)
            {
                var duplicateImei1Groups = lineSerials
                    .Select((s, index) => new { s.Imei1, Index = index })
                    .Where(x => !string.IsNullOrWhiteSpace(x.Imei1))
                    .GroupBy(x => x.Imei1)
                    .Where(g => g.Count() > 1);

                foreach (var group in duplicateImei1Groups)
                {
                    foreach (var item in group)
                    {
                        imei1Errors[item.Index] = "IMEI 1 trùng lặp trong danh sách";
                        hasErrors = true;
                    }
                }

                for (int i = 0; i < lineSerials.Count; i++)
                {
                    var imei = lineSerials[i].Imei1;
                    if (!string.IsNullOrWhiteSpace(imei) && !imei1Errors.ContainsKey(i))
                    {
                        if (await PurchaseOrderService.IsImeiExistsAsync(imei))
                        {
                            imei1Errors[i] = "IMEI 1 đã tồn tại trong hệ thống";
                            hasErrors = true;
                        }
                    }
                }
            }

             // --- 3. Validate IMEI 2 (if enabled) ---
            if (useImei2)
            {
                var duplicateImei2Groups = lineSerials
                    .Select((s, index) => new { s.Imei2, Index = index })
                    .Where(x => !string.IsNullOrWhiteSpace(x.Imei2))
                    .GroupBy(x => x.Imei2)
                    .Where(g => g.Count() > 1);

                foreach (var group in duplicateImei2Groups)
                {
                    foreach (var item in group)
                    {
                        imei2Errors[item.Index] = "IMEI 2 trùng lặp trong danh sách";
                        hasErrors = true;
                    }
                }

                for (int i = 0; i < lineSerials.Count; i++)
                {
                    var imei = lineSerials[i].Imei2;
                    if (!string.IsNullOrWhiteSpace(imei) && !imei2Errors.ContainsKey(i))
                    {
                        if (await PurchaseOrderService.IsImeiExistsAsync(imei))
                        {
                            imei2Errors[i] = "IMEI 2 đã tồn tại trong hệ thống";
                            hasErrors = true;
                        }
                    }
                }
            }

            if (hasErrors)
            {
                // Don't close, show errors
                StateHasChanged();
                return;
            }
        }

        showSerialModal = false;
        currentLine = null;
    }

    private async Task CancelSerialModal()
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Dữ liệu chưa được lưu. Bạn có chắc chắn muốn đóng và hủy thay đổi?"))
        {
            return;
        }

        if (currentLine != null && !string.IsNullOrEmpty(backupSerialsJson))
        {
            // Restore from backup
            var restored = JsonSerializer.Deserialize<List<ProductSerialDTO>>(backupSerialsJson);
            if (restored != null)
            {
                currentLine.Serials = restored;
            }
        }

        showSerialModal = false;
        currentLine = null;
    }

    // Không cần hàm UpdateSerial thủ công nữa vì đã dùng @bind

    private async Task SaveDraft()
    {
        try
        {
            if (purchaseOrder.SupplierId <= 0)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Vui lòng chọn nhà cung cấp trước khi lưu.");
                showSupplierModal = true;
                StateHasChanged();
                return;
            }

            if (Id.HasValue)
            {
                await PurchaseOrderService.UpdatePurchaseOrderAsync(purchaseOrder);
                await JSRuntime.InvokeVoidAsync("alert", "Cập nhật thành công!");
            }
            else
            {
                var newId = await PurchaseOrderService.CreatePurchaseOrderAsync(purchaseOrder);
                Navigation.NavigateTo($"/admin/purchase-orders/edit/{newId}");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Lỗi: {ex.Message}");
        }
    }

    private async Task OnClickComplete()
    {
        if (purchaseOrder.SupplierId <= 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Vui lòng chọn nhà cung cấp trước khi hoàn tất.");
            return;
        }

        if (purchaseOrder.Lines == null || !purchaseOrder.Lines.Any())
        {
            await JSRuntime.InvokeVoidAsync("alert", "Vui lòng thêm sản phẩm vào phiếu nhập.");
            return;
        }
        
        foreach (var line in purchaseOrder.Lines)
        {
            if (line.IsSerialTracked)
            {
                // Validate serial input
                // FIX: Check if we have enough NON-EMPTY serials
                var validSerials = line.Serials.Count(s => !string.IsNullOrWhiteSpace(s.SerialNumber));
                if (validSerials < line.Quantity)
                {
                    await JSRuntime.InvokeVoidAsync("alert", $"Sản phẩm {line.ProductName} chưa nhập đủ Serial (Đã nhập: {validSerials}/{line.Quantity}).");
                    return;
                }
            }
        }

        showConfirmModal = true;
    }

    private async Task ConfirmCompleteOrder()
    {
        showConfirmModal = false;
        isLoading = true; // Show loading
        try
        {
            int orderId;
            if (Id.HasValue)
            {
                orderId = Id.Value;
                // Update latest data first if needed? No, backend should handle.
                await PurchaseOrderService.UpdatePurchaseOrderAsync(purchaseOrder);
            }
            else
            {
                // Create first
                orderId = await PurchaseOrderService.CreatePurchaseOrderAsync(purchaseOrder);
            }

            await PurchaseOrderService.CompletePurchaseOrderAsync(orderId);
            purchaseOrder.Status = "RECEIVED";
            
            // Navigate back to list
            Navigation.NavigateTo("/admin/purchase-orders");
        }
        catch (Exception ex)
        {
            isLoading = false;
            await JSRuntime.InvokeVoidAsync("alert", $"Lỗi: {ex.Message}");
        }
    }

    private async Task CancelOrder()
    {
        if (!Id.HasValue) return;

        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Bạn có chắc chắn hủy phiếu nhập này?"))
        {
            return;
        }

        try
        {
            await PurchaseOrderService.CancelPurchaseOrderAsync(Id.Value);
            purchaseOrder.Status = "CANCELLED";
            await JSRuntime.InvokeVoidAsync("alert", "Đã hủy phiếu nhập!");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Lỗi: {ex.Message}");
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/admin/purchase-orders");
    }

    private string GetStatusClass(string status)
    {
        return status?.ToUpper() switch
        {
            "DRAFT" => "bg-yellow-200 text-yellow-800",
            "RECEIVED" => "bg-green-200 text-green-800",
            "CANCELLED" => "bg-red-200 text-red-800",
            _ => "bg-gray-200 text-gray-800"
        };
    }
