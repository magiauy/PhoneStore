@page "/product"
@using System.Globalization
@using PhoneStoreUser.Components.Models

<PageTitle>Danh sách sản phẩm GuZone</PageTitle>

<div class="space-y-6">
    <section class="rounded-3xl border border-gray-200 bg-white/90 p-6 shadow-sm">
        <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#2563EB]">GuZone Catalog</p>
                <h1 class="text-2xl font-semibold text-gray-900">Tất cả product model</h1>
                <p class="text-sm text-gray-500">Tìm đúng flagship theo brand, danh mục, giá và thuộc tính kỹ thuật.</p>
            </div>
            <div class="rounded-2xl border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-600">
                <p class="font-semibold text-gray-900">@ProductModels.Count mẫu</p>
                <p>Đa dạng @Brands.Count thương hiệu • cập nhật mỗi tuần</p>
            </div>
        </div>
    </section>

    <div class="grid gap-5 lg:grid-cols-[280px_minmax(0,1fr)]">
        <aside class="space-y-4">
            <div class="rounded-3xl border border-gray-200 bg-white p-4 shadow-sm">
                <div class="flex items-center justify-between">
                    <h2 class="text-base font-semibold text-gray-900">Bộ lọc thông minh</h2>
                    <span class="text-xs text-gray-500">Realtime</span>
                </div>
                <div class="mt-4 space-y-4">
                    <div class="space-y-2">
                        <label class="text-xs font-semibold uppercase tracking-wide text-gray-500">Từ khóa</label>
                        <div class="flex items-center gap-2 rounded-2xl border border-gray-200 bg-gray-50 px-3 py-2">
                            <svg class="h-4 w-4 text-gray-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 4.5a6 6 0 1 1 0 12a6 6 0 0 1 0-12zm7 12l3.5 3.5" />
                            </svg>
                            <input type="search"
                                   placeholder="iPhone 12, Galaxy..."
                                   class="w-full bg-transparent text-sm text-gray-800 placeholder:text-gray-400 focus:outline-none"
                                   @bind-Value="SearchTerm"
                                   @bind-Value:event="oninput" />
                        </div>
                    </div>

                    <div class="space-y-2">
                        <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Thương hiệu</p>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var brand in Brands)
                            {
                                var isActive = SelectedBrandIds.Contains(brand.Id);
                                <button type="button"
                                        class="@GetPillClass(isActive)"
                                        @onclick="() => ToggleBrand(brand.Id)">@brand.Name</button>
                            }
                        </div>
                    </div>

                    <div class="space-y-2">
                        <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Danh mục</p>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var category in Categories)
                            {
                                var isActive = SelectedCategoryIds.Contains(category.Id);
                                <button type="button"
                                        class="@GetPillClass(isActive)"
                                        @onclick="() => ToggleCategory(category.Id)">@category.Name</button>
                            }
                        </div>
                    </div>

                    <div class="space-y-2">
                        <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Khoảng giá (VNĐ)</p>
                        <div class="grid gap-2 sm:grid-cols-2">
                            <div>
                                <label class="text-xs text-gray-500">Từ</label>
                                <input type="number"
                                       inputmode="numeric"
                                       placeholder="18.000.000"
                                       class="mt-1 w-full rounded-xl border border-gray-200 px-3 py-2 text-sm focus:border-[#2563EB] focus:ring-2 focus:ring-[#2563EB]/40"
                                       @bind-Value="MinPriceInput"
                                       @bind-Value:event="oninput" />
                            </div>
                            <div>
                                <label class="text-xs text-gray-500">Đến</label>
                                <input type="number"
                                       inputmode="numeric"
                                       placeholder="35.000.000"
                                       class="mt-1 w-full rounded-xl border border-gray-200 px-3 py-2 text-sm focus:border-[#2563EB] focus:ring-2 focus:ring-[#2563EB]/40"
                                       @bind-Value="MaxPriceInput"
                                       @bind-Value:event="oninput" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="rounded-3xl border border-gray-200 bg-white p-4 shadow-sm">
                <h3 class="text-base font-semibold text-gray-900">Thuộc tính</h3>
                <p class="text-xs text-gray-500">Chọn color, storage, RAM...</p>
                <div class="mt-4 space-y-4">
                    @foreach (var attribute in Attributes)
                    {
                        if (!AttributeOptions.TryGetValue(attribute.Id, out var options) || options.Count == 0)
                        {
                            continue;
                        }

                        <div class="space-y-2">
                            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">@(attribute.Name)</p>
                            <div class="flex flex-wrap gap-2">
                                @foreach (var option in options)
                                {
                                    var isActive = SelectedAttributeValues.TryGetValue(attribute.Id, out var selected) && selected.Contains(option);
                                    <button type="button"
                                            class="@GetPillClass(isActive)"
                                            @onclick="() => ToggleAttributeValue(attribute.Id, option)">@option</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </aside>

        <section class="space-y-4">
            @{
                var filteredModels = FilteredProductModels.ToList();
            }
            <div class="rounded-3xl border border-gray-200 bg-white p-4 shadow-sm">
                <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-[#2563EB]">Kết quả</p>
                        <h2 class="text-xl font-semibold text-gray-900">@filteredModels.Count product model</h2>
                        <p class="text-sm text-gray-500">Hiển thị theo điều kiện tìm kiếm realtime.</p>
                    </div>
                    <button type="button"
                            class="rounded-full border border-gray-200 px-4 py-2 text-sm font-semibold text-gray-600 transition hover:border-[#2563EB] hover:text-[#2563EB] disabled:cursor-not-allowed disabled:opacity-50"
                            disabled="@(!HasActiveFilters)"
                            @onclick="ClearAllFilters">
                        Xoá tất cả bộ lọc
                    </button>
                </div>

                @if (HasActiveFilters)
                {
                    <div class="mt-3 flex flex-wrap gap-2">
                        @if (!string.IsNullOrWhiteSpace(SearchTerm))
                        {
                            <button type="button" class="@GetChipClass()" @onclick="() => SearchTerm = string.Empty">
                                Từ khóa: <span class="font-semibold">@SearchTerm</span>
                                <span aria-hidden="true">×</span>
                            </button>
                        }

                        @foreach (var brandId in SelectedBrandIds)
                        {
                            if (BrandLookup.TryGetValue(brandId, out var brandName))
                            {
                                <button type="button" class="@GetChipClass()" @onclick="() => ToggleBrand(brandId)">
                                    Brand: <span class="font-semibold">@brandName</span>
                                    <span aria-hidden="true">×</span>
                                </button>
                            }
                        }

                        @foreach (var categoryId in SelectedCategoryIds)
                        {
                            if (CategoryLookup.TryGetValue(categoryId, out var categoryName))
                            {
                                <button type="button" class="@GetChipClass()" @onclick="() => ToggleCategory(categoryId)">
                                    Danh mục: <span class="font-semibold">@categoryName</span>
                                    <span aria-hidden="true">×</span>
                                </button>
                            }
                        }

                        @if (ParsedMinPrice.HasValue || ParsedMaxPrice.HasValue)
                        {
                            <button type="button" class="@GetChipClass()" @onclick="ClearPrice">
                                Giá: <span class="font-semibold">@GetPriceRangeLabel()</span>
                                <span aria-hidden="true">×</span>
                            </button>
                        }

                        @foreach (var attribute in Attributes)
                        {
                            if (!SelectedAttributeValues.TryGetValue(attribute.Id, out var selected) || selected.Count == 0)
                            {
                                continue;
                            }

                            foreach (var value in selected)
                            {
                                <button type="button"
                                        class="@GetChipClass()"
                                        @onclick="() => ToggleAttributeValue(attribute.Id, value)">
                                    @(attribute.Name): <span class="font-semibold">@value</span>
                                    <span aria-hidden="true">×</span>
                                </button>
                            }
                        }
                    </div>
                }
            </div>

            @if (filteredModels.Any())
            {
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
                    @foreach (var model in filteredModels)
                    {
                        var summary = GetModelSummary(model.Id);
                        <article class="flex flex-col overflow-hidden rounded-3xl border border-gray-200 bg-white shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-lg">
                            <div class="relative aspect-square bg-gray-50">
                                <img src="@GetModelImageUrl(model, summary.BrandName)"
                                     alt="@model.Name"
                                     class="h-full w-full object-cover"
                                     loading="lazy" />
                                <span class="absolute left-3 top-3 rounded-full bg-black/80 px-3 py-1 text-xs font-semibold text-white">@summary.BrandName</span>
                            </div>
                            <div class="flex flex-1 flex-col gap-3 p-4">
                                <div>
                                    <h3 class="text-base font-semibold text-gray-900">@model.Name</h3>
                                    <p class="text-sm text-gray-500 line-clamp-2">@model.Description</p>
                                </div>
                                <div class="flex items-center justify-between">
                                    <p class="text-lg font-semibold text-[#2563EB]">@summary.PriceLabel</p>
                                    <a href="/product/@model.Slug" class="text-sm font-semibold text-[#2563EB] transition hover:text-blue-700">Xem chi tiết →</a>
                                </div>
                                @if (summary.Highlights.Any())
                                {
                                    <div class="flex flex-wrap gap-2">
                                        @foreach (var highlight in summary.Highlights)
                                        {
                                            <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-600">@highlight</span>
                                        }
                                    </div>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="rounded-3xl border border-dashed border-gray-300 bg-white p-10 text-center shadow-sm">
                    <p class="text-xl font-semibold text-gray-900">Không có model phù hợp</p>
                    <p class="text-sm text-gray-500">Hãy nới lỏng bộ lọc hoặc xoá bớt thuộc tính để thấy nhiều lựa chọn hơn.</p>
                    <button type="button"
                            class="mt-4 rounded-full bg-[#2563EB] px-5 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700"
                            @onclick="ClearAllFilters">
                        Reset bộ lọc
                    </button>
                </div>
            }
        </section>
    </div>
</div>

@code {
    private readonly List<ProductModel> ProductModels = ProductModelData.GetSampleProductModels();
    private readonly List<Product> Products = ProductData.GetSampleProducts();
    private readonly List<Brand> Brands = BrandData.GetSampleBrands();
    private readonly List<ProductCategory> Categories = ProductCategoryData.GetSampleProductCategories();
    private readonly List<ProductAttribute> Attributes = ProductAttributeData.GetSampleProductAttributes();
    private readonly List<ProductAttributeValue> AttributeValues = ProductAttributeValueData.GetSampleProductAttributeValues();

    private readonly HashSet<int> SelectedBrandIds = new();
    private readonly HashSet<int> SelectedCategoryIds = new();
    private readonly Dictionary<int, HashSet<string>> SelectedAttributeValues = new();

    private Dictionary<int, string> BrandLookup = new();
    private Dictionary<int, string> CategoryLookup = new();
    private Dictionary<int, List<string>> AttributeOptions = new();

    private string SearchTerm { get; set; } = string.Empty;
    private string MinPriceInput { get; set; } = string.Empty;
    private string MaxPriceInput { get; set; } = string.Empty;

    private static readonly CultureInfo ViCulture = CultureInfo.GetCultureInfo("vi-VN");

    protected override void OnInitialized()
    {
        BrandLookup = Brands.ToDictionary(b => b.Id, b => b.Name);
        CategoryLookup = Categories.ToDictionary(c => c.Id, c => c.Name);
        AttributeOptions = Attributes.ToDictionary(
            attr => attr.Id,
            attr => AttributeValues
                .Where(v => v.AttributeId == attr.Id && !string.IsNullOrWhiteSpace(v.ValueText))
                .Select(v => v.ValueText!)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(v => v)
                .ToList());

        foreach (var attribute in Attributes)
        {
            SelectedAttributeValues.TryAdd(attribute.Id, new HashSet<string>(StringComparer.OrdinalIgnoreCase));
        }
    }

    private IEnumerable<ProductModel> FilteredProductModels => ProductModels.Where(ModelMatchesFilters);

    private bool ModelMatchesFilters(ProductModel model)
    {
        var modelProducts = Products.Where(p => p.ModelId == model.Id).ToList();
        if (modelProducts.Count == 0)
        {
            return false;
        }

        if (!string.IsNullOrWhiteSpace(SearchTerm))
        {
            var keyword = SearchTerm.Trim();
            var matchesKeyword = model.Name.Contains(keyword, StringComparison.OrdinalIgnoreCase)
                || (model.Description?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false)
                || modelProducts.Any(p => p.Name.Contains(keyword, StringComparison.OrdinalIgnoreCase));

            if (!matchesKeyword)
            {
                return false;
            }
        }

        if (SelectedBrandIds.Any() && !modelProducts.Any(p => SelectedBrandIds.Contains(p.BrandId)))
        {
            return false;
        }

        if (SelectedCategoryIds.Any() && !modelProducts.Any(p => SelectedCategoryIds.Contains(p.CategoryId)))
        {
            return false;
        }

        var minPrice = ParsedMinPrice;
        var maxPrice = ParsedMaxPrice;
        if (minPrice.HasValue && !modelProducts.Any(p => p.Price >= minPrice.Value))
        {
            return false;
        }

        if (maxPrice.HasValue && !modelProducts.Any(p => p.Price <= maxPrice.Value))
        {
            return false;
        }

        var attributeFilters = SelectedAttributeValues
            .Where(pair => pair.Value.Count > 0)
            .ToList();

        if (attributeFilters.Count > 0)
        {
            var candidateProductIds = modelProducts.Select(p => p.Id).ToHashSet();
            foreach (var filter in attributeFilters)
            {
                candidateProductIds = candidateProductIds
                    .Where(productId => AttributeValues.Any(value =>
                        value.ProductId == productId &&
                        value.AttributeId == filter.Key &&
                        value.ValueText != null &&
                        filter.Value.Contains(value.ValueText)))
                    .ToHashSet();

                if (candidateProductIds.Count == 0)
                {
                    return false;
                }
            }
        }

        return true;
    }

    private decimal? ParsedMinPrice => ParsePrice(MinPriceInput);
    private decimal? ParsedMaxPrice => ParsePrice(MaxPriceInput);

    private static decimal? ParsePrice(string? input)
    {
        if (string.IsNullOrWhiteSpace(input))
        {
            return null;
        }

        if (decimal.TryParse(input, NumberStyles.Number, CultureInfo.InvariantCulture, out var value))
        {
            return value;
        }

        if (decimal.TryParse(input, NumberStyles.Number, ViCulture, out value))
        {
            return value;
        }

        return null;
    }

    private string GetPillClass(bool isActive) => isActive
        ? "rounded-full border border-[#2563EB] bg-[#2563EB]/10 px-3 py-1 text-xs font-semibold text-[#2563EB]"
        : "rounded-full border border-gray-200 bg-white px-3 py-1 text-xs font-semibold text-gray-600 hover:border-[#2563EB]/50 hover:text-[#2563EB] transition";

    private string GetChipClass() => "inline-flex items-center gap-1 rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-600 hover:bg-gray-200";

    private void ToggleBrand(int brandId)
    {
        if (!SelectedBrandIds.Add(brandId))
        {
            SelectedBrandIds.Remove(brandId);
        }
    }

    private void ToggleCategory(int categoryId)
    {
        if (!SelectedCategoryIds.Add(categoryId))
        {
            SelectedCategoryIds.Remove(categoryId);
        }
    }

    private void ToggleAttributeValue(int attributeId, string value)
    {
        if (!SelectedAttributeValues.TryGetValue(attributeId, out var values))
        {
            values = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            SelectedAttributeValues[attributeId] = values;
        }

        if (!values.Add(value))
        {
            values.Remove(value);
        }
    }

    private void ClearAllFilters()
    {
        SearchTerm = string.Empty;
        MinPriceInput = string.Empty;
        MaxPriceInput = string.Empty;
        SelectedBrandIds.Clear();
        SelectedCategoryIds.Clear();
        foreach (var set in SelectedAttributeValues.Values)
        {
            set.Clear();
        }
    }

    private void ClearPrice()
    {
        MinPriceInput = string.Empty;
        MaxPriceInput = string.Empty;
    }

    private string GetPriceRangeLabel()
    {
        if (ParsedMinPrice.HasValue && ParsedMaxPrice.HasValue)
        {
            return $"{ParsedMinPrice.Value.ToString("N0", ViCulture)} - {ParsedMaxPrice.Value.ToString("N0", ViCulture)}";
        }

        if (ParsedMinPrice.HasValue)
        {
            return $">= {ParsedMinPrice.Value.ToString("N0", ViCulture)}";
        }

        if (ParsedMaxPrice.HasValue)
        {
            return $"<= {ParsedMaxPrice.Value.ToString("N0", ViCulture)}";
        }

        return "";
    }

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(SearchTerm)
        || SelectedBrandIds.Any()
        || SelectedCategoryIds.Any()
        || SelectedAttributeValues.Any(pair => pair.Value.Count > 0)
        || ParsedMinPrice.HasValue
        || ParsedMaxPrice.HasValue;

    private string GetBrandNameForModel(int modelId)
    {
        var product = Products.FirstOrDefault(p => p.ModelId == modelId);
        if (product != null && BrandLookup.TryGetValue(product.BrandId, out var brandName))
        {
            return brandName;
        }

        return "GuZone";
    }

    private string GetModelImageUrl(ProductModel model, string brandName)
    {
        if (string.IsNullOrWhiteSpace(model.Image))
        {
            return "/images/placeholder-phone.png";
        }

        var normalizedBrand = brandName.Replace(" ", "-").ToLowerInvariant();
        return $"https://res.cloudinary.com/dstytmxfh/image/upload/v1763457477/mobileguzone/{normalizedBrand}/{model.Slug}/{model.Image}";
    }

    private ProductModelSummary GetModelSummary(int modelId)
    {
        var modelProducts = Products.Where(p => p.ModelId == modelId).ToList();
        if (modelProducts.Count == 0)
        {
            return new ProductModelSummary("GuZone", "Liên hệ", new List<string>());
        }

        var brandName = GetBrandNameForModel(modelId);
        var priceLabel = FormatPriceRange(modelProducts);
        var highlights = BuildHighlights(modelProducts.Select(p => p.Id).ToList());
        return new ProductModelSummary(brandName, priceLabel, highlights);
    }

    private string FormatPriceRange(List<Product> modelProducts)
    {
        var min = modelProducts.Min(p => p.Price);
        var max = modelProducts.Max(p => p.Price);
        var minLabel = min.ToString("N0", ViCulture);
        var maxLabel = max.ToString("N0", ViCulture);
        return min == max ? $"{minLabel} đ" : $"{minLabel} - {maxLabel} đ";
    }

    private List<string> BuildHighlights(List<int> productIds)
    {
        var highlights = new List<string>();
        var productIdSet = productIds.ToHashSet();
        var colors = AttributeValues
            .Where(v => v.AttributeId == 1 && v.ValueText != null && productIdSet.Contains(v.ProductId))
            .Select(v => v.ValueText!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        var storages = AttributeValues
            .Where(v => v.AttributeId == 2 && v.ValueText != null && productIdSet.Contains(v.ProductId))
            .Select(v => v.ValueText!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(v => v)
            .ToList();

        var rams = AttributeValues
            .Where(v => v.AttributeId == 3 && v.ValueText != null && productIdSet.Contains(v.ProductId))
            .Select(v => v.ValueText!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(v => v)
            .Select(v => $"{v} RAM")
            .ToList();

        if (storages.Count > 0)
        {
            highlights.Add(string.Join(" · ", storages));
        }

        if (rams.Count > 0)
        {
            highlights.Add(string.Join(" · ", rams));
        }

        if (colors.Count > 0)
        {
            highlights.Add($"{colors.Count} màu");
        }

        return highlights;
    }

    private record ProductModelSummary(string BrandName, string PriceLabel, List<string> Highlights);
}
