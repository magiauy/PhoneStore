@page "/history"
@using PhoneStoreUser.Services
@using PhoneStoreUser.Data
@inject IOrderService OrderService
@inject IUserSessionService UserSessionService
@inject NavigationManager Navigation

<div class="min-h-screen bg-gray-50 py-10 font-sans text-slate-800">
    <div class="container mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mb-8 flex flex-col items-start justify-between gap-4 md:flex-row md:items-end">
            <div>
                <nav class="mb-2 text-sm font-medium text-slate-500">
                    <a href="/" class="hover:text-blue-600 transition-colors">Trang chủ</a>
                    <span class="mx-2 text-slate-300">/</span>
                    <span class="text-blue-600">Lịch sử đơn hàng</span>
                </nav>
                <h1 class="text-3xl font-bold tracking-tight text-slate-900">Lịch sử mua sắm</h1>
                <p class="mt-1 text-slate-500">Quản lý và theo dõi trạng thái các đơn hàng của bạn.</p>
            </div>
            
            <a href="/" class="group inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-5 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition-all hover:border-blue-200 hover:bg-blue-50 hover:text-blue-700">
                <i class="fa-solid fa-arrow-left transition-transform group-hover:-translate-x-1"></i>
                Tiếp tục mua sắm
            </a>
        </div>

        @if (isLoading)
        {
            <div class="space-y-6">
                @for (var i = 0; i < 2; i++)
                {
                    <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
                        <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center border-b border-slate-50 pb-4 mb-4">
                            <div class="h-6 w-40 animate-pulse rounded bg-slate-100"></div>
                            <div class="h-8 w-24 animate-pulse rounded-full bg-slate-100"></div>
                        </div>
                        <div class="space-y-4">
                            <div class="flex gap-4">
                                <div class="h-16 w-16 animate-pulse rounded-lg bg-slate-100"></div>
                                <div class="flex-1 space-y-2">
                                    <div class="h-4 w-3/4 animate-pulse rounded bg-slate-100"></div>
                                    <div class="h-4 w-1/4 animate-pulse rounded bg-slate-100"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else if (!orders.Any())
        {
            <div class="flex flex-col items-center justify-center rounded-3xl border border-dashed border-slate-300 bg-white py-20 text-center shadow-sm">
                <div class="mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-blue-50 ring-8 ring-blue-50/50">
                    <i class="fa-solid fa-box-open text-3xl text-blue-500"></i>
                </div>
                <h3 class="text-xl font-semibold text-slate-900">Bạn chưa có đơn hàng nào</h3>
                <p class="mt-2 max-w-sm text-slate-500">Hãy khám phá các sản phẩm công nghệ mới nhất tại GuZone và đặt hàng ngay hôm nay.</p>
                <a href="/products" class="mt-8 inline-flex items-center gap-2 rounded-xl bg-blue-600 px-6 py-3 text-sm font-semibold text-white shadow-md shadow-blue-200 transition-transform hover:-translate-y-0.5 hover:bg-blue-700">
                    <i class="fa-solid fa-bag-shopping"></i>
                    Khám phá sản phẩm
                </a>
            </div>
        }
        else
        {
            <div class="space-y-6">
                @foreach (var order in orders)
                {
                    <div class="group relative overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition-all hover:border-blue-300 hover:shadow-lg hover:shadow-blue-100/50">
                        
                        <div class="flex flex-col gap-4 border-b border-slate-100 bg-slate-50/50 px-6 py-4 sm:flex-row sm:items-center sm:justify-between">
                            <div class="flex items-center gap-4">
                                <div class="flex h-10 w-10 items-center justify-center rounded-full bg-white text-blue-600 shadow-sm ring-1 ring-slate-200">
                                    <i class="fa-solid fa-receipt"></i>
                                </div>
                                <div>
                                    <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Mã đơn hàng</p>
                                    <p class="font-bold text-slate-800">#@order.Id</p>
                                </div>
                                <div class="hidden h-8 w-px bg-slate-200 sm:block"></div>
                                <div class="hidden sm:block">
                                    <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Ngày đặt</p>
                                    <p class="text-sm font-medium text-slate-700">@FormatDate(order.InvoiceDate)</p>
                                </div>
                            </div>

                            <div class="flex items-center justify-between gap-3 sm:justify-end">
                                <span class="sm:hidden text-sm text-slate-500">@FormatDate(order.InvoiceDate)</span>
                                <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wide shadow-sm @GetStatusBadgeClass(order.Status)">
                                    @GetStatusIcon(order.Status)
                                    @GetStatusLabel(order.Status)
                                </span>
                            </div>
                        </div>

                        <div class="p-6">
                            @if (order.Lines.Any())
                            {
                                <div class="space-y-4">
                                    @foreach (var line in order.Lines)
                                    {
                                        <div class="flex items-start gap-4">
                                            <div class="flex h-16 w-16 flex-shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-400">
                                                <i class="fa-solid fa-mobile-screen text-xl"></i>
                                            </div>
                                            
                                            <div class="flex-1">
                                                <div class="flex flex-col justify-between gap-2 sm:flex-row">
                                                    <div>
                                                        <h4 class="font-semibold text-slate-900 line-clamp-2">@GetProductName(line)</h4>
                                                        <p class="mt-1 text-sm text-slate-500">Đơn giá: @line.UnitPrice.ToString("N0") ₫</p>
                                                    </div>
                                                    <div class="text-right">
                                                        <p class="font-bold text-slate-900">@line.TotalPrice.ToString("N0") ₫</p>
                                                        <p class="text-xs text-slate-500">Số lượng: x @line.Quantity</p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        @if (line != order.Lines.Last())
                                        {
                                            <hr class="border-slate-100" />
                                        }
                                    }
                                </div>
                            }
                        </div>

                        <div class="bg-slate-50 px-6 py-4">
                            <div class="flex items-center justify-between sm:justify-end sm:gap-8">
                                <span class="text-sm font-medium text-slate-500">Tổng thành tiền</span>
                                <div class="flex items-baseline gap-1">
                                    <span class="text-xl font-bold text-blue-600">@order.FinalAmount.ToString("N0")</span>
                                    <span class="text-sm font-semibold text-blue-600">₫</span>
                                </div>
                            </div>
                        </div>

                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private List<InvoiceEntity> orders = new();
    private bool isLoading = true;
    private bool hasLoadedSession;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || hasLoadedSession)
        {
            return;
        }

        var session = await UserSessionService.InitializeAsync();
        hasLoadedSession = true;

        if (session is null)
        {
            Navigation.NavigateTo("/login?returnUrl=/history", true);
            return;
        }

        orders = await OrderService.GetOrdersAsync(session.PersonId);
        isLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    // Helper để lấy Icon cho badge trạng thái
    private RenderFragment GetStatusIcon(string status) => builder =>
    {
        var iconClass = status.ToLowerInvariant() switch {
            "paid" or "completed" => "fa-check",
            "delivering" => "fa-truck-fast",
            "refunded" => "fa-rotate-left",
            "cancelled" => "fa-xmark",
            _ => "fa-clock"
        };
        builder.OpenElement(0, "i");
        builder.AddAttribute(1, "class", $"fa-solid {iconClass}");
        builder.CloseElement();
    };

    private static string GetStatusBadgeClass(string status) => status.ToLowerInvariant() switch
    {
        "paid" => "bg-emerald-100 text-emerald-700 ring-1 ring-emerald-500/20",
        "completed" => "bg-blue-100 text-blue-700 ring-1 ring-blue-500/20",
        "delivering" => "bg-amber-100 text-amber-700 ring-1 ring-amber-500/20",
        "refunded" => "bg-purple-100 text-purple-700 ring-1 ring-purple-500/20",
        "cancelled" => "bg-red-100 text-red-700 ring-1 ring-red-500/20",
        _ => "bg-slate-100 text-slate-600 ring-1 ring-slate-500/20"
    };

    private static string GetStatusLabel(string status) => status.ToLowerInvariant() switch
    {
        "paid" => "Đã thanh toán",
        "completed" => "Hoàn tất",
        "delivering" => "Đang vận chuyển",
        "refunded" => "Đã hoàn tiền",
        "cancelled" => "Đã hủy",
        "unpaid" => "Chưa thanh toán",
        _ => status
    };

    private static string FormatDate(DateTime dateTime) => dateTime.ToLocalTime().ToString("HH:mm, dd/MM/yyyy");

    private static string GetProductName(InvoiceLineEntity line) =>
        line.Product is not null
            ? line.Product.Name
            : $"Sản phẩm #{line.ProductId}";
}