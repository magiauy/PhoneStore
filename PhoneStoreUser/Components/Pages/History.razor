@page "/history"
@using PhoneStoreUser.Services
@using PhoneStoreUser.Data
@inject IOrderService OrderService
@inject IUserSessionService UserSessionService
@inject NavigationManager Navigation

<div class="bg-gray-100 min-h-screen py-8 text-gray-800">
    <div class="container mx-auto px-4 lg:px-8 max-w-6xl">
        <div class="flex items-center justify-between mb-6">
            <div>
                <p class="text-sm text-gray-500">Theo dõi hành trình mua sắm của bạn</p>
                <h1 class="text-2xl font-semibold">Lịch sử đơn hàng</h1>
            </div>
            <a href="/" class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
                <i class="fa-solid fa-arrow-left"></i>
                Về trang chủ
            </a>
        </div>

        @if (isLoading)
        {
            <div class="space-y-4">
                @for (var i = 0; i < 3; i++)
                {
                    <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
                        <div class="flex items-center justify-between">
                            <div class="h-4 w-32 animate-pulse rounded bg-gray-200"></div>
                            <div class="h-6 w-20 animate-pulse rounded bg-gray-200"></div>
                        </div>
                        <div class="mt-4 grid grid-cols-2 gap-3 text-sm">
                            <div class="h-4 w-24 animate-pulse rounded bg-gray-200"></div>
                            <div class="h-4 w-16 animate-pulse rounded bg-gray-200"></div>
                            <div class="h-4 w-28 animate-pulse rounded bg-gray-200"></div>
                            <div class="h-4 w-20 animate-pulse rounded bg-gray-200"></div>
                        </div>
                    </div>
                }
            </div>
        }
        else if (!orders.Any())
        {
            <div class="rounded-2xl border border-dashed border-gray-300 bg-white p-10 text-center shadow-sm">
                <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-blue-50 text-blue-600">
                    <i class="fa-solid fa-box-open text-xl"></i>
                </div>
                <p class="text-lg font-semibold text-gray-800">Bạn chưa có đơn hàng nào</p>
                <p class="text-sm text-gray-500">Bắt đầu mua sắm để trải nghiệm sản phẩm mới nhất tại GuZone.</p>
                <a href="/products" class="mt-6 inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-blue-700">
                    <i class="fa-solid fa-bag-shopping"></i>
                    Xem sản phẩm
                </a>
            </div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var order in orders)
                {
                    <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm hover:shadow-md transition">
                        <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                            <div class="space-y-1">
                                <div class="flex items-center gap-2 text-sm text-gray-500">
                                    <i class="fa-solid fa-receipt text-blue-600"></i>
                                    <span>Mã đơn: <span class="font-semibold text-gray-800">#@order.Id</span></span>
                                </div>
                                <div class="text-sm text-gray-500">Ngày tạo: @FormatDate(order.InvoiceDate)</div>
                            </div>
                            <div class="flex flex-wrap items-center gap-3">
                                <span class="rounded-full px-3 py-1 text-xs font-semibold @GetStatusBadgeClass(order.Status)">
                                    @GetStatusLabel(order.Status)
                                </span>
                                <div class="rounded-lg bg-gray-50 px-3 py-2 text-right">
                                    <div class="text-xs text-gray-500">Tổng thanh toán</div>
                                    <div class="text-lg font-semibold text-gray-800">@order.FinalAmount.ToString("N0") ₫</div>
                                </div>
                            </div>
                        </div>

                        @if (order.Lines.Any())
                        {
                            <div class="mt-4 rounded-lg border border-gray-100 bg-gray-50 p-4">
                                <div class="flex items-center justify-between text-xs uppercase tracking-wide text-gray-500">
                                    <span>Sản phẩm</span>
                                    <span>Số lượng / Thành tiền</span>
                                </div>
                                <div class="mt-3 space-y-3">
                                    @foreach (var line in order.Lines)
                                    {
                                        <div class="flex flex-col gap-2 rounded-lg bg-white p-3 shadow-sm md:flex-row md:items-center md:justify-between">
                                            <div>
                                                <p class="text-sm font-medium text-gray-800">@GetProductName(line)</p>
                                                <p class="text-xs text-gray-500">Đơn giá: @line.UnitPrice.ToString("N0") ₫</p>
                                            </div>
                                            <div class="flex items-center gap-3 text-sm text-gray-700">
                                                <span class="rounded-full bg-blue-50 px-3 py-1 text-blue-700">x@line.Quantity</span>
                                                <span class="font-semibold">@line.TotalPrice.ToString("N0") ₫</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private List<InvoiceEntity> orders = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var session = await UserSessionService.InitializeAsync();
        if (session is null)
        {
            Navigation.NavigateTo("/login?returnUrl=/history");
            return;
        }

        orders = await OrderService.GetOrdersAsync(session.PersonId);
        isLoading = false;
    }

    private static string GetStatusBadgeClass(string status) => status switch
    {
        "paid" => "bg-green-100 text-green-700 border border-green-200",
        "completed" => "bg-blue-100 text-blue-700 border border-blue-200",
        "delivering" => "bg-amber-100 text-amber-700 border border-amber-200",
        "refunded" => "bg-purple-100 text-purple-700 border border-purple-200",
        "cancelled" => "bg-red-100 text-red-700 border border-red-200",
        _ => "bg-gray-100 text-gray-700 border border-gray-200"
    };

    private static string GetStatusLabel(string status) => status.ToLowerInvariant() switch
    {
        "paid" => "Đã thanh toán",
        "completed" => "Hoàn tất",
        "delivering" => "Đang giao",
        "refunded" => "Đã hoàn tiền",
        "cancelled" => "Đã hủy",
        "unpaid" => "Chưa thanh toán",
        _ => status
    };

    private static string FormatDate(DateTime dateTime) => dateTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm");

    private static string GetProductName(InvoiceLineEntity line) =>
        line.Product is not null
            ? line.Product.Name
            : $"Sản phẩm #{line.ProductId}";
}
