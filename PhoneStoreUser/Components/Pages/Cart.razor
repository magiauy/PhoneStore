@page "/cart"
@using PhoneStoreUser.Components.ViewModels
@using PhoneStoreUser.Services
@using System.Globalization
@inject ICartService CartService
@inject NavigationManager NavigationManager
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>Giỏ hàng - GuZone</PageTitle>

<div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-6">Giỏ hàng của bạn</h1>

        @if (_isLoading)
        {
            <div class="text-center py-10">
                <p class="text-gray-500">Đang tải giỏ hàng...</p>
            </div>
        }
        else if (cartItems == null || !cartItems.Any())
        {
            <div class="text-center py-10">
                <p class="text-xl text-gray-600">Giỏ hàng của bạn đang trống.</p>
                <a href="/" class="mt-4 inline-block bg-[#2563EB] text-white px-6 py-2 rounded-xl hover:bg-blue-700 transition">Tiếp tục mua sắm</a>
            </div>
        }
        else
        {
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="lg:col-span-2 space-y-4">
                @foreach (var item in cartItems)
                {
                    <div class="flex items-center justify-between border border-gray-200 rounded-2xl p-4 bg-white shadow-sm">
                        <div class="flex items-center space-x-4">
                            <div class="w-20 h-20 bg-gray-100 rounded-xl flex items-center justify-center overflow-hidden">
                                <img src="@(item.ImageUrl ?? "https://placehold.co/200x200?text=No+Image")" alt="@item.Product.Name" class="w-full h-full object-cover" />
                            </div>
                            <div>
                                <h3 class="font-semibold text-gray-900">@item.Product.Name</h3>
                                <p class="text-[#2563EB] font-medium">@item.Product.Price.ToString("N0", new CultureInfo("vi-VN")) ₫</p>
                            </div>
                        </div>
                        <div class="flex items-center space-x-4">
                            <div class="flex items-center border border-gray-200 rounded-lg">
                                <button class="px-3 py-1 hover:bg-gray-50 text-gray-600" @onclick="() => UpdateQuantity(item, item.Quantity - 1)">-</button>
                                <span class="px-3 py-1 text-sm font-medium text-gray-900">@item.Quantity</span>
                                <button class="px-3 py-1 hover:bg-gray-50 text-gray-600" @onclick="() => UpdateQuantity(item, item.Quantity + 1)">+</button>
                            </div>
                            <button class="text-red-500 hover:text-red-700 p-2" @onclick="() => RemoveItem(item)">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                </svg>
                            </button>
                        </div>
                    </div>
                }
                
                <div class="flex justify-end">
                     <button class="text-red-600 hover:text-red-800 text-sm font-semibold" @onclick="ClearCart">Xóa tất cả</button>
                </div>
            </div>

            <div class="bg-white border border-gray-200 p-6 rounded-2xl h-fit shadow-sm">
                <h2 class="text-xl font-bold mb-4 text-gray-900">Tóm tắt đơn hàng</h2>
                <div class="flex justify-between mb-2 text-gray-600">
                    <span>Tạm tính</span>
                    <span>@totalPrice.ToString("N0", new CultureInfo("vi-VN")) ₫</span>
                </div>
                <div class="border-t border-gray-100 my-4"></div>
                <div class="flex justify-between mb-6 text-xl font-bold text-gray-900">
                    <span>Tổng cộng</span>
                    <span class="text-[#2563EB]">@totalPrice.ToString("N0", new CultureInfo("vi-VN")) ₫</span>
                </div>
                <button class="w-full bg-[#2563EB] text-white py-3 rounded-xl font-semibold hover:bg-blue-700 transition shadow-lg shadow-blue-500/30">
                    Tiến hành thanh toán
                </button>
                <a href="/" class="block text-center mt-4 text-sm text-gray-500 hover:text-[#2563EB] transition">Tiếp tục mua sắm</a>
            </div>
        </div>
    }
</div>

@code {
    private List<CartItem> cartItems = new();
    private decimal totalPrice;
    // Thêm biến này để tránh hiện "Giỏ hàng trống" khi đang load
    private bool _isLoading = true; 

    protected override void OnInitialized()
    {
        // Đăng ký sự kiện ngay khi Component được tạo (kể cả Prerender)
        // Để đảm bảo không bỏ lỡ bất kỳ thay đổi nào
        CartService.OnChange += HandleCartChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Chỉ chạy duy nhất 1 lần khi Browser đã sẵn sàng
            await CartService.EnsureInitialized();
            
            // Load dữ liệu lần đầu
            await LoadData();
            
            _isLoading = false;
            StateHasChanged(); // Báo hiệu để vẽ lại UI
        }
    }

    // Hàm xử lý tập trung: Chỉ cần gọi hàm này khi Service báo có thay đổi
    private async void HandleCartChanged()
    {
        await LoadData();
        StateHasChanged();
    }

    private async Task LoadData()
    {
        // Chỉ lấy dữ liệu nếu Service đã sẵn sàng
        if (CartService.IsInitialized) 
        {
            cartItems = await CartService.GetCartItems();
            totalPrice = await CartService.GetTotal();
        }
    }

    private async Task UpdateQuantity(CartItem item, int newQuantity)
    {
        // Chỉ gọi Service, không cần gọi RefreshCart thủ công nữa
        // Service sẽ bắn event OnChange -> kích hoạt HandleCartChanged
        await CartService.UpdateQuantity(item.Product, newQuantity);
    }

    private async Task RemoveItem(CartItem item)
    {
        await CartService.RemoveFromCart(item.Product);
    }

    private async Task ClearCart()
    {
        await CartService.ClearCart();
    }

    public void Dispose()
    {
        // Hủy đăng ký để tránh Memory Leak
        CartService.OnChange -= HandleCartChanged;
    }
}