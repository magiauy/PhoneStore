@page "/order-success"
@inject NavigationManager Navigation

<div class="container mx-auto p-8 max-w-2xl text-center">
    <div class="bg-white p-10 rounded-2xl shadow-lg border border-gray-100">
        <div class="mb-6">
            <div class="w-24 h-24 bg-green-100 rounded-full flex items-center justify-center mx-auto">
                <i class="fa-solid fa-check text-5xl text-green-600"></i>
            </div>
        </div>
        
        <h1 class="text-3xl font-bold text-gray-800 mb-4">Đặt Hàng Thành Công!</h1>
        
        <p class="text-gray-600 mb-8 text-lg">
            Cảm ơn bạn đã mua sắm tại PhoneStore. <br/>
            Đơn hàng của bạn đang được xử lý và sẽ sớm được giao đến bạn.
        </p>

        @if (!string.IsNullOrEmpty(OrderId))
        {
            <div class="bg-gray-50 p-4 rounded-lg mb-8 inline-block">
                <span class="text-gray-500">Mã đơn hàng:</span>
                <span class="font-mono font-bold text-gray-800 ml-2">#@OrderId</span>
            </div>
        }

        <div class="space-y-3">
            <a href="/" class="block w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-lg transition transform hover:scale-105">
                <i class="fa-solid fa-house mr-2"></i> Về trang chủ
            </a>
            <a href="/products" class="block w-full bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 font-bold py-3 px-6 rounded-lg transition">
                <i class="fa-solid fa-bag-shopping mr-2"></i> Tiếp tục mua sắm
            </a>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? OrderId { get; set; }
}
