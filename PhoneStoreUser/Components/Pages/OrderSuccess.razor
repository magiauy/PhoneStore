@page "/order-success"
@using PhoneStoreUser.Data
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IOrderService OrderService

<div class="container mx-auto p-8 max-w-2xl text-center">
    <div class="bg-white p-10 rounded-2xl shadow-lg border border-gray-100">
        @if (IsCancelled)
        {
            <div class="mb-6">
                <div class="w-24 h-24 bg-red-100 rounded-full flex items-center justify-center mx-auto">
                    <i class="fa-solid fa-xmark text-5xl text-red-600"></i>
                </div>
            </div>
            
            <h1 class="text-3xl font-bold text-gray-800 mb-4">Thanh Toán Đã Hủy</h1>
            
            <p class="text-gray-600 mb-8 text-lg">
                Giao dịch thanh toán của bạn đã bị hủy. <br />
                Đơn hàng đã được tạo nhưng chưa thanh toán.
            </p>
        }
        else
        {
            <div class="mb-6">
                <div class="w-24 h-24 bg-green-100 rounded-full flex items-center justify-center mx-auto">
                    <i class="fa-solid fa-check text-5xl text-green-600"></i>
                </div>
            </div>
            
            <h1 class="text-3xl font-bold text-gray-800 mb-4">Đặt Hàng Thành Công!</h1>
            
            <p class="text-gray-600 mb-8 text-lg">
                Cảm ơn bạn đã mua sắm tại PhoneStore. <br />
                Đơn hàng của bạn đang được xử lý và sẽ sớm được giao đến bạn.
            </p>
        }

        @if (!string.IsNullOrEmpty(DisplayOrderId))
        {
            <div class="bg-gray-50 p-4 rounded-lg mb-6 inline-block">
                <span class="text-gray-500">Mã đơn hàng:</span>
                <span class="font-mono font-bold text-gray-800 ml-2">#@DisplayOrderId</span>
            </div>

            @if (Order != null && Order.Lines.Any())
            {
                <div class="text-left bg-slate-50 border border-slate-100 rounded-xl p-4 mb-8">
                    <h3 class="text-base font-bold text-slate-800 mb-3 flex items-center gap-2">
                        <i class="fa-solid fa-list-check text-blue-600"></i> Chi tiết đơn hàng
                    </h3>
                    <div class="space-y-3">
                        @foreach (var line in Order.Lines)
                        {
                            <div class="flex items-start justify-between gap-3">
                                <div class="flex-1">
                                    <p class="font-semibold text-slate-900">@((line.Product?.Name) ?? $"Sản phẩm #{line.ProductId}")</p>
                                    <p class="text-xs text-slate-500">Đơn giá: @line.UnitPrice.ToString("N0") đ</p>
                                </div>
                                <div class="text-right">
                                    <p class="text-sm font-semibold text-slate-800">x @line.Quantity</p>
                                    <p class="text-sm text-blue-700 font-bold">@line.TotalPrice.ToString("N0") đ</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }

        <div class="space-y-3">
            <a href="/" class="block w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-lg transition transform hover:scale-105">
                <i class="fa-solid fa-house mr-2"></i> Về trang chủ
            </a>
            <a href="/products" class="block w-full bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 font-bold py-3 px-6 rounded-lg transition">
                <i class="fa-solid fa-bag-shopping mr-2"></i> Tiếp tục mua sắm
            </a>
        </div>
    </div>
</div>

<script>
    (function () {
        try {
            // Check if running inside an iframe and try to break out
            if (window.self !== window.top) {
                window.top.location.href = window.location.href;
            }
        } catch (err) {
            console.warn("Unable to break out of iframe automatically.", err);
            // Fall back to opening the page in a new tab so the user can continue
            try {
                window.open(window.location.href, "_blank");
            } catch (nestedErr) {
                console.warn("Fallback navigation also failed.", nestedErr);
            }
        }
    })();
</script>

@code {
    [SupplyParameterFromQuery]
    public string? OrderId { get; set; }

    [SupplyParameterFromQuery]
    public string? OrderCode { get; set; }

    [SupplyParameterFromQuery]
    public bool? Cancel { get; set; }

    [SupplyParameterFromQuery]
    public string? Status { get; set; }

    private bool IsCancelled => (Cancel.HasValue && Cancel.Value) || Status == "CANCELLED";

    private string? DisplayOrderId => !string.IsNullOrEmpty(OrderId) ? OrderId : OrderCode;
    private InvoiceEntity? Order { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Double check with JS interop if needed, but the script tag above should handle it
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (int.TryParse(OrderId ?? OrderCode, out var invoiceId))
        {
            Order = await OrderService.GetOrderAsync(invoiceId);
        }
    }
}