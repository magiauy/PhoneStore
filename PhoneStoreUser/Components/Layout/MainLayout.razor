@inherits LayoutComponentBase

<div class="min-h-screen bg-gray-50 text-gray-900">
    <Navbar />
    <main class="min-h-[calc(100vh-200px)]">
        <div class="max-w-6xl mx-auto px-4 py-6">
            @Body
        </div>
    </main>
    <Footer />
</div>

<div id="blazor-error-ui" class="fixed bottom-0 left-0 right-0 z-50 hidden bg-red-50 p-4 text-sm text-red-600 shadow-lg">
    An unhandled error has occurred.
    <a href="" class="ml-4 font-semibold text-red-700 underline">Reload</a>
    <a class="ml-4 cursor-pointer font-semibold">🗙</a>
</div>
