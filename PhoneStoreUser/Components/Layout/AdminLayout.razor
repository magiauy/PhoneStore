@inherits LayoutComponentBase

<div class="h-screen bg-gray-100 text-gray-800 flex overflow-hidden">
    <aside class="w-64 bg-gray-900 text-gray-100 flex flex-col flex-shrink-0 h-full overflow-y-auto">
        <div class="px-6 py-4 border-b border-gray-800">
            <div class="text-lg font-semibold tracking-tight">GuZone Admin</div>
            <p class="text-xs text-gray-400 mt-1">Quản trị cửa hàng</p>
        </div>

        <nav class="flex-1 px-3 py-4 space-y-1">
            <NavLink href="/admin/dashboard" Match="NavLinkMatch.All"
                     class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-300 hover:bg-gray-800 transition-all duration-200"
                     ActiveClass="bg-blue-600 text-white shadow-sm !text-white">
                <i class="fa-solid fa-gauge-high text-sm"></i>
                <span>Dashboard</span>
            </NavLink>

            <NavLink href="/admin/orders"
                     class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-300 hover:bg-gray-800 transition-all duration-200"
                     ActiveClass="bg-blue-600 text-white shadow-sm !text-white">
                <i class="fa-solid fa-receipt text-sm"></i>
                <span>Xử lý đơn hàng</span>
            </NavLink>

            <NavLink href="/admin/orders-history"
                     class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-300 hover:bg-gray-800 transition-all duration-200"
                     ActiveClass="bg-blue-600 text-white shadow-sm !text-white">
                <i class="fa-solid fa-receipt text-sm"></i>
                <span>Thống kê đơn hàng</span>
            </NavLink>

            <NavLink href="/admin/products"
                     class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-300 hover:bg-gray-800 transition-all duration-200"
                     ActiveClass="bg-blue-600 text-white shadow-sm !text-white">
                <i class="fa-solid fa-mobile-screen-button text-sm"></i>
                <span>Sản phẩm</span>
            </NavLink>

            <NavLink href="/admin/suppliers"
                     class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-300 hover:bg-gray-800 transition-all duration-200"
                     ActiveClass="bg-blue-600 text-white shadow-sm !text-white">
                <i class="fa-solid fa-truck text-sm"></i>
                <span>Nhà cung cấp</span>
            </NavLink>

            <NavLink href="/admin/customers"
                     class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-300 hover:bg-gray-800 transition-all duration-200"
                     ActiveClass="bg-blue-600 text-white shadow-sm !text-white">
                <i class="fa-solid fa-users text-sm"></i>
                <span>Khách hàng</span>
            </NavLink>

            <NavLink href="/admin/inventory"
                     class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-300 hover:bg-gray-800 transition-all duration-200"
                     ActiveClass="bg-blue-600 text-white shadow-sm !text-white">
                <i class="fa-solid fa-boxes-stacked text-sm"></i>
                <span>Tồn kho</span>
            </NavLink>
            <NavLink href="/admin/promotions"
                     class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-300 hover:bg-gray-800 transition-all duration-200"
                     ActiveClass="bg-blue-600 text-white shadow-sm !text-white">
                <i class="fa-solid fa-tags text-sm"></i>
                <span>Khuyến mãi</span>
            </NavLink>
            <NavLink href="/admin/reviews"
                     class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-300 hover:bg-gray-800 transition-all duration-200"
                     ActiveClass="bg-blue-600 text-white shadow-sm !text-white">
                <i class="fa-solid fa-user-shield text-sm"></i>
                <span>Đánh giá</span>
            </NavLink>
        </nav>
    </aside>

    <div class="flex-1 flex flex-col overflow-hidden min-h-0">
        <header class="h-16 px-6 bg-white border-b border-gray-200 flex items-center justify-between flex-shrink-0">
            <div>
                <p class="text-sm text-gray-500">Không gian quản trị</p>
                <h1 class="text-lg font-semibold text-gray-900">@CurrentTitle</h1>
            </div>
            <div class="flex items-center gap-3">
                <button class="px-3 py-2 text-sm rounded-lg border border-gray-200 hover:border-blue-600 hover:text-blue-600 transition">Trợ giúp</button>
                <button class="px-3 py-2 text-sm rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition">Tạo mới</button>
            </div>
        </header>

        <main class="flex-1 p-6 overflow-y-auto min-h-0">
            <div class="bg-white rounded-xl border shadow-sm p-4">
                @Body
            </div>
        </main>
    </div>
</div>

@code {
    [Inject]
    public NavigationManager NavigationManager { get; set; } = default!;

    private string CurrentTitle
    {
        get
        {
            var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).TrimEnd('/');

            return path switch
            {
                "admin/orders" => "Quản lý đơn hàng",
                "admin/products" => "Danh mục sản phẩm",
                "admin/suppliers" => "Nhà cung cấp",
                "admin/customers" => "Khách hàng",
                "admin/inventory" => "Tồn kho",
                "admin/orders-history" => "Thống kê đơn hàng",
                "admin/dashboard" => "Dashboard",
                "admin/promotions" => "Quản lý Khuyến mãi",
                "admin/reviews" => "Quản lý đánh giá",
                _ => "Bảng điều khiển"
            };
        }
    }
}
