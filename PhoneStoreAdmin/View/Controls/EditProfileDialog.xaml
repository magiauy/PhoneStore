<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PhoneStoreAdmin.View.Controls.EditProfileDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhoneStoreAdmin.View.Controls">

    <UserControl.Resources>
        <Style x:Key="InputFieldStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <Style x:Key="ReadOnlyFieldStyle" TargetType="TextBox" BasedOn="{StaticResource InputFieldStyle}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="{StaticResource BrushBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
        </Style>

        <Style x:Key="InputLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>

        <Style x:Key="ValidationErrorStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource BrushError}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushPrimary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BrushBackground}" MinWidth="400" MaxWidth="500" CornerRadius="8" MaxHeight="1000">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header - Fixed at top -->
        <StackPanel Grid.Row="0" Margin="24,24,24,0" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE77B;" 
                          FontSize="24" 
                          Foreground="{StaticResource BrushPrimary}"
                          VerticalAlignment="Center"/>
                <TextBlock x:Uid="EditProfileDialogTitle"
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource BrushText}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Uid="EditProfileDialogDescription"
                       FontSize="14" 
                       Foreground="{StaticResource BrushTextSecondary}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Scrollable Content -->
        <ScrollViewer Grid.Row="1" 
                      Margin="24,16,24,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">

            <!-- Form Fields -->
            <StackPanel Spacing="4">
                
                <!-- Username (Read-only) -->
                <TextBlock x:Uid="UsernameLabel" Style="{StaticResource InputLabelStyle}"/>
                <TextBox x:Name="UsernameTextBox"
                         Style="{StaticResource ReadOnlyFieldStyle}"
                         IsEnabled="False"/>

                <!-- Email -->
                <TextBlock x:Uid="EmailLabel" Style="{StaticResource InputLabelStyle}"/>
                <TextBox x:Name="EmailTextBox"
                         x:Uid="EmailPlaceholder"
                         Style="{StaticResource InputFieldStyle}"
                         TextChanged="EmailTextBox_TextChanged"/>
                <TextBlock x:Name="EmailError"
                           Style="{StaticResource ValidationErrorStyle}"
                           Visibility="Collapsed"/>

                <!-- Full Name -->
                <TextBlock x:Uid="FullNameLabel" Style="{StaticResource InputLabelStyle}"/>
                <TextBox x:Name="FullNameTextBox"
                         x:Uid="FullNamePlaceholder"
                         Style="{StaticResource InputFieldStyle}"
                         TextChanged="FullNameTextBox_TextChanged"/>
                <TextBlock x:Name="FullNameError"
                           Style="{StaticResource ValidationErrorStyle}"
                           Visibility="Collapsed"/>

                <!-- Phone -->
                <TextBlock x:Uid="PhoneLabel" Style="{StaticResource InputLabelStyle}"/>
                <TextBox x:Name="PhoneTextBox"
                         x:Uid="PhonePlaceholder"
                         Style="{StaticResource InputFieldStyle}"
                         TextChanged="PhoneTextBox_TextChanged"/>
                <TextBlock x:Name="PhoneError"
                           Style="{StaticResource ValidationErrorStyle}"
                           Visibility="Collapsed"/>

            </StackPanel>

            <!-- Success/Error Messages -->
            <StackPanel x:Name="MessagePanel" Spacing="8">
                <InfoBar x:Name="ErrorInfoBar"
                         Severity="Error"
                         IsOpen="False"
                         x:Uid="ProfileUpdateFailedMessage"/>
                
                <InfoBar x:Name="SuccessInfoBar"
                         Severity="Success"
                         IsOpen="False"
                         x:Uid="ProfileUpdateSuccessMessage"/>
            </StackPanel>
            
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons - Fixed at bottom -->
        <Grid Grid.Row="2" Margin="24,16,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Button x:Name="CancelButton"
                    Grid.Column="0"
                    x:Uid="CancelButton"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="CancelButton_Click"/>
            
            <Button x:Name="SaveButton"
                    Grid.Column="2"
                    x:Uid="SaveProfileButton"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="SaveButton_Click"
                    IsEnabled="False"/>
        </Grid>

        <!-- Loading Overlay -->
        <Border x:Name="LoadingOverlay"
                Background="#80000000"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        Spacing="12">
                <ProgressRing Width="32" Height="32" IsActive="True"/>
                <TextBlock x:Uid="ProcessingText"
                           FontSize="14"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>