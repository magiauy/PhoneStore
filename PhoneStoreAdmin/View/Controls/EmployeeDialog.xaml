<?xml version="1.0" encoding="utf-8" ?>
<ContentControl
    x:Class="PhoneStoreAdmin.View.Controls.EmployeeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="520">

    <ContentControl.Resources>
        <Style x:Key="InputFieldStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource BrushSurface}" />
            <Setter Property="Margin" Value="0,4,0,8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="ReadOnlyFieldStyle" TargetType="TextBox" BasedOn="{StaticResource InputFieldStyle}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Background" Value="{StaticResource BrushBackground}" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        </Style>

        <Style x:Key="InputLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>

        <Style x:Key="ValidationErrorStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource BrushError}" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleSwitch">
            <Setter Property="Margin" Value="0,8,0,12" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </ContentControl.Resources>

    <ScrollViewer
        Margin="12"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="8">
                <StackPanel Spacing="4">
                    <StackPanel x:Name="EmployeeIdPanel" Spacing="4">
                        <TextBlock Text="Employee ID" Style="{StaticResource InputLabelStyle}" />
                        <TextBox x:Name="EmployeeIdTextBox" Style="{StaticResource ReadOnlyFieldStyle}" />
                    </StackPanel>

                    <TextBlock Text="Employee Code" Style="{StaticResource InputLabelStyle}" />
                    <TextBox x:Name="EmployeeCodeTextBox"
                             Style="{StaticResource InputFieldStyle}"
                             PlaceholderText="Enter employee code"
                             TextChanged="EmployeeCodeTextBox_TextChanged" />
                    <TextBlock x:Name="EmployeeCodeError"
                               Style="{StaticResource ValidationErrorStyle}"
                               Visibility="Collapsed" />

                    <TextBlock Text="Full Name" Style="{StaticResource InputLabelStyle}" />
                    <TextBox x:Name="FullNameTextBox"
                             Style="{StaticResource InputFieldStyle}"
                             PlaceholderText="Enter full name"
                             TextChanged="FullNameTextBox_TextChanged" />
                    <TextBlock x:Name="FullNameError"
                               Style="{StaticResource ValidationErrorStyle}"
                               Visibility="Collapsed" />

                    <TextBlock Text="Email" Style="{StaticResource InputLabelStyle}" />
                    <TextBox x:Name="EmailTextBox"
                             Style="{StaticResource InputFieldStyle}"
                             PlaceholderText="example@domain.com"
                             TextChanged="EmailTextBox_TextChanged" />
                    <TextBlock x:Name="EmailError"
                               Style="{StaticResource ValidationErrorStyle}"
                               Visibility="Collapsed" />

                    <TextBlock Text="Phone Number" Style="{StaticResource InputLabelStyle}" />
                    <TextBox x:Name="PhoneTextBox"
                             Style="{StaticResource InputFieldStyle}"
                             PlaceholderText="0xxxxxxxxx"
                             TextChanged="PhoneTextBox_TextChanged" />
                    <TextBlock x:Name="PhoneError"
                               Style="{StaticResource ValidationErrorStyle}"
                               Visibility="Collapsed" />

                    <TextBlock Text="Hire Date" Style="{StaticResource InputLabelStyle}" />
                    <DatePicker x:Name="HireDatePicker"
                                CornerRadius="6"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                SelectedDateChanged="HireDatePicker_SelectedDateChanged" />
                    <TextBlock x:Name="HireDateError"
                               Style="{StaticResource ValidationErrorStyle}"
                               Visibility="Collapsed" />

                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="Status" Style="{StaticResource InputLabelStyle}" />
                        <ToggleSwitch x:Name="IsActiveToggle"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      OffContent="Inactive"
                                      OnContent="Active" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="8">
                    <InfoBar x:Name="ErrorInfoBar"
                             IsOpen="False"
                             Severity="Error"
                             Title="Error"
                             Message="Unable to complete the operation. Please try again." />
                </StackPanel>
            </StackPanel>

            <Border x:Name="LoadingOverlay"
                    Background="#80000000"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Spacing="12">
                    <ProgressRing Width="32" Height="32" IsActive="True" />
                    <TextBlock Text="Processing..." Foreground="White" FontSize="14" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</ContentControl>
