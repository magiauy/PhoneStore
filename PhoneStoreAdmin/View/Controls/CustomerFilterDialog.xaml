<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="PhoneStoreAdmin.View.Controls.CustomerFilterDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Bộ lọc khách hàng"
    PrimaryButtonText="Áp dụng"
    SecondaryButtonText="Đặt lại"
    CloseButtonText="Đóng"
    DefaultButton="Primary">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
            <TextBlock x:Name="ActiveFiltersText"
                       Text="Chưa có bộ lọc nào"
                       Foreground="{StaticResource BrushTextSecondary}"
                       TextWrapping="Wrap"/>

            <StackPanel Spacing="12">
                <TextBlock Text="Trạng thái" FontWeight="SemiBold"/>
                <ComboBox x:Name="StatusComboBox" SelectedIndex="0">
                    <ComboBoxItem Content="Tất cả" Tag="All"/>
                    <ComboBoxItem Content="Đang hoạt động" Tag="Active"/>
                    <ComboBoxItem Content="Ngưng hoạt động" Tag="Inactive"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="Khoảng thời gian tạo" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <DatePicker x:Name="CreatedFromDatePicker"/>
                    <TextBlock Text="đến" VerticalAlignment="Center"/>
                    <DatePicker x:Name="CreatedToDatePicker"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="Đầu số điện thoại" FontWeight="SemiBold"/>
                <TextBox x:Name="PhonePrefixTextBox"
                         PlaceholderText="Ví dụ: 09, 03"/>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="Thành phố/Tỉnh" FontWeight="SemiBold"/>
                <TextBox x:Name="CityTextBox"
                         PlaceholderText="Nhập tên thành phố hoặc tỉnh"/>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="Thông tin bổ sung" FontWeight="SemiBold"/>
                <StackPanel Spacing="8">
                    <ToggleSwitch x:Name="HasEmailToggle" Header="Có email"/>
                    <ToggleSwitch x:Name="HasAddressToggle" Header="Có địa chỉ"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
