<?xml version="1.0" encoding="utf-8" ?>
<ContentControl
    x:Class="PhoneStoreAdmin.View.Controls.PromotionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhoneStoreAdmin.View.Controls"
    Width="500">

	<ContentControl.Resources>
		<Style x:Key="InputFieldStyle" TargetType="TextBox">
			<Setter Property="Height" Value="40" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Background" Value="{StaticResource BrushSurface}" />
			<Setter Property="Margin" Value="0,4,0,8" />
			<Setter Property="Padding" Value="12,8" />
			<Setter Property="AcceptsReturn" Value="False" />
			<Setter Property="TextWrapping" Value="NoWrap" />
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="Width" Value="450" />
		</Style>

		<Style x:Key="MultilineInputFieldStyle" BasedOn="{StaticResource InputFieldStyle}" TargetType="TextBox">
			<Setter Property="Height" Value="80" />
			<Setter Property="AcceptsReturn" Value="True" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="VerticalContentAlignment" Value="Top" />
		</Style>

		<Style
            x:Key="ReadOnlyFieldStyle"
            BasedOn="{StaticResource InputFieldStyle}"
            TargetType="TextBox">
			<Setter Property="IsReadOnly" Value="True" />
			<Setter Property="Background" Value="{StaticResource BrushBackground}" />
			<Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
		</Style>

		<Style x:Key="InputLabelStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="14" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{StaticResource BrushText}" />
			<Setter Property="Margin" Value="0,8,0,4" />
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="Width" Value="450" />
		</Style>

		<Style x:Key="DatePickerStyle" TargetType="DatePicker">
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="Width" Value="450" />
			<Setter Property="Margin" Value="0,4,0,8" />
		</Style>

		<Style x:Key="ToggleSwitchStyle" TargetType="ToggleSwitch">
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="Width" Value="450" />
			<Setter Property="Margin" Value="0,4,0,8" />
		</Style>

		<Style x:Key="ValidationErrorStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Foreground" Value="{StaticResource BrushError}" />
			<Setter Property="Margin" Value="0,0,0,8" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
	</ContentControl.Resources>

	<ScrollViewer
        Width="Auto"
        Margin="12,12,12,0"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
		<Grid Padding="12,12,12,12">
			<StackPanel HorizontalAlignment="Center">

				<StackPanel HorizontalAlignment="Center" Spacing="4">
					<TextBlock x:Uid="PromotionNameLabel" Style="{StaticResource InputLabelStyle}" />
					<TextBox
                        x:Name="PromotionNameTextBox"
                        x:Uid="PromotionNamePlaceholder"
                        Style="{StaticResource InputFieldStyle}"
                        TextChanged="PromotionNameTextBox_TextChanged" />
					<TextBlock
                        x:Name="PromotionNameError"
                        Style="{StaticResource ValidationErrorStyle}"
                        Visibility="Collapsed" />

					<TextBlock x:Uid="PromotionDescriptionLabel" Style="{StaticResource InputLabelStyle}" />
					<TextBox
                        x:Name="PromotionDescriptionTextBox"
                        x:Uid="PromotionDescriptionPlaceholder"
                        Style="{StaticResource MultilineInputFieldStyle}"
                        TextChanged="PromotionDescriptionTextBox_TextChanged" />
					<TextBlock
                        x:Name="PromotionDescriptionError"
                        Style="{StaticResource ValidationErrorStyle}"
                        Visibility="Collapsed" />

					<TextBlock x:Uid="PromotionStartDateLabel" Style="{StaticResource InputLabelStyle}" />
					<DatePicker
                        x:Name="PromotionStartDatePicker"
                        Style="{StaticResource DatePickerStyle}"
                        DateChanged="PromotionStartDatePicker_DateChanged" />
					<TextBlock
                        x:Name="StartDateError"
                        Style="{StaticResource ValidationErrorStyle}"
                        Visibility="Collapsed" />

					<TextBlock x:Uid="PromotionEndDateLabel" Style="{StaticResource InputLabelStyle}" />
					<DatePicker
                        x:Name="PromotionEndDatePicker"
                        Style="{StaticResource DatePickerStyle}"
                        DateChanged="PromotionEndDatePicker_DateChanged" />
					<TextBlock
                        x:Name="EndDateError"
                        Style="{StaticResource ValidationErrorStyle}"
                        Visibility="Collapsed" />

					<TextBlock
                        x:Name="DateValidationError"
                        Style="{StaticResource ValidationErrorStyle}"
                        Visibility="Collapsed" />

					<TextBlock x:Uid="PromotionIsActiveLabel" Style="{StaticResource InputLabelStyle}" />
					<ToggleSwitch
                        x:Name="PromotionIsActiveToggle"
                        Style="{StaticResource ToggleSwitchStyle}"
                        OnContent="Active"
                        OffContent="Inactive" />

				</StackPanel>

				<StackPanel x:Name="MessagePanel" Spacing="8">
					<InfoBar
                        x:Name="ErrorInfoBar"
                        x:Uid="PromotionUpdateFailedMessage"
                        IsOpen="False"
                        Severity="Error" />

					<InfoBar
                        x:Name="SuccessInfoBar"
                        x:Uid="PromotionUpdateSuccessMessage"
                        IsOpen="False"
                        Severity="Success" />
				</StackPanel>

			</StackPanel>

			<Border
                x:Name="LoadingOverlay"
                Background="#80000000"
                Visibility="Collapsed">
				<StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
					<ProgressRing
                        Width="32"
                        Height="32"
                        IsActive="True" />
					<TextBlock
                        x:Uid="ProcessingPromotionText"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        Foreground="White" />
				</StackPanel>
			</Border>
		</Grid>
	</ScrollViewer>

</ContentControl>
