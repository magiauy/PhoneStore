<?xml version="1.0" encoding="utf-8" ?>
<ContentControl
    x:Class="PhoneStoreAdmin.View.Controls.SupplierDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhoneStoreAdmin.View.Controls"
    Width="5000">

    <ContentControl.Resources>
        <Style x:Key="InputFieldStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource BrushSurface}" />
            <Setter Property="Margin" Value="0,4,0,8" />
            <Setter Property="Padding" Value="8,8" />
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Width" Value="450" />
        </Style>

        <Style
            x:Key="MultilineInputFieldStyle"
            BasedOn="{StaticResource InputFieldStyle}"
            TargetType="TextBox">
            <Setter Property="Height" Value="80" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style
            x:Key="ReadOnlyFieldStyle"
            BasedOn="{StaticResource InputFieldStyle}"
            TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Background" Value="{StaticResource BrushBackground}" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        </Style>

        <Style x:Key="InputLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Margin" Value="0,8,0,4" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Width" Value="450" />
        </Style>

        <Style x:Key="ValidationErrorStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource BrushError}" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleSwitch">
            <Setter Property="Margin" Value="0,0,0,0" />
            <Setter Property="Padding" Value="0,0,0,0" />
            <Setter Property="Header" Value="" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Width" Value="400" />
        </Style>
    </ContentControl.Resources>
    <ScrollViewer
        Width="Auto"
        Margin="12,12,12,0"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid Padding="12,12,12,12">
            <StackPanel HorizontalAlignment="Center">

                <!--  Form Fields  -->
                <StackPanel HorizontalAlignment="Center" Spacing="4">

                    <!--  Supplier Name  -->
                    <TextBlock x:Uid="SupplierNameLabel" Style="{StaticResource InputLabelStyle}" />
                    <TextBox
                        x:Name="SupplierNameTextBox"
                        x:Uid="SupplierNamePlaceholder"
                        Style="{StaticResource InputFieldStyle}"
                        TextChanged="SupplierNameTextBox_TextChanged" />
                    <TextBlock
                        x:Name="SupplierNameError"
                        Style="{StaticResource ValidationErrorStyle}"
                        Visibility="Collapsed" />

                    <!--  Phone  -->
                    <TextBlock x:Uid="SupplierPhoneLabel" Style="{StaticResource InputLabelStyle}" />
                    <TextBox
                        x:Name="PhoneTextBox"
                        x:Uid="PhonePlaceholder"
                        Style="{StaticResource InputFieldStyle}"
                        TextChanged="PhoneTextBox_TextChanged" />
                    <TextBlock
                        x:Name="PhoneError"
                        Style="{StaticResource ValidationErrorStyle}"
                        Visibility="Collapsed" />

                    <!--  Email  -->
                    <TextBlock x:Uid="SupplierEmailLabel" Style="{StaticResource InputLabelStyle}" />
                    <TextBox
                        x:Name="EmailTextBox"
                        x:Uid="EmailPlaceholder"
                        Style="{StaticResource InputFieldStyle}"
                        TextChanged="EmailTextBox_TextChanged" />
                    <TextBlock
                        x:Name="EmailError"
                        Style="{StaticResource ValidationErrorStyle}"
                        Visibility="Collapsed" />

                    <!--  Address  -->
                    <TextBlock x:Uid="SupplierAddressLabel" Style="{StaticResource InputLabelStyle}" />
                    <TextBox
                        x:Name="AddressTextBox"
                        x:Uid="AddressPlaceholder"
                        Style="{StaticResource MultilineInputFieldStyle}"
                        TextChanged="AddressTextBox_TextChanged" />
                    <TextBlock
                        x:Name="AddressError"
                        Style="{StaticResource ValidationErrorStyle}"
                        Visibility="Collapsed" />

                    <!--  Tax Number  -->
                    <TextBlock x:Uid="SupplierTaxNumberLabel" Style="{StaticResource InputLabelStyle}" />
                    <TextBox
                        x:Name="TaxNumberTextBox"
                        x:Uid="TaxNumberPlaceholder"
                        Style="{StaticResource InputFieldStyle}"
                        TextChanged="TaxNumberTextBox_TextChanged" />
                    <TextBlock
                        x:Name="TaxNumberError"
                        Style="{StaticResource ValidationErrorStyle}"
                        Visibility="Collapsed" />

                    <!--  Is Active  -->
                    <TextBlock x:Uid="SupplierIsActiveLabel" Style="{StaticResource InputLabelStyle}" />
                    <ToggleSwitch
                        x:Name="IsActiveToggleSwitch"
                        Style="{StaticResource ToggleSwitchStyle}"
                        Toggled="IsActiveToggleSwitch_Toggled" />

                </StackPanel>

                <!--  Success/Error Messages  -->
                <StackPanel x:Name="MessagePanel" Spacing="8">
                    <InfoBar
                        x:Name="ErrorInfoBar"
                        x:Uid="SupplierUpdateFailedMessage"
                        IsOpen="False"
                        Severity="Error" />

                    <InfoBar
                        x:Name="SuccessInfoBar"
                        x:Uid="SupplierUpdateSuccessMessage"
                        IsOpen="False"
                        Severity="Success" />
                </StackPanel>

            </StackPanel>

            <!--  Loading Overlay  -->
            <Border
                x:Name="LoadingOverlay"
                Background="#80000000"
                Visibility="Collapsed">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
                    <ProgressRing
                        Width="32"
                        Height="32"
                        IsActive="True" />
                    <TextBlock
                        x:Uid="ProcessingSupplierText"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        Foreground="White" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>

</ContentControl>