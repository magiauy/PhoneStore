<?xml version="1.0" encoding="utf-8" ?>
<ContentControl
    x:Class="PhoneStoreAdmin.View.Controls.CustomerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhoneStoreAdmin.View.Controls"
    Width="500">

    <ContentControl.Resources>
        <Style x:Key="InputFieldStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource BrushSurface}" />
            <Setter Property="Margin" Value="0,4,0,8" />
            <Setter Property="Padding" Value="8,8" />
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Width" Value="420" />
        </Style>

        <Style
            x:Key="MultilineInputFieldStyle"
            BasedOn="{StaticResource InputFieldStyle}"
            TargetType="TextBox">
            <Setter Property="Height" Value="80" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style
            x:Key="ReadOnlyFieldStyle"
            BasedOn="{StaticResource InputFieldStyle}"
            TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Background" Value="{StaticResource BrushBackground}" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        </Style>

        <Style x:Key="InputLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Margin" Value="0,8,0,4" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Width" Value="420" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ValidationErrorStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource BrushError}" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleSwitch">
            <Setter Property="Margin" Value="0,0,0,0" />
            <Setter Property="Padding" Value="0,0,0,0" />
            <Setter Property="Header" Value="" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Width" Value="400" />
        </Style>
    </ContentControl.Resources>

    <ScrollViewer
        Width="Auto"
        Margin="12,12,12,0"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid Padding="12">
            <StackPanel HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" Spacing="4">
                    <TextBlock x:Uid="CustomerIdLabel" Text="Mã khách hàng" Style="{StaticResource InputLabelStyle}" />
                    <TextBox
                        x:Name="CustomerIdTextBox"
                        IsEnabled="False"
                        Style="{StaticResource ReadOnlyFieldStyle}" />

                    <TextBlock x:Uid="CustomerNameLabel" Text="Họ và tên" Style="{StaticResource InputLabelStyle}" />
                    <TextBox
                        x:Name="CustomerNameTextBox"
                        x:Uid="CustomerNamePlaceholder"
                        Style="{StaticResource InputFieldStyle}"
                        TextChanged="CustomerNameTextBox_TextChanged" />
                    <TextBlock
                        x:Name="CustomerNameError"
                        Style="{StaticResource ValidationErrorStyle}"
                        Visibility="Collapsed" />

                    <TextBlock x:Uid="CustomerPhoneLabel" Text="Số điện thoại" Style="{StaticResource InputLabelStyle}" />
                    <TextBox
                        x:Name="PhoneTextBox"
                        x:Uid="CustomerPhonePlaceholder"
                        Style="{StaticResource InputFieldStyle}"
                        TextChanged="PhoneTextBox_TextChanged" />
                    <TextBlock
                        x:Name="PhoneError"
                        Style="{StaticResource ValidationErrorStyle}"
                        Visibility="Collapsed" />

                    <TextBlock x:Uid="CustomerEmailLabel" Text="Email" Style="{StaticResource InputLabelStyle}" />
                    <TextBox
                        x:Name="EmailTextBox"
                        x:Uid="CustomerEmailPlaceholder"
                        Style="{StaticResource InputFieldStyle}"
                        TextChanged="EmailTextBox_TextChanged" />
                    <TextBlock
                        x:Name="EmailError"
                        Style="{StaticResource ValidationErrorStyle}"
                        Visibility="Collapsed" />

                    <TextBlock x:Uid="CustomerAddressLabel" Text="Địa chỉ" Style="{StaticResource InputLabelStyle}" />
                    <TextBox
                        x:Name="AddressTextBox"
                        x:Uid="CustomerAddressPlaceholder"
                        Style="{StaticResource MultilineInputFieldStyle}"
                        TextChanged="AddressTextBox_TextChanged" />
                    <TextBlock
                        x:Name="AddressError"
                        Style="{StaticResource ValidationErrorStyle}"
                        Visibility="Collapsed" />

                    <TextBlock x:Uid="CustomerStatusLabel" Text="Trạng thái hoạt động" Style="{StaticResource InputLabelStyle}" />
                    <ToggleSwitch
                        x:Name="IsActiveToggleSwitch"
                        x:Uid="CustomerStatusToggle"
                        Style="{StaticResource ToggleSwitchStyle}"
                        Toggled="IsActiveToggleSwitch_Toggled" />
                </StackPanel>

                <StackPanel x:Name="MessagePanel" Spacing="8" Margin="0,12,0,0">
                    <InfoBar
                        x:Name="ErrorInfoBar"
                        x:Uid="CustomerUpdateFailedMessage"
                        IsOpen="False"
                        Severity="Error" />
                    <InfoBar
                        x:Name="SuccessInfoBar"
                        x:Uid="CustomerUpdateSuccessMessage"
                        IsOpen="False"
                        Severity="Success" />
                </StackPanel>
            </StackPanel>

            <Border
                x:Name="LoadingOverlay"
                Background="#80000000"
                Visibility="Collapsed">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
                    <ProgressRing Width="32" Height="32" IsActive="True" />
                    <TextBlock
                        x:Uid="ProcessingCustomerText"
                        Text="Đang xử lý..."
                        HorizontalAlignment="Center"
                        FontSize="14"
                        Foreground="White" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</ContentControl>
