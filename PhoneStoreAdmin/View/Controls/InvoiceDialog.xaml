<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="PhoneStoreAdmin.View.Controls.InvoiceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Invoice Dialog"
    xmlns:local="using:PhoneStoreAdmin.View.Controls"
    Width="500">

    <ContentControl.Resources>
        <!-- Reuse the same base styles from SupplierDialog -->
        <Style x:Key="InputFieldStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource BrushSurface}" />
            <Setter Property="Margin" Value="0,4,0,8" />
            <Setter Property="Padding" Value="8,8" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Width" Value="450" />
        </Style>

        <Style
            x:Key="InputLabelStyle"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Margin" Value="0,8,0,4" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Width" Value="450" />
        </Style>

        <Style x:Key="ReadOnlyFieldStyle" TargetType="TextBox" BasedOn="{StaticResource InputFieldStyle}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Background" Value="{StaticResource BrushBackground}" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        </Style>
    </ContentControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="12">
			<StackPanel HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" Spacing="4">
             
                    <!-- Person -->
                    <TextBlock x:Uid="InvoiceCustomerLabel" Style="{StaticResource InputLabelStyle}" />
                    <ComboBox x:Name="PersonComboBox"
                              Width="450"
                              PlaceholderText="Select customer"
                              HorizontalAlignment="Center"/>

                    <!-- Promotion -->
                    <TextBlock x:Uid="InvoicePromoteCodeLabel" Style="{StaticResource InputLabelStyle}" />
                    <ComboBox x:Name="PromotionComboBox"
                              PlaceholderText="Select promotion code"
                              DisplayMemberPath="Code"
                              SelectedValuePath="Id"
                              Width="300"
                              SelectionChanged="PromotionComboBox_SelectionChanged"/>
					
                    <!-- Created By -->
                    <TextBlock x:Uid="InvoiceCreatorLabel" Style="{StaticResource InputLabelStyle}" />
                    <ComboBox x:Name="CreatedByComboBox"
                              Width="450"
                              PlaceholderText="Select staff"
                              HorizontalAlignment="Center"/>

                    <!-- Invoice Date -->
                    <TextBlock x:Uid="InvoiceDateLabel" Style="{StaticResource InputLabelStyle}" />
                    <DatePicker x:Name="InvoiceDatePicker" Width="450" HorizontalAlignment="Center"/>

                    <!-- Status -->
                    <TextBlock x:Uid="InvoiceStatusLabel" Style="{StaticResource InputLabelStyle}" />
                    <ComboBox x:Name="StatusComboBox"
                              Width="450"
                              HorizontalAlignment="Center"
                              PlaceholderText="Select status">
                        <ComboBoxItem Content="Pending"/>
                        <ComboBoxItem Content="Paid"/>
                        <ComboBoxItem Content="Cancelled"/>
                    </ComboBox>

                    <!-- Total Amount -->
                    <TextBlock x:Uid="InvoiceTotalLabel" Style="{StaticResource InputLabelStyle}" />
                    <TextBox x:Name="TotalAmountTextBox"
                             Style="{StaticResource InputFieldStyle}"
                             InputScope="Number"
                             TextChanged="TotalAmountTextBox_TextChanged"/>
					<TextBlock x:Name="TotalAmountError"
                           Foreground="Red"
                           FontSize="12"
                           Visibility="Collapsed"
                           Text="Please enter a valid total amount" />
					
                    <!-- Discount Amount (auto-filled from promotion) -->
                    <TextBlock x:Uid="InvoiceDiscountLabel" Style="{StaticResource InputLabelStyle}" />
					<TextBox x:Name="DiscountAmountTextBox"
			                IsReadOnly="True"
			                PlaceholderText="Auto-filled from promotion code"
			                Width="300"/>

                    <!-- Final Amount -->
                    <TextBlock x:Uid="InvoiceFinalLabel" Style="{StaticResource InputLabelStyle}" />
					<TextBox x:Name="FinalAmountTextBox" IsReadOnly="True" Width="300"/>

                    <!-- Payment Method -->
                    <TextBlock x:Uid="InvoicePaymentLabel" Style="{StaticResource InputLabelStyle}" />
                    <ComboBox x:Name="PaymentMethodComboBox"
                              Width="450"
                              HorizontalAlignment="Center"
                              PlaceholderText="Select method">
                        <ComboBoxItem Content="Cash"/>
                        <ComboBoxItem Content="Card"/>
                        <ComboBoxItem Content="Transfer"/>
                    </ComboBox>
					<TextBlock x:Name="PaymentMethodError"
                       Foreground="Red"
                       Visibility="Collapsed"
                       Text="Please select payment method" />

                    <!-- Note -->
                    <TextBlock x:Uid="InvoiceNoteLabel" Style="{StaticResource InputLabelStyle}" />
                    <TextBox x:Name="NoteTextBox"
                             Style="{StaticResource InputFieldStyle}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="80"/>
            </StackPanel>
			<!--  Success/Error Messages  -->
			<StackPanel x:Name="MessagePanel" Spacing="8">
				<InfoBar
					x:Name="ErrorInfoBar"
					x:Uid="InvoiceUpdateFailedMessage"
					IsOpen="False"
					Severity="Error" />

				<InfoBar
					x:Name="SuccessInfoBar"
					x:Uid="InvoiceUpdateSuccessMessage"
					IsOpen="False"
					Severity="Success" />
			</StackPanel>

			</StackPanel>

			<!--  Loading Overlay  -->
			<Border
                x:Name="LoadingOverlay"
                Background="#80000000"
                Visibility="Collapsed">
				<StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
					<ProgressRing
                        Width="32"
                        Height="32"
                        IsActive="True" />
					<TextBlock
                        x:Uid="ProcessingSupplierText"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        Foreground="White" />
				</StackPanel>
			</Border>
        </Grid>
    </ScrollViewer>
</ContentDialog>