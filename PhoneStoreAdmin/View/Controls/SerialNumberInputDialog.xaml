<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="PhoneStoreAdmin.View.Controls.SerialNumberInputDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhoneStoreAdmin.View.Controls"
    x:Uid="SerialNumberInputDialog"
    Width="600"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,16,0,0" Spacing="16">
            <!--  Validation Error InfoBar  -->
            <InfoBar
                x:Name="ValidationInfoBar"
                x:Uid="ValidationErrorInfoBar"
                Closed="ValidationErrorInfoBar_Closed"
                IsClosable="True"
                IsOpen="{x:Bind ShowValidationError, Mode=OneWay}"
                Message="{x:Bind ValidationMessage, Mode=OneWay}"
                Severity="Error" />

            <TextBlock
                FontSize="16"
                FontWeight="SemiBold"
                Text="{x:Bind ProductName, Mode=OneWay}"
                TextWrapping="Wrap" />

            <TextBlock
                FontSize="14"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind GetQuantityText(), Mode=OneWay}"
                TextWrapping="Wrap" />

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!--  Toggle for input mode  -->
            <ToggleSwitch
                x:Name="RangeInputToggle"
                Header="Serial Input Mode"
                IsOn="{x:Bind IsRangeInputMode, Mode=TwoWay}"
                OffContent="Manual entry"
                OnContent="Range input (from - to)"
                Toggled="OnInputModeToggled" />

            <!--  Range Input Section  -->
            <Border
                Padding="16"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind RangeInputVisibility, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <TextBlock
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Enter starting serial, system will automatically generate sequential serials."
                        TextWrapping="Wrap" />
                    
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <TextBox
                            x:Name="StartSerialTextBox"
                            Grid.Column="0"
                            Header="Starting Serial"
                            PlaceholderText="E.g: SN001"
                            Text="{x:Bind StartSerial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextChanged="OnStartSerialChanged" />
                        
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Click="OnGenerateSerials"
                            Content="Generate Serials"
                            Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                    
                    <!--  Preview of generated serials  -->
                    <TextBlock
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind GeneratedSerialsPreview, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind HasGeneratedPreview, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!--  Manual Input Section - Serial number inputs  -->
            <StackPanel Spacing="8" Visibility="{x:Bind ManualInputVisibility, Mode=OneWay}">
                <ItemsRepeater ItemsSource="{x:Bind SerialEntries}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="local:SerialEntry">
                            <Border
                                Margin="0,0,0,8"
                                Padding="12"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind GetMachineTitle(), Mode=OneWay}" />

                                    <TextBox
                                        Grid.Column="1"
                                        PlaceholderText="Enter Serial Number"
                                        Text="{x:Bind SerialNumber, Mode=TwoWay}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
