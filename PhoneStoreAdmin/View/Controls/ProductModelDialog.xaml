<?xml version="1.0" encoding="utf-8"?>
<ContentControl
    x:Class="PhoneStoreAdmin.View.Controls.ProductModelDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="480"
    mc:Ignorable="d">
    <ContentControl.Resources>
        <Style x:Key="InputFieldStyle" TargetType="Control">
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource BrushSurface}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,4,0,12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="TextInputStyle" TargetType="TextBox" BasedOn="{StaticResource InputFieldStyle}" />
        <Style x:Key="MultilineInputStyle" TargetType="TextBox" BasedOn="{StaticResource InputFieldStyle}">
            <Setter Property="Height" Value="120" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="InputLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>

        <Style x:Key="ValidationErrorStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource BrushError}" />
            <Setter Property="Margin" Value="0,-8,0,8" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </ContentControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8" Padding="16">
            <StackPanel>
                <TextBlock Text="Model name" Style="{StaticResource InputLabelStyle}" />
                <TextBox x:Name="NameTextBox" Style="{StaticResource TextInputStyle}" TextChanged="NameTextBox_TextChanged" />
                <TextBlock x:Name="NameErrorText" Style="{StaticResource ValidationErrorStyle}" />
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Description" Style="{StaticResource InputLabelStyle}" />
                <TextBox x:Name="DescriptionTextBox" Style="{StaticResource MultilineInputStyle}" TextChanged="DescriptionTextBox_TextChanged" />
                <TextBlock x:Name="DescriptionErrorText" Style="{StaticResource ValidationErrorStyle}" />
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Default image URL" Style="{StaticResource InputLabelStyle}" />
                <TextBox x:Name="ImageUrlTextBox" Style="{StaticResource TextInputStyle}" TextChanged="ImageUrlTextBox_TextChanged" />
                <TextBlock x:Name="ImageUrlErrorText" Style="{StaticResource ValidationErrorStyle}" />
            </StackPanel>

            <InfoBar
                x:Name="ErrorInfoBar"
                IsOpen="False"
                Severity="Error"
                Margin="0,12,0,0"
                Title="Unable to save model" />
            <InfoBar
                x:Name="SuccessInfoBar"
                IsOpen="False"
                Severity="Success"
                Margin="0,8,0,0"
                Title="Model updated" />
        </StackPanel>
    </ScrollViewer>
</ContentControl>
