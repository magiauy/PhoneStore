<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="PhoneStoreAdmin.View.Controls.ProductModelDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:PhoneStoreAdmin.View.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ContentDialog.Resources>
        <Style x:Key="InputFieldStyle" TargetType="Control">
            <Setter Property="Height" Value="42" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource BrushSurface}" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,6,0,12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="TextInputStyle" TargetType="TextBox" BasedOn="{StaticResource InputFieldStyle}" />
        <Style x:Key="MultilineInputStyle" TargetType="TextBox" BasedOn="{StaticResource InputFieldStyle}">
            <Setter Property="Height" Value="100" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="InputLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Margin" Value="0,8,0,6" />
        </Style>

        <Style x:Key="ValidationErrorStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource BrushError}" />
            <Setter Property="Margin" Value="0,-8,0,8" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </ContentDialog.Resources>

    <Grid Width="720">
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="650">
            <Grid Padding="20" ColumnDefinitions="300,360" ColumnSpacing="24">
                <StackPanel Grid.Column="0" Spacing="12">
                <StackPanel>
                    <TextBlock Text="Model name" Style="{StaticResource InputLabelStyle}" />
                    <TextBox x:Name="NameTextBox" Style="{StaticResource TextInputStyle}" TextChanged="NameTextBox_TextChanged" PlaceholderText="Enter product model name..." />
                    <TextBlock x:Name="NameErrorText" Style="{StaticResource ValidationErrorStyle}" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Description" Style="{StaticResource InputLabelStyle}" />
                    <TextBox x:Name="DescriptionTextBox" Style="{StaticResource MultilineInputStyle}" TextChanged="DescriptionTextBox_TextChanged" PlaceholderText="Enter model description (optional)..." />
                    <TextBlock x:Name="DescriptionErrorText" Style="{StaticResource ValidationErrorStyle}" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Default image URL" Style="{StaticResource InputLabelStyle}" />
                    <TextBox x:Name="ImageUrlTextBox" Style="{StaticResource TextInputStyle}" TextChanged="ImageUrlTextBox_TextChanged" PlaceholderText="https://example.com/image.jpg" />
                    <TextBlock x:Name="ImageUrlErrorText" Style="{StaticResource ValidationErrorStyle}" />
                </StackPanel>

                <InfoBar
                    x:Name="ErrorInfoBar"
                    IsOpen="False"
                    Severity="Error"
                    Margin="0,12,0,0"
                    Title="Unable to save model" />
                <InfoBar
                    x:Name="SuccessInfoBar"
                    IsOpen="False"
                    Severity="Success"
                    Margin="0,8,0,0"
                    Title="Model updated" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="12">
                <TextBlock Text="Attributes" Style="{StaticResource InputLabelStyle}" Margin="0,8,0,8" />
                <TextBlock
                    x:Name="EmptyAttributesText"
                    Text="No attributes available. Create product attributes first."
                    Style="{StaticResource ValidationErrorStyle}"
                    Margin="0,-4,0,8" />
                <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{x:Bind AttributeSelections, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="controls:ModelAttributeSelection">
                                <Border 
                                    Background="{StaticResource BrushSurface}" 
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8" 
                                    Padding="14">
                                    <StackPanel Spacing="6">
                                        <CheckBox 
                                            Content="{x:Bind DisplayName}" 
                                            IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                            FontWeight="SemiBold"
                                            FontSize="14" />
                                        <TextBlock 
                                            Text="{x:Bind DataTypeLabel}" 
                                            Foreground="{StaticResource BrushSecondaryText}" 
                                            FontSize="12"
                                            Margin="32,0,0,0" />
                                        <TextBlock
                                            Text="{x:Bind Description}"
                                            Visibility="{x:Bind DescriptionVisibility}"
                                            Foreground="{StaticResource BrushSecondaryText}"
                                            FontSize="12"
                                            TextWrapping="Wrap"
                                            Margin="32,0,0,0"
                                            Opacity="0.8" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Grid>
        </ScrollViewer>
    </Grid>
</ContentDialog>
