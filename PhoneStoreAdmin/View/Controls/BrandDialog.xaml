<?xml version="1.0" encoding="utf-8" ?>
<ContentControl
    x:Class="PhoneStoreAdmin.View.Controls.BrandDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhoneStoreAdmin.View.Controls"
    Width="500">

    <ContentControl.Resources>
        <Style x:Key="InputFieldStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource BrushSurface}" />
            <Setter Property="Margin" Value="0,4,0,8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Width" Value="450" />
        </Style>

        <Style
            x:Key="ReadOnlyFieldStyle"
            BasedOn="{StaticResource InputFieldStyle}"
            TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Background" Value="{StaticResource BrushBackground}" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        </Style>

        <Style x:Key="InputLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Margin" Value="0,8,0,4" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Width" Value="450" />
        </Style>

        <Style x:Key="ValidationErrorStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource BrushError}" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </ContentControl.Resources>
    
    <ScrollViewer
        Width="Auto"
        Margin="12,12,12,0"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid Padding="12,12,12,12">
            <StackPanel HorizontalAlignment="Center">

                <StackPanel HorizontalAlignment="Center" Spacing="4">

                    <TextBlock x:Uid="BrandIdLabel" Style="{StaticResource InputLabelStyle}" />
                    <TextBox
                        x:Name="BrandIdTextBox"
                        IsEnabled="False"
                        Style="{StaticResource ReadOnlyFieldStyle}" />

                    <TextBlock x:Uid="BrandNameLabel" Style="{StaticResource InputLabelStyle}" />
                    <TextBox
                        x:Name="BrandNameTextBox"
                        x:Uid="BrandNamePlaceholder"
                        Style="{StaticResource InputFieldStyle}"
                        TextChanged="BrandNameTextBox_TextChanged" />
                    <TextBlock
                        x:Name="BrandNameError"
                        Style="{StaticResource ValidationErrorStyle}"
                        Visibility="Collapsed" />

                </StackPanel>

                <StackPanel x:Name="MessagePanel" Spacing="8">
                    <InfoBar
                        x:Name="ErrorInfoBar"
                        x:Uid="BrandUpdateFailedMessage"
                        IsOpen="False"
                        Severity="Error" />

                    <InfoBar
                        x:Name="SuccessInfoBar"
                        x:Uid="BrandUpdateSuccessMessage"
                        IsOpen="False"
                        Severity="Success" />
                </StackPanel>

            </StackPanel>

            <Border
                x:Name="LoadingOverlay"
                Background="#80000000"
                Visibility="Collapsed">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
                    <ProgressRing
                        Width="32"
                        Height="32"
                        IsActive="True" />
                    <TextBlock
                        x:Uid="ProcessingBrandText"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        Foreground="White" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>

</ContentControl>