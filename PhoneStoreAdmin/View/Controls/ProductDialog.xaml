<?xml version="1.0" encoding="utf-8" ?>
<ContentControl
    x:Class="PhoneStoreAdmin.View.Controls.ProductDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhoneStoreAdmin.View.Controls"
    Width="560">

    <ContentControl.Resources>
        <Style x:Key="InputFieldStyle" TargetType="Control">
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource BrushSurface}" />
            <Setter Property="Margin" Value="0,4,0,8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="TextInputStyle" TargetType="TextBox" BasedOn="{StaticResource InputFieldStyle}" />
        <Style x:Key="NumberInputStyle" TargetType="NumberBox" BasedOn="{StaticResource InputFieldStyle}" />
        <Style x:Key="ComboInputStyle" TargetType="ComboBox" BasedOn="{StaticResource InputFieldStyle}" />

        <Style x:Key="InputLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Margin" Value="0,8,0,4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="ValidationErrorStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource BrushError}" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </ContentControl.Resources>

    <Grid>
        <ScrollViewer
            Width="Auto"
            Margin="12,12,12,0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">

                <StackPanel>
                    <TextBlock x:Uid="ProductSkuLabel" Style="{StaticResource InputLabelStyle}" />
                    <TextBox
                        x:Name="SkuTextBox"
                        x:Uid="ProductSkuPlaceholder"
                        Style="{StaticResource TextInputStyle}"
                        TextChanged="SkuTextBox_TextChanged" />
                    <TextBlock x:Name="SkuError" Style="{StaticResource ValidationErrorStyle}" />
                </StackPanel>

                <StackPanel>
                    <TextBlock x:Uid="ProductNameLabel" Style="{StaticResource InputLabelStyle}" />
                    <TextBox
                        x:Name="NameTextBox"
                        x:Uid="ProductNamePlaceholder"
                        Style="{StaticResource TextInputStyle}"
                        TextChanged="NameTextBox_TextChanged" />
                    <TextBlock x:Name="NameError" Style="{StaticResource ValidationErrorStyle}" />
                </StackPanel>

                <StackPanel>
                    <TextBlock x:Uid="ProductCategoryLabel" Style="{StaticResource InputLabelStyle}" />
                    <ComboBox
                        x:Name="CategoryComboBox"
                        x:Uid="ProductCategoryPlaceholder"
                        Style="{StaticResource ComboInputStyle}"
                        DisplayMemberPath="DisplayName"
                        SelectedValuePath="Value"
                        SelectionChanged="CategoryComboBox_SelectionChanged" />
                    <TextBlock x:Name="CategoryError" Style="{StaticResource ValidationErrorStyle}" />
                </StackPanel>

                <StackPanel>
                    <TextBlock x:Uid="ProductBrandLabel" Style="{StaticResource InputLabelStyle}" />
                    <ComboBox
                        x:Name="BrandComboBox"
                        x:Uid="ProductBrandPlaceholder"
                        Style="{StaticResource ComboInputStyle}"
                        DisplayMemberPath="DisplayName"
                        SelectedValuePath="Value"
                        SelectionChanged="BrandComboBox_SelectionChanged" />
                    <TextBlock x:Name="BrandError" Style="{StaticResource ValidationErrorStyle}" />
                </StackPanel>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Uid="ProductPriceLabel" Style="{StaticResource InputLabelStyle}" />
                        <NumberBox
                            x:Name="PriceNumberBox"
                            x:Uid="ProductPricePlaceholder"
                            Style="{StaticResource NumberInputStyle}"
                            Minimum="0"
                            SmallChange="1000"
                            SpinButtonPlacementMode="Inline"
                            ValueChanged="PriceNumberBox_ValueChanged" />
                        <TextBlock x:Name="PriceError" Style="{StaticResource ValidationErrorStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock x:Uid="ProductCostLabel" Style="{StaticResource InputLabelStyle}" />
                        <NumberBox
                            x:Name="CostNumberBox"
                            x:Uid="ProductCostPlaceholder"
                            Style="{StaticResource NumberInputStyle}"
                            Minimum="0"
                            SmallChange="1000"
                            SpinButtonPlacementMode="Inline"
                            ValueChanged="CostNumberBox_ValueChanged" />
                        <TextBlock x:Name="CostError" Style="{StaticResource ValidationErrorStyle}" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                    <StackPanel Width="200">
                        <TextBlock x:Uid="ProductWarrantyLabel" Style="{StaticResource InputLabelStyle}" />
                        <NumberBox
                            x:Name="WarrantyNumberBox"
                            x:Uid="ProductWarrantyPlaceholder"
                            Style="{StaticResource NumberInputStyle}"
                            Minimum="0"
                            Maximum="240"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="WarrantyNumberBox_ValueChanged" />
                        <TextBlock x:Name="WarrantyError" Style="{StaticResource ValidationErrorStyle}" />
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock x:Uid="ProductIsSerialTrackedLabel" Style="{StaticResource InputLabelStyle}" />
                        <ToggleSwitch
                            x:Name="SerialTrackedToggle"
                            Toggled="SerialTrackedToggle_Toggled" />
                    </StackPanel>
                </StackPanel>

                <StackPanel>
                    <TextBlock x:Uid="ProductStatusLabel" Style="{StaticResource InputLabelStyle}" />
                    <ComboBox
                        x:Name="StatusComboBox"
                        Style="{StaticResource ComboInputStyle}"
                        DisplayMemberPath="DisplayName"
                        SelectedValuePath="Value"
                        SelectionChanged="StatusComboBox_SelectionChanged" />
                    <TextBlock x:Name="StatusError" Style="{StaticResource ValidationErrorStyle}" />
                </StackPanel>

                <StackPanel x:Name="SerialSummaryPanel" Spacing="4" Visibility="Collapsed">
                    <TextBlock x:Name="SerialSummaryText" Style="{StaticResource InputLabelStyle}" />
                    <Button
                        x:Name="ViewSerialsButton"
                        HorizontalAlignment="Left"
                        Click="ViewSerialsButton_Click" />
                </StackPanel>

                <StackPanel>
                    <TextBlock x:Uid="ProductAttributesHeader" Style="{StaticResource InputLabelStyle}" />
                    <StackPanel x:Name="AttributesPanel" Spacing="12" />
                </StackPanel>

                <StackPanel x:Name="MessagePanel" Spacing="8">
                    <InfoBar
                        x:Name="ErrorInfoBar"
                        x:Uid="ProductUpdateFailedMessage"
                        IsOpen="False"
                        Severity="Error" />
                    <InfoBar
                        x:Name="SuccessInfoBar"
                        x:Uid="ProductUpdateSuccessMessage"
                        IsOpen="False"
                        Severity="Success" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Border
            x:Name="LoadingOverlay"
            Background="#80000000"
            Visibility="Collapsed">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <ProgressRing Width="32" Height="32" IsActive="True" />
                <TextBlock
                    x:Uid="ProcessingProductText"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="White" />
            </StackPanel>
        </Border>
    </Grid>
</ContentControl>
