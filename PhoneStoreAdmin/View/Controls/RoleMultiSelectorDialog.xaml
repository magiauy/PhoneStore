<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="PhoneStoreAdmin.View.Controls.RoleMultiSelectorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhoneStoreAdmin.View.Controls"
    Title="Chọn vai trò"
    Width="800"
    Height="600"
    MinWidth="600"
    MinHeight="400"
    MaxWidth="1000"
    MaxHeight="800"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    PrimaryButtonText="Xác nhận"
    SecondaryButtonText="Hủy">

    <ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Theme/Colors.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Shadow  -->
            <ThemeShadow x:Name="SharedShadow" />

            <!--  Search Box Style  -->
            <Style x:Key="DialogSearchBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="40,10,16,10" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Height" Value="44" />
            </Style>
        </ResourceDictionary>
    </ContentDialog.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Search Section  -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <!--  Search Box with Icon  -->
            <TextBox
                x:Name="SearchBox"
                PlaceholderText="Tìm kiếm vai trò..."
                HorizontalAlignment="Stretch"
                Style="{StaticResource DialogSearchBoxStyle}"
                TextChanged="SearchBox_TextChanged" />
            <FontIcon
                Margin="12,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontSize="16"
                Foreground="{StaticResource BrushTextSecondary}"
                Glyph="&#xE721;"
                IsHitTestVisible="False" />
        </Grid>

        <!--  Roles List  -->
        <Grid Grid.Row="1">
            <!--  Loading State  -->
            <StackPanel
                x:Name="LoadingPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16"
                Visibility="Collapsed">
                <ProgressRing
                    Width="48"
                    Height="48"
                    Foreground="{StaticResource BrushTextPrimary}"
                    IsActive="True" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="15"
                    Foreground="{StaticResource BrushTextSecondary}"
                    Text="Đang tải danh sách vai trò..." />
            </StackPanel>

            <!--  Empty State  -->
            <StackPanel
                x:Name="EmptyPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16"
                Visibility="Collapsed">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="48"
                    Foreground="{StaticResource BrushTextSecondary}"
                    Glyph="&#xE7C3;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="16"
                    FontWeight="Medium"
                    Foreground="{StaticResource BrushTextPrimary}"
                    Text="Không tìm thấy vai trò" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="{StaticResource BrushTextSecondary}"
                    Text="Thử tìm kiếm với từ khóa khác" />
            </StackPanel>

            <!--  Roles List with Checkboxes  -->
            <ScrollViewer
                x:Name="RolesScrollViewer"
                VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="RolesContainer" Spacing="8" Padding="0,0,8,0" />
            </ScrollViewer>
        </Grid>

        <!--  Selected Count  -->
        <Border
            Grid.Row="2"
            Margin="0,16,0,0"
            Padding="12,8"
            Background="{StaticResource BrushSurfaceVariant}"
            CornerRadius="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon
                    FontSize="16"
                    Foreground="{StaticResource BrushTextPrimary}"
                    Glyph="&#xE73E;" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{StaticResource BrushTextPrimary}">
                    <Run Text="Đã chọn:" />
                    <Run x:Name="SelectedCountText" FontWeight="SemiBold" Text="0" />
                    <Run Text="vai trò" />
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</ContentDialog>
