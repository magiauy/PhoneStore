<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PhoneStoreAdmin.View.Controls.ChangePasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhoneStoreAdmin.View.Controls">

    <UserControl.Resources>
        <Style x:Key="PasswordFieldStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <Style x:Key="InputLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>

        <Style x:Key="ValidationErrorStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource BrushError}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushPrimary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BrushBackground}" MinWidth="400" MaxWidth="450" CornerRadius="8" MaxHeight="1000">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header - Fixed at top -->
        <StackPanel Grid.Row="0" Margin="24,24,24,0" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE72E;" 
                          FontSize="24" 
                          Foreground="{StaticResource BrushPrimary}"
                          VerticalAlignment="Center"/>
                <TextBlock x:Uid="ChangePasswordDialogTitle"
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource BrushText}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Uid="ChangePasswordDialogDescription"
                       FontSize="14" 
                       Foreground="{StaticResource BrushTextSecondary}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Scrollable Content -->
        <ScrollViewer Grid.Row="1" 
                      Margin="24,16,24,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">

            <!-- Form Fields -->
            <StackPanel Spacing="4">
                
                <!-- Current Password -->
                <TextBlock x:Uid="CurrentPasswordLabel" Style="{StaticResource InputLabelStyle}"/>
                <PasswordBox x:Name="CurrentPasswordBox"
                             x:Uid="CurrentPasswordPlaceholder"
                             Style="{StaticResource PasswordFieldStyle}"
                             PasswordChanged="CurrentPasswordBox_PasswordChanged"
                             PasswordRevealMode="Hidden"/>
                <TextBlock x:Name="CurrentPasswordError"
                           Style="{StaticResource ValidationErrorStyle}"
                           Visibility="Collapsed"/>

                <!-- New Password -->
                <TextBlock x:Uid="NewPasswordLabel" Style="{StaticResource InputLabelStyle}"/>
                <PasswordBox x:Name="NewPasswordBox"
                             x:Uid="NewPasswordPlaceholder"
                             Style="{StaticResource PasswordFieldStyle}"
                             PasswordChanged="NewPasswordBox_PasswordChanged"
                             PasswordRevealMode="Hidden"/>
                
                <!-- Password Strength Indicator -->
                <StackPanel x:Name="PasswordStrengthPanel" Spacing="4">
                    <ProgressBar x:Name="PasswordStrengthBar"
                                 Height="4"
                                 CornerRadius="2"
                                 Margin="0,4,0,4"
                                 Value="0"
                                 Maximum="100"/>
                    <TextBlock x:Name="PasswordStrengthText"
                               FontSize="12"
                               Foreground="{StaticResource BrushTextSecondary}"/>
                </StackPanel>


                <!-- Confirm New Password -->
                <TextBlock x:Uid="ConfirmPasswordLabel" Style="{StaticResource InputLabelStyle}"/>
                <PasswordBox x:Name="ConfirmPasswordBox"
                             x:Uid="ConfirmPasswordPlaceholder"
                             Style="{StaticResource PasswordFieldStyle}"
                             PasswordChanged="ConfirmPasswordBox_PasswordChanged"
                             PasswordRevealMode="Hidden"/>
                <TextBlock x:Name="ConfirmPasswordError"
                           Style="{StaticResource ValidationErrorStyle}"
                           Visibility="Collapsed"/>

                <!-- Password Requirements -->
                <Border Background="{StaticResource BrushSurface}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12"
                        Margin="0,8,0,0">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="PasswordRequirementsHeader"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushText}"/>
                        
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="LengthIcon" Glyph="&#xE73E;" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock
                                Name ="LengthText" 
                                x:Uid="PasswordRequirementLength"
                                       FontSize="11"
                                       Foreground="{StaticResource BrushTextSecondary}"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="UpperIcon" Glyph="&#xE73E;" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock
                                Name ="UpperText"
                                x:Uid="PasswordRequirementUppercase"
                                       FontSize="11"
                                       Foreground="{StaticResource BrushTextSecondary}"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="LowerIcon" Glyph="&#xE73E;" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock
                                Name ="LowerText"
                                x:Uid="PasswordRequirementLowercase"
                                       FontSize="11"
                                       Foreground="{StaticResource BrushTextSecondary}"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="NumberIcon" Glyph="&#xE73E;" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock 
                                Name ="NumberText"
                                x:Uid="PasswordRequirementNumber"
                                       FontSize="11"
                                       Foreground="{StaticResource BrushTextSecondary}"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="SpecialIcon" Glyph="&#xE73E;" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock 
                                Name ="SpecialText"
                                x:Uid="PasswordRequirementSpecial"
                                       FontSize="11"
                                       Foreground="{StaticResource BrushTextSecondary}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Success/Error Messages -->
            <StackPanel x:Name="MessagePanel" Spacing="8">
                <InfoBar x:Name="ErrorInfoBar"
                         Severity="Error"
                         IsOpen="False"
                         x:Uid="PasswordChangeFailedMessage"/>
            </StackPanel>
            
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons - Fixed at bottom -->
        <Grid Grid.Row="2" Margin="24,16,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Button x:Name="CancelButton"
                    Grid.Column="0"
                    x:Uid="CancelButton"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="CancelButton_Click"/>
            
            <Button x:Name="ChangePasswordButton"
                    Grid.Column="2"
                    x:Uid="ChangePasswordDialogButton"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="ChangePasswordButton_Click"
                    IsEnabled="False"/>
        </Grid>

        <!-- Loading Overlay -->
        <Border x:Name="LoadingOverlay"
                Background="#80000000"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        Spacing="12">
                <ProgressRing Width="32" Height="32" IsActive="True"/>
                <TextBlock x:Uid="ProcessingText"
                           FontSize="14"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
