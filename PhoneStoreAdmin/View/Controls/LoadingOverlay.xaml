<UserControl
    x:Class="PhoneStoreAdmin.View.Controls.LoadingOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Theme/Colors.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Loading Overlay -->
    <Grid x:Name="RootGrid" 
          Visibility="Collapsed"
          CornerRadius="12">
        
        <!-- Semi-transparent background -->
        <Border Background="#F0FFFFFF"
                CornerRadius="12"/>
        
        <!-- Loading Card -->
        <Border Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MinWidth="200">
            
            <StackPanel Spacing="16" 
                       HorizontalAlignment="Center">
                
                <!-- Progress Ring -->
                <ProgressRing x:Name="LoadingRing"
                             IsActive="True"
                             Width="48"
                             Height="48"
                             Foreground="{StaticResource BrushPrimary}"
                             HorizontalAlignment="Center"/>
                
                <!-- Loading Text -->
                <TextBlock x:Name="LoadingText"
                          Text="Đang tải..."
                          FontSize="14"
                          Foreground="{StaticResource BrushText}"
                          HorizontalAlignment="Center"
                          TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
