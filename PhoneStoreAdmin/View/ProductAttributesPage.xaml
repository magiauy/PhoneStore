<Page
    x:Class="PhoneStoreAdmin.View.ProductAttributesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhoneStoreAdmin.View"
    xmlns:viewModels="using:PhoneStore.Services.ViewModels.ProductAttributes"
    xmlns:converters="using:PhoneStoreAdmin.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:DataType="local:ProductAttributesPage"
    Background="{StaticResource BrushBackground}"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BrushPrimary}" />
                <Setter Property="Foreground" Value="{StaticResource BrushOnPrimary}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="18,10" />
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BrushSurface}" />
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Padding" Value="16,10" />
            </Style>

            <Style x:Key="AttributeOptionListViewItemStyle" TargetType="ListViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="PageRoot" Padding="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,24,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical" Spacing="4">
                <TextBlock
                    x:Uid="ProductAttributes_HeaderTitle"
                    FontSize="32"
                    FontWeight="Bold"
                    Foreground="{StaticResource BrushText}" />
                <TextBlock
                    x:Uid="ProductAttributes_HeaderSubtitle"
                    FontSize="14"
                    Foreground="{StaticResource BrushTextSecondary}" />
            </StackPanel>

            <Button
                Grid.Column="1"
                x:Name="AddAttributeButton"
                Margin="16,0,0,0"
                Padding="16,10"
                Click="AddAttributeButton_Click"
                IsEnabled="{x:Bind CanManageAttributes, Mode=OneWay}"
                Visibility="{x:Bind CanManageAttributes, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}"
                Style="{StaticResource PrimaryButtonStyle}">
                <TextBlock x:Uid="ProductAttributes_AddAttributeButton" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="24,0,24,24" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <!-- Attribute list -->
            <Border
                Grid.Column="0"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20">
                <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

                    <AutoSuggestBox
                        x:Name="SearchBox"
                        x:Uid="ProductAttributes_Search"
                        Grid.Row="0"
                        Margin="0,0,0,8"
                        Padding="12,8"
                        Background="Transparent"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        QueryIcon="Find"
                        TextChanged="SearchBox_TextChanged" />

                    <Grid Grid.Row="1" ColumnSpacing="12" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock
                                x:Uid="ProductAttributes_DataTypeFilter"
                                FontSize="12"
                                Foreground="{StaticResource BrushTextSecondary}" />
                            <ComboBox
                                x:Name="DataTypeFilterComboBox"
                                ItemsSource="{x:Bind DataTypeFilters, Mode=OneWay}"
                                SelectedItem="{x:Bind SelectedFilterOption, Mode=TwoWay}"
                                DisplayMemberPath="Label"
                                PlaceholderText=""
                                MinWidth="160" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            x:Name="ClearFiltersButton"
                            Margin="0,20,0,0"
                            Padding="12,8"
                            Click="ClearFiltersButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}">
                            <TextBlock x:Uid="ProductAttributes_ClearFilters" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" ColumnSpacing="12" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Uid="ProductAttributes_NameColumn"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock
                                Grid.Column="1"
                                x:Uid="ProductAttributes_DataTypeColumn"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock
                                Grid.Column="2"
                                x:Uid="ProductAttributes_OptionCountColumn"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextSecondary}" />
                        </Grid>

                        <Grid Grid.Row="1">
                            <ListView
                                x:Name="AttributesListView"
                                ItemsSource="{x:Bind Attributes, Mode=OneWay}"
                                SelectedItem="{x:Bind SelectedAttribute, Mode=TwoWay}"
                                SelectionMode="Single"
                                IsItemClickEnabled="False"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:ProductAttributeViewModel">
                                        <Grid ColumnSpacing="12" Padding="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Text="{x:Bind Name}" 
                                                Foreground="{StaticResource BrushText}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind DataTypeDisplay}" 
                                                Foreground="{StaticResource BrushTextSecondary}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{x:Bind OptionCount}" 
                                                HorizontalAlignment="Right"
                                                Foreground="{StaticResource BrushTextSecondary}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel
                                x:Name="EmptyStatePanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                Spacing="4">
                                <TextBlock
                                    x:Uid="ProductAttributes_EmptyStateTitle"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource BrushText}" />
                                <TextBlock
                                    x:Uid="ProductAttributes_EmptyStateDescription"
                                    FontSize="13"
                                    TextAlignment="Center"
                                    Foreground="{StaticResource BrushTextSecondary}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="3" ColumnSpacing="12" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="PreviousPageButton"
                            Padding="12,8"
                            Click="PreviousPageButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}">
                            <FontIcon Glyph="&#xE76B;" />
                        </Button>

                        <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center">
                            <TextBlock x:Name="PageInfoTextBlock" Foreground="{StaticResource BrushText}" />
                            <TextBlock x:Name="RecordSummaryTextBlock" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            x:Name="NextPageButton"
                            Padding="12,8"
                            Click="NextPageButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}">
                            <FontIcon Glyph="&#xE76C;" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Attribute detail and options -->
            <Border
                Grid.Column="1"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Uid="ProductAttributes_DetailsHeader"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource BrushText}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button
                                x:Name="EditAttributeButton"
                                Click="EditAttributeButton_Click"
                                IsEnabled="{x:Bind HasSelectedAttribute, Mode=OneWay}"
                                Visibility="{x:Bind CanManageAttributes, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}"
                                Style="{StaticResource SecondaryButtonStyle}">
                                <TextBlock x:Uid="ProductAttributes_EditAttributeButton" />
                            </Button>
                            <Button
                                x:Name="DeleteAttributeButton"
                                Click="DeleteAttributeButton_Click"
                                IsEnabled="{x:Bind HasSelectedAttribute, Mode=OneWay}"
                                Visibility="{x:Bind CanManageAttributes, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}"
                                Style="{StaticResource SecondaryButtonStyle}">
                                <TextBlock x:Uid="ProductAttributes_DeleteAttributeButton" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Spacing="8" Visibility="{x:Bind HasSelectedAttribute, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock
                                x:Uid="ProductAttributes_DataTypeLabel"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock
                                Text="{x:Bind SelectedAttribute.DataTypeDisplay, Mode=OneWay}" 
                                Foreground="{StaticResource BrushText}" />
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Spacing="4">
                            <TextBlock
                                x:Uid="ProductAttributes_NoteLabel"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock
                                Text="{x:Bind SelectedAttribute.Note, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource BrushText}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="2" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="{x:Bind OptionsHeaderText, Mode=OneWay}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushText}" />
                            <Button
                                Grid.Column="1"
                                x:Name="AddOptionButton"
                                Click="AddOptionButton_Click"
                                IsEnabled="{x:Bind HasSelectedAttribute, Mode=OneWay}"
                                Visibility="{x:Bind CanManageAttributes, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}"
                                Style="{StaticResource SecondaryButtonStyle}">
                                <TextBlock x:Uid="ProductAttributes_AddOptionButton" />
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1" ColumnSpacing="12" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Uid="ProductAttributes_OptionValueColumn"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock
                                Grid.Column="1"
                                x:Uid="ProductAttributes_OptionNormalizedColumn"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock
                                Grid.Column="2"
                                x:Uid="ProductAttributes_OptionSortColumn"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock
                                Grid.Column="3"
                                x:Uid="ProductAttributes_OptionStatusColumn"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextSecondary}" />
                        </Grid>

                        <Grid Grid.Row="2">
                            <ListView
                                x:Name="AttributeOptionsListView"
                                ItemsSource="{x:Bind AttributeOptions, Mode=OneWay}"
                                SelectionMode="None"
                                Padding="0"
                                ItemContainerStyle="{StaticResource AttributeOptionListViewItemStyle}"
                                Visibility="{x:Bind HasSelectedAttribute, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:ProductAttributeOptionViewModel">
                                        <Grid ColumnSpacing="12" Padding="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="350" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Text="{x:Bind DisplayValue}"
                                                Foreground="{StaticResource BrushText}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind NormalizedValue}"
                                                Foreground="{StaticResource BrushTextSecondary}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{x:Bind SortOrder}"
                                                HorizontalTextAlignment="Center"
                                                Foreground="{StaticResource BrushTextSecondary}" />
                                            <TextBlock
                                                Grid.Column="3"
                                                Text="{x:Bind StatusText}"
                                                HorizontalTextAlignment="Center"
                                                Foreground="{StaticResource BrushTextSecondary}" />
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
                                                <Button
                                                    Click="OptionEditButton_Click"
                                                    Tag="{x:Bind Id}"
                                                    Visibility="{Binding DataContext.CanManageAttributes, ElementName=PageRoot, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Style="{StaticResource SecondaryButtonStyle}">
                                                    <TextBlock x:Uid="ProductAttributes_OptionEditButton" />
                                                </Button>
                                                <Button
                                                    Click="OptionDeleteButton_Click"
                                                    Tag="{x:Bind Id}"
                                                    Visibility="{Binding DataContext.CanManageAttributes, ElementName=PageRoot, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Style="{StaticResource SecondaryButtonStyle}">
                                                    <TextBlock x:Uid="ProductAttributes_OptionDeleteButton" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel
                                x:Name="OptionsEmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                Spacing="4">
                                <TextBlock
                                    x:Uid="ProductAttributes_OptionsEmpty"
                                    FontSize="14"
                                    TextAlignment="Center"
                                    Foreground="{StaticResource BrushTextSecondary}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Grid.Row="3"
                            x:Name="OptionRecordSummaryTextBlock"
                            FontSize="12"
                            Foreground="{StaticResource BrushTextSecondary}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
