<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PhoneStoreAdmin.View.PromotionEditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhoneStoreAdmin.View"
    xmlns:converters="using:PhoneStoreAdmin.View"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="{StaticResource BrushBackground}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Theme/Colors.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <ThemeShadow x:Key="SharedShadow" />

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BrushSurface}" />
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>
            <Style x:Key="InputLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                <Setter Property="Margin" Value="4,8,0,4" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Width" Value="450" />
            </Style>

            <!-- Converters -->
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:CurrencyConverter x:Key="CurrencyConverter" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.RowSpan="2">
			<Rectangle>
				<Rectangle.Fill>
					<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
						<GradientStop Offset="0" Color="{StaticResource ColorBackground}" />
						<GradientStop Offset="0.5" Color="#FFF0F2FF" />
						<GradientStop Offset="1" Color="#FFE8ECFF" />
					</LinearGradientBrush>
				</Rectangle.Fill>
			</Rectangle>
			<Grid>
				<Ellipse
                    Width="400"
                    Height="400"
                    Margin="-200,-100,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Opacity="0.1">
					<Ellipse.Fill>
						<RadialGradientBrush>
							<GradientStop Offset="0" Color="{StaticResource ColorPrimary}" />
							<GradientStop Offset="1" Color="{StaticResource ColorPrimaryLight}" />
						</RadialGradientBrush>
					</Ellipse.Fill>
				</Ellipse>
				<Ellipse
                    Width="300"
                    Height="300"
                    Margin="0,0,-150,-150"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Opacity="0.1">
					<Ellipse.Fill>
						<RadialGradientBrush>
							<GradientStop Offset="0" Color="{StaticResource ColorAccent}" />
							<GradientStop Offset="1" Color="Transparent" />
						</RadialGradientBrush>
					</Ellipse.Fill>
				</Ellipse>
			</Grid>
		</Grid>
        <!-- Header -->
        <Border Grid.Row="0"
                Margin="32,32,32,24"
                Style="{StaticResource CardStyle}"
                Shadow="{StaticResource SharedShadow}">
            <Grid Padding="32,24">
                <StackPanel Orientation="Vertical" Spacing="8">
                    <RichTextBlock IsTextSelectionEnabled="False" VerticalAlignment="Center">
                        <Paragraph LineHeight="48" LineStackingStrategy="BlockLineHeight">
                            <Hyperlink Click="BreadcrumbPromotions_Click" UnderlineStyle="None">
                                <Run x:Uid="HeaderTitlePromotion" FontSize="36" FontWeight="Bold">
                                    <Run.Foreground>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="{StaticResource ColorPrimary}" Offset="0" />
                                            <GradientStop Color="{StaticResource ColorAccent}" Offset="1" />
                                        </LinearGradientBrush>
                                    </Run.Foreground>
                                </Run>
                            </Hyperlink>
                            <Run Text=" › " 
                                 FontSize="36" 
                                 FontWeight="Bold"
                                 Foreground="{StaticResource BrushTextSecondary}"/>
                            <Run x:Name="BreadcrumbCurrentText" x:Uid="EditPromotionTitle" FontSize="36" FontWeight="Bold">
                                <Run.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="{StaticResource ColorPrimary}" Offset="0" />
                                        <GradientStop Color="{StaticResource ColorAccent}" Offset="1" />
                                    </LinearGradientBrush>
                                </Run.Foreground>
                            </Run>
                        </Paragraph>
                    </RichTextBlock>
                    <TextBlock x:Uid="SubHeaderUpdateTitlePromotion" FontSize="16" Foreground="{StaticResource BrushTextSecondary}" />
                </StackPanel>
            </Grid>
        </Border>
        <!-- Content -->
        <Border Grid.Row="1" Margin="32,0,32,32" Style="{StaticResource CardStyle}" Shadow="{StaticResource SharedShadow}" Padding="32">
            <Grid x:Name="EditContentGrid" ColumnSpacing="24" RowSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <!-- Promotion Details Card -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" Padding="28" Shadow="{StaticResource SharedShadow}" Background="{StaticResource BrushBackground}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        
                        <!-- Header Section -->
                        <StackPanel Grid.Row="0" Spacing="20">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <SymbolIcon Symbol="Calendar"
                                            Foreground="{StaticResource BrushPrimary}"/>
                                <TextBlock x:Uid="PromotionInfo"
                                            Text="Thông tin khuyến mãi"
                                            FontSize="20"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource BrushText}"
                                            VerticalAlignment="Center"/>
                            </StackPanel>
                            <Rectangle Height="1"
                                    Fill="{StaticResource BrushBorder}"
                                    Opacity="0.5"/>
                        </StackPanel>
                        
                        <!-- Scrollable Content -->
                        <ScrollViewer Grid.Row="1" 
                                    HorizontalScrollBarVisibility="Disabled" 
                                    VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12">
                                <StackPanel>
                                    <TextBlock x:Uid="PromotionNameLabel" Style="{StaticResource InputLabelStyle}" />
                                    <TextBox x:Name="PromotionNameTextBox" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Uid="PromotionDescriptionLabel" Style="{StaticResource InputLabelStyle}" />
                                    <TextBox x:Name="DescriptionTextBox" AcceptsReturn="True" TextWrapping="Wrap" />
                                </StackPanel>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Uid="PromotionStartDateLabel" Style="{StaticResource InputLabelStyle}" />
                                        <DatePicker x:Name="StartDatePicker" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Uid="PromotionEndDateLabel" Style="{StaticResource InputLabelStyle}" />
                                        <DatePicker x:Name="EndDatePicker" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel>
                                    <TextBlock x:Uid="PromotionIsActiveLabel" Style="{StaticResource InputLabelStyle}" />
                                    <ToggleSwitch x:Name="IsActiveToggle" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Promotion Codes Card -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="28" Shadow="{StaticResource SharedShadow}" Background="{StaticResource BrushBackground}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="20">
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="PromotionCodes" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" />
                                <Button x:Name="AddCodeButton" Grid.Column="1" Click="AddCodeButton_Click" Style="{ThemeResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE710;" />
                                        <TextBlock x:Uid="BtnNewPromotionCode" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Rectangle Height="1"
                                    Fill="{StaticResource BrushBorder}"
                                    Opacity="0.5"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsRepeater x:Name="PromotionCodesRepeater"
                                           ItemsSource="{x:Bind PromotionCodesCollection, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <muxc:UniformGridLayout MinItemWidth="300"
                                                            MinItemHeight="140"
                                                            ItemsStretch="Fill"
                                                            MinColumnSpacing="16"
                                                            MinRowSpacing="16" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:PromotionCodeViewModel" xmlns:viewModels="using:PhoneStoreAdmin.ViewModels">
                                        <Border Background="{StaticResource BrushSurface}"
                                                BorderBrush="{StaticResource BrushBorder}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="16">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind Code}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                                        <Border Background="{x:Bind StatusColor, Mode=OneTime}" CornerRadius="12" Padding="8,4" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind LocalizedStatusText, Mode=OneTime}" FontSize="10" Foreground="White" />
                                                        </Border>
                                                        <Button Width="32" Height="32" Padding="0" Style="{ThemeResource SubtleButtonStyle}">
                                                            <Button.Flyout>
                                                                <MenuFlyout>
                                                                    <MenuFlyoutItem x:Uid="BtnEditPromotionCode" Tag="{x:Bind Id}" Click="EditPromotionCode_Click">
                                                                        <MenuFlyoutItem.Icon>
                                                                            <FontIcon Glyph="&#xE70F;" />
                                                                        </MenuFlyoutItem.Icon>
                                                                    </MenuFlyoutItem>
                                                                    <MenuFlyoutItem x:Uid="BtnActivatePromotionCode" Tag="{x:Bind Id}" Click="ActivatePromotionCode_Click" Visibility="{x:Bind IsActive, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=False}">
                                                                        <MenuFlyoutItem.Icon>
                                                                            <FontIcon Glyph="&#xE8FB;" />
                                                                        </MenuFlyoutItem.Icon>
                                                                    </MenuFlyoutItem>
                                                                    <MenuFlyoutItem x:Uid="BtnDeactivatePromotionCode" Tag="{x:Bind Id}" Click="DeactivatePromotionCode_Click" Visibility="{x:Bind IsActive, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=True}">
                                                                        <MenuFlyoutItem.Icon>
                                                                            <FontIcon Glyph="&#xE711;" />
                                                                        </MenuFlyoutItem.Icon>
                                                                    </MenuFlyoutItem>
                                                                </MenuFlyout>
                                                            </Button.Flyout>
                                                            <FontIcon Glyph="&#xE712;" FontSize="14" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Grid.Row="1" Spacing="4">
                                                    <TextBlock FontSize="13" Foreground="{StaticResource BrushTextSecondary}">
                                                        <Run x:Uid="PromotionCodeDiscountAmountLabel" Text="Discount" />
                                                        <Run Text=": " />
                                                        <Run Text="{x:Bind DiscountAmount, Mode=OneTime, Converter={StaticResource CurrencyConverter}}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="13" Foreground="{StaticResource BrushTextSecondary}">
                                                        <Run x:Uid="PromotionCodeMinimumAmountLabel" Text="Min" />
                                                        <Run Text=": " />
                                                        <Run Text="{x:Bind MinimumAmount, Mode=OneTime, Converter={StaticResource CurrencyConverter}}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="13" Foreground="{StaticResource BrushTextSecondary}">
                                                        <Run x:Uid="PromotionCodeUsedCountLabel" Text="Usage" />
                                                        <Run Text=": " />
                                                        <Run Text="{x:Bind UsageStatus, Mode=OneTime}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Actions -->
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                    <Button x:Name="SaveButton" Click="SaveButton_Click" Style="{ThemeResource AccentButtonStyle}"/>
                    <Button x:Name="CancelButton" Click="CancelButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
