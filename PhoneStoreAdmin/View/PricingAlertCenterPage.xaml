<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PhoneStoreAdmin.View.PricingAlertCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhoneStoreAdmin.View"
    xmlns:converters="using:PhoneStoreAdmin.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:BoolToAlertColorConverter x:Key="BoolToAlertColorConverter"/>
        <converters:BoolToAlertBgConverter x:Key="BoolToAlertBgConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{StaticResource BrushSurface}" 
                BorderBrush="{StaticResource BrushBorder}" 
                BorderThickness="0,0,0,1" 
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton"
                        Grid.Column="0"
                        Click="BackButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Quay lại Dashboard">
                    <FontIcon Glyph="&#xE72B;" FontSize="20" Foreground="{StaticResource BrushText}"/>
                </Button>

                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Trung tâm cảnh báo" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource BrushText}"/>
                    <TextBlock Text="Quản lý và xử lý các cảnh báo biến động giá" 
                               FontSize="14" 
                               Foreground="{StaticResource BrushTextSecondary}"/>
                </StackPanel>

                <Button x:Name="RefreshButton"
                        Grid.Column="2"
                        Click="RefreshButton_Click"
                        Background="{StaticResource BrushSurface}" 
                        Foreground="{StaticResource BrushText}"
                        BorderBrush="{StaticResource BrushBorder}"
                        CornerRadius="8" 
                        Padding="16,12"
                        ToolTipService.ToolTip="Làm mới danh sách">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="16"/>
                        <TextBlock Text="Làm mới"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Padding="24" ColumnDefinitions="2*,1*" ColumnSpacing="24">
            
            <!-- Alerts DataGrid -->
            <Border Grid.Column="0" 
                    Background="{StaticResource BrushSurface}" 
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="12" 
                    Padding="0">
                <Grid RowDefinitions="Auto,*">
                    <!-- Table Header -->
                    <Border Grid.Row="0" 
                            Background="{StaticResource BrushSurface}" 
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <Grid ColumnDefinitions="2*,Auto,Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Column="0" Text="Sản phẩm" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" FontSize="13"/>
                            <TextBlock Grid.Column="1" Text="Variance%" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Width="80" TextAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="FIFO" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Width="100" TextAlignment="Right" Margin="12,0,0,0"/>
                            <TextBlock Grid.Column="3" Text="NIFO" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Width="100" TextAlignment="Right" Margin="12,0,0,0"/>
                            <TextBlock Grid.Column="4" Text="Tồn kho" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Width="70" TextAlignment="Right" Margin="12,0,0,0"/>
                            <TextBlock Grid.Column="5" Text="Tổn thất" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Width="110" TextAlignment="Right" Margin="12,0,0,0"/>
                            <TextBlock Grid.Column="6" Text="Ngày" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Width="90" TextAlignment="Right" Margin="12,0,0,0"/>
                        </Grid>
                    </Border>
                    
                    <!-- Alerts List -->
                    <ListView x:Name="AlertsListView"
                              Grid.Row="1"
                              SelectionMode="Single"
                              SelectionChanged="AlertsListView_SelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="16,12"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,2*,Auto,Auto,Auto,Auto,Auto,Auto">
                                    <!-- Alert Type Icon -->
                                    <FontIcon Grid.Column="0" 
                                              Glyph="{Binding AlertTypeGlyph}" 
                                              FontSize="16"
                                              Foreground="{Binding IsRecoveryAlert, Converter={StaticResource BoolToAlertColorConverter}}"
                                              Margin="0,0,12,0"
                                              VerticalAlignment="Center"
                                              ToolTipService.ToolTip="{Binding AlertTypeDisplay}"/>
                                    
                                    <!-- Product Info -->
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding ProductName}" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="{StaticResource BrushText}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding ProductSku}" 
                                                       FontSize="12" 
                                                       Foreground="{StaticResource BrushTextSecondary}"/>
                                            <Border Background="{Binding IsRecoveryAlert, Converter={StaticResource BoolToAlertBgConverter}}"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    Visibility="{Binding IsRecoveryAlert, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="Hồi phục" 
                                                           FontSize="10" 
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrushSuccess}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <!-- Variance -->
                                    <Border Grid.Column="2" 
                                            Background="{Binding IsRecoveryAlert, Converter={StaticResource BoolToAlertBgConverter}}" 
                                            CornerRadius="4" 
                                            Padding="8,4"
                                            Width="80"
                                            HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding VarianceDisplay}" 
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding IsRecoveryAlert, Converter={StaticResource BoolToAlertColorConverter}}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                    
                                    <!-- FIFO -->
                                    <TextBlock Grid.Column="3" 
                                               Text="{Binding CostFifoDisplay}" 
                                               Width="100" 
                                               TextAlignment="Right"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource BrushText}"/>
                                    
                                    <!-- NIFO -->
                                    <TextBlock Grid.Column="4" 
                                               Text="{Binding CostNifoDisplay}" 
                                               Width="100" 
                                               TextAlignment="Right"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource BrushText}"/>
                                    
                                    <!-- Stock -->
                                    <TextBlock Grid.Column="5" 
                                               Text="{Binding CurrentStock}" 
                                               Width="70" 
                                               TextAlignment="Right"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource BrushText}"/>
                                    
                                    <!-- Potential Loss / Gain -->
                                    <TextBlock Grid.Column="6" 
                                               Text="{Binding PotentialLossDisplay}" 
                                               Width="110" 
                                               TextAlignment="Right"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding IsRecoveryAlert, Converter={StaticResource BoolToAlertColorConverter}}"
                                               FontWeight="SemiBold"/>
                                    
                                    <!-- Date -->
                                    <TextBlock Grid.Column="7" 
                                               Text="{Binding CreatedAtDisplay}" 
                                               Width="90" 
                                               TextAlignment="Right"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{StaticResource BrushTextSecondary}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    
                    <!-- Empty State -->
                    <StackPanel x:Name="EmptyState" 
                                Grid.Row="1"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center"
                                Spacing="16"
                                Padding="48">
                        <FontIcon Glyph="&#xE73E;" FontSize="64" Foreground="{StaticResource BrushSuccess}"/>
                        <TextBlock Text="Không có cảnh báo nào" 
                                   FontSize="18" 
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushText}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Tất cả sản phẩm đang ở trạng thái ổn định" 
                                   FontSize="14" 
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Detail Panel -->
            <Border Grid.Column="1" 
                    Background="{StaticResource BrushSurface}" 
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <!-- No Selection State -->
                    <StackPanel x:Name="NoSelectionState"
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center"
                                Spacing="16"
                                Padding="24">
                        <FontIcon Glyph="&#xE8A5;" FontSize="48" Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBlock Text="Chọn một cảnh báo để xem chi tiết" 
                                   FontSize="14" 
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Detail Content -->
                    <Grid x:Name="DetailPanel" Visibility="Collapsed" Padding="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Product Header -->
                    <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,24">
                        <TextBlock x:Name="DetailProductName" 
                                   Text="Tên sản phẩm" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource BrushText}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetailProductSku" 
                                   Text="SKU" 
                                   FontSize="14" 
                                   Foreground="{StaticResource BrushTextSecondary}"/>
                    </StackPanel>
                    
                    <!-- Alert Info Cards -->
                    <StackPanel Grid.Row="1" Spacing="12" Margin="0,0,0,24">
                        <!-- Variance Card -->
                        <Border Background="{StaticResource BrushError}" 
                                Opacity="1"
                                CornerRadius="8" 
                                Padding="16">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Biến động giá" 
                                               FontSize="12" 
                                               Foreground="Black"/>
                                    <TextBlock x:Name="DetailVariance" 
                                               Text="-15.5%" 
                                               FontSize="24" 
                                               FontWeight="Bold" 
                                               Foreground="Black"/>
                                </StackPanel>
                                <FontIcon Grid.Column="1" 
                                          Glyph="&#xE74B;" 
                                          FontSize="32" 
                                          Foreground="{StaticResource BrushError}"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        
                        <!-- Cost Comparison -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Border Grid.Column="0" 
                                    Background="{StaticResource BrushPrimary}" 
                                    Opacity="1"
                                    CornerRadius="8" 
                                    Padding="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="FIFO (Giá vốn)" 
                                               FontSize="12" 
                                               Foreground="Black"/>
                                    <TextBlock x:Name="DetailFifo" 
                                               Text="0đ" 
                                               FontSize="18" 
                                               FontWeight="SemiBold" 
                                               Foreground="Black"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" 
                                    Background="{StaticResource BrushWarning}" 
                                    Opacity="1"
                                    CornerRadius="8" 
                                    Padding="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="NIFO (Giá thay thế)" 
                                               FontSize="12" 
                                               Foreground="Black"/>
                                    <TextBlock x:Name="DetailNifo" 
                                               Text="0đ" 
                                               FontSize="18" 
                                               FontWeight="SemiBold" 
                                               Foreground="Black"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        
                        <!-- Stock and Loss -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Border Grid.Column="0" 
                                    Background="{StaticResource BrushSurface}" 
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8" 
                                    Padding="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Tồn kho hiện tại" 
                                               FontSize="12" 
                                               Foreground="{StaticResource BrushTextSecondary}"/>
                                    <TextBlock x:Name="DetailStock" 
                                               Text="0" 
                                               FontSize="18" 
                                               FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushText}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" 
                                    Background="{StaticResource BrushError}" 
                                    Opacity="1"
                                    CornerRadius="8" 
                                    Padding="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Tổn thất tiềm năng" 
                                               FontSize="12" 
                                               Foreground="Black"/>
                                    <TextBlock x:Name="DetailPotentialLoss" 
                                               Text="0đ" 
                                               FontSize="18" 
                                               FontWeight="SemiBold" 
                                               Foreground="Black"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        
                        <!-- Created Date -->
                        <Border Background="{StaticResource BrushSurface}" 
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="8" 
                                Padding="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Ngày tạo cảnh báo" 
                                           FontSize="12" 
                                           Foreground="{StaticResource BrushTextSecondary}"/>
                                <TextBlock x:Name="DetailCreatedAt" 
                                           Text="01/01/2024 00:00" 
                                           FontSize="14" 
                                           Foreground="{StaticResource BrushText}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    
                    <!-- Spacer -->
                    <Grid Grid.Row="2"/>
                    
                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="3" Spacing="12">
                        <TextBlock Text="Hành động" 
                                   FontSize="14" 
                                   FontWeight="SemiBold" 
                                   Foreground="{StaticResource BrushText}"
                                   Margin="0,0,0,8"/>
                        
                        <!-- Price Drop Alert Actions -->
                        <StackPanel x:Name="PriceDropActions" Spacing="12">
                            <Button x:Name="HoldPriceButton"
                                    Click="HoldPriceButton_Click"
                                    HorizontalAlignment="Stretch"
                                    Background="{StaticResource BrushPrimary}" 
                                    Foreground="{StaticResource BrushOnPrimary}"
                                    CornerRadius="8" 
                                    Padding="16,14" 
                                    BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE72E;" FontSize="18"/>
                                    <TextBlock Text="Giữ giá" FontWeight="SemiBold" FontSize="15"/>
                                </StackPanel>
                            </Button>
                            
                            <Button x:Name="ClearanceButton"
                                    Click="ClearanceButton_Click"
                                    HorizontalAlignment="Stretch"
                                    Background="{StaticResource BrushWarning}" 
                                    Foreground="White"
                                    CornerRadius="8" 
                                    Padding="16,14" 
                                    BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE74B;" FontSize="18"/>
                                    <TextBlock Text="Kích hoạt xả hàng" FontWeight="SemiBold" FontSize="15"/>
                                </StackPanel>
                            </Button>
                            
                            <TextBlock Text="Giữ giá: Giữ nguyên giá bán hiện tại, không thay đổi." 
                                       FontSize="11" 
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                            <TextBlock Text="Xả hàng: Chuyển sang chế độ CLEARANCE, tính lại giá theo NIFO + biên lợi nhuận tối thiểu." 
                                       FontSize="11" 
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        
                        <!-- Recovery Alert Actions -->
                        <StackPanel x:Name="RecoveryActions" Visibility="Collapsed" Spacing="12">
                            <!-- Price Preview Panel -->
                            <Border Background="{StaticResource BrushSuccess}" 
                                    Opacity="0.1"
                                    CornerRadius="8" 
                                    Padding="16">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Preview giá mới" 
                                               FontSize="12" 
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushSuccess}"/>
                                    <Grid ColumnDefinitions="*,Auto,*">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="Giá hiện tại" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                            <TextBlock x:Name="PreviewCurrentPrice" 
                                                       Text="0đ" 
                                                       FontSize="16" 
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushText}"/>
                                        </StackPanel>
                                        <FontIcon Grid.Column="1" 
                                                  Glyph="&#xE72A;" 
                                                  FontSize="20" 
                                                  Foreground="{StaticResource BrushSuccess}"
                                                  VerticalAlignment="Center"
                                                  Margin="16,0"/>
                                        <StackPanel Grid.Column="2" Spacing="4">
                                            <TextBlock Text="Giá mới" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                            <TextBlock x:Name="PreviewNewPrice" 
                                                       Text="0đ" 
                                                       FontSize="16" 
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource BrushSuccess}"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                        <TextBlock Text="Thay đổi:" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                        <TextBlock x:Name="PreviewPriceChange" 
                                                   Text="+0đ (+0%)" 
                                                   FontSize="11" 
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushSuccess}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="FIFO mới:" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                        <TextBlock x:Name="PreviewNewFifo" 
                                                   Text="0đ" 
                                                   FontSize="11" 
                                                   Foreground="{StaticResource BrushText}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            
                            <Button x:Name="ResetAutoButton"
                                    Click="ResetAutoButton_Click"
                                    HorizontalAlignment="Stretch"
                                    Background="{StaticResource BrushSuccess}" 
                                    Foreground="White"
                                    CornerRadius="8" 
                                    Padding="16,14" 
                                    BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE72C;" FontSize="18"/>
                                    <TextBlock Text="Reset về Auto" FontWeight="SemiBold" FontSize="15"/>
                                </StackPanel>
                            </Button>
                            
                            <Button x:Name="KeepClearanceButton"
                                    Click="HoldPriceButton_Click"
                                    HorizontalAlignment="Stretch"
                                    Background="{StaticResource BrushSurface}" 
                                    Foreground="{StaticResource BrushText}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    CornerRadius="8" 
                                    Padding="16,14">
                                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE72E;" FontSize="18"/>
                                    <TextBlock Text="Giữ chế độ xả hàng" FontWeight="SemiBold" FontSize="15"/>
                                </StackPanel>
                            </Button>
                            
                            <TextBlock Text="Reset về Auto: Thoát CLEARANCE, reset FIFO = NIFO và tính lại giá theo AUTO_PROTECT." 
                                       FontSize="11" 
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                            <TextBlock Text="Giữ chế độ xả hàng: Tiếp tục bán với giá xả hàng hiện tại." 
                                       FontSize="11" 
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" 
              Grid.RowSpan="2" 
              Background="#80000000" 
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="48" Height="48"/>
                <TextBlock x:Name="LoadingText" Text="Đang tải dữ liệu..." Foreground="White" FontSize="14"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
