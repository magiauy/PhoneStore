<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PhoneStoreAdmin.View.AddPurchaseOrderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PhoneStoreAdmin.View.Controls"
    xmlns:globalization="using:System.Globalization"
    xmlns:local="using:PhoneStoreAdmin.View"
    xmlns:sys="using:System"
    x:DataType="local:AddPurchaseOrderPage"
    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">

    <Page.Resources>
        <!--  Styles  -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="24" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="ProductCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <!--  Primary Button Style  -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushPrimary}" />
            <Setter Property="Foreground" Value="{StaticResource BrushOnPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource BrushPrimaryHover}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource BrushPrimaryPressed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="RootBorder"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0.6"
                                                Duration="0:0:0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Padding="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header Section  -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel VerticalAlignment="Center" Spacing="4">
                <TextBlock
                    x:Uid="CreatePurchaseOrderPageTitle"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="Purchase Order" />
                <TextBlock
                    x:Uid="CreatePurchaseOrderPageSubtitle"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Select products and create import vouchers" />
            </StackPanel>

            <Button
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Style="{StaticResource PrimaryButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE710;" />
                    <TextBlock x:Uid="BtnNewPurchaseOrder" Text="New Purchase Order" />
                </StackPanel>
            </Button>
        </Grid>

        <!--  Main Content - Two Columns  -->
        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Left Panel - Product List  -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid RowSpacing="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Title  -->
                    <TextBlock
                        x:Uid="ProductListSectionTitle"
                        Grid.Row="0"
                        Style="{StaticResource SectionTitleStyle}" />

                    <!--  Search Box  -->
                    <TextBox
                        x:Name="SearchTextBox"
                        x:Uid="SearchTextBoxProduct"
                        Grid.Row="1"
                        TextChanged="{x:Bind OnSearchTextChanged}">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        </TextBox.Resources>
                    </TextBox>

                    <!--  Filter Buttons  -->
                    <StackPanel
                        Grid.Row="2"
                        Orientation="Horizontal"
                        Spacing="12">
                        <ComboBox
                            x:Name="CategoryComboBox"
                            x:Uid="CategoryComboBox"
                            MinWidth="160"
                            Header="Danh mục"
                            ItemsSource="{x:Bind Categories}"
                            SelectedIndex="0"
                            SelectionChanged="{x:Bind OnCategorySelectionChanged}" />
                        <ComboBox
                            x:Name="BrandComboBox"
                            x:Uid="BrandComboBox"
                            MinWidth="160"
                            Header="Thương hiệu"
                            ItemsSource="{x:Bind Brands}"
                            SelectedIndex="0"
                            SelectionChanged="{x:Bind OnBrandSelectionChanged}" />

                        <!--  Import from Excel Button  -->
                        <Button
                            x:Name="ImportExcelButton"
                            VerticalAlignment="Bottom"
                            Click="{x:Bind OnImportFromExcel}"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="Import products with serial/IMEI from Excel file">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE8B5;" />
                                <TextBlock Text="Import Excel" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!--  Products List  -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <ItemsRepeater x:Name="ProductsRepeater" ItemsSource="{x:Bind FilteredProducts}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="local:PurchaseOrderProductItem">
                                    <Border Style="{StaticResource ProductCardStyle}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!--  Product Icon  -->
                                            <Border
                                                Grid.Column="0"
                                                Width="48"
                                                Height="48"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="8">
                                                <FontIcon
                                                    FontSize="24"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Glyph="&#xE7F4;" />
                                            </Border>

                                            <!--  Product Info  -->
                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="4">
                                                <TextBlock
                                                    FontSize="15"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                    Text="{x:Bind ProductName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontSize="13"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind BrandName}" />
                                                <TextBlock
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Text="{x:Bind FormatPrice(CurrentCost)}" />
                                            </StackPanel>

                                            <!--  Add Button  -->
                                            <Button
                                                x:Uid="BtnAddProduct"
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Click="{x:Bind AddToPurchaseOrder}"
                                                Content="Thêm"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  Right Panel - Purchase Order  -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid RowSpacing="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Purchase Order Header with ID Badge  -->
                    <Grid Grid.Row="0">
                        <TextBlock
                            x:Uid="PurchaseOrderSectionTitle"
                            VerticalAlignment="Center"
                            Style="{StaticResource SectionTitleStyle}"
                            Text="Purchase Order" />
                        <Border
                            Padding="12,6"
                            HorizontalAlignment="Right"
                            CornerRadius="6">
                            <TextBlock
                                x:Name="PurchaseOrderIdLabel"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource ColorPrimary}"
                                Text="PO No: PN00123" />
                        </Border>
                    </Grid>

                    <!--  Supplier Info  -->
                    <Border
                        Grid.Row="1"
                        Padding="10"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                x:Uid="SupplierInfoTitle"
                                Grid.Row="0"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="Supplier Information" />

                            <Grid Grid.Row="1" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        Text="{x:Bind SelectedSupplier.Name, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind SelectedSupplier.Phone, Mode=OneWay}" />
                                </StackPanel>

                                <Button
                                    x:Uid="BtnSelectSupplier"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Click="{x:Bind OnSelectSupplier}"
                                    Content="Select"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!--  Selected Products  -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <TextBlock
                                x:Uid="SelectedProductsTitle"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="Selected Products" />

                            <ItemsRepeater ItemsSource="{x:Bind PurchaseOrderItems}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="local:PurchaseOrderLineItem">
                                        <Border
                                            Margin="0,0,0,12"
                                            Padding="0"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <StackPanel Spacing="0">
                                                <!--  Product Header  -->
                                                <Grid Padding="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Spacing="4">
                                                        <TextBlock
                                                            FontSize="14"
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                            Text="{x:Bind ProductName}" />
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock
                                                                x:Uid="QuantityLabel"
                                                                FontSize="12"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="Qty:" />
                                                            <TextBlock
                                                                FontSize="12"
                                                                FontWeight="SemiBold"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{x:Bind Quantity, Mode=OneWay}" />
                                                            <TextBlock
                                                                x:Uid="UnitCostLabel"
                                                                FontSize="12"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="Unit Cost:" />
                                                            <TextBlock
                                                                FontSize="12"
                                                                FontWeight="SemiBold"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{x:Bind FormatPrice(UnitCost), Mode=OneWay}" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!--  Edit Serials Button (only for serial-tracked products)  -->
                                                    <Button
                                                        Grid.Column="1"
                                                        Width="32"
                                                        Height="32"
                                                        Margin="0,0,8,0"
                                                        Padding="0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Click="{x:Bind EditSerialNumbers}"
                                                        CornerRadius="16"
                                                        Style="{ThemeResource SubtleButtonStyle}"
                                                        ToolTipService.ToolTip="Edit Serial Numbers"
                                                        Visibility="{x:Bind EditSerialsButtonVisibility, Mode=OneWay}">
                                                        <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                                    </Button>

                                                    <!--  Remove Button  -->
                                                    <Button
                                                        Grid.Column="2"
                                                        Width="32"
                                                        Height="32"
                                                        Padding="0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Click="{x:Bind RemoveFromPurchaseOrder}"
                                                        CornerRadius="16"
                                                        Style="{ThemeResource SubtleButtonStyle}"
                                                        ToolTipService.ToolTip="Remove Product">
                                                        <FontIcon FontSize="14" Glyph="&#xE738;" />
                                                    </Button>
                                                </Grid>

                                                <!--  Total Price Bar  -->
                                                <Border Padding="16,12" CornerRadius="0">
                                                    <TextBlock
                                                        HorizontalAlignment="Right"
                                                        FontSize="16"
                                                        FontWeight="Bold"
                                                        Foreground="{ThemeResource ColorPrimary}"
                                                        Text="{x:Bind FormatPrice(TotalCost), Mode=OneWay}" />
                                                </Border>

                                                <!--  Expandable Serial Numbers Section  -->
                                                <Expander
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Background="Transparent"
                                                    CornerRadius="0,0,8,8"
                                                    Visibility="{x:Bind SerialExpanderVisibility, Mode=OneWay}">
                                                    <Expander.Header>
                                                        <TextBlock
                                                            x:Uid="ViewDeviceDetailsHeader"
                                                            FontSize="13"
                                                            FontWeight="SemiBold"
                                                            Text="View Device Details" />
                                                    </Expander.Header>
                                                    <ItemsRepeater ItemsSource="{x:Bind SerialEntries, Mode=OneWay}">
                                                        <ItemsRepeater.ItemTemplate>
                                                            <DataTemplate x:DataType="controls:SerialEntry">
                                                                <Border
                                                                    Margin="16,8,16,8"
                                                                    Padding="12"
                                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                                    CornerRadius="6">
                                                                    <StackPanel Spacing="6">
                                                                        <TextBlock
                                                                            FontSize="13"
                                                                            FontWeight="SemiBold"
                                                                            Text="{x:Bind GetMachineTitle(), Mode=OneWay}" />
                                                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                                            <Run x:Uid="SerialLabel" Text="Serial: " />
                                                                            <Run FontWeight="SemiBold" Text="{x:Bind SerialNumber, Mode=OneWay}" />
                                                                        </TextBlock>
                                                                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                                            <Run x:Uid="Imei1Label" Text="IMEI 1: " />
                                                                            <Run FontWeight="SemiBold" Text="{x:Bind Imei1, Mode=OneWay}" />
                                                                        </TextBlock>
                                                                        <TextBlock
                                                                            FontSize="12"
                                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                            Visibility="{x:Bind HasImei2(), Mode=OneWay}">
                                                                            <Run x:Uid="Imei2Label" Text="IMEI 2: " />
                                                                            <Run FontWeight="SemiBold" Text="{x:Bind Imei2, Mode=OneWay}" />
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsRepeater.ItemTemplate>
                                                    </ItemsRepeater>
                                                </Expander>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </ScrollViewer>

                    <!--  Summary Section  -->
                    <Border
                        Grid.Row="3"
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="12">
                            <Grid>
                                <TextBlock
                                    x:Uid="SubtotalLabel"
                                    FontSize="14"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Subtotal:" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind FormatPrice(TotalAmount), Mode=OneWay}" />
                            </Grid>

                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <Grid>
                                <TextBlock
                                    x:Uid="TotalLabel"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource ColorPrimary}"
                                    Text="Total:" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource ColorPrimary}"
                                    Text="{x:Bind FormatPrice(TotalAmount), Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  Action Buttons  -->
                    <StackPanel Grid.Row="4" Spacing="10">
                        <Button
                            x:Name="PrintPurchaseOrderButton"
                            x:Uid="BtnPrintPurchaseOrder"
                            HorizontalAlignment="Stretch"
                            Click="{x:Bind OnPrintPurchaseOrder}"
                            Content="Print Purchase Order"
                            IsEnabled="{x:Bind HasPurchaseOrderItems, Mode=OneWay}"
                            Style="{ThemeResource DefaultButtonStyle}" />

                        <Button
                            x:Name="CreatePurchaseOrderButton"
                            x:Uid="BtnCompletePurchaseOrder"
                            HorizontalAlignment="Stretch"
                            Click="{x:Bind OnCreatePurchaseOrder}"
                            Content="{x:Bind SaveButtonText, Mode=OneWay}"
                            IsEnabled="{x:Bind HasPurchaseOrderItems, Mode=OneWay}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
