<Page
    x:Class="PhoneStoreAdmin.View.SuppliersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:converters="using:Windows.UI.Xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PhoneStoreAdmin.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PhoneStoreAdmin.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <local:SortDirectionToVisibilityConverter x:Key="SortDirectionToVisibilityConverter" />
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="CenteredCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="Padding" Value="0,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Border
                                    x:Name="CheckBorder"
                                    Width="18"
                                    Height="18"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                                    BorderBrush="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                    BorderThickness="1" />
                                <FontIcon
                                    x:Name="CheckGlyph"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="12"
                                    Foreground="{ThemeResource CheckBoxCheckGlyphForegroundChecked}"
                                    Glyph="&#xE73E;"
                                    Visibility="Collapsed" />
                            </Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Pressed" />
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckGlyph" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CenteredTextBlockStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,8,30,8" />
        </Style>
        <Style x:Key="LeftAlignedTextBlockStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="Padding" Value="8,8,8,8" />
        </Style>
        <Style x:Key="NoRightBorderHeaderStyle" TargetType="ContentControl">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border
                            Padding="4"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="↑↓"
                                    Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SortDirection, Converter={StaticResource SortDirectionToVisibilityConverter}}" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CenteredCellStyle" TargetType="controls:DataGridCell">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0,0,0,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style TargetType="controls:DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="FocusVisualPrimaryBrush" Value="Transparent" />
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:DataGridCell">
                        <Grid x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter Content="{TemplateBinding Content}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="PointerOverSelected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="controls:DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="ActionCellStyle" TargetType="controls:DataGridCell">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0,0,8,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="IsHitTestVisible" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualPrimaryBrush" Value="Transparent" />
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:DataGridCell">
                        <Grid x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter Content="{TemplateBinding Content}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="PointerOverSelected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SubtleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ControlFillColorInputActiveBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ControlFillColorDisabledBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Opacity">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0.5" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <StackPanel
            Padding="24"
            Orientation="Vertical"
            Spacing="24">

            <!--  Header  -->
            <TextBlock
                x:Name="HeaderTitleSupplier"
                x:Uid="HeaderTitleSupplier"
                FontSize="32"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorPrimary}" />

            <!--  Filter Card  -->
            <Border
                Padding="16"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <StackPanel Orientation="Vertical" Spacing="12">
                    <!--  Row 1: Filters  -->
                    <Grid ColumnSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="FilterNameBoxSupplier"
                            x:Uid="FilterNameBoxSupplier"
                            Grid.Column="0"
                            MinWidth="80"
                            MinHeight="40"
                            Padding="10"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            PlaceholderText="Name / Tên" />
                        <TextBox
                            x:Name="FilterPhoneBoxSupplier"
                            x:Uid="FilterPhoneBoxSupplier"
                            Grid.Column="1"
                            MinWidth="80"
                            MinHeight="40"
                            Padding="10"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            PlaceholderText="Phone / Số điện thoại" />
                        <TextBox
                            x:Name="FilterEmailBoxSupplier"
                            x:Uid="FilterEmailBoxSupplier"
                            Grid.Column="2"
                            MinWidth="80"
                            MinHeight="40"
                            Padding="10"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            PlaceholderText="Email" />
                        <TextBox
                            x:Name="FilterAddressBoxSupplier"
                            x:Uid="FilterAddressBoxSupplier"
                            Grid.Column="3"
                            MinWidth="80"
                            MinHeight="40"
                            Padding="10"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            PlaceholderText="Address / Địa chỉ" />
                        <TextBox
                            x:Name="FilterTaxBoxSupplier"
                            x:Uid="FilterTaxBoxSupplier"
                            Grid.Column="4"
                            MinWidth="80"
                            MinHeight="40"
                            Padding="10"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            PlaceholderText="Tax ID / Mã số thuế" />
                        <ComboBox
                            x:Name="FilterActiveBoxSupplier"
                            x:Uid="FilterActiveBoxSupplier"
                            Grid.Column="5"
                            MinWidth="80"
                            MinHeight="40"
                            Padding="10"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center">
                            <ComboBoxItem
                                x:Uid="ComboBoxItemAll"
                                IsSelected="True"
                                Tag="-1" />
                            <ComboBoxItem x:Uid="ComboBoxItemActivate" Tag="1" />
                            <ComboBoxItem x:Uid="ComboBoxItemDeActivate" Tag="0" />
                        </ComboBox>
                    </Grid>
                    <!--  Row 2: Buttons  -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="BtnSearchSupplier"
                            x:Uid="BtnSearchSupplier"
                            Grid.Column="0"
                            MinHeight="40"
                            HorizontalAlignment="Stretch"
                            Click="BtnSearch_Click"
                            CornerRadius="8"
                            Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6">
                                <TextBlock x:Uid="BtnSearchText" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="BtnClearFilterSupplier"
                            x:Uid="BtnClearFilterSupplier"
                            Grid.Column="1"
                            MinHeight="40"
                            HorizontalAlignment="Stretch"
                            Click="BtnClearFilter_Click"
                            CornerRadius="8"
                            Style="{ThemeResource DefaultButtonStyle}">
                            <StackPanel
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6">
                                <TextBlock x:Uid="BtnClearText" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!--  Quick Actions  -->
            <Border
                Padding="16"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="BtnSupplierCreate"
                        Grid.Column="0"
                        MinHeight="40"
                        HorizontalAlignment="Stretch"
                        Click="BtnCreate_Click"
                        CornerRadius="8"
                        Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" />
                            <TextBlock x:Uid="BtnNewSupplier" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="1"
                        MinHeight="40"
                        HorizontalAlignment="Stretch"
                        CornerRadius="8"
                        Style="{ThemeResource DefaultButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B5;" />
                            <TextBlock x:Uid="BtnImportSupplier" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="2"
                        MinHeight="40"
                        HorizontalAlignment="Stretch"
                        CornerRadius="8"
                        Style="{ThemeResource DefaultButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEDE1;" />
                            <TextBlock x:Uid="BtnExportSupplier" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!--  Data List  -->
            <controls:DataGrid
                x:Name="dgSuppliers"
                Margin="0,8,0,0"
                HorizontalAlignment="Stretch"
                AutoGenerateColumns="False"
                CanUserReorderColumns="False"
                CanUserResizeColumns="True"
                CanUserSortColumns="True"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{x:Bind Suppliers, Mode=OneWay}"
                SelectionMode="Single"
                VerticalScrollBarVisibility="Auto">
                <controls:DataGrid.Resources>
                    <SolidColorBrush x:Key="DataGridSelectedBackgroundBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="DataGridSelectedForegroundBrush" Color="Black" />
                </controls:DataGrid.Resources>
                <controls:DataGrid.ColumnHeaderStyle>
                    <Style TargetType="ContentControl">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ContentControl">
                                    <Border
                                        Padding="4,0,8,0"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,1,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                Content="{TemplateBinding Content}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="4,0,0,0"
                                                VerticalAlignment="Center"
                                                Text="↑↓"
                                                Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SortDirection, Converter={StaticResource SortDirectionToVisibilityConverter}}" />
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </controls:DataGrid.ColumnHeaderStyle>
                <controls:DataGrid.Columns>
                    <!--  ID  -->
                    <controls:DataGridTemplateColumn
                        x:Uid="ColIDSupplier"
                        Width="100"
                        CanUserSort="True"
                        CellStyle="{StaticResource CenteredCellStyle}">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource CenteredTextBlockStyle}" Text="{Binding Id}" />
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <!--  Name  -->
                    <controls:DataGridTemplateColumn
                        x:Uid="ColNameSupplier"
                        Width="2*"
                        CanUserSort="True">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource LeftAlignedTextBlockStyle}" Text="{Binding Name}" />
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <!--  Phone  -->
                    <controls:DataGridTemplateColumn
                        x:Uid="ColPhoneSupplier"
                        Width="150"
                        CanUserSort="True"
                        CellStyle="{StaticResource CenteredCellStyle}">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource CenteredTextBlockStyle}" Text="{Binding Phone}" />
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <!--  Email  -->
                    <controls:DataGridTemplateColumn
                        x:Uid="ColEmailSupplier"
                        Width="2*"
                        CanUserSort="True">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource LeftAlignedTextBlockStyle}" Text="{Binding Email}" />
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <!--  Address  -->
                    <controls:DataGridTemplateColumn
                        x:Uid="ColAddressSupplier"
                        Width="3*"
                        CanUserSort="True">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource LeftAlignedTextBlockStyle}" Text="{Binding Address}" />
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <!--  Tax  -->
                    <controls:DataGridTemplateColumn
                        x:Uid="ColTaxSupplier"
                        Width="120"
                        CanUserSort="True"
                        CellStyle="{StaticResource CenteredCellStyle}">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource CenteredTextBlockStyle}" Text="{Binding TaxNumber}" />
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <!--  Active  -->
                    <controls:DataGridTemplateColumn
                        x:Uid="ColActiveSupplier"
                        Width="80"
                        CanUserSort="True"
                        CellStyle="{StaticResource CenteredCellStyle}">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox
                                    Width="20"
                                    Height="20"
                                    Padding="0,0,8,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding IsActive, Mode=OneWay}"
                                    IsEnabled="False"
                                    Style="{StaticResource CenteredCheckBoxStyle}" />
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <!--  Actions  -->
                    <controls:DataGridTemplateColumn
                        x:Uid="ColActionsSupplier"
                        Width="240"
                        CanUserSort="False"
                        CellStyle="{StaticResource ActionCellStyle}"
                        HeaderStyle="{StaticResource NoRightBorderHeaderStyle}">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel
                                    Padding="0,0,8,0"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        x:Uid="BtnEditSupplierToolTip"
                                        Click="BtnEdit_Click"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Tag="{Binding Id}">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="16"
                                            Foreground="#0078D4"
                                            Glyph="&#xE70F;" />
                                    </Button>
                                    <Button
                                        x:Uid="BtnEditSupplierToolTip"
                                        Click="BtnDetail_Click"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Tag="{Binding Id}">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="16"
                                            Foreground="#2ECC71"
                                            Glyph="&#xE946;" />
                                    </Button>
                                    <Button
                                        x:Name="BtnActivate"
                                        x:Uid="BtnEditSupplierToolTip"
                                        Click="BtnActivate_Click"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Tag="{Binding Id}"
                                        Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='False'}">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="16"
                                            Foreground="#2ECC71"
                                            Glyph="&#xE73E;" />
                                    </Button>
                                    <Button
                                        x:Name="BtnDeActivate"
                                        x:Uid="BtnEditSupplierToolTip"
                                        Click="BtnDeActivate_Click"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Tag="{Binding Id}"
                                        Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='True'}">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="16"
                                            Foreground="#E81123"
                                            Glyph="&#xE71A;" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                </controls:DataGrid.Columns>
            </controls:DataGrid>

            <!--  Pagination  -->
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <Button
                    x:Name="BtnFirstPageSupplier"
                    x:Uid="BtnFirstPageSupplier"
                    Click="BtnFirstPage_Click"
                    Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon Glyph="&#xE892;" />
                </Button>
                <Button
                    x:Name="BtnPrevPageSupplier"
                    x:Uid="BtnPrevPageSupplier"
                    Click="BtnPrevPage_Click"
                    Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon Glyph="&#xE76B;" />
                </Button>
                <TextBlock
                    Margin="8,0"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{x:Bind CurrentPage, Mode=OneWay}" />
                <TextBlock
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Text="/" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{x:Bind TotalPages, Mode=OneWay}" />
                <Button
                    x:Name="BtnNextPageSupplier"
                    x:Uid="BtnNextPageSupplier"
                    Click="BtnNextPage_Click"
                    Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon Glyph="&#xE76C;" />
                </Button>
                <Button
                    x:Name="BtnLastPageSupplier"
                    x:Uid="BtnLastPageSupplier"
                    Click="BtnLastPage_Click"
                    Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon Glyph="&#xE893;" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>