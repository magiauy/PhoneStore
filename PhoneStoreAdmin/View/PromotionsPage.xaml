<Page
    x:Class="PhoneStoreAdmin.View.PromotionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:PhoneStoreAdmin.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PhoneStoreAdmin.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{StaticResource BrushBackground}"
    mc:Ignorable="d">
	<Page.Resources>
		<ThemeShadow x:Name="SharedShadow" />

		<!--  Converters  -->
		<converters:DateOnlyConverter x:Key="DateConverter" />
		<converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

		<Style x:Key="CardStyle" TargetType="Border">
			<Setter Property="Background">
				<Setter.Value>
					<SolidColorBrush Opacity="0.95" Color="{StaticResource ColorSurface}" />
				</Setter.Value>
			</Setter>
			<Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="12" />
		</Style>

		<Style x:Key="PrimaryButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="{StaticResource BrushPrimary}" />
			<Setter Property="Foreground" Value="{StaticResource BrushOnPrimary}" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Padding" Value="20,14" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Grid>
							<Border
                                x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}">
								<ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Foreground="{TemplateBinding Foreground}" />
							</Border>
							<VisualStateManager.VisualStateGroups>
								<VisualStateGroup x:Name="CommonStates">
									<VisualState x:Name="Normal" />
									<VisualState x:Name="PointerOver">
										<Storyboard>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
												<DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource BrushPrimaryHover}" />
											</ObjectAnimationUsingKeyFrames>
										</Storyboard>
									</VisualState>
									<VisualState x:Name="Pressed">
										<Storyboard>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
												<DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource BrushPrimaryPressed}" />
											</ObjectAnimationUsingKeyFrames>
										</Storyboard>
									</VisualState>
									<VisualState x:Name="Disabled">
										<Storyboard>
											<DoubleAnimation
                                                Storyboard.TargetName="RootBorder"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0.6"
                                                Duration="0:0:0" />
										</Storyboard>
									</VisualState>
								</VisualStateGroup>
							</VisualStateManager.VisualStateGroups>
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="SecondaryButtonStyle" TargetType="Button">
			<Setter Property="Background">
				<Setter.Value>
					<SolidColorBrush Color="{StaticResource ColorSurface}" />
				</Setter.Value>
			</Setter>
			<Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="FontWeight" Value="Medium" />
		</Style>

		<Style x:Key="InputStyle" TargetType="TextBox">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="16,10" />
			<Setter Property="FontSize" Value="15" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
		</Style>
	</Page.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Grid Grid.RowSpan="2">
			<Rectangle>
				<Rectangle.Fill>
					<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
						<GradientStop Offset="0" Color="{StaticResource ColorBackground}" />
						<GradientStop Offset="0.5" Color="#FFF0F2FF" />
						<GradientStop Offset="1" Color="#FFE8ECFF" />
					</LinearGradientBrush>
				</Rectangle.Fill>
			</Rectangle>
			<Grid>
				<Ellipse
                    Width="400"
                    Height="400"
                    Margin="-200,-100,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Opacity="0.1">
					<Ellipse.Fill>
						<RadialGradientBrush>
							<GradientStop Offset="0" Color="{StaticResource ColorPrimary}" />
							<GradientStop Offset="1" Color="{StaticResource ColorPrimaryLight}" />
						</RadialGradientBrush>
					</Ellipse.Fill>
				</Ellipse>
				<Ellipse
                    Width="300"
                    Height="300"
                    Margin="0,0,-150,-150"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Opacity="0.1">
					<Ellipse.Fill>
						<RadialGradientBrush>
							<GradientStop Offset="0" Color="{StaticResource ColorAccent}" />
							<GradientStop Offset="1" Color="Transparent" />
						</RadialGradientBrush>
					</Ellipse.Fill>
				</Ellipse>
			</Grid>
		</Grid>

		<Border
            Grid.Row="0"
            Margin="32,32,32,24"
            Shadow="{StaticResource SharedShadow}"
            Style="{StaticResource CardStyle}">
			<Grid Padding="32,24">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<StackPanel
                    Grid.Column="0"
                    Orientation="Vertical"
                    Spacing="8">
					<TextBlock
                        x:Uid="HeaderTitlePromotion"
                        FontSize="36"
                        FontWeight="Bold">
						<TextBlock.Foreground>
							<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
								<GradientStop Offset="0" Color="{StaticResource ColorPrimary}" />
								<GradientStop Offset="1" Color="{StaticResource ColorAccent}" />
							</LinearGradientBrush>
						</TextBlock.Foreground>
					</TextBlock>
					<TextBlock
                        x:Uid="SubHeaderTitlePromotion"
                        FontSize="16"
                        Foreground="{StaticResource BrushTextSecondary}" />
				</StackPanel>

				<Button
                    x:Name="AddPromotionButton"
                    Grid.Column="1"
                    Padding="20,14"
                    VerticalAlignment="Center"
                    Click="BtnCreate_Click"
                    Shadow="{StaticResource SharedShadow}"
                    Style="{StaticResource PrimaryButtonStyle}">
					<StackPanel Orientation="Horizontal" Spacing="10">
						<FontIcon FontSize="18" Glyph="&#xE710;" />
						<TextBlock x:Uid="BtnNewPromotion" FontSize="15" />
					</StackPanel>
				</Button>
			</Grid>
		</Border>

		<Grid Grid.Row="1" Margin="32,0,32,32">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<Border
                Grid.Row="0"
                Margin="0,0,0,24"
                Padding="24,20"
                Shadow="{StaticResource SharedShadow}"
                Style="{StaticResource CardStyle}">
				<Grid>
					<!-- Search Row -->
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<AutoSuggestBox
                            x:Name="SearchBox"
                            x:Uid="SearchPromotion"
                            Grid.Column="0"
                            Margin="0,0,16,0"
                            Padding="16,10"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            FontSize="15"
                            QueryIcon="Find"
                            TextChanged="SearchBox_TextChanged" />
						<StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="12">
							<Button
                                x:Name="FilterButton"
                                Padding="16,12"
                                Click="FilterButton_Click"
                                Shadow="{StaticResource SharedShadow}"
                                Style="{StaticResource SecondaryButtonStyle}">
								<StackPanel Orientation="Horizontal" Spacing="8">
									<FontIcon
                                        FontSize="16"
                                        Foreground="{StaticResource BrushPrimary}"
                                        Glyph="&#xE71C;" />
									<TextBlock
                                        x:Uid="BtnFilterPromotion"
                                        FontWeight="Medium"
                                        Foreground="{StaticResource BrushText}" />
								</StackPanel>
							</Button>
							<Button
                                x:Name="RefreshButton"
                                Padding="14"
                                Click="BtnClearFilter_Click"
                                Shadow="{StaticResource SharedShadow}"
                                Style="{StaticResource SecondaryButtonStyle}">
								<FontIcon
                                    FontSize="16"
                                    Foreground="{StaticResource BrushPrimary}"
                                    Glyph="&#xE72C;" />
							</Button>
						</StackPanel>
					</Grid>
				</Grid>
			</Border>

			<!--  Filter Panel  -->
			<Border
                x:Name="FilterPanel"
                Grid.Row="1"
                Margin="0,0,0,24"
                Padding="24,20"
                Shadow="{StaticResource SharedShadow}"
                Style="{StaticResource CardStyle}"
                Visibility="Collapsed">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0" Margin="8,0,8,0" Spacing="4">
						<TextBlock x:Uid="FilterStatusBoxPromotion" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
						<ComboBox x:Name="StatusFilterBox"
                                  Height="40"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="FilterChange">
							<ComboBoxItem x:Uid="SelectBoxAllValue" />
							<ComboBoxItem x:Uid="SelectBoxActivateValue" />
							<ComboBoxItem x:Uid="SelectBoxInActivateValue" />
						</ComboBox>
					</StackPanel>

					<StackPanel Grid.Column="1" Margin="8,0,8,0" Spacing="4">
						<TextBlock x:Uid="FilterStartDateBoxPromotion" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
						<DatePicker x:Name="StartDatePicker"
                                    Height="40"
                                    HorizontalAlignment="Stretch"
                                    DateChanged="FilterChange" />
					</StackPanel>

					<StackPanel Grid.Column="2" Margin="8,0,8,0" Spacing="4">
						<TextBlock x:Uid="FilterEndDateBoxPromotion" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
						<DatePicker x:Name="EndDatePicker"
                                    Height="40"
                                    HorizontalAlignment="Stretch"
                                    DateChanged="FilterChange" />
					</StackPanel>
				</Grid>
			</Border>

			<Border
                Grid.Row="2"
                Padding="0"
                Shadow="{StaticResource SharedShadow}"
                Style="{StaticResource CardStyle}">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<Border
                        Grid.Row="0"
                        Padding="32,20"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="12,12,0,0">
						<Border.Background>
							<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
								<GradientStop Offset="0" Color="#FFFAFBFF" />
								<GradientStop Offset="1" Color="#FFF5F7FF" />
							</LinearGradientBrush>
						</Border.Background>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="80" />
								<ColumnDefinition Width="2*" MinWidth="180" />
								<ColumnDefinition Width="2*" MinWidth="200" />
								<ColumnDefinition Width="200" />
								<ColumnDefinition Width="200" />
								<ColumnDefinition Width="100" />
								<ColumnDefinition Width="120" />
							</Grid.ColumnDefinitions>
							<TextBlock
                                x:Uid="ColIDPromotion"
                                Grid.Column="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextSecondary}" />
							<TextBlock
                                x:Uid="ColNamePromotion"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextSecondary}" />
							<TextBlock
                                x:Uid="ColDescriptionPromotion"
                                Grid.Column="2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextSecondary}" />
							<TextBlock
                                x:Uid="ColStartDatePromotion"
                                Grid.Column="3"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextSecondary}" />
							<TextBlock
                                x:Uid="ColEndDatePromotion"
                                Grid.Column="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextSecondary}" />
							<TextBlock
                                x:Uid="ColStatusPromotion"
                                Grid.Column="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextSecondary}" />
							<TextBlock
                                x:Uid="ColActionsPromotion"
                                Grid.Column="6"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextSecondary}" />
						</Grid>
					</Border>

					<ScrollViewer
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
						<ListView
                            x:Name="PromotionsListView"
                            Background="Transparent"
                            ItemsSource="{x:Bind Promotions, Mode=OneWay}"
                            SelectionMode="None">
							<ListView.ItemContainerStyle>
								<Style TargetType="ListViewItem">
									<Setter Property="HorizontalContentAlignment" Value="Stretch" />
									<Setter Property="Padding" Value="0" />
									<Setter Property="Margin" Value="0" />
									<Setter Property="Background" Value="Transparent" />
									<Setter Property="Template">
										<Setter.Value>
											<ControlTemplate TargetType="ListViewItem">
												<Border
                                                    x:Name="ItemBorder"
                                                    Padding="32,20"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{StaticResource BrushBorder}"
                                                    BorderThickness="0,0,0,1">
													<Grid>
														<Rectangle
                                                            x:Name="HoverBackground"
                                                            Fill="Transparent"
                                                            Opacity="0" />
														<ContentPresenter />
													</Grid>
													<VisualStateManager.VisualStateGroups>
														<VisualStateGroup x:Name="CommonStates">
															<VisualState x:Name="Normal">
																<Storyboard>
																	<DoubleAnimation
                                                                        Storyboard.TargetName="HoverBackground"
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="0"
                                                                        Duration="0:0:0.2" />
																</Storyboard>
															</VisualState>
															<VisualState x:Name="PointerOver">
																<Storyboard>
																	<DoubleAnimation
                                                                        Storyboard.TargetName="HoverBackground"
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="0.03"
                                                                        Duration="0:0:0.2" />
																	<ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Fill">
																		<DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource BrushPrimary}" />
																	</ObjectAnimationUsingKeyFrames>
																</Storyboard>
															</VisualState>
														</VisualStateGroup>
													</VisualStateManager.VisualStateGroups>
												</Border>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
								</Style>
							</ListView.ItemContainerStyle>
							<ListView.ItemTemplate>
								<DataTemplate>
									<Grid DoubleTapped="Grid_DoubleTapped" Background="Transparent">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="80" />
											<ColumnDefinition Width="2*" MinWidth="180" />
											<ColumnDefinition Width="2*" MinWidth="200" />
											<ColumnDefinition Width="200" />
											<ColumnDefinition Width="200" />
											<ColumnDefinition Width="100" />
											<ColumnDefinition Width="120" />
										</Grid.ColumnDefinitions>

										<Border
                                            Grid.Column="0"
                                            Width="32"
                                            Height="32"
                                            HorizontalAlignment="Center"
                                            Background="{StaticResource BrushPrimaryLight}"
                                            CornerRadius="8">
											<TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource BrushPrimary}"
                                                Text="{Binding Id}" />
										</Border>

										<TextBlock
                                            Grid.Column="1"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource BrushText}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap">
											<ToolTipService.ToolTip>
												<ToolTip Content="{Binding Name}" />
											</ToolTipService.ToolTip>
										</TextBlock>

										<TextBlock
                                            Grid.Column="2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="{StaticResource BrushTextSecondary}"
                                            Text="{Binding Description}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap">
											<ToolTipService.ToolTip>
												<ToolTip Content="{Binding Description}" />
											</ToolTipService.ToolTip>
										</TextBlock>

										<TextBlock
                                            Grid.Column="3"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="{StaticResource BrushText}"
                                            Text="{Binding StartDate, Converter={StaticResource DateConverter}}" />

										<TextBlock
                                            Grid.Column="4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="{StaticResource BrushText}"
                                            Text="{Binding EndDate, Converter={StaticResource DateConverter}}" />

										<Border
                                            Grid.Column="5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="{Binding StatusColor}"
                                            CornerRadius="12"
                                            Padding="12,6">
											<TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="{Binding LocalizedStatusText}"/>
										</Border>

										<Button
                                            Grid.Column="6"
                                            Width="36"
                                            Height="36"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="BtnActions_Click"
                                            CornerRadius="8"
                                            Tag="{Binding}">
											<FontIcon
                                                FontSize="16"
                                                Foreground="{StaticResource BrushTextSecondary}"
                                                Glyph="&#xE712;" />
											<ToolTipService.ToolTip>
												<ToolTip x:Uid="BtnActionPromotion" Placement="Left" />
											</ToolTipService.ToolTip>
											<FlyoutBase.AttachedFlyout>
												<MenuFlyout>
                                                <MenuFlyoutItem
                                                        x:Uid="BtnEditPromotion"
                                                        Click="NavigateToEditPromotion_Click"
                                                        Tag="{Binding Id}">
														<MenuFlyoutItem.Icon>
															<FontIcon Glyph="&#xE104;" />
														</MenuFlyoutItem.Icon>
													</MenuFlyoutItem>
													<MenuFlyoutItem
                                                        x:Uid="BtnActivatePromotion"
                                                        Click="BtnActivate_Click"
                                                        Tag="{Binding Id}"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=False}">
														<MenuFlyoutItem.Icon>
															<FontIcon Glyph="&#xE8BB;" />
														</MenuFlyoutItem.Icon>
													</MenuFlyoutItem>
													<MenuFlyoutItem
                                                        x:Uid="BtnDeactivatePromotion"
                                                        Click="BtnDeactivate_Click"
                                                        Tag="{Binding Id}"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
														<MenuFlyoutItem.Icon>
															<FontIcon Glyph="&#xE8D8;" />
														</MenuFlyoutItem.Icon>
													</MenuFlyoutItem>
												</MenuFlyout>
											</FlyoutBase.AttachedFlyout>
										</Button>
									</Grid>
								</DataTemplate>
							</ListView.ItemTemplate>
						</ListView>
					</ScrollViewer>

					<Grid
                        x:Name="EmptyStatePanel"
                        Grid.Row="1"
                        Padding="60"
                        Visibility="Collapsed">
						<StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Vertical"
                            Spacing="24">
							<Border
                                Width="80"
                                Height="80"
                                Background="{StaticResource BrushPrimaryLight}"
                                CornerRadius="40">
								<FontIcon
                                    FontSize="32"
                                    Foreground="{StaticResource BrushPrimary}"
                                    Glyph="&#xE8A5;" />
							</Border>
							<StackPanel HorizontalAlignment="Center" Spacing="8">
								<TextBlock
                                    x:Uid="EmptyStateTitlePromotion"
                                    HorizontalAlignment="Center"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource BrushText}" />
								<TextBlock
                                    x:Uid="EmptyStateDescriptionPromotion"
                                    HorizontalAlignment="Center"
                                    FontSize="16"
                                    Foreground="{StaticResource BrushTextSecondary}"
                                    TextAlignment="Center"
                                    TextWrapping="WrapWholeWords" />
							</StackPanel>
						</StackPanel>
					</Grid>

					<Border
                        Grid.Row="2"
                        Padding="32,20"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,12,12">
						<Border.Background>
							<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
								<GradientStop Offset="0" Color="#FFF5F7FF" />
								<GradientStop Offset="1" Color="#FFFAFBFF" />
							</LinearGradientBrush>
						</Border.Background>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<StackPanel
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="16">
								<Border
                                    Padding="16,8"
                                    Background="{StaticResource BrushPrimaryLight}"
                                    CornerRadius="16">
									<TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource BrushPrimary}">
										<Run x:Uid="ShowIngPromotion" />
										<Run x:Name="RecordCountText" Text="0" />
										<Run x:Uid="Promotions" />
									</TextBlock>
								</Border>
							</StackPanel>

							<StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="12">
								<Button
                                    x:Name="PreviousPageButton"
                                    Width="40"
                                    Height="40"
                                    Padding="0"
                                    Click="BtnLastPage_Click"
                                    IsEnabled="False"
                                    Style="{StaticResource SecondaryButtonStyle}">
									<FontIcon FontSize="16" Glyph="&#xE760;" />
								</Button>
								<Border
                                    Padding="20,10"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource BrushPrimaryLight}"
                                    CornerRadius="20">
									<TextBlock
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource BrushPrimary}">
										<Run x:Uid="PagePromotion" />
										<Run x:Name="PageInfoText" Text="1 / 1" />
									</TextBlock>
								</Border>
								<Button
                                    x:Name="NextPageButton"
                                    Width="40"
                                    Height="40"
                                    Padding="0"
                                    Click="BtnNextPage_Click"
                                    IsEnabled="False"
                                    Style="{StaticResource SecondaryButtonStyle}">
									<FontIcon FontSize="16" Glyph="&#xE761;" />
								</Button>
							</StackPanel>
						</Grid>
					</Border>
