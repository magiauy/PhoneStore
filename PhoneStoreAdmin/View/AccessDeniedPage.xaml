<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PhoneStoreAdmin.View.AccessDeniedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhoneStoreAdmin.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BrushBackground}">

    <Grid>
        <StackPanel 
            HorizontalAlignment="Center" 
            VerticalAlignment="Center" 
            Spacing="24">
            
            <!-- Icon -->
            <FontIcon 
                Glyph="&#xE72E;" 
                FontSize="80" 
                Foreground="{StaticResource BrushError}"
                HorizontalAlignment="Center"/>
            
            <!-- Title -->
            <TextBlock 
                x:Name="TitleText"
                x:Uid="AccessDenied_Title"
                Text="Access Denied"
                FontSize="32" 
                FontWeight="Bold" 
                Foreground="{StaticResource BrushText}"
                HorizontalAlignment="Center"/>
            
            <!-- Message -->
            <TextBlock 
                x:Name="MessageText"
                x:Uid="AccessDenied_Message"
                Text="You don't have permission to access this page."
                FontSize="16" 
                Foreground="{StaticResource BrushTextSecondary}"
                HorizontalAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="400"
                TextAlignment="Center"/>
            
            <!-- Required Permission Info -->
            <Border 
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Visibility="{x:Bind RequiredPermissionVisibility, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock 
                        x:Uid="AccessDenied_RequiredPermission"
                        Text="Required Permission:"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock 
                        x:Name="RequiredPermissionText"
                        Text="{x:Bind RequiredPermission, Mode=OneWay}"
                        FontSize="14"
                        Foreground="{StaticResource BrushPrimary}"
                        FontFamily="Consolas"/>
                </StackPanel>
            </Border>
            
            <!-- Back to Dashboard Button -->
            <Button 
                x:Name="BackToDashboardButton"
                x:Uid="AccessDenied_BackToDashboard"
                Content="Back to Dashboard"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Center"
                Padding="24,12"
                Click="BackToDashboardButton_Click"/>
            
        </StackPanel>
    </Grid>
</Page>
