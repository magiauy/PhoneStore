<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PhoneStoreAdmin.View.PricingSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhoneStoreAdmin.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{StaticResource BrushSurface}" 
                BorderBrush="{StaticResource BrushBorder}" 
                BorderThickness="0,0,0,1" 
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton"
                        Grid.Column="0"
                        Click="BackButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Quay lại Dashboard">
                    <FontIcon Glyph="&#xE72B;" FontSize="20" Foreground="{StaticResource BrushText}"/>
                </Button>

                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Cài đặt định giá" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource BrushText}"/>
                    <TextBlock Text="Cấu hình các tham số cho hệ thống định giá động" 
                               FontSize="14" 
                               Foreground="{StaticResource BrushTextSecondary}"/>
                </StackPanel>

                <Button x:Name="SaveButton"
                        Grid.Column="2"
                        Click="SaveButton_Click"
                        Background="{StaticResource BrushPrimary}" 
                        Foreground="{StaticResource BrushOnPrimary}"
                        CornerRadius="8" 
                        Padding="16,12" 
                        BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="16"/>
                        <TextBlock Text="Lưu cài đặt" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Padding="24" ColumnDefinitions="1*,1*" ColumnSpacing="24">
                
                <!-- Settings Section -->
                <StackPanel Grid.Column="0" Spacing="24">
                    
                    <!-- Margin Settings Card -->
                    <Border Background="{StaticResource BrushSurface}" 
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="12" 
                            Padding="24">
                        <StackPanel Spacing="20">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Cài đặt biên lợi nhuận" 
                                           FontSize="18" 
                                           FontWeight="SemiBold" 
                                           Foreground="{StaticResource BrushText}"/>
                                <TextBlock Text="Thiết lập biên lợi nhuận cho các chế độ định giá" 
                                           FontSize="13" 
                                           Foreground="{StaticResource BrushTextSecondary}"/>
                            </StackPanel>
                            
                            <!-- Desired Margin -->
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" 
                                               Text="Biên lợi nhuận mong muốn" 
                                               FontSize="14" 
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushText}"/>
                                    <TextBlock Grid.Column="1" 
                                               Text="(AUTO_PROTECT)" 
                                               FontSize="12" 
                                               Foreground="{StaticResource BrushTextSecondary}"/>
                                </Grid>
                                <TextBlock Text="Biên lợi nhuận áp dụng khi thị trường tăng giá. Công thức: MAX(FIFO, NIFO) × (1 + Margin)" 
                                           FontSize="12" 
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <NumberBox x:Name="DesiredMarginInput"
                                               Grid.Column="0"
                                               Value="10"
                                               Minimum="0"
                                               Maximum="100"
                                               SpinButtonPlacementMode="Compact"
                                               SmallChange="1"
                                               LargeChange="5"
                                               ValueChanged="DesiredMarginInput_ValueChanged"/>
                                    <TextBlock Grid.Column="1" 
                                               Text="%" 
                                               FontSize="16" 
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushText}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>
                                </Grid>
                            </StackPanel>
                            
                            <!-- Minimum Margin -->
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" 
                                               Text="Biên lợi nhuận tối thiểu" 
                                               FontSize="14" 
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushText}"/>
                                    <TextBlock Grid.Column="1" 
                                               Text="(CLEARANCE)" 
                                               FontSize="12" 
                                               Foreground="{StaticResource BrushTextSecondary}"/>
                                </Grid>
                                <TextBlock Text="Biên lợi nhuận tối thiểu khi xả hàng. Công thức: NIFO × (1 + Margin)" 
                                           FontSize="12" 
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <NumberBox x:Name="MinimumMarginInput"
                                               Grid.Column="0"
                                               Value="5"
                                               Minimum="0"
                                               Maximum="100"
                                               SpinButtonPlacementMode="Compact"
                                               SmallChange="1"
                                               LargeChange="5"
                                               ValueChanged="MinimumMarginInput_ValueChanged"/>
                                    <TextBlock Grid.Column="1" 
                                               Text="%" 
                                               FontSize="16" 
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushText}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- Threshold Settings Card -->
                    <Border Background="{StaticResource BrushSurface}" 
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="12" 
                            Padding="24">
                        <StackPanel Spacing="20">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Ngưỡng cảnh báo" 
                                           FontSize="18" 
                                           FontWeight="SemiBold" 
                                           Foreground="{StaticResource BrushText}"/>
                                <TextBlock Text="Thiết lập ngưỡng kích hoạt cảnh báo biến động giá" 
                                           FontSize="13" 
                                           Foreground="{StaticResource BrushTextSecondary}"/>
                            </StackPanel>
                            
                            <!-- Variance Threshold -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Ngưỡng chênh lệch giá" 
                                           FontSize="14" 
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushText}"/>
                                <TextBlock Text="Khi variance (NIFO - FIFO) / FIFO thấp hơn ngưỡng này, hệ thống sẽ tạo cảnh báo và dừng tự động cập nhật giá" 
                                           FontSize="12" 
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <NumberBox x:Name="VarianceThresholdInput"
                                               Grid.Column="0"
                                               Value="-10"
                                               Minimum="-100"
                                               Maximum="0"
                                               SpinButtonPlacementMode="Compact"
                                               SmallChange="1"
                                               LargeChange="5"
                                               ValueChanged="VarianceThresholdInput_ValueChanged"/>
                                    <TextBlock Grid.Column="1" 
                                               Text="%" 
                                               FontSize="16" 
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushText}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>
                                </Grid>
                                <Border Background="{StaticResource BrushWarning}" 
                                        Opacity="0.1"
                                        CornerRadius="8" 
                                        Padding="12"
                                        Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{StaticResource BrushWarning}"/>
                                        <TextBlock Text="Giá trị âm: Cảnh báo khi giá nhập giảm so với giá vốn" 
                                                   FontSize="12" 
                                                   Foreground="{StaticResource BrushWarning}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- Validation Messages -->
                    <Border x:Name="ValidationErrorBorder"
                            Background="{StaticResource BrushError}" 
                            Opacity="0.1"
                            CornerRadius="8" 
                            Padding="16"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE783;" FontSize="20" Foreground="{StaticResource BrushError}"/>
                            <TextBlock x:Name="ValidationErrorText" 
                                       Text="" 
                                       FontSize="14" 
                                       Foreground="{StaticResource BrushError}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Preview Calculator Section -->
                <Border Grid.Column="1" 
                        Background="{StaticResource BrushSurface}" 
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="12" 
                        Padding="24"
                        VerticalAlignment="Top">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Công cụ tính giá" 
                                       FontSize="18" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource BrushText}"/>
                            <TextBlock Text="Xem trước giá bán với các tham số đã cấu hình" 
                                       FontSize="13" 
                                       Foreground="{StaticResource BrushTextSecondary}"/>
                        </StackPanel>
                        
                        <!-- Input Fields -->
                        <StackPanel Spacing="16">
                            <!-- FIFO Input -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Giá vốn FIFO" 
                                           FontSize="14" 
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushText}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <NumberBox x:Name="PreviewFifoInput"
                                               Grid.Column="0"
                                               Value="10000000"
                                               Minimum="0"
                                               Maximum="999999999999"
                                               SpinButtonPlacementMode="Hidden"
                                               ValueChanged="PreviewInput_ValueChanged"/>
                                    <TextBlock Grid.Column="1" 
                                               Text="đ" 
                                               FontSize="16" 
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushText}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>
                                </Grid>
                            </StackPanel>
                            
                            <!-- NIFO Input -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Giá thay thế NIFO" 
                                           FontSize="14" 
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushText}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <NumberBox x:Name="PreviewNifoInput"
                                               Grid.Column="0"
                                               Value="11000000"
                                               Minimum="0"
                                               Maximum="999999999999"
                                               SpinButtonPlacementMode="Hidden"
                                               ValueChanged="PreviewInput_ValueChanged"/>
                                    <TextBlock Grid.Column="1" 
                                               Text="đ" 
                                               FontSize="16" 
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushText}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Divider -->
                        <Border Height="1" Background="{StaticResource BrushBorder}"/>
                        
                        <!-- Preview Results -->
                        <StackPanel Spacing="16">
                            <!-- Variance -->
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" 
                                           Text="Variance" 
                                           FontSize="14"
                                           Foreground="{StaticResource BrushTextSecondary}"/>
                                <TextBlock x:Name="PreviewVarianceText" 
                                           Grid.Column="1" 
                                           Text="+10.00%" 
                                           FontSize="14" 
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushSuccess}"/>
                            </Grid>
                            
                            <!-- Market Trend -->
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" 
                                           Text="Xu hướng thị trường" 
                                           FontSize="14"
                                           Foreground="{StaticResource BrushTextSecondary}"/>
                                <Border x:Name="PreviewTrendBorder"
                                        Grid.Column="1" 
                                        Background="{StaticResource BrushSuccess}" 
                                        Opacity="0.1"
                                        CornerRadius="4" 
                                        Padding="8,4">
                                    <TextBlock x:Name="PreviewTrendText" 
                                               Text="↗ Tăng" 
                                               FontSize="12" 
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushSuccess}"/>
                                </Border>
                            </Grid>
                            
                            <!-- Divider -->
                            <Border Height="1" Background="{StaticResource BrushBorder}"/>
                            
                            <!-- AUTO_PROTECT Price -->
                            <Border Background="{StaticResource BrushPrimary}" 
                                    Opacity="0.1"
                                    CornerRadius="8" 
                                    Padding="16">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Giá AUTO_PROTECT" 
                                                   FontSize="12" 
                                                   Foreground="{StaticResource BrushTextSecondary}"/>
                                        <TextBlock Text="MAX(FIFO, NIFO) × (1 + Desired Margin)" 
                                                   FontSize="10" 
                                                   Foreground="{StaticResource BrushTextSecondary}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="PreviewAutoProtectPrice" 
                                               Grid.Column="1" 
                                               Text="12,100,000đ" 
                                               FontSize="18" 
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BrushPrimary}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            
                            <!-- CLEARANCE Price -->
                            <Border Background="{StaticResource BrushWarning}" 
                                    Opacity="0.1"
                                    CornerRadius="8" 
                                    Padding="16">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Giá CLEARANCE" 
                                                   FontSize="12" 
                                                   Foreground="{StaticResource BrushTextSecondary}"/>
                                        <TextBlock Text="NIFO × (1 + Minimum Margin)" 
                                                   FontSize="10" 
                                                   Foreground="{StaticResource BrushTextSecondary}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="PreviewClearancePrice" 
                                               Grid.Column="1" 
                                               Text="11,550,000đ" 
                                               FontSize="18" 
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BrushWarning}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            
                            <!-- Alert Status -->
                            <Border x:Name="PreviewAlertBorder"
                                    Background="{StaticResource BrushError}" 
                                    Opacity="0.1"
                                    CornerRadius="8" 
                                    Padding="16"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE7BA;" FontSize="20" Foreground="{StaticResource BrushError}"/>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Sẽ tạo cảnh báo" 
                                                   FontSize="14" 
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushError}"/>
                                        <TextBlock Text="Variance thấp hơn ngưỡng cảnh báo" 
                                                   FontSize="12" 
                                                   Foreground="{StaticResource BrushTextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" 
              Grid.RowSpan="2" 
              Background="#80000000" 
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="48" Height="48"/>
                <TextBlock x:Name="LoadingText" Text="Đang lưu cài đặt..." Foreground="White" FontSize="14"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
