<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PhoneStoreAdmin.View.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhoneStoreAdmin.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:DataType="local:SettingsPage"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Setting Card Style -->
        <Style x:Key="SettingCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Setting Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="Margin" Value="0,24,0,12"/>
        </Style>

        <!-- Setting Item Style -->
        <Style x:Key="SettingItemStyle" TargetType="Grid">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
        </Style>

        <!-- Button Style for Settings -->
        <Style x:Key="SettingButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Height" Value="40"/>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="SettingComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>

        <!-- Logout Button Style -->
        <Style x:Key="LogoutButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushError}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource BrushBackground}">
        <ScrollViewer VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
            <Grid Width="900"
                  HorizontalAlignment="Center" 
                  Margin="40,24,40,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Page Header -->
                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE713;" 
                                  FontSize="32" 
                                  Foreground="{StaticResource BrushPrimary}" 
                                  VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Uid="SettingsTitle"
                                       FontSize="32" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource BrushText}"/>
                            <TextBlock x:Uid="SettingsSubtitle"
                                       FontSize="14" 
                                       Foreground="{StaticResource BrushTextSecondary}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Settings Content -->
                <StackPanel Grid.Row="1">
                    
                    <!-- Account Section -->
                    <TextBlock x:Uid="AccountSection" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource SettingCardStyle}">
                        <StackPanel Spacing="16">
                            <!-- User Profile -->
                            <Grid Style="{StaticResource SettingItemStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Profile Picture -->
                                <PersonPicture Grid.Column="0" 
                                               Width="48" 
                                               Height="48" 
                                               VerticalAlignment="Center"/>
                                
                                <!-- User Info -->
                                <StackPanel Grid.Column="1" 
                                            Margin="16,0,0,0" 
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="UserNameTextBlock"
                                               x:Uid="UserName"
                                               FontSize="16" 
                                               FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushText}"/>
                                    <TextBlock x:Name="UserEmailTextBlock"
                                               x:Uid="UserEmail"
                                               FontSize="14" 
                                               Foreground="{StaticResource BrushTextSecondary}"/>
                                    <TextBlock x:Name="UserRoleTextBlock"
                                               x:Uid="UserRole"
                                               FontSize="12" 
                                               Foreground="{StaticResource BrushTextSecondary}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                
                                <!-- Edit Profile Button -->
                                <Button Grid.Column="2" 
                                        x:Uid="EditProfile"
                                        Style="{StaticResource SettingButtonStyle}"
                                        Width="100"
                                        x:Name="EditProfileButton"
                                        Click="EditProfileButton_Click"/>
                            </Grid>

                            <!-- User Permissions Info -->
                            <Grid Style="{StaticResource SettingItemStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <FontIcon Grid.Column="0" 
                                          Glyph="&#xE7EF;" 
                                          FontSize="16" 
                                          Foreground="{StaticResource BrushTextSecondary}"
                                          VerticalAlignment="Center"/>
                                
                                <StackPanel Grid.Column="1" 
                                            Margin="12,0,0,0" 
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="UserPermissionsTextBlock"
                                               x:Uid="UserPermissions"
                                               FontSize="13" 
                                               Foreground="{StaticResource BrushTextSecondary}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Change Password -->
                            <Grid Style="{StaticResource SettingItemStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <FontIcon Grid.Column="0" 
                                          Glyph="&#xE72E;" 
                                          FontSize="20" 
                                          Foreground="{StaticResource BrushTextSecondary}"
                                          VerticalAlignment="Center"/>
                                
                                <StackPanel Grid.Column="1" 
                                            Margin="16,0,0,0" 
                                            VerticalAlignment="Center">
                                    <TextBlock x:Uid="ChangePassword"
                                               FontSize="16" 
                                               Foreground="{StaticResource BrushText}"/>
                                    <TextBlock x:Uid="ChangePasswordDescription"
                                               FontSize="14" 
                                               Foreground="{StaticResource BrushTextSecondary}"/>
                                </StackPanel>
                                
                                <Button Grid.Column="2" 
                                        x:Uid="ChangePasswordButton"
                                        Style="{StaticResource SettingButtonStyle}"
                                        Width="90"
                                        x:Name="ChangePasswordButton"
                                        Click="ChangePasswordButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Application Settings -->
                    <TextBlock x:Uid="ApplicationSection" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource SettingCardStyle}">
                        <StackPanel Spacing="16">
                            
                            <!-- Language Setting -->
                            <Grid Style="{StaticResource SettingItemStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <FontIcon Grid.Column="0" 
                                          Glyph="&#xF2B7;" 
                                          FontSize="20" 
                                          Foreground="{StaticResource BrushTextSecondary}"
                                          VerticalAlignment="Center"/>
                                
                                <StackPanel Grid.Column="1" 
                                            Margin="16,0,0,0" 
                                            VerticalAlignment="Center">
                                    <TextBlock x:Uid="Language"
                                               FontSize="16" 
                                               Foreground="{StaticResource BrushText}"/>
                                    <TextBlock x:Uid="LanguageDescription"
                                               FontSize="14" 
                                               Foreground="{StaticResource BrushTextSecondary}"/>
                                </StackPanel>
                                
                                <ComboBox Grid.Column="2" 
                                          x:Name="LanguageComboBox"
                                          Style="{StaticResource SettingComboBoxStyle}"
                                          SelectionChanged="LanguageComboBox_SelectionChanged">
                                    <ComboBoxItem x:Uid="English" Tag="en-US"/>
                                    <ComboBoxItem x:Uid="Vietnamese" Tag="vi-VN"/>
                                </ComboBox>
                            </Grid>

                            <!-- Theme Setting -->
                            <Grid Style="{StaticResource SettingItemStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0"
                                          Glyph="&#xE790;"
                                          FontSize="20"
                                          Foreground="{StaticResource BrushTextSecondary}"
                                          VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1"
                                            Margin="16,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Uid="Theme"
                                               FontSize="16"
                                               Foreground="{StaticResource BrushText}"/>
                                    <TextBlock x:Uid="ThemeDescription"
                                               FontSize="14"
                                               Foreground="{StaticResource BrushTextSecondary}"/>
                                    <TextBlock Text="Changes take effect immediately."
                                               FontSize="12"
                                               Foreground="{StaticResource BrushTextSecondary}"/>
                                </StackPanel>

                                <ToggleSwitch Grid.Column="2"
                                              x:Name="ThemeToggleSwitch"
                                              IsOn="{x:Bind IsDarkThemeEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              OnContent="Dark"
                                              OffContent="Light"
                                              HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Notification Setting -->
                            <Grid Style="{StaticResource SettingItemStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0"
                                          Glyph="&#xE7F4;"
                                          FontSize="20"
                                          Foreground="{StaticResource BrushTextSecondary}"
                                          VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1"
                                            Margin="16,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Notifications"
                                               FontSize="16"
                                               Foreground="{StaticResource BrushText}"/>
                                    <TextBlock Text="Receive alerts about order updates and critical events."
                                               FontSize="14"
                                               Foreground="{StaticResource BrushTextSecondary}"/>
                                </StackPanel>

                                <ToggleSwitch Grid.Column="2"
                                              x:Name="NotificationsToggleSwitch"
                                              IsOn="{x:Bind AreNotificationsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              OnContent="On"
                                              OffContent="Off"
                                              HorizontalAlignment="Right"/>
                            </Grid>

                        </StackPanel>
                    </Border>

                    <!-- System Settings (Placeholder for future additions) -->
                    <TextBlock x:Uid="SystemSection" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource SettingCardStyle}">
                        <StackPanel Spacing="16">
                            <!-- About -->
                            <Grid Style="{StaticResource SettingItemStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <FontIcon Grid.Column="0" 
                                          Glyph="&#xE946;" 
                                          FontSize="20" 
                                          Foreground="{StaticResource BrushTextSecondary}"
                                          VerticalAlignment="Center"/>
                                
                                <StackPanel Grid.Column="1" 
                                            Margin="16,0,0,0" 
                                            VerticalAlignment="Center">
                                    <TextBlock x:Uid="About"
                                               FontSize="16" 
                                               Foreground="{StaticResource BrushText}"/>
                                    <TextBlock x:Uid="AboutAppDescription"
                                               FontSize="14" 
                                               Foreground="{StaticResource BrushTextSecondary}"/>
                                </StackPanel>
                                
                                <Button Grid.Column="2" 
                                        x:Uid="View"
                                        Style="{StaticResource SettingButtonStyle}"
                                        Width="80"
                                        x:Name="AboutButton"
                                        Click="AboutButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Account Actions -->
                    <TextBlock x:Uid="AccountActionsSection" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource SettingCardStyle}">
                        <Grid Style="{StaticResource SettingItemStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <FontIcon Grid.Column="0" 
                                      Glyph="&#xE7E8;" 
                                      FontSize="20" 
                                      Foreground="{StaticResource BrushError}"
                                      VerticalAlignment="Center"/>
                            
                            <StackPanel Grid.Column="1" 
                                        Margin="16,0,0,0" 
                                        VerticalAlignment="Center">
                                <TextBlock x:Uid="SignOut"
                                           FontSize="16" 
                                           Foreground="{StaticResource BrushText}"/>
                                <TextBlock x:Uid="SignOutDescription"
                                           FontSize="14" 
                                           Foreground="{StaticResource BrushTextSecondary}"/>
                            </StackPanel>
                            
                            <Button Grid.Column="2" 
                                    x:Uid="SignOutButton"
                                    Style="{StaticResource LogoutButtonStyle}"
                                    Width="100"
                                    x:Name="LogoutButton"
                                    Click="LogoutButton_Click"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>