<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PhoneStoreAdmin.View.SalesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhoneStoreAdmin.View"
    xmlns:sys="using:System"
    xmlns:globalization="using:System.Globalization"
    x:DataType="local:SalesPage"
    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">

    <Page.Resources>
        <!-- Alias tokens theo Fluent Design -->
        <SolidColorBrush x:Key="App/Fill/Surface" Color="{ThemeResource SolidBackgroundFillColorBase}"/>
        <SolidColorBrush x:Key="App/Fill/Card" Color="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <SolidColorBrush x:Key="App/Text/Primary" Color="{ThemeResource TextFillColorPrimary}"/>
        <SolidColorBrush x:Key="App/Text/Secondary" Color="{ThemeResource TextFillColorSecondary}"/>
        <SolidColorBrush x:Key="App/Stroke/Card" Color="{ThemeResource CardStrokeColorDefault}"/>
        <SolidColorBrush x:Key="App/Accent/Fill" Color="{ThemeResource AccentFillColorDefault}"/>
        
        <!-- Style cho product card -->
        <Style x:Key="ProductCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Style cho invoice panel -->
        <Style x:Key="InvoicePanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- Shadow cho elevation -->
        <ThemeShadow x:Key="DefaultShadow"/>
    </Page.Resources>

    <Grid Padding="24" RowDefinitions="Auto,*">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,24">
            <TextBlock 
                Text="Bán Hàng" 
                Style="{ThemeResource TitleTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock 
                Text="Chọn sản phẩm và tạo hóa đơn bán hàng"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnDefinitions="2*,20,1.2*">
            
            <!-- Left Panel - Danh sách sản phẩm -->
            <Border Grid.Column="0" Style="{StaticResource InvoicePanelStyle}">
                <Border.Shadow>
                    <ThemeShadow/>
                </Border.Shadow>
                
                <Grid RowDefinitions="Auto,Auto,*">
                    <!-- Search Header -->
                    <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,16">
                        <TextBlock 
                            Text="Danh Sách Sản Phẩm"
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        
                        <!-- Search Box -->
                        <TextBox 
                            x:Name="SearchTextBox"
                            PlaceholderText="Tìm kiếm sản phẩm..."
                            TextChanged="{x:Bind OnSearchTextChanged}">
                            <TextBox.Resources>
                                <ResourceDictionary>
                                    <SolidColorBrush x:Key="TextControlBackground" Color="{ThemeResource SubtleFillColorSecondary}"/>
                                </ResourceDictionary>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>

                    <!-- Filter -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
                        <ComboBox 
                            x:Name="CategoryComboBox"
                            Header="Danh mục"
                            PlaceholderText="Tất cả danh mục"
                            MinWidth="150"
                            SelectionChanged="{x:Bind OnCategorySelectionChanged}"/>
                        <ComboBox 
                            x:Name="BrandComboBox"
                            Header="Thương hiệu"
                            PlaceholderText="Tất cả thương hiệu"
                            MinWidth="150"
                            SelectionChanged="{x:Bind OnBrandSelectionChanged}"/>
                    </StackPanel>

                    <!-- Products ListView -->
                    <ListView 
                        Grid.Row="2"
                        x:Name="ProductsListView"
                        ItemsSource="{x:Bind FilteredProducts}"
                        SelectionMode="None"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                        
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:SalesItem">
                                <Border Style="{StaticResource ProductCardStyle}">
                                    <Grid ColumnDefinitions="60,*,Auto">
                                        <!-- Product Image Placeholder -->
                                        <Border 
                                            Grid.Column="0"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="4"
                                            Width="50" Height="50"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                            <FontIcon 
                                                Glyph="&#xE8B9;" 
                                                FontSize="20"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Border>

                                        <!-- Product Info -->
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock 
                                                Text="{x:Bind ProductName}" 
                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                TextTrimming="CharacterEllipsis"/>
                                            <TextBlock 
                                                Text="{x:Bind BrandName}" 
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock 
                                                Text="{x:Bind FormatPrice(Price)}" 
                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        </StackPanel>

                                        <!-- Add Button -->
                                        <Button 
                                            Grid.Column="2"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            VerticalAlignment="Center"
                                            MinWidth="80"
                                            Click="{x:Bind AddToInvoice}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE710;" FontSize="14"/>
                                                <TextBlock Text="Thêm"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Right Panel - Thông tin hóa đơn -->
            <Border Grid.Column="2" Style="{StaticResource InvoicePanelStyle}">
                <Border.Shadow>
                    <ThemeShadow/>
                </Border.Shadow>
                
                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
                    <!-- Invoice Header -->
                    <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,20">
                        <TextBlock 
                            Text="Hóa Đơn Bán Hàng"
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock 
                            x:Name="InvoiceNumberText"
                            Text="{x:Bind sys:String.Format(x:Null, 'Số HĐ: {0}', InvoiceNumber)}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Customer Info -->
                    <StackPanel Grid.Row="1" Spacing="12" Margin="0,0,0,16">
                        <TextBlock 
                            Text="Thông tin khách hàng"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                        <TextBox 
                            x:Name="CustomerNameTextBox"
                            Header="Tên khách hàng"
                            Text="{x:Bind CustomerName, Mode=TwoWay}"
                            PlaceholderText="Nhập tên khách hàng"/>
                        <TextBox 
                            x:Name="CustomerPhoneTextBox"
                            Header="Số điện thoại"
                            Text="{x:Bind CustomerPhone, Mode=TwoWay}"
                            PlaceholderText="Nhập số điện thoại"/>
                    </StackPanel>

                    <!-- Invoice Items -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="InvoiceItemsPanel" Spacing="8">
                            <TextBlock 
                                Text="Sản phẩm đã chọn"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Margin="0,0,0,8"/>
                            
                            <ListView 
                                x:Name="InvoiceItemsListView"
                                ItemsSource="{x:Bind InvoiceItems}"
                                SelectionMode="None">
                                
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:InvoiceLineItem">
                                        <Border 
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="6"
                                            Padding="8"
                                            Margin="0,0,0,4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock 
                                                        Text="{x:Bind ProductName}" 
                                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                                        TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock 
                                                            Text="{x:Bind sys:String.Format(x:Null, 'SL: {0}', Quantity)}" 
                                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock 
                                                            Text="{x:Bind FormatPrice(UnitPrice)}" 
                                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button 
                                                    Grid.Column="1"
                                                    Style="{ThemeResource SubtleButtonStyle}"
                                                    Width="24" Height="24"
                                                    Padding="0"
                                                    Click="{x:Bind RemoveFromInvoice}"
                                                    ToolTipService.ToolTip="Xóa sản phẩm">
                                                    <FontIcon Glyph="&#xE738;" FontSize="12"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Invoice Summary -->
                    <Border 
                        Grid.Row="3"
                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,16,0,16">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock 
                                    Grid.Column="0"
                                    Text="Tạm tính:"
                                    Style="{ThemeResource BodyTextBlockStyle}"/>
                                <TextBlock 
                                    Grid.Column="1"
                                    x:Name="SubtotalText"
                                    Text="{x:Bind FormatPrice(Subtotal)}"
                                    Style="{ThemeResource BodyTextBlockStyle}"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock 
                                    Grid.Column="0"
                                    Text="VAT (10%):"
                                    Style="{ThemeResource BodyTextBlockStyle}"/>
                                <TextBlock 
                                    Grid.Column="1"
                                    x:Name="VatText"
                                    Text="{x:Bind FormatPrice(VatAmount)}"
                                    Style="{ThemeResource BodyTextBlockStyle}"/>
                            </Grid>
                            <Rectangle 
                                Height="1" 
                                Fill="{ThemeResource DividerStrokeColorDefaultBrush}" 
                                Margin="0,4"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock 
                                    Grid.Column="0"
                                    Text="Tổng cộng:"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                <TextBlock 
                                    Grid.Column="1"
                                    x:Name="TotalText"
                                    Text="{x:Bind FormatPrice(Total)}"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="4" Spacing="8">
                        <Button 
                            x:Name="ProcessSaleButton"
                            Style="{ThemeResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Click="{x:Bind OnProcessSale}"
                            IsEnabled="{x:Bind HasInvoiceItems}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8A7;" FontSize="16"/>
                                <TextBlock Text="Thanh Toán"/>
                            </StackPanel>
                        </Button>
                        
                        <Button 
                            x:Name="ClearInvoiceButton"
                            Style="{ThemeResource DefaultButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Click="{x:Bind OnClearInvoice}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE711;" FontSize="16"/>
                                <TextBlock Text="Tạo Hóa Đơn Mới"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>