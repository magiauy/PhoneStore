<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PhoneStoreAdmin.View.SalesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:globalization="using:System.Globalization"
    xmlns:local="using:PhoneStoreAdmin.View"
    xmlns:sys="using:System"
    x:DataType="local:SalesPage"
    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">

    <Page.Resources>
        <!--  Alias tokens theo Fluent Design  -->
        <SolidColorBrush x:Key="App/Fill/Surface" Color="{ThemeResource SolidBackgroundFillColorBase}" />
        <SolidColorBrush x:Key="App/Fill/Card" Color="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <SolidColorBrush x:Key="App/Text/Primary" Color="{ThemeResource TextFillColorPrimary}" />
        <SolidColorBrush x:Key="App/Text/Secondary" Color="{ThemeResource TextFillColorSecondary}" />
        <SolidColorBrush x:Key="App/Stroke/Card" Color="{ThemeResource CardStrokeColorDefault}" />
        <SolidColorBrush x:Key="App/Accent/Fill" Color="{ThemeResource AccentFillColorDefault}" />

        <!--  Style cho product card  -->
        <Style x:Key="ProductCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!--  Style cho invoice panel  -->
        <Style x:Key="InvoicePanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <!--  Shadow cho elevation  -->
        <ThemeShadow x:Key="DefaultShadow" />
    </Page.Resources>

    <Grid Padding="24" RowDefinitions="Auto,*">
        <!--  Header  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,24"
            Spacing="8">
            <TextBlock
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="Bán Hàng" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="Chọn sản phẩm và tạo hóa đơn bán hàng" />
        </StackPanel>

        <!--  Main Content  -->
        <Grid Grid.Row="1" ColumnDefinitions="2*,20,1.2*">

            <!--  Left Panel - Danh sách sản phẩm  -->
            <Border Grid.Column="0" Style="{StaticResource InvoicePanelStyle}">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>

                <Grid RowDefinitions="Auto,Auto,*">
                    <!--  Search Header  -->
                    <StackPanel
                        Grid.Row="0"
                        Margin="0,0,0,16"
                        Spacing="12">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="Danh Sách Sản Phẩm" />

                        <!--  Search Box  -->
                        <TextBox
                            x:Name="SearchTextBox"
                            PlaceholderText="Tìm kiếm sản phẩm..."
                            TextChanged="{x:Bind OnSearchTextChanged}">
                            <TextBox.Resources>
                                <ResourceDictionary>
                                    <SolidColorBrush x:Key="TextControlBackground" Color="{ThemeResource SubtleFillColorSecondary}" />
                                </ResourceDictionary>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>

                    <!--  Filter  -->
                    <StackPanel
                        Grid.Row="1"
                        Margin="0,0,0,16"
                        Orientation="Horizontal"
                        Spacing="12">
                        <ComboBox
                            x:Name="CategoryComboBox"
                            MinWidth="150"
                            Header="Danh mục"
                            PlaceholderText="Tất cả danh mục"
                            SelectionChanged="{x:Bind OnCategorySelectionChanged}" />
                        <ComboBox
                            x:Name="BrandComboBox"
                            MinWidth="150"
                            Header="Thương hiệu"
                            PlaceholderText="Tất cả thương hiệu"
                            SelectionChanged="{x:Bind OnBrandSelectionChanged}" />
                    </StackPanel>

                    <!--  Products ListView  -->
                    <ListView
                        x:Name="ProductsListView"
                        Grid.Row="2"
                        ItemsSource="{x:Bind FilteredProducts}"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectionMode="None">

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:SalesItem">
                                <Border Style="{StaticResource ProductCardStyle}">
                                    <Grid ColumnDefinitions="60,*,Auto">
                                        <!--  Product Image Placeholder  -->
                                        <Border
                                            Grid.Column="0"
                                            Width="50"
                                            Height="50"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="4">
                                            <FontIcon
                                                FontSize="20"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="&#xE8B9;" />
                                        </Border>

                                        <!--  Product Info  -->
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind ProductName}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Text="{x:Bind BrandName}" />
                                            <TextBlock
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind FormatPrice(Price)}" />
                                        </StackPanel>

                                        <!--  Add Button  -->
                                        <Button
                                            Grid.Column="2"
                                            MinWidth="80"
                                            VerticalAlignment="Center"
                                            Click="{x:Bind AddToInvoice}"
                                            Style="{ThemeResource AccentButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon FontSize="14" Glyph="&#xE710;" />
                                                <TextBlock Text="Thêm" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!--  Right Panel - Thông tin hóa đơn  -->
            <Border Grid.Column="2" Style="{StaticResource InvoicePanelStyle}">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>

                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
                    <!--  Invoice Header  -->
                    <StackPanel
                        Grid.Row="0"
                        Margin="0,0,0,20"
                        Spacing="8">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="Hóa Đơn Bán Hàng" />
                        <TextBlock
                            x:Name="InvoiceNumberText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind sys:String.Format(x:Null, 'Số HĐ: {0}', InvoiceNumber)}" />
                    </StackPanel>

                    <!--  Customer Info  -->
                    <StackPanel
                        Grid.Row="1"
                        Margin="0,0,0,16"
                        Spacing="12">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Thông tin khách hàng" />
                        <TextBox
                            x:Name="CustomerNameTextBox"
                            Header="Tên khách hàng"
                            PlaceholderText="Nhập tên khách hàng"
                            Text="{x:Bind CustomerName, Mode=TwoWay}" />
                        <TextBox
                            x:Name="CustomerPhoneTextBox"
                            Header="Số điện thoại"
                            PlaceholderText="Nhập số điện thoại"
                            Text="{x:Bind CustomerPhone, Mode=TwoWay}" />
                    </StackPanel>

                    <!--  Invoice Items  -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="InvoiceItemsPanel" Spacing="8">
                            <TextBlock
                                Margin="0,0,0,8"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="Sản phẩm đã chọn" />

                            <ListView
                                x:Name="InvoiceItemsListView"
                                ItemsSource="{x:Bind InvoiceItems}"
                                SelectionMode="None">

                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:InvoiceLineItem">
                                        <Border
                                            Margin="0,0,0,4"
                                            Padding="8"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock
                                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind ProductName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind sys:String.Format(x:Null, 'SL: {0}', Quantity)}" />
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind FormatPrice(UnitPrice)}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="1"
                                                    Width="24"
                                                    Height="24"
                                                    Padding="0"
                                                    Click="{x:Bind RemoveFromInvoice}"
                                                    Style="{ThemeResource SubtleButtonStyle}"
                                                    ToolTipService.ToolTip="Xóa sản phẩm">
                                                    <FontIcon FontSize="12" Glyph="&#xE738;" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </ScrollViewer>

                    <!--  Invoice Summary  -->
                    <Border
                        Grid.Row="3"
                        Margin="0,16,0,16"
                        Padding="12"
                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                        CornerRadius="8">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Grid.Column="0"
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="Tạm tính:" />
                                <TextBlock
                                    x:Name="SubtotalText"
                                    Grid.Column="1"
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind FormatPrice(Subtotal)}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Grid.Column="0"
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="VAT (10%):" />
                                <TextBlock
                                    x:Name="VatText"
                                    Grid.Column="1"
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind FormatPrice(VatAmount)}" />
                            </Grid>
                            <Rectangle
                                Height="1"
                                Margin="0,4"
                                Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Grid.Column="0"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Text="Tổng cộng:" />
                                <TextBlock
                                    x:Name="TotalText"
                                    Grid.Column="1"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind FormatPrice(Total)}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  Action Buttons  -->
                    <StackPanel Grid.Row="4" Spacing="8">
                        <Button
                            x:Name="ProcessSaleButton"
                            HorizontalAlignment="Stretch"
                            Click="{x:Bind OnProcessSale}"
                            IsEnabled="{x:Bind HasInvoiceItems}"
                            Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE8A7;" />
                                <TextBlock Text="Thanh Toán" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="ClearInvoiceButton"
                            HorizontalAlignment="Stretch"
                            Click="{x:Bind OnClearInvoice}"
                            Style="{ThemeResource DefaultButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE711;" />
                                <TextBlock Text="Tạo Hóa Đơn Mới" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>