<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PhoneStoreAdmin.View.SalesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:globalization="using:System.Globalization"
    xmlns:local="using:PhoneStoreAdmin.View"
    xmlns:sys="using:System"
    xmlns:converters="using:PhoneStoreAdmin.View.Converters"
    Background="{StaticResource BrushBackground}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Theme/Colors.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Shadow Styles  -->
            <ThemeShadow x:Name="SharedShadow" />

            <!--  Card Style  -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Opacity="0.95" Color="{StaticResource ColorSurface}" />
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>

            <converters:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <SolidColorBrush x:Key="SerialFieldBackgroundBrush" Color="#FFFDF4D1" />

            <Style x:Key="ProductItemContainerStyle" TargetType="ListViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="0" RowDefinitions="Auto,*">

        <!--  Modern Gradient Background  -->
        <Grid Grid.RowSpan="2">
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="{StaticResource ColorBackground}" />
                        <GradientStop Offset="0.5" Color="#FFF0F2FF" />
                        <GradientStop Offset="1" Color="#FFE8ECFF" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!--  Decorative Elements  -->
            <Grid>
                <Ellipse
                    Width="400"
                    Height="400"
                    Margin="-200,-100,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Opacity="0.1">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="{StaticResource ColorPrimary}" />
                            <GradientStop Offset="1" Color="{StaticResource ColorPrimaryLight}" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse
                    Width="300"
                    Height="300"
                    Margin="0,0,-150,-150"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Opacity="0.1">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="{StaticResource ColorAccent}" />
                            <GradientStop Offset="1" Color="Transparent" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
        </Grid>

        <!--  Header Section  -->
        <Border
            Grid.Row="0"
            Margin="32,32,32,24"
            Shadow="{StaticResource SharedShadow}"
            Style="{StaticResource CardStyle}">
            <Grid Padding="32,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    Orientation="Vertical"
                    Spacing="8">
                    <TextBlock
                        x:Uid="Sales_HeaderTitle"
                        FontSize="36"
                        FontWeight="Bold">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="{StaticResource ColorPrimary}" />
                                <GradientStop Offset="1" Color="{StaticResource ColorAccent}" />
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock
                        x:Uid="Sales_HeaderSubtitle"
                        FontSize="16"
                        Foreground="{StaticResource BrushTextSecondary}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Main Content Area  -->
        <Grid Grid.Row="1" Margin="32,0,32,32" ColumnDefinitions="2*, 24, 1.2*">

            <Grid Grid.Column="0" RowDefinitions="Auto, *">

                <Grid Grid.Row="0" Margin="0,0,0,16" ColumnDefinitions="*, Auto, Auto, Auto" ColumnSpacing="12">
                    
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Tìm kiếm" Style="{ThemeResource CaptionTextBlockStyle}"/>
                        <Grid>
                            <TextBox
                                x:Name="SearchTextBox"
                                PlaceholderText="Tìm tên sản phẩm..."
                                Padding="36,10,10,10"
                                TextChanged="{x:Bind OnSearchTextChanged}" />
                            <FontIcon 
                                Glyph="&#xE721;" 
                                FontSize="12" 
                                HorizontalAlignment="Left" 
                                Margin="12,0,0,0"
                                IsHitTestVisible="False"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </StackPanel>

                    <ComboBox
                        x:Name="CategoryComboBox"
                        Grid.Column="1"
                        MinWidth="140"
                        Header="Danh mục"
                        ItemsSource="{x:Bind Categories, Mode=OneWay}"
                        PlaceholderText="Tất cả"
                        SelectionChanged="{x:Bind OnCategorySelectionChanged}" />

                    <ComboBox
                        x:Name="BrandComboBox"
                        Grid.Column="2"
                        MinWidth="140"
                        Header="Thương hiệu"
                        ItemsSource="{x:Bind Brands, Mode=OneWay}"
                        PlaceholderText="Tất cả"
                        SelectionChanged="{x:Bind OnBrandSelectionChanged}" />

                    <Button
                        x:Name="RefreshFilterButton"
                        Grid.Column="3"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,1"
                        Click="{x:Bind OnRefreshFilters}"
                        ToolTipService.ToolTip="Làm mới bộ lọc">
                        <FontIcon Glyph="&#xE72C;" />
                    </Button>
                </Grid>

                <Border
                    Grid.Row="1"
                    Background="{ThemeResource LayerFillColorAltBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">

                    <ListView
                        x:Name="ProductsListView"
                        Padding="16"
                        ItemContainerStyle="{StaticResource ProductItemContainerStyle}"
                        ItemsSource="{x:Bind FilteredProducts}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:SalesItem">
                                <Grid
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{x:Bind StockBorderBrush, Mode=OneWay}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        Width="48"
                                        Height="48"
                                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                        CornerRadius="4">
                                        <FontIcon
                                            FontSize="20"
                                            Foreground="{ThemeResource BrushPrimary}"
                                            Glyph="&#xE8B9;" />
                                    </Border>

                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="16,0,0,0"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                        <TextBlock
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind ProductName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border
                                                Padding="6,2"
                                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                                CornerRadius="4">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind BrandName}" />
                                            </Border>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind FormatStock(StockQuantity)}" />
                                        </StackPanel>
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            FontSize="12"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Text="{x:Bind StockErrorMessage}"
                                            Visibility="{x:Bind StockErrorVisibility}" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="16">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource BrushPrimary}"
                                            Style="{ThemeResource SubtitleTextBlockStyle}"
                                            Text="{x:Bind FormatPrice(Price)}" />
                                        <Button
                                            Click="{x:Bind AddToInvoice}"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            Background="{ThemeResource BrushPrimary}"
                                            ToolTipService.ToolTip="Thêm vào hóa đơn">
                                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>

            <Grid Grid.Column="2" RowDefinitions="Auto, *">
                <Grid Grid.RowSpan="2" CornerRadius="12" Translation="0,0,16">
                    <Grid.Shadow>
                        <ThemeShadow />
                    </Grid.Shadow>
                </Grid>

                <Grid
                    Grid.RowSpan="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">

                    <Grid Padding="20" RowDefinitions="Auto, *, Auto">

                       <StackPanel Grid.Row="0" Spacing="16">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Hóa đơn" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <TextBlock
                                        Text="{x:Bind sys:String.Format(x:Null, '#{0}', InvoiceNumber)}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                
                                <Button
                                    Grid.Column="1"
                                    x:Name="ClearInvoiceButton"
                                    VerticalAlignment="Top"
                                    Click="{x:Bind OnClearInvoice}"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="Xóa làm mới">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                </Button>
                            </Grid>

                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                           <StackPanel Spacing="12">
    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
        <TextBox
            x:Name="CustomerPhoneTextBox"
            Grid.Column="0"
            Header="Số điện thoại"
            InputScope="Number"
            PlaceholderText="Nhập SĐT khách hàng..."
            Text="{x:Bind CustomerPhone, Mode=TwoWay}"
            TextChanged="{x:Bind OnCheckPhoneNumberChanged}" />

        <Button
            Grid.Column="1"
            VerticalAlignment="Bottom"
            Click="{x:Bind OnCheckPhoneNumberClick}"
            Style="{ThemeResource AccentButtonStyle}"
            Background="{ThemeResource BrushPrimary}"
            ToolTipService.ToolTip="Kiểm tra khách hàng">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon FontSize="14" Glyph="&#xE721;" /> <TextBlock Text="Kiểm tra"/>
            </StackPanel>
        </Button>
    </Grid>

    <StackPanel Spacing="4">
        
        <Border
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="12"
            Visibility="{x:Bind ExistingCustomerNameVisibility, Mode=OneWay}">
            <Grid ColumnDefinitions="Auto, *">
                <FontIcon
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                    Glyph="&#xE930;" /> <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="Đã tìm thấy khách hàng thành viên" />
                    <TextBlock
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ExistingCustomerName, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBox
            x:Name="CustomerNameTextBox"
            Header="Tên khách hàng"
            PlaceholderText="Nhập tên khách hàng mới"
            Text="{x:Bind CustomerName, Mode=TwoWay}"
            Visibility="{x:Bind ManualCustomerNameVisibility, Mode=OneWay}" />
    </StackPanel>
</StackPanel>
                            
                            <TextBlock Text="Sản phẩm" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,8,0,0"/>
                        </StackPanel>

                        <ListView
    x:Name="InvoiceItemsListView"
    Grid.Row="1"
    Margin="0,12,0,12"
    ItemsSource="{x:Bind InvoiceItems}"
    SelectionMode="None">
    <ListView.ItemTemplate>
        <DataTemplate x:DataType="local:InvoiceLineItem">
            <StackPanel Margin="0,0,0,8" Spacing="4">
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ProductName}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind FormatPrice(UnitPrice)}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">

                        <Button
                            Width="32"
                            Height="32"
                            Padding="0"
                            Click="{x:Bind DecreaseQuantity}"
                            CornerRadius="16"
                            IsEnabled="{x:Bind CanDecrease, Mode=OneWay}"
                            Style="{ThemeResource SubtleButtonStyle}">
                            <FontIcon FontSize="12" Glyph="&#xE738;" />
                        </Button>

                        <Border
                            MinWidth="24"
                            Padding="4,0"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            CornerRadius="4">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="{x:Bind Quantity, Mode=OneWay}" />
                        </Border>

                        <Button
                            Width="32"
                            Height="32"
                            Padding="0"
                            Click="{x:Bind IncreaseQuantity}"
                            CornerRadius="16"
                            IsEnabled="{x:Bind CanIncrease, Mode=OneWay}"
                            Style="{ThemeResource SubtleButtonStyle}">
                            <FontIcon FontSize="12" Glyph="&#xE710;" />
                        </Button>
                    </StackPanel>

                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind FormatPrice(TotalPrice), Mode=OneWay}" />

                    <Button
                        Grid.Column="3"
                        Margin="8,0,0,0"
                        Padding="6"
                        Click="{x:Bind RemoveFromInvoice}"
                        Style="{ThemeResource SubtleButtonStyle}">
                        <FontIcon Glyph="&#xE711;" FontSize="10" />
                    </Button>
                </Grid>

                <Border
                    Visibility="{x:Bind IsSerialTracked, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{StaticResource SerialFieldBackgroundBrush}"
                    BorderBrush="{x:Bind SerialContainerBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,6,0,0">
                    <StackPanel Spacing="6">
                        <TextBlock
                            Text="SERIAL / IMEI"
                            FontWeight="SemiBold"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ItemsControl ItemsSource="{x:Bind SerialEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:SerialEntryViewModel">
                                    <StackPanel Margin="0,4,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                PlaceholderText="{x:Bind PlaceholderText}"
                                                Text="{x:Bind SerialInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                BorderBrush="{x:Bind BorderBrush, Mode=OneWay}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                LostFocus="{x:Bind OnLostFocus}"
                                                Padding="10,8,30,8"/>
                                            <FontIcon
                                                Grid.Column="1"
                                                Glyph="{x:Bind StatusIcon, Mode=OneWay}"
                                                Foreground="{x:Bind StatusColor, Mode=OneWay}"
                                                FontSize="12"
                                                Margin="0,0,10,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                IsHitTestVisible="False"
                                                Visibility="{x:Bind IconVisibility, Mode=OneWay}" />
                                        </Grid>

                                        <TextBlock
                                            Text="{x:Bind Message, Mode=OneWay}"
                                            Foreground="{StaticResource SystemFillColorCriticalBrush}"
                                            Visibility="{x:Bind MessageVisibility, Mode=OneWay}"
                                            FontSize="11"
                                            Margin="2,2,0,0"
                                            TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

    </ListView.ItemTemplate>
</ListView>

                        <StackPanel Grid.Row="2" Spacing="16">
                            <Border
                                Background="{ThemeResource LayerFillColorAltBrush}"
                                CornerRadius="8"
                                Padding="16">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <TextBlock Text="Tạm tính" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind FormatPrice(Subtotal), Mode=OneWay}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="VAT (10%)" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind FormatPrice(VatAmount), Mode=OneWay}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{ThemeResource SurfaceStrokeColorDefaultBrush}" Margin="0,4"/>
                                    <Grid>
                                        <TextBlock Text="TỔNG CỘNG" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                                        <TextBlock
                                            Text="{x:Bind FormatPrice(Total), Mode=OneWay}"
                                            Style="{ThemeResource TitleTextBlockStyle}"
                                            Foreground="{ThemeResource BrushPrimary}"
                                            HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Button
                                x:Name="ProcessSaleButton"
                                HorizontalAlignment="Stretch"
                                Click="{x:Bind OnProcessSale}"
                                IsEnabled="{x:Bind HasInvoiceItems, Mode=OneWay}"
                                Style="{ThemeResource AccentButtonStyle}"
                                Height="44">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8A7;" />
                                    <TextBlock Text="THANH TOÁN NGAY" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
