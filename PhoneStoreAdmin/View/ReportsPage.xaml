<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PhoneStoreAdmin.View.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PhoneStoreAdmin.View.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PhoneStoreAdmin.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{StaticResource BrushBackground}"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Theme/Colors.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Shadow Styles  -->
            <ThemeShadow x:Name="SharedShadow" />

            <!--  Card Style  -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Opacity="0.95" Color="{StaticResource ColorSurface}" />
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>

            <!--  Stat Card Style  -->
            <Style x:Key="StatCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BrushSurface}" />
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <!--  Primary Button Style  -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BrushPrimary}" />
                <Setter Property="Foreground" Value="{StaticResource BrushOnPrimary}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="20,14" />
            </Style>

            <!--  Secondary Button Style  -->
            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="{StaticResource ColorSurface}" />
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontWeight" Value="Medium" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Modern Gradient Background  -->
        <Grid Grid.RowSpan="2">
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="{StaticResource ColorBackground}" />
                        <GradientStop Offset="0.5" Color="#FFF0F2FF" />
                        <GradientStop Offset="1" Color="#FFE8ECFF" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!--  Decorative Elements  -->
            <Grid>
                <Ellipse
                    Width="400"
                    Height="400"
                    Margin="-200,-100,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Opacity="0.1">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="{StaticResource ColorPrimary}" />
                            <GradientStop Offset="1" Color="{StaticResource ColorPrimaryLight}" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Ellipse
                    Width="300"
                    Height="300"
                    Margin="0,0,-150,-150"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Opacity="0.1">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="{StaticResource ColorAccent}" />
                            <GradientStop Offset="1" Color="Transparent" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
        </Grid>

        <!--  Header Section  -->
        <Border
            Grid.Row="0"
            Margin="32,32,32,24"
            Shadow="{StaticResource SharedShadow}"
            Style="{StaticResource CardStyle}">
            <Grid Padding="32,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Orientation="Vertical"
                    Spacing="8">
                    <TextBlock
                        x:Uid="Reports_PageTitle"
                        FontSize="36"
                        FontWeight="Bold">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="{StaticResource ColorPrimary}" />
                                <GradientStop Offset="1" Color="{StaticResource ColorAccent}" />
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock
                        x:Uid="Reports_PageDescription"
                        FontSize="16"
                        Foreground="{StaticResource BrushTextSecondary}" />
                </StackPanel>

                <Button
                    x:Name="RefreshButton"
                    Grid.Column="1"
                    Padding="14,10"
                    Click="RefreshButton_Click"
                    Style="{StaticResource SecondaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE72C;" />
                        <TextBlock x:Uid="Reports_RefreshButton" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!--  Main Content Area with Tabs  -->
        <Border
            Grid.Row="1"
            Margin="32,0,32,32"
            Padding="32,24"
            Shadow="{StaticResource SharedShadow}"
            Style="{StaticResource CardStyle}">

            <Pivot
                x:Name="ReportsPivot"
                Margin="0"
                Background="Transparent">

                <!--  Purchase Orders Statistics Tab  -->
                <PivotItem>
                    <PivotItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE7BF;" />
                            <TextBlock x:Uid="Reports_PurchaseOrdersTab" FontSize="16" />
                        </StackPanel>
                    </PivotItem.Header>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="0,24" Spacing="24">

                            <!--  Filter Section  -->
                            <Border Padding="20" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="16" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!--  Title  -->
                                    <TextBlock
                                        x:Uid="Reports_FilterTitle"
                                        Grid.Row="0"
                                        Grid.ColumnSpan="4"
                                        Margin="0,0,0,0"
                                        FontSize="16"
                                        FontWeight="SemiBold" />

                                    <!--  From Date  -->
                                    <StackPanel
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Margin="0,0,12,0">
                                        <TextBlock x:Uid="Reports_FromDateLabel" Margin="0,0,0,8" />
                                        <CalendarDatePicker
                                            x:Name="FromDatePicker"
                                            HorizontalAlignment="Stretch"
                                            DateChanged="DateFilter_Changed" />
                                    </StackPanel>

                                    <!--  To Date  -->
                                    <StackPanel
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="0,0,12,0">
                                        <TextBlock x:Uid="Reports_ToDateLabel" Margin="0,0,0,8" />
                                        <CalendarDatePicker
                                            x:Name="ToDatePicker"
                                            HorizontalAlignment="Stretch"
                                            DateChanged="DateFilter_Changed" />
                                    </StackPanel>

                                    <!--  Status Filter  -->
                                    <StackPanel
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        Margin="0,0,12,0">
                                        <TextBlock x:Uid="Reports_StatusLabel" Margin="0,0,0,8" />
                                        <ComboBox
                                            x:Name="StatusFilterComboBox"
                                            HorizontalAlignment="Stretch"
                                            SelectionChanged="StatusFilter_Changed">
                                            <ComboBoxItem x:Uid="Reports_AllStatus" Tag="" />
                                            <ComboBoxItem x:Uid="Reports_DraftStatus" Tag="DRAFT" />
                                            <ComboBoxItem x:Uid="Reports_ReceivedStatus" Tag="RECEIVED" />
                                            <ComboBoxItem x:Uid="Reports_CancelledStatus" Tag="CANCELLED" />
                                        </ComboBox>
                                    </StackPanel>

                                    <!--  Apply Button  -->
                                    <Button
                                        x:Name="ApplyFilterButton"
                                        Grid.Row="2"
                                        Grid.Column="3"
                                        Padding="20,10"
                                        VerticalAlignment="Bottom"
                                        Click="ApplyFilter_Click"
                                        Style="{StaticResource PrimaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE71C;" />
                                            <TextBlock x:Uid="Reports_ApplyButton" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!--  Summary Cards  -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  Total Orders Card  -->
                                <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                                    <StackPanel Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Border
                                                Width="48"
                                                Height="48"
                                                Background="{StaticResource BrushPrimaryLight}"
                                                CornerRadius="10">
                                                <FontIcon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="24"
                                                    Foreground="{StaticResource BrushPrimary}"
                                                    Glyph="&#xE7BF;" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock
                                                    x:Uid="Reports_TotalOrdersLabel"
                                                    FontSize="13"
                                                    Foreground="{StaticResource BrushTextSecondary}" />
                                                <TextBlock
                                                    x:Name="TotalOrdersText"
                                                    FontSize="28"
                                                    FontWeight="Bold"
                                                    Foreground="{StaticResource BrushPrimary}"
                                                    Text="0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!--  Total Amount Card  -->
                                <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                                    <StackPanel Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Border
                                                Width="48"
                                                Height="48"
                                                Background="#E8F5E9"
                                                CornerRadius="10">
                                                <FontIcon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="24"
                                                    Foreground="#4CAF50"
                                                    Glyph="&#xE7EF;" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock
                                                    x:Uid="Reports_TotalAmountLabel"
                                                    FontSize="13"
                                                    Foreground="{StaticResource BrushTextSecondary}" />
                                                <TextBlock
                                                    x:Name="TotalAmountText"
                                                    FontSize="28"
                                                    FontWeight="Bold"
                                                    Foreground="#4CAF50"
                                                    Text="0 ₫" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!--  Draft Orders Card  -->
                                <Border Grid.Column="4" Style="{StaticResource StatCardStyle}">
                                    <StackPanel Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Border
                                                Width="48"
                                                Height="48"
                                                Background="#FFF3E0"
                                                CornerRadius="10">
                                                <FontIcon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="24"
                                                    Foreground="#FF9800"
                                                    Glyph="&#xE70F;" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock
                                                    x:Uid="Reports_DraftOrdersLabel"
                                                    FontSize="13"
                                                    Foreground="{StaticResource BrushTextSecondary}" />
                                                <TextBlock
                                                    x:Name="DraftOrdersText"
                                                    FontSize="28"
                                                    FontWeight="Bold"
                                                    Foreground="#FF9800"
                                                    Text="0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!--  Received Orders Card  -->
                                <Border Grid.Column="6" Style="{StaticResource StatCardStyle}">
                                    <StackPanel Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Border
                                                Width="48"
                                                Height="48"
                                                Background="#E3F2FD"
                                                CornerRadius="10">
                                                <FontIcon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="24"
                                                    Foreground="#2196F3"
                                                    Glyph="&#xE73E;" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock
                                                    x:Uid="Reports_ReceivedOrdersLabel"
                                                    FontSize="13"
                                                    Foreground="{StaticResource BrushTextSecondary}" />
                                                <TextBlock
                                                    x:Name="ReceivedOrdersText"
                                                    FontSize="28"
                                                    FontWeight="Bold"
                                                    Foreground="#2196F3"
                                                    Text="0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!--  Charts Section  -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  Monthly Trend Chart  -->
                                <Border
                                    Grid.Column="0"
                                    Padding="24"
                                    Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="16">
                                        <TextBlock
                                            x:Uid="Reports_MonthlyTrendTitle"
                                            FontSize="18"
                                            FontWeight="SemiBold" />

                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                            <Grid
                                                x:Name="MonthlyChartGrid"
                                                Height="300"
                                                MinWidth="600">
                                                <!--  Chart will be drawn here in code-behind  -->
                                            </Grid>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>

                                <!--  Top Suppliers  -->
                                <Border
                                    Grid.Column="2"
                                    Padding="24"
                                    Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="16">
                                        <TextBlock
                                            x:Uid="Reports_TopSuppliersTitle"
                                            FontSize="18"
                                            FontWeight="SemiBold" />

                                        <ListView
                                            x:Name="TopSuppliersListView"
                                            MaxHeight="300"
                                            SelectionMode="None">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="12" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border
                                                            Grid.Column="0"
                                                            Width="32"
                                                            Height="32"
                                                            Background="{StaticResource BrushPrimaryLight}"
                                                            CornerRadius="8">
                                                            <TextBlock
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                FontSize="14"
                                                                FontWeight="Bold"
                                                                Foreground="{StaticResource BrushPrimary}"
                                                                Text="{Binding Rank}" />
                                                        </Border>

                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock
                                                                Padding="0,0,20,0"
                                                                FontSize="14"
                                                                FontWeight="SemiBold"
                                                                Text="{Binding SupplierName}"
                                                                TextTrimming="CharacterEllipsis"
                                                                TextWrapping="NoWrap" />
                                                            <TextBlock FontSize="12" Foreground="{StaticResource BrushTextSecondary}">
                                                                <Run Text="{Binding OrderCount}" />
                                                                <Run x:Uid="Reports_OrdersCount" />
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <TextBlock
                                                            Grid.Column="3"
                                                            VerticalAlignment="Center"
                                                            FontSize="14"
                                                            FontWeight="Bold"
                                                            Foreground="#4CAF50"
                                                            Text="{Binding TotalAmount}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </Border>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>

                <!--  Placeholder for future tabs  -->
                <PivotItem>
                    <PivotItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8EC;" />
                            <TextBlock x:Uid="Reports_SalesTab" FontSize="16" />
                        </StackPanel>
                    </PivotItem.Header>
                    <Grid Padding="32">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="24"
                            Foreground="{StaticResource BrushTextSecondary}"
                            Text="Coming soon..." />
                    </Grid>
                </PivotItem>

            </Pivot>
        </Border>
    </Grid>
</Page>
