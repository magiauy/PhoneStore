<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PhoneStoreAdmin.View.RolesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhoneStoreAdmin.View"
    xmlns:controls="using:PhoneStoreAdmin.View.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BrushBackground}">

    <Page.Resources>
        <!-- Shadow Styles -->
        <ThemeShadow x:Name="SharedShadow" />

        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{StaticResource ColorSurface}" Opacity="0.95"/>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushPrimary}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushOnPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Margin="{TemplateBinding Padding}"
                                    Foreground="{TemplateBinding Foreground}"/>
                            </Border>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{StaticResource BrushPrimaryHover}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{StaticResource BrushPrimaryPressed}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.6"
                                                             Duration="0:0:0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{StaticResource ColorSurface}"/>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Modern Gradient Background -->
        <Grid Grid.RowSpan="2">
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource ColorBackground}" Offset="0"/>
                        <GradientStop Color="#FFF0F2FF" Offset="0.5"/>
                        <GradientStop Color="#FFE8ECFF" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Decorative Elements -->
            <Grid>
                <Ellipse Width="400" Height="400" 
                         HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="-200,-100,0,0"
                         Opacity="0.1">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="{StaticResource ColorPrimary}" Offset="0"/>
                            <GradientStop Color="{StaticResource ColorPrimaryLight}" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Ellipse Width="300" Height="300" 
                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,-150,-150"
                         Opacity="0.1">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="{StaticResource ColorAccent}" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
        </Grid>

        <!-- Header Section -->
        <Border Grid.Row="0" 
                Margin="32,32,32,24"
                Style="{StaticResource CardStyle}"
                Shadow="{StaticResource SharedShadow}">
            <Grid Padding="32,24">
                <StackPanel Orientation="Vertical" Spacing="8">
                    <TextBlock x:Uid="Roles_PageTitle" 
                               FontSize="36"
                               FontWeight="Bold">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{StaticResource ColorPrimary}" Offset="0"/>
                                <GradientStop Color="{StaticResource ColorAccent}" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock x:Uid="Roles_PageDescription" 
                               FontSize="16"
                               Foreground="{StaticResource BrushTextSecondary}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Row="1" 
                Margin="32,0,32,32"
                Style="{StaticResource CardStyle}"
                Shadow="{StaticResource SharedShadow}"
                Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Roles List -->
                <Border Grid.Column="0"
                        Background="{StaticResource BrushBackground}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="0,0,1,0"
                        CornerRadius="12,0,0,12"
                        Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Toolbar Header -->
                        <Border Grid.Row="0"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="0,0,0,1"
                                Padding="24,20"
                                CornerRadius="12,0,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFAFBFF" Offset="0"/>
                                    <GradientStop Color="#FFF5F7FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Title and Buttons -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Uid="Roles_RoleListTitle"
                                               Grid.Column="0"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushText}"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="CreateRoleButton"
                                                x:Uid="Roles_AddRoleButton"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Padding="14,10"
                                                Click="CreateRoleButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE710;" FontSize="14"/>
                                                <TextBlock x:Uid="Roles_AddRoleButtonText"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="RefreshRolesButton"
                                                x:Uid="Roles_RefreshButton"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="10,10"
                                                Click="RefreshRolesButton_Click">
                                            <FontIcon Glyph="&#xE72C;" FontSize="16" Foreground="{StaticResource BrushText}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Search Box -->
                                <AutoSuggestBox x:Name="RoleSearchBox"
                                                x:Uid="Roles_SearchBox"
                                                Grid.Row="2"
                                                QueryIcon="Find"
                                                Background="{StaticResource BrushSurface}"
                                                BorderBrush="{StaticResource BrushBorder}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12,8"
                                                FontSize="14"
                                                VerticalContentAlignment="Center"
                                                TextChanged="RoleSearchBox_TextChanged"/>
                            </Grid>
                        </Border>

                        <!-- Roles ListView -->
                        <ScrollViewer Grid.Row="1" 
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Hidden">
                            <ListView x:Name="RolesListView"
                                      ItemsSource="{x:Bind Roles, Mode=OneWay}"
                                      Background="Transparent"
                                      SelectionMode="Single"
                                      SelectionChanged="RolesListView_SelectionChanged"
                                      Padding="16">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,12"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="4"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <VisualStateManager.VisualStateGroups>
                                                            <VisualStateGroup x:Name="CommonStates">
                                                                <VisualState x:Name="Normal">
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="SelectionIndicator"
                                                                                         Storyboard.TargetProperty="Opacity"
                                                                                         To="0"
                                                                                         Duration="0:0:0.2"/>
                                                                    </Storyboard>
                                                                </VisualState>
                                                                <VisualState x:Name="Selected">
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="SelectionIndicator"
                                                                                         Storyboard.TargetProperty="Opacity"
                                                                                         To="1"
                                                                                         Duration="0:0:0.2"/>
                                                                    </Storyboard>
                                                                </VisualState>
                                                            </VisualStateGroup>
                                                        </VisualStateManager.VisualStateGroups>

                                                        <!-- Selection Indicator -->
                                                        <Rectangle x:Name="SelectionIndicator"
                                                                   Grid.Column="0"
                                                                   Width="4"
                                                                   Fill="{StaticResource BrushPrimary}"
                                                                   VerticalAlignment="Stretch"
                                                                   Opacity="0"
                                                                   RadiusX="2"
                                                                   RadiusY="2"/>

                                                        <!-- Content -->
                                                        <ContentPresenter x:Name="ContentPresenter"
                                                                          Grid.Column="1"
                                                                          Content="{TemplateBinding Content}"
                                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                                         />
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>

                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BrushSurface}"
                                                BorderBrush="{StaticResource BrushBorder}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="20,16">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="8"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="12"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Role Name -->
                                                <TextBlock Grid.Row="0"
                                                           Text="{Binding Name}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrushText}"/>

                                                <!-- Description -->
                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding Description}"
                                                           FontSize="13"
                                                           Foreground="{StaticResource BrushTextSecondary}"
                                                           TextWrapping="Wrap"
                                                           MaxLines="2"/>

                                                <!-- Info Row -->
                                                <Grid Grid.Row="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Permission Count Badge -->
                                                    <Border Grid.Column="0"
                                                            Background="{StaticResource BrushPrimaryLight}"
                                                            CornerRadius="12"
                                                            Padding="10,4">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon Glyph="&#xE72E;"
                                                                      FontSize="12"
                                                                      Foreground="{StaticResource BrushPrimary}"/>
                                                            <TextBlock Text="{Binding PermissionCount}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource BrushPrimary}"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Weight Badge -->
                                                    <Border Grid.Column="2"
                                                            Background="{StaticResource BrushBackground}"
                                                            BorderBrush="{StaticResource BrushBorder}"
                                                            BorderThickness="1"
                                                            CornerRadius="12"
                                                            Padding="10,4">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon Glyph="&#xE7C3;"
                                                                      FontSize="12"
                                                                      Foreground="{StaticResource BrushTextSecondary}"/>
                                                            <TextBlock Text="{Binding Weight}"
                                                                       FontSize="12"
                                                                       FontWeight="Medium"
                                                                       Foreground="{StaticResource BrushTextSecondary}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ScrollViewer>

                        <!-- Empty State for Roles -->
                        <Grid x:Name="EmptyRolesState"
                              Grid.Row="1"
                              Visibility="Collapsed"
                              Padding="32">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="16">
                                <FontIcon Glyph="&#xE716;"
                                          FontSize="64"
                                          Foreground="{StaticResource BrushTextSecondary}"
                                          Opacity="0.5"/>
                                <TextBlock x:Uid="Roles_EmptyStateMessage"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Right Panel: Permissions Panel -->
                <Border Grid.Column="2"
                        Background="{StaticResource BrushBackground}"
                        CornerRadius="0,12,12,0"
                        Padding="0">
                    <Grid>
                        <!-- No Role Selected State -->
                        <StackPanel x:Name="NoRoleSelectedPanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="20"
                                    Padding="40">
                            <Border Width="100" Height="100"
                                    Background="{StaticResource BrushPrimaryLight}"
                                    CornerRadius="50">
                                <FontIcon FontSize="40"
                                          Foreground="{StaticResource BrushPrimary}"
                                          Glyph="&#xE8FB;"/>
                            </Border>
                            <StackPanel HorizontalAlignment="Center" Spacing="8">
                                <TextBlock x:Uid="Roles_NoRoleSelectedTitle"
                                           HorizontalAlignment="Center"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushText}"/>
                                <TextBlock x:Uid="Roles_NoRoleSelectedMessage"
                                           HorizontalAlignment="Center"
                                           FontSize="14"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="350"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Permissions Content (when role selected) -->
                        <Grid x:Name="PermissionsContentPanel"
                              Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Permissions Header -->
                            <Border Grid.Row="0"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="0,0,0,1"
                                    Padding="32,20"
                                    CornerRadius="0,12,0,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFAFBFF" Offset="0"/>
                                        <GradientStop Color="#FFF5F7FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Role Info -->
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock x:Name="SelectedRoleName"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource BrushPrimary}"/>
                                        <TextBlock x:Name="SelectedRoleDescription"
                                                   FontSize="14"
                                                   Foreground="{StaticResource BrushTextSecondary}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="EditRoleButton"
                                                x:Uid="Roles_EditButton"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="12,8"
                                                Click="EditRoleButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                                                <TextBlock x:Uid="Roles_EditButtonText"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="DeleteRoleButton"
                                                x:Uid="Roles_DeleteButton"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="12,8"
                                                Click="DeleteRoleButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="#D32F2F"/>
                                                <TextBlock x:Uid="Roles_DeleteButtonText" Foreground="#D32F2F"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Permissions List -->
                            <ScrollViewer Grid.Row="1" 
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="32,24">
                                <StackPanel x:Name="PermissionsContainer" Spacing="16">
                                    <!-- Permissions will be loaded dynamically by module groups -->
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Save Button Footer -->
                            <Border Grid.Row="2"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="0,1,0,0"
                                    Padding="32,20"
                                    CornerRadius="0,0,12,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFF5F7FF" Offset="0"/>
                                        <GradientStop Color="#FFFAFBFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Info Message -->
                                    <StackPanel Grid.Column="0" 
                                                Orientation="Horizontal" 
                                                Spacing="8"
                                                VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE946;" 
                                                  FontSize="16" 
                                                  Foreground="{StaticResource BrushPrimary}"/>
                                        <TextBlock x:Uid="Roles_SaveChangesInfo"
                                                   FontSize="13"
                                                   Foreground="{StaticResource BrushTextSecondary}"/>
                                    </StackPanel>

                                    <!-- Save Button -->
                                    <Button x:Name="SavePermissionsButton"
                                            x:Uid="Roles_SaveButton"
                                            Grid.Column="1"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="24,12"
                                            Click="SavePermissionsButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE74E;" FontSize="16"/>
                                            <TextBlock x:Uid="Roles_SaveButtonText" FontSize="15"/>
                                        </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Permissions Loading Overlay -->
                    <controls:LoadingOverlay x:Name="PermissionsLoadingOverlay"
                                             Grid.RowSpan="3"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             Canvas.ZIndex="10"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
                <controls:LoadingOverlay x:Name="LoadingOverlay" 
                                         Grid.ColumnSpan="3"/>
            </Grid>
        </Border>
    </Grid>
</Page>
