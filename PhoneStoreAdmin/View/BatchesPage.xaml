<Page
    x:Class="PhoneStoreAdmin.View.BatchesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:PhoneStoreAdmin.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PhoneStoreAdmin.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{StaticResource BrushBackground}"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Theme/Colors.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Shadow Styles  -->
            <ThemeShadow x:Name="SharedShadow" />

            <!--  Card Style  -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Opacity="0.95" Color="{StaticResource ColorSurface}" />
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>

            <!--  Converters  -->
            <converters:DateOnlyConverter x:Key="DateConverter" />
            <converters:CurrencyConverter x:Key="CurrencyConverter" />

            <!--  Style cho CalendarView để giảm font size trong popup lịch  -->
            <Style x:Key="CustomCalendarViewStyle" TargetType="CalendarView">
                <Setter Property="Background" Value="White" />
                <Setter Property="DayItemFontSize" Value="13" />
                <Setter Property="MonthYearItemFontSize" Value="13" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <!--  Primary Button Style  -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BrushPrimary}" />
                <Setter Property="Foreground" Value="{StaticResource BrushOnPrimary}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="20,14" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border
                                    x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                    <ContentPresenter
                                        Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        Foreground="{TemplateBinding Foreground}" />
                                </Border>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource BrushPrimaryHover}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource BrushPrimaryPressed}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="RootBorder"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0.6"
                                                    Duration="0:0:0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!--  Secondary Button Style  -->
            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="{StaticResource ColorSurface}" />
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontWeight" Value="Medium" />
            </Style>
            <!--  Input Style for TextBox  -->
            <Style x:Key="InputStyle" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Height" Value="44" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>
            <!--  Input Style for ComboBox  -->
            <Style x:Key="ComboBoxInputStyle" TargetType="ComboBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Height" Value="44" />
                <Setter Property="MinWidth" Value="160" />
            </Style>
            <!--  Input Style for CalendarDatePicker  -->
            <Style x:Key="CalendarDatePickerInputStyle" TargetType="CalendarDatePicker">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Height" Value="44" />
                <Setter Property="MinWidth" Value="160" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--  Modern Gradient Background  -->
        <Grid Grid.RowSpan="2">
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="{StaticResource ColorBackground}" />
                        <GradientStop Offset="0.5" Color="#FFF0F2FF" />
                        <GradientStop Offset="1" Color="#FFE8ECFF" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!--  Decorative Elements  -->
            <Grid>
                <Ellipse
                    Width="400"
                    Height="400"
                    Margin="-200,-100,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Opacity="0.1">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="{StaticResource ColorPrimary}" />
                            <GradientStop Offset="1" Color="{StaticResource ColorPrimaryLight}" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse
                    Width="300"
                    Height="300"
                    Margin="0,0,-150,-150"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Opacity="0.1">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="{StaticResource ColorAccent}" />
                            <GradientStop Offset="1" Color="Transparent" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
        </Grid>
        <!--  Header Section  -->
        <Border
            Grid.Row="0"
            Margin="32,32,32,24"
            Shadow="{StaticResource SharedShadow}"
            Style="{StaticResource CardStyle}">
            <Grid Padding="32,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    Orientation="Vertical"
                    Spacing="8">
                    <TextBlock
                        x:Uid="HeaderTitleBatch"
                        FontSize="36"
                        FontWeight="Bold">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="{StaticResource ColorPrimary}" />
                                <GradientStop Offset="1" Color="{StaticResource ColorAccent}" />
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock
                        x:Uid="SubHeaderTitleBatch"
                        FontSize="16"
                        Foreground="{StaticResource BrushTextSecondary}" />
                </StackPanel>
                <Button
                    x:Name="AddBatchButton"
                    Grid.Column="1"
                    Padding="20,14"
                    VerticalAlignment="Center"
                    Click="BtnCreate_Click"
                    Shadow="{StaticResource SharedShadow}"
                    Style="{StaticResource PrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontSize="18" Glyph="&#xE710;" />
                        <TextBlock x:Uid="BtnNewBatch" FontSize="15" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
        <!--  Main Content Area  -->
        <Grid Grid.Row="1" Margin="32,0,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--  Search and Filter Bar  -->
            <Border
                Grid.Row="0"
                Margin="0,0,0,24"
                Padding="24,20"
                Shadow="{StaticResource SharedShadow}"
                Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        x:Uid="SearchBatch"
                        Grid.Column="0"
                        Margin="0,0,16,0"
                        Padding="16,10"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        FontSize="15"
                        QueryIcon="Find"
                        TextChanged="SearchBox_TextChanged" />
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="12">
                        <Button
                            x:Name="FilterButton"
                            Padding="16,12"
                            Click="FilterButton_Click"
                            Shadow="{StaticResource SharedShadow}"
                            Style="{StaticResource SecondaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{StaticResource BrushPrimary}"
                                    Glyph="&#xE71C;" />
                                <TextBlock
                                    x:Uid="BtnFilterBatch"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource BrushText}" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="RefreshButton"
                            Padding="14"
                            Click="BtnClearFilter_Click"
                            Shadow="{StaticResource SharedShadow}"
                            Style="{StaticResource SecondaryButtonStyle}">
                            <FontIcon
                                FontSize="16"
                                Foreground="{StaticResource BrushPrimary}"
                                Glyph="&#xE72C;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <!--  Filter Panel  -->
            <Border
                x:Name="FilterPanel"
                Grid.Row="1"
                Margin="0,0,0,24"
                Padding="24,20"
                Shadow="{StaticResource SharedShadow}"
                Style="{StaticResource CardStyle}"
                Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!--  Filter Batch Code  -->
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="4">
                        <TextBlock
                            x:Uid="FilterBatchCode"
                            Margin="0,0,0,4"
                            FontWeight="SemiBold" />
                        <TextBox
                            x:Name="FilterBatchCodeBox"
                            Style="{StaticResource InputStyle}"
                            TextChanged="FilterChange" />
                    </StackPanel>
                    <!--  Filter Note  -->
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="4">
                        <TextBlock
                            x:Uid="FilterNote"
                            Margin="0,0,0,4"
                            FontWeight="SemiBold" />
                        <TextBox
                            x:Name="FilterNoteBox"
                            Style="{StaticResource InputStyle}"
                            TextChanged="FilterChange" />
                    </StackPanel>
                    <!--  Filter Supplier  -->
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="2"
                        Margin="4">
                        <TextBlock
                            x:Uid="FilterSupplierBoxPurchaseOrder"
                            Margin="0,0,0,4"
                            FontWeight="SemiBold" />
                        <ComboBox
                            x:Name="FilterSupplierBoxPurchaseOrder"
                            MinWidth="160"
                            DisplayMemberPath="Name"
                            ItemsSource="{x:Bind Suppliers, Mode=OneWay}"
                            SelectedIndex="0"
                            SelectedValuePath="Id"
                            SelectionChanged="FilterChange"
                            Style="{StaticResource ComboBoxInputStyle}" />
                    </StackPanel>
                    <!--  Filter Created Date From  -->
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="4">
                        <TextBlock
                            x:Uid="FilterCreatedDateFrom"
                            Margin="0,0,0,4"
                            FontWeight="SemiBold" />
                        <CalendarDatePicker
                            x:Name="FilterCreatedDateFromBox"
                            CalendarViewStyle="{StaticResource CustomCalendarViewStyle}"
                            DateChanged="FilterChangeDate"
                            Style="{StaticResource CalendarDatePickerInputStyle}" />
                    </StackPanel>

                    <!--  Filter Created Date To  -->
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="4">
                        <TextBlock
                            x:Uid="FilterCreatedDateTo"
                            Margin="0,0,0,4"
                            FontWeight="SemiBold" />
                        <CalendarDatePicker
                            x:Name="FilterCreatedDateToBox"
                            CalendarViewStyle="{StaticResource CustomCalendarViewStyle}"
                            DateChanged="FilterChangeDate"
                            Style="{StaticResource CalendarDatePickerInputStyle}" />
                    </StackPanel>

                </Grid>
            </Border>
            <!--  Data Table Section  -->
            <Border
                Grid.Row="2"
                Padding="0"
                Shadow="{StaticResource SharedShadow}"
                Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!--  Table Header  -->
                    <Border
                        Grid.Row="0"
                        Padding="32,20"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="12,12,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#FFFAFBFF" />
                                <GradientStop Offset="1" Color="#FFF5F7FF" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" MinWidth="150" />
                                <ColumnDefinition Width="*" MinWidth="80" />
                                <ColumnDefinition Width="*" MinWidth="150" />
                                <ColumnDefinition Width="*" MinWidth="150" />
                                <ColumnDefinition Width="*" MinWidth="150" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Uid="ColIDBatch"
                                Grid.Column="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock
                                x:Uid="ColBatchCode"
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock
                                x:Uid="ColCreatedAt"
                                Grid.Column="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock
                                x:Uid="ColPurchaseOrderId"
                                Grid.Column="3"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock
                                x:Uid="ColSupplierName"
                                Grid.Column="4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock
                                x:Uid="ColNoteBatch"
                                Grid.Column="5"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock
                                x:Uid="ColActionsBatch"
                                Grid.Column="6"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextSecondary}" />
                        </Grid>
                    </Border>
                    <!--  Table Content  -->
                    <ScrollViewer
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Auto">
                        <ListView
                            x:Name="BatchesListView"
                            Background="Transparent"
                            ItemsSource="{x:Bind Batches, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border
                                                    x:Name="ItemBorder"
                                                    Padding="32,20"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{StaticResource BrushBorder}"
                                                    BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Rectangle
                                                            x:Name="HoverBackground"
                                                            Fill="Transparent"
                                                            Opacity="0" />
                                                        <ContentPresenter />
                                                    </Grid>
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualState x:Name="Normal">
                                                                <Storyboard>
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetName="HoverBackground"
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="0"
                                                                        Duration="0:0:0.2" />
                                                                </Storyboard>
                                                            </VisualState>
                                                            <VisualState x:Name="PointerOver">
                                                                <Storyboard>
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetName="HoverBackground"
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="0.03"
                                                                        Duration="0:0:0.2" />
                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Fill">
                                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource BrushPrimary}" />
                                                                    </ObjectAnimationUsingKeyFrames>
                                                                </Storyboard>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" MinWidth="150" />
                                            <ColumnDefinition Width="*" MinWidth="80" />
                                            <ColumnDefinition Width="*" MinWidth="150" />
                                            <ColumnDefinition Width="*" MinWidth="150" />
                                            <ColumnDefinition Width="*" MinWidth="150" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <!--  ID with accent color  -->
                                        <Border
                                            Grid.Column="0"
                                            Width="32"
                                            Height="32"
                                            HorizontalAlignment="Center"
                                            Background="{StaticResource BrushPrimaryLight}"
                                            CornerRadius="8">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource BrushPrimary}"
                                                Text="{Binding Id}" />
                                        </Border>
                                        <!--  Batch Code  -->
                                        <TextBlock
                                            Grid.Column="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Foreground="{StaticResource BrushText}"
                                            Text="{Binding BatchCode}" />
                                        <!--  Created At  -->
                                        <TextBlock
                                            Grid.Column="2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Foreground="{StaticResource BrushText}"
                                            Text="{Binding CreatedAt, Converter={StaticResource DateConverter}}" />
                                        <!--  Purchase Order Id  -->
                                        <TextBlock
                                            Grid.Column="3"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource BrushText}"
                                            Text="{Binding PurchaseOrderId}" />
                                        <!--  Purchase Order Id  -->
                                        <TextBlock
                                            Grid.Column="4"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource BrushText}"
                                            Text="{Binding SupplierName}" />
                                        <!--  Note  -->
                                        <TextBlock
                                            Grid.Column="5"
                                            MaxWidth="200"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Foreground="{StaticResource BrushText}"
                                            Text="{Binding Note}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap">
                                            <ToolTipService.ToolTip>
                                                <ToolTip Content="{Binding Note}" />
                                            </ToolTipService.ToolTip>
                                        </TextBlock>
                                        <!--  Actions Button  -->
                                        <Button
                                            Grid.Column="6"
                                            Width="36"
                                            Height="36"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="BtnActions_Click"
                                            CornerRadius="8"
                                            Tag="{Binding}">
                                            <FontIcon
                                                FontSize="16"
                                                Foreground="{StaticResource BrushTextSecondary}"
                                                Glyph="&#xE712;" />
                                            <ToolTipService.ToolTip>
                                                <ToolTip x:Uid="BtnActionBatch" Placement="Left" />
                                            </ToolTipService.ToolTip>
                                            <FlyoutBase.AttachedFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem
                                                        x:Uid="BtnDetailBatch"
                                                        Click="BtnDetail_Click"
                                                        Tag="{Binding}">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE8A7;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem
                                                        x:Uid="BtnEditBatch"
                                                        Click="BtnEdit_Click"
                                                        Tag="{Binding}">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE104;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem
                                                        x:Uid="BtnDeleteBatch"
                                                        Click="BtnDelete_Click"
                                                        Tag="{Binding}">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE711;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </FlyoutBase.AttachedFlyout>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </ScrollViewer>
                    <!--  Empty State Message  -->
                    <Grid
                        x:Name="EmptyStatePanel"
                        Grid.Row="1"
                        Padding="60"
                        Visibility="Collapsed">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Vertical"
                            Spacing="24">
                            <Border
                                Width="80"
                                Height="80"
                                Background="{StaticResource BrushPrimaryLight}"
                                CornerRadius="40">
                                <FontIcon
                                    FontSize="32"
                                    Foreground="{StaticResource BrushPrimary}"
                                    Glyph="&#xE8A5;" />
                            </Border>
                            <StackPanel HorizontalAlignment="Center" Spacing="8">
                                <TextBlock
                                    x:Uid="EmptyStateTitle"
                                    HorizontalAlignment="Center"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource BrushText}" />
                                <TextBlock
                                    x:Uid="EmptyStateDescription"
                                    HorizontalAlignment="Center"
                                    FontSize="16"
                                    Foreground="{StaticResource BrushTextSecondary}"
                                    TextAlignment="Center"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <!--  Table Footer with Pagination  -->
                    <Border
                        Grid.Row="2"
                        Padding="32,20"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,12,12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#FFF5F7FF" />
                                <GradientStop Offset="1" Color="#FFFAFBFF" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="16">
                                <Border
                                    Padding="16,8"
                                    Background="{StaticResource BrushPrimaryLight}"
                                    CornerRadius="16">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource BrushPrimary}">
                                        <Run x:Uid="ShowIngBatch" />
                                        <Run x:Name="RecordCountText" Text="0" />
                                        <Run x:Uid="Batches" />
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="12">
                                <Button
                                    x:Name="PreviousPageButton"
                                    Width="40"
                                    Height="40"
                                    Padding="0"
                                    Click="BtnLastPage_Click"
                                    IsEnabled="False"
                                    Style="{StaticResource SecondaryButtonStyle}">
                                    <FontIcon FontSize="16" Glyph="&#xE760;" />
                                </Button>
                                <Border
                                    Padding="20,10"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource BrushPrimaryLight}"
                                    CornerRadius="20">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource BrushPrimary}">
                                        <Run x:Uid="PageBatch" />
                                        <Run x:Name="PageInfoText" Text="1 / 1" />
                                    </TextBlock>
                                </Border>
                                <Button
                                    x:Name="NextPageButton"
                                    Width="40"
                                    Height="40"
                                    Padding="0"
                                    Click="BtnNextPage_Click"
                                    IsEnabled="False"
                                    Style="{StaticResource SecondaryButtonStyle}">
                                    <FontIcon FontSize="16" Glyph="&#xE761;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>