<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PhoneStoreAdmin.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhoneStoreAdmin"
    Title="PhoneStore Admin - Login">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded">
        <!-- Gradient background -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource ColorPrimaryLight}" Offset="0"/>
                <GradientStop Color="{StaticResource ColorPrimary}" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Main login card -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="FormPanel">
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" 
                    CornerRadius="16" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="48,40"
                    MinWidth="420"
                    MaxWidth="480">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>

                <StackPanel Spacing="28">
                    <!-- Header -->
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <Image x:Uid="LogoPath"
                               Width="96" 
                               Height="86"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Stretch="Uniform"
                               />
                        <TextBlock x:Uid="AppSubtitle"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Login form -->
                    <StackPanel Spacing="20">
                        <!-- Username -->
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="UsernameLabel"
                                       FontWeight="SemiBold" 
                                       FontSize="14"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBox x:Uid="UsernameTextBox"
                                     x:Name="UsernameTextBox"
                                     Height="44"
                                     CornerRadius="8"
                                     FontSize="14"
                                     Padding="16,12"
                                     BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                                     Background="{ThemeResource ControlFillColorDefaultBrush}"
                                     TextChanged="UsernameTextBox_TextChanged"
                                     KeyDown="UsernameTextBox_KeyDown"
                                     MaxLength="50"/>
                        </StackPanel>

                        <!-- Password -->
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock x:Uid="PasswordLabel"
                                           FontWeight="SemiBold" 
                                           FontSize="14"
                                           HorizontalAlignment="Left"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <HyperlinkButton x:Uid="ForgotPassword"
                                                 FontSize="12"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Top"
                                                 Click="ForgotPassword_Click"
                                                 Padding="0"/>
                            </Grid>
                            <PasswordBox x:Uid="PasswordTextBox"
                                         x:Name="PasswordTextBox"
                                         Height="44"
                                         CornerRadius="8"
                                         FontSize="14"
                                         Padding="16,12"
                                         BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                                         Background="{ThemeResource ControlFillColorDefaultBrush}"
                                         PasswordRevealMode="Peek"
                                            KeyDown="PasswordTextBox_KeyDown"
                                         PasswordChanged="PasswordTextBox_PasswordChanged"
                                         MaxLength="100"/>
                        </StackPanel>
                        <!-- Sign In -->
                        <Button x:Uid="SignIn"
                                x:Name="LoginButton"
                                Height="48"
                                HorizontalAlignment="Stretch"
                                Background="{StaticResource BrushPrimary}"
                                Foreground="{StaticResource BrushOnPrimary}"
                                CornerRadius="8"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Margin="0,8,0,0"
                                Click="LoginButton_Click"
                                PointerPressed="LoginButton_PointerPressed"
                                PointerReleased="LoginButton_PointerReleased">
                            <Button.RenderTransform>
                                <ScaleTransform />
                            </Button.RenderTransform>
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" 
                                            HorizontalAlignment="Center"
                                            Spacing="12">
                                    <ProgressRing x:Name="LoginProgressRing"
                                                  Width="20" 
                                                  Height="20"
                                                  IsActive="False"
                                                  Visibility="Collapsed"
                                                  Foreground="{StaticResource BrushOnPrimary}"/>
                                    <TextBlock x:Name="LoginButtonText"/>
                                </StackPanel>
                            </Button.Content>
                            <!-- <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Enter"/>
                            </Button.KeyboardAccelerators> -->
                        </Button>
                    </StackPanel>

                    <!-- Footer -->
                    <StackPanel Spacing="12" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <TextBlock FontSize="13" 
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run x:Uid="NoAccount"/>
                            <Hyperlink Click="SignUp_Click" 
                                       Foreground="{StaticResource BrushPrimary}">
                                <Run x:Uid="SignUpHere" FontWeight="SemiBold"/>
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock x:Uid="AppCopyright"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
