<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PhoneStoreAdmin.View.PricingDashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhoneStoreAdmin.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{StaticResource BrushSurface}" 
                BorderBrush="{StaticResource BrushBorder}" 
                BorderThickness="0,0,0,1" 
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Định giá động" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource BrushText}"/>
                    <TextBlock Text="Theo dõi biến động giá và quản lý cảnh báo tồn kho" 
                               FontSize="14" 
                               Foreground="{StaticResource BrushTextSecondary}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button x:Name="RefreshButton"
                            Click="RefreshButton_Click"
                            Background="{StaticResource BrushSurface}" 
                            Foreground="{StaticResource BrushText}"
                            BorderBrush="{StaticResource BrushBorder}"
                            CornerRadius="8" 
                            Padding="16,12"
                            ToolTipService.ToolTip="Làm mới dữ liệu">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="16"/>
                            <TextBlock Text="Làm mới"/>
                        </StackPanel>
                    </Button>
                    
                    <Button x:Name="AlertCenterButton"
                            Click="AlertCenterButton_Click"
                            Background="{StaticResource BrushPrimary}" 
                            Foreground="{StaticResource BrushOnPrimary}"
                            CornerRadius="8" 
                            Padding="16,12" 
                            BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7BA;" FontSize="16"/>
                            <TextBlock Text="Trung tâm cảnh báo" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="24" Spacing="24">

                <!-- Summary Cards -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" 
                               Text="Tổng quan" 
                               FontSize="20" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource BrushText}" 
                               Margin="0,0,0,16"/>
                    
                    <Grid Grid.Row="1" ColumnDefinitions="1*,1*,1*,1*" ColumnSpacing="16">
                        <!-- Total Products Card -->
                        <Border Grid.Column="0" 
                                Background="{StaticResource BrushSurface}" 
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="12" 
                                Padding="20">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" 
                                               Text="Tổng sản phẩm" 
                                               FontSize="14" 
                                               Foreground="{StaticResource BrushTextSecondary}"/>
                                    <Border Grid.Column="1" 
                                            Background="{StaticResource BrushPrimary}" 
                                            CornerRadius="16" 
                                            Width="32" 
                                            Height="32">
                                        <FontIcon Glyph="&#xE8F1;" 
                                                  FontSize="16" 
                                                  Foreground="White" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="TotalProductsText" 
                                           Text="0" 
                                           FontSize="28" 
                                           FontWeight="Bold" 
                                           Foreground="{StaticResource BrushText}"/>
                                <TextBlock Text="Sản phẩm đang theo dõi" 
                                           FontSize="12" 
                                           Foreground="{StaticResource BrushTextSecondary}"/>
                            </StackPanel>
                        </Border>

                        <!-- Price Increase Card -->
                        <Border Grid.Column="1" 
                                Background="{StaticResource BrushSurface}" 
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="12" 
                                Padding="20">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" 
                                               Text="Tăng giá" 
                                               FontSize="14" 
                                               Foreground="{StaticResource BrushTextSecondary}"/>
                                    <Border Grid.Column="1" 
                                            Background="{StaticResource BrushSuccess}" 
                                            CornerRadius="16" 
                                            Width="32" 
                                            Height="32">
                                        <FontIcon Glyph="&#xE8E5;" 
                                                  FontSize="16" 
                                                  Foreground="White" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="PriceIncreaseText" 
                                           Text="0" 
                                           FontSize="28" 
                                           FontWeight="Bold" 
                                           Foreground="{StaticResource BrushText}"/>
                                <TextBlock Text="↗ Thị trường tăng" 
                                           FontSize="12" 
                                           Foreground="{StaticResource BrushSuccess}"/>
                            </StackPanel>
                        </Border>

                        <!-- Clearance Card -->
                        <Border Grid.Column="2" 
                                Background="{StaticResource BrushSurface}" 
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="12" 
                                Padding="20">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" 
                                               Text="Xả kho" 
                                               FontSize="14" 
                                               Foreground="{StaticResource BrushTextSecondary}"/>
                                    <Border Grid.Column="1" 
                                            Background="{StaticResource BrushWarning}" 
                                            CornerRadius="16" 
                                            Width="32" 
                                            Height="32">
                                        <FontIcon Glyph="&#xE74B;" 
                                                  FontSize="16" 
                                                  Foreground="White" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="ClearanceText" 
                                           Text="0" 
                                           FontSize="28" 
                                           FontWeight="Bold" 
                                           Foreground="{StaticResource BrushText}"/>
                                <TextBlock Text="Đang xả hàng" 
                                           FontSize="12" 
                                           Foreground="{StaticResource BrushWarning}"/>
                            </StackPanel>
                        </Border>

                        <!-- Pending Alerts Card -->
                        <Border Grid.Column="3" 
                                Background="{StaticResource BrushSurface}" 
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="12" 
                                Padding="20">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" 
                                               Text="Cảnh báo" 
                                               FontSize="14" 
                                               Foreground="{StaticResource BrushTextSecondary}"/>
                                    <Border Grid.Column="1" 
                                            Background="{StaticResource BrushError}" 
                                            CornerRadius="16" 
                                            Width="32" 
                                            Height="32">
                                        <FontIcon Glyph="&#xE7BA;" 
                                                  FontSize="16" 
                                                  Foreground="White" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="PendingAlertsText" 
                                           Text="0" 
                                           FontSize="28" 
                                           FontWeight="Bold" 
                                           Foreground="{StaticResource BrushText}"/>
                                <TextBlock Text="Chờ xử lý" 
                                           FontSize="12" 
                                           Foreground="{StaticResource BrushError}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>


                <!-- FIFO vs NIFO Trend and Recent Activity -->
                <Grid ColumnDefinitions="2*,1*" ColumnSpacing="20">
                    <!-- FIFO vs NIFO Trend Chart Area -->
                    <Border Grid.Column="0" 
                            Background="{StaticResource BrushSurface}" 
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="12" 
                            Padding="24">
                        <StackPanel Spacing="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" 
                                           Text="Xu hướng FIFO vs NIFO" 
                                           FontSize="18" 
                                           FontWeight="SemiBold" 
                                           Foreground="{StaticResource BrushText}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Border Background="{StaticResource BrushPrimary}" Width="12" Height="12" CornerRadius="2"/>
                                        <TextBlock Text="FIFO" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Border Background="{StaticResource BrushSuccess}" Width="12" Height="12" CornerRadius="2"/>
                                        <TextBlock Text="NIFO" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            
                            <!-- Product Trend List -->
                            <ListView x:Name="TrendListView"
                                      MaxHeight="300"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="8,12" ColumnDefinitions="*,Auto,Auto,Auto">
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="{Binding ProductName}" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="{StaticResource BrushText}"/>
                                                <TextBlock Text="{Binding ProductSku}" 
                                                           FontSize="12" 
                                                           Foreground="{StaticResource BrushTextSecondary}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2" Margin="16,0">
                                                <TextBlock Text="FIFO" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"/>
                                                <TextBlock Text="{Binding CostFifoDisplay}" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimary}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="2" Margin="16,0">
                                                <TextBlock Text="NIFO" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"/>
                                                <TextBlock Text="{Binding CostNifoDisplay}" FontWeight="SemiBold" Foreground="{StaticResource BrushSuccess}"/>
                                            </StackPanel>
                                            <Border Grid.Column="3" 
                                                    Background="{Binding TrendBackground}" 
                                                    CornerRadius="4" 
                                                    Padding="8,4"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TrendDisplay}" 
                                                           FontSize="12" 
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding TrendForeground}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            
                            <!-- Empty State -->
                            <StackPanel x:Name="TrendEmptyState" 
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center" 
                                        Spacing="8"
                                        Padding="24">
                                <FontIcon Glyph="&#xE9D9;" FontSize="48" Foreground="{StaticResource BrushTextSecondary}"/>
                                <TextBlock Text="Chưa có dữ liệu xu hướng" 
                                           FontSize="14" 
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Recent Activity -->
                    <Border Grid.Column="1" 
                            Background="{StaticResource BrushSurface}" 
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="12" 
                            Padding="24">
                        <StackPanel Spacing="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" 
                                           Text="Hoạt động gần đây" 
                                           FontSize="18" 
                                           FontWeight="SemiBold" 
                                           Foreground="{StaticResource BrushText}"/>
                            </Grid>
                            
                            <!-- Activity List -->
                            <ListView x:Name="RecentActivityListView"
                                      MaxHeight="300"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="4,8" ColumnDefinitions="Auto,*">
                                            <Border Grid.Column="0" 
                                                    Background="{Binding ActivityBackground}" 
                                                    CornerRadius="8" 
                                                    Width="40" 
                                                    Height="40" 
                                                    Margin="0,0,12,0">
                                                <FontIcon Glyph="{Binding ActivityIcon}" 
                                                          FontSize="16" 
                                                          Foreground="{Binding ActivityIconColor}" 
                                                          HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="{Binding ActivityTitle}" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="{StaticResource BrushText}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding ActivityDescription}" 
                                                           FontSize="12" 
                                                           Foreground="{StaticResource BrushTextSecondary}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding ActivityTime}" 
                                                           FontSize="11" 
                                                           Foreground="{StaticResource BrushTextSecondary}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            
                            <!-- Empty State -->
                            <StackPanel x:Name="ActivityEmptyState" 
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center" 
                                        Spacing="8"
                                        Padding="24">
                                <FontIcon Glyph="&#xE823;" FontSize="48" Foreground="{StaticResource BrushTextSecondary}"/>
                                <TextBlock Text="Chưa có hoạt động" 
                                           FontSize="14" 
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" 
              Grid.RowSpan="2" 
              Background="#80000000" 
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="48" Height="48"/>
                <TextBlock Text="Đang tải dữ liệu..." Foreground="White" FontSize="14"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
