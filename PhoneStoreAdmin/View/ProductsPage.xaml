                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" Background="#F4F6F8" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE8EA;" FontSize="20" Foreground="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Grid Grid.Column="1" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock FontSize="15" FontWeight="Bold">Samsung Galaxy Tab S9</TextBlock>
                                                <TextBlock FontSize="12" Foreground="#6B7280">Samsung</TextBlock>
                                                   <TextBlock FontSize="12" Foreground="#009688">Available: 6</TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#009688" VerticalAlignment="Center">$699</TextBlock>
                                                <Button Background="#E0E8FF" BorderThickness="0" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="8,0,12,0" MinWidth="70" Height="32">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                                        <FontIcon Glyph="&#xE70F;" FontSize="16" Foreground="#3A5EFF" />
                                                        <TextBlock FontSize="14" Foreground="#3A5EFF" VerticalAlignment="Center">Edit</TextBlock>
                                                    </StackPanel>
                                                </Button>
