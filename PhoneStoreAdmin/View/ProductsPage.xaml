                </Grid>
            </Border>
            <!-- Right Panel: Product Details / Empty State -->
        <Border Grid.Column="2"
            Style="{StaticResource CardStyle}"
            Padding="0">
            <Grid>
                <!-- Placeholder panel, will be hidden when a product is selected -->
                <StackPanel x:Name="ProductDetailPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20" Padding="40">
                    <Border Width="100" Height="100" Background="#E0E8FF" CornerRadius="50">
                        <FontIcon FontSize="40" Glyph="&#xE73E;" Foreground="#3A5EFF" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="#3A5EFF" TextAlignment="Center">Select a product to view details</TextBlock>
                        <TextBlock FontSize="15" Foreground="#6B7280" TextAlignment="Center">Please select a product from the list on the left to view and edit details</TextBlock>
                    </StackPanel>
                </StackPanel>
                <!-- Product detail panel, shown when a product is selected -->
                <StackPanel x:Name="ProductDetailPanel" Visibility="Collapsed" Padding="40" VerticalAlignment="Top" Spacing="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Avatar Centered Vertically -->
                        <Border Grid.Row="0" Grid.Column="0" Width="100" Height="100" Background="#E0E8FF" CornerRadius="50" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <FontIcon x:Name="ProductDetailIcon" FontSize="40" Glyph="&#xE8EA;" Foreground="#3A5EFF" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <!-- Name & Brand Centered Vertically to Avatar -->
                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                            <TextBlock x:Name="ProductDetailName" FontSize="20" FontWeight="Bold" Foreground="#3A5EFF" TextAlignment="Center">Product Name</TextBlock>
                            <TextBlock x:Name="ProductDetailBrand" FontSize="15" Foreground="#6B7280" TextAlignment="Center">Brand</TextBlock>
                            <TextBlock x:Name="ProductDetailAvailable" FontSize="15" Foreground="#009688" TextAlignment="Center">Available: </TextBlock>
                        </StackPanel>
                        <!-- Price Centered Vertically to Avatar -->
                        <TextBlock Grid.Row="0" Grid.Column="2" x:Name="ProductDetailPrice" FontSize="20" FontWeight="SemiBold" Foreground="#009688" TextAlignment="Right" VerticalAlignment="Center" HorizontalAlignment="Right">$0</TextBlock>
                    </Grid>
                    <!-- User Inputs as Form -->
                    <StackPanel Orientation="Vertical" Margin="0,16,0,0">
                        <TextBlock Text="Product Name" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4" />
                        <TextBox x:Name="ProductNameInput" Style="{StaticResource InputStyle}" FontSize="16" PlaceholderText="Edit name..." Margin="0,0,0,0" />
                        <TextBlock Text="Brand" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,4" />
                        <TextBox x:Name="ProductBrandInput" Style="{StaticResource InputStyle}" FontSize="16" PlaceholderText="Edit brand..." Margin="0,0,0,0" />
                        <TextBlock Text="Price" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,4" />
                        <TextBox x:Name="ProductPriceInput" Style="{StaticResource InputStyle}" FontSize="16" PlaceholderText="Edit price..." Margin="0,0,0,0" />
                        <TextBlock Text="Available" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,4" />
                        <TextBox x:Name="ProductAvailableInput" Style="{StaticResource InputStyle}" FontSize="16" PlaceholderText="Edit available quantity..." Margin="0,0,0,0" />
                    </StackPanel>
                    <!-- Confirm Button -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0" Spacing="12">
                        <Button x:Name="ProductDetailConfirmButton" Content="Confirm" Height="44" Width="160" Style="{StaticResource PrimaryButtonStyle}" FontSize="16" VerticalAlignment="Top" />
                        <Button x:Name="ProductDetailDeleteButton" Click="ProductDetailDeleteButton_Click" Height="44" Width="44" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Top" ToolTipService.ToolTip="Delete product">
                            <FontIcon Glyph="&#xE74D;" FontSize="20" Foreground="#E53935" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Page>