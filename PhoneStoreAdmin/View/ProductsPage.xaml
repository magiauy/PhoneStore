                                                <Button Background="#E0E8FF" BorderThickness="0" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="8,0,12,0" MinWidth="70" Height="32" Click="EditProductButton_Click">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                                        <FontIcon Glyph="&#xE70F;" FontSize="16" Foreground="#3A5EFF" />
                                                        <TextBlock FontSize="14" Foreground="#3A5EFF" VerticalAlignment="Center">Edit</TextBlock>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </ListViewItem>
                                <ListViewItem>
                                    <Border Margin="0,0,0,6" Padding="8" Background="White" CornerRadius="10" BorderBrush="#E0E3EB" BorderThickness="1" Height="80">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" Background="#F4F6F8" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE8EA;" FontSize="20" Foreground="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Grid Grid.Column="1" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock FontSize="15" FontWeight="Bold">Xperia 1 V</TextBlock>
                                                <TextBlock FontSize="12" Foreground="#6B7280">Sony</TextBlock>
                                                   <TextBlock FontSize="12" Foreground="#009688">Available: 3</TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#009688" VerticalAlignment="Center">$1099</TextBlock>
                                                <Button Background="#E0E8FF" BorderThickness="0" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="8,0,12,0" MinWidth="70" Height="32" Click="EditProductButton_Click">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                                        <FontIcon Glyph="&#xE70F;" FontSize="16" Foreground="#3A5EFF" />
                                                        <TextBlock FontSize="14" Foreground="#3A5EFF" VerticalAlignment="Center">Edit</TextBlock>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </ListViewItem>
                                <ListViewItem>
                                    <Border Margin="0,0,0,6" Padding="8" Background="White" CornerRadius="10" BorderBrush="#E0E3EB" BorderThickness="1" Height="80">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" Background="#F4F6F8" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE8EA;" FontSize="20" Foreground="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Grid Grid.Column="1" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock FontSize="15" FontWeight="Bold">Find X7</TextBlock>
                                                <TextBlock FontSize="12" Foreground="#6B7280">Oppo</TextBlock>
                                                   <TextBlock FontSize="12" Foreground="#009688">Available: 8</TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#009688" VerticalAlignment="Center">$799</TextBlock>
                                                <Button Background="#E0E8FF" BorderThickness="0" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="8,0,12,0" MinWidth="70" Height="32" Click="EditProductButton_Click">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                                        <FontIcon Glyph="&#xE70F;" FontSize="16" Foreground="#3A5EFF" />
                                                        <TextBlock FontSize="14" Foreground="#3A5EFF" VerticalAlignment="Center">Edit</TextBlock>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </ListViewItem>
                                <ListViewItem>
                                    <Border Margin="0,0,0,6" Padding="8" Background="White" CornerRadius="10" BorderBrush="#E0E3EB" BorderThickness="1" Height="80">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" Background="#F4F6F8" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE8EA;" FontSize="20" Foreground="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Grid Grid.Column="1" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock FontSize="15" FontWeight="Bold">Xiaomi 14 Ultra</TextBlock>
                                                <TextBlock FontSize="12" Foreground="#6B7280">Xiaomi</TextBlock>
                                                   <TextBlock FontSize="12" Foreground="#009688">Available: 10</TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#009688" VerticalAlignment="Center">$799</TextBlock>
                                                <Button Background="#E0E8FF" BorderThickness="0" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="8,0,12,0" MinWidth="70" Height="32" Click="EditProductButton_Click">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                                        <FontIcon Glyph="&#xE70F;" FontSize="16" Foreground="#3A5EFF" />
                                                        <TextBlock FontSize="14" Foreground="#3A5EFF" VerticalAlignment="Center">Edit</TextBlock>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </ListViewItem>
                                <ListViewItem>
                                    <Border Margin="0,0,0,6" Padding="8" Background="White" CornerRadius="10" BorderBrush="#E0E3EB" BorderThickness="1" Height="80">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" Background="#F4F6F8" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE8EA;" FontSize="20" Foreground="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Grid Grid.Column="1" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock FontSize="15" FontWeight="Bold">iPad Pro 12.9 inch M2</TextBlock>
                                                <TextBlock FontSize="12" Foreground="#6B7280">Apple</TextBlock>
                                                   <TextBlock FontSize="12" Foreground="#009688">Available: 4</TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#009688" VerticalAlignment="Center">$1099</TextBlock>
                                                <Button Background="#E0E8FF" BorderThickness="0" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="8,0,12,0" MinWidth="70" Height="32" Click="EditProductButton_Click">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                                        <FontIcon Glyph="&#xE70F;" FontSize="16" Foreground="#3A5EFF" />
                                                        <TextBlock FontSize="14" Foreground="#3A5EFF" VerticalAlignment="Center">Edit</TextBlock>
                                                    </StackPanel>
                                                </Button>
