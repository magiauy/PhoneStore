<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PhoneStoreAdmin.View.ProductsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:PhoneStoreAdmin.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PhoneStoreAdmin.View"
    xmlns:viewModels="using:PhoneStoreAdmin.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{StaticResource BrushBackground}"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Theme/Colors.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

            <ThemeShadow x:Key="SharedShadow" />

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Opacity="0.95" Color="{StaticResource ColorSurface}" />
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BrushPrimary}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="18,12" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BrushSurface}" />
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="FontWeight" Value="Medium" />
            </Style>

            <converters:CurrencyConverter x:Key="CurrencyConverter" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.RowSpan="2">
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="{StaticResource ColorBackground}" />
                        <GradientStop Offset="0.5" Color="#FFF0F2FF" />
                        <GradientStop Offset="1" Color="#FFE8ECFF" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Grid>
                <Ellipse
                    Width="420"
                    Height="420"
                    Margin="-220,-120,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Opacity="0.08">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="{StaticResource ColorPrimary}" />
                            <GradientStop Offset="1" Color="{StaticResource ColorPrimaryLight}" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse
                    Width="320"
                    Height="320"
                    Margin="0,0,-160,-160"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Opacity="0.08">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="{StaticResource ColorAccent}" />
                            <GradientStop Offset="1" Color="Transparent" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
        </Grid>

        <Border
            Grid.Row="0"
            Margin="32,32,32,24"
            Padding="32,24"
            Shadow="{StaticResource SharedShadow}"
            Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical" Spacing="8">
                    <TextBlock
                        Text="Product Models"
                        FontSize="36"
                        FontWeight="Bold">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="{StaticResource ColorPrimary}" />
                                <GradientStop Offset="1" Color="{StaticResource ColorAccent}" />
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock
                        Text="Manage models and product variants"
                        FontSize="16"
                        Foreground="{StaticResource BrushTextSecondary}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button
                        x:Name="RefreshModelsButton"
                        Content="Refresh"
                        Click="RefreshModelsButton_Click"
                        Style="{StaticResource SecondaryButtonStyle}" />
                    <Button
                        x:Name="CreateModelButton"
                        Content="Create Product Model"
                        Click="CreateModelButton_Click"
                        Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="32,0,32,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Margin="0,0,16,0"
                Padding="20"
                Shadow="{StaticResource SharedShadow}"
                Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,16">
                        <TextBlock
                            Text="Model catalog"
                            FontSize="20"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <GridView
                            x:Name="ModelGridView"
                            Grid.Row="0"
                            ItemsSource="{x:Bind ProductModels, Mode=OneWay}"
                            IsItemClickEnabled="True"
                            ItemClick="ModelGridView_ItemClick"
                            SelectionMode="Single">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid ItemWidth="260" ItemHeight="200" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:ProductModelListItemViewModel" xmlns:viewModels="using:PhoneStoreAdmin.ViewModels">
                                    <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="4" Shadow="{StaticResource SharedShadow}">
                                        <StackPanel Spacing="12">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <Border Width="56" Height="56" Background="{StaticResource BrushPrimaryLight}" CornerRadius="12">
                                                    <FontIcon Glyph="&#xE722;" FontSize="24" Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Border>
                                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind VariantCount, Mode=OneWay}" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind DescriptionPreview}" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="WrapWholeWords" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Updated" FontSize="12" Foreground="{StaticResource BrushTextTertiary}" />
                                                <TextBlock Text="{x:Bind UpdatedAt, Mode=OneWay}" FontSize="12" Foreground="{StaticResource BrushTextTertiary}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Visibility="{x:Bind HasNoModels, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border Width="88" Height="88" Background="{StaticResource BrushPrimaryLight}" CornerRadius="44">
                                <FontIcon FontSize="36" Foreground="{StaticResource BrushPrimary}" Glyph="&#xE8A5;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="No models yet" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock
                                    Text="Create your first product model to start grouping product variants"
                                    FontSize="14"
                                    Foreground="{StaticResource BrushTextSecondary}"
                                    TextAlignment="Center"
                                    TextWrapping="WrapWholeWords"
                                    Width="260" />
                            </StackPanel>
                            <Button Content="Create Product Model" Click="CreateModelButton_Click" Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Padding="24"
                Shadow="{StaticResource SharedShadow}"
                Style="{StaticResource CardBorderStyle}"
                Visibility="{x:Bind SelectedModelDetail != null, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Border Width="72" Height="72" Background="{StaticResource BrushPrimaryLight}" CornerRadius="20">
                                <FontIcon Glyph="&#xE7F8;" FontSize="32" Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind SelectedModelDetail?.Model.Name, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{x:Bind SelectedModelDetail?.Model.Description, Mode=OneWay}" FontSize="14" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{x:Bind SelectedModelSummary, Mode=OneWay}" FontSize="12" Foreground="{StaticResource BrushTextTertiary}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Create Product" Click="CreateProductButton_Click" Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Content="Edit Model" Click="EditModelButton_Click" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="Duplicate Model" Click="DuplicateModelButton_Click" Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Variants" FontSize="20" FontWeight="SemiBold" />
                            <ListView
                                x:Name="VariantsListView"
                                ItemsSource="{x:Bind SelectedModelDetail?.Variants, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:ProductListItemViewModel" xmlns:viewModels="using:PhoneStoreAdmin.ViewModels">
                                        <Border Padding="16" Margin="0,0,0,12" CornerRadius="12" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="4" Width="150">
                                                    <TextBlock Text="SKU" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                                                    <TextBlock Text="{x:Bind Sku}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock Text="{x:Bind Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock Text="{x:Bind BrandName}" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" />
                                                        <TextBlock Text="{x:Bind CategoryName}" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind Price, Converter={StaticResource CurrencyConverter}}" FontSize="14" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
                                                    <Button Content="Edit" Tag="{x:Bind Id}" Click="EditProductButton_Click" Style="{StaticResource SecondaryButtonStyle}" />
                                                    <TextBlock Text="{x:Bind StatusText}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="{x:Bind SelectedModelDetail != null &amp;&amp; !SelectedModelDetail.HasVariants, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="No variants yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="Use the button above to create a product variant for this model" FontSize="14" Foreground="{StaticResource BrushTextSecondary}" TextAlignment="Center" TextWrapping="Wrap" Width="220" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
