<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Primary  -->
    <Color x:Key="ColorPrimary">#FF4053F7</Color>
    <Color x:Key="ColorPrimaryHover">#FF3042C9</Color>
    <Color x:Key="ColorPrimaryLight">#FFA5AEFF</Color>
    <Color x:Key="ColorOnPrimary">#FFFFFFFF</Color>
    <Color x:Key="ColorPrimaryPressed">#CC4053F7</Color>
    <!-- Fluent Design Container Colors -->
    <Color x:Key="ColorPrimaryContainer">#FFF0F2FF</Color>
    <Color x:Key="ColorOnPrimaryContainer">#FF4053F7</Color>

    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}" />
    <SolidColorBrush x:Key="BrushPrimaryHover" Color="{StaticResource ColorPrimaryHover}" />
    <SolidColorBrush x:Key="BrushPrimaryLight" Color="{StaticResource ColorPrimaryLight}" />
    <SolidColorBrush x:Key="BrushOnPrimary" Color="{StaticResource ColorOnPrimary}" />
    <SolidColorBrush x:Key="BrushPrimaryPressed" Color="{StaticResource ColorPrimaryPressed}" />
    <SolidColorBrush x:Key="BrushPrimaryContainer" Color="{StaticResource ColorPrimaryContainer}" />
    <SolidColorBrush x:Key="BrushOnPrimaryContainer" Color="{StaticResource ColorOnPrimaryContainer}" />

    <!--  Secondary  -->
    <Color x:Key="ColorSecondary">#FFA5AEFF</Color>
    <Color x:Key="ColorOnSecondary">#FF1E1E2F</Color>
    <SolidColorBrush x:Key="BrushSecondary" Color="{StaticResource ColorSecondary}" />
    <SolidColorBrush x:Key="BrushOnSecondary" Color="{StaticResource ColorOnSecondary}" />

    <!--  Accent  -->
    <Color x:Key="ColorAccent">#FF5CE1E6</Color>
    <Color x:Key="ColorOnAccent">#FF1E1E2F</Color>
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushOnAccent" Color="{StaticResource ColorOnAccent}" />

    <!--  Neutral  -->
    <Color x:Key="ColorBackground">#FFF5F7FF</Color>
    <Color x:Key="ColorSurface">#FFFFFFFF</Color>
    <Color x:Key="ColorSurfaceVariant">#FFF0F2FF</Color>
    <Color x:Key="ColorBorder">#FFE0E3F5</Color>
    <Color x:Key="ColorText">#FF1E1E2F</Color>
    <Color x:Key="ColorTextSecondary">#FF6B6B8C</Color>
    <Color x:Key="ColorTextTertiary">#FF9E9EAD</Color>

    <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
    <!-- Secondary background for sections/banners -->
    <Color x:Key="ColorBackgroundSecondary">#FFF0F2FF</Color>
    <SolidColorBrush x:Key="BrushBackgroundSecondary" Color="{StaticResource ColorBackgroundSecondary}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushSurfaceVariant" Color="{StaticResource ColorSurfaceVariant}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextTertiary" Color="{StaticResource ColorTextTertiary}" />

    <!--  Status  -->
    <Color x:Key="ColorSuccess">#FF4CAF50</Color>
    <Color x:Key="ColorWarning">#FFFFB74D</Color>
    <Color x:Key="ColorError">#FFE53935</Color>
    <Color x:Key="ColorInfo">#FF2196F3</Color>

    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="BrushError" Color="{StaticResource ColorError}" />
    <SolidColorBrush x:Key="BrushInfo" Color="{StaticResource ColorInfo}" />
</ResourceDictionary>
